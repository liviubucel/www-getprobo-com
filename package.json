{
  "name": "zebrabyte-website",
  "type": "module",
  "version": "0.0.1",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "npm run sync:zebrabyte-blog && npm run check:performance-assets && npm run sync:changelog && npm run check:zebrabyte-content && npm run check:experience && astro build && npm run llms:normalize && npm run sitemap:i18n && npm run check:i18n && npm run check:public-brand",
    "sync:security-assets": "node tools/sync-security-brand-assets.mjs",
    "sync:zebrabyte-blog": "node tools/sync-zebrabyte-blog-optimized.mjs",
    "sync:changelog": "node tools/sync-github-changelog.mjs",
    "check:performance-assets": "node tools/check-performance-assets.mjs",
    "check:zebrabyte-content": "node tools/check-zebrabyte-content.mjs",
    "check:experience": "node tools/check-probo-design-contract.mjs && node tools/check-svg-assets.mjs && node tools/check-experience-contract.mjs && node tools/check-experience-provenance.mjs",
    "check:i18n": "node tools/check-i18n.mjs",
    "check:public-brand": "node tools/check-public-brand.mjs",
    "llms:normalize": "node tools/normalize-llms-assets.mjs",
    "sitemap:i18n": "node tools/localize-sitemap.mjs",
    "check:docs": "node tools/check-docs.mjs",
    "docs:check-reference": "node tools/generate-reference.mjs --check",
    "docs:generate": "node tools/generate-reference.mjs",
    "redirects:generate": "node tools/generate-redirects.mjs",
    "indexnow:submit": "node --env-file=.env tools/submit-indexnow.mjs",
    "newsletter:announce": "node --env-file=.env tools/send-newsletter-announcement.mjs",
    "newsletter:notify-post": "node --env-file=.env tools/notify-newsletter-post.mjs",
    "format": "node tools/format-changed.mjs",
    "preview": "astro preview",
    "astro": "astro",
    "deploy": "npm run build && wrangler deploy"
  },
  "dependencies": {
    "@astrojs/mdx": "^7.0.5",
    "@astrojs/rss": "^4.0.19",
    "@astrojs/sitemap": "^3.7.3",
    "@astrojs/starlight": "^0.41.7",
    "@astrojs/svelte": "^9.0.1",
    "@phosphor-icons/core": "^2.1.1",
    "@phosphor-icons/web": "^2.1.2",
    "@probo/cookie-banner": "^0.13.0",
    "@splidejs/splide": "^4.1.4",
    "@splidejs/splide-extension-auto-scroll": "^0.5.3",
    "@splidejs/splide-extension-intersection": "^0.2.0",
    "@splidejs/svelte-splide": "^0.2.9",
    "@tailwindcss/vite": "^4.3.3",
    "astro": "^7.2.0",
    "clsx": "^2.1.1",
    "embla-carousel": "^8.6.0",
    "embla-carousel-autoplay": "^8.6.0",
    "embla-carousel-svelte": "^8.6.0",
    "fuse.js": "^7.5.0",
    "lottie-web": "^5.13.0",
    "mermaid": "^11.16.1",
    "posthog-js": "^1.413.3",
    "prettier": "^3.9.6",
    "prettier-plugin-astro": "^0.14.1",
    "prettier-plugin-svelte": "^4.1.1",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "svelte": "^5.56.8",
    "svelte-sonner": "^1.1.1",
    "tailwind-merge": "^3.6.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^6.0.3",
    "yaml": "^2.9.0"
  },
  "devDependencies": {
    "@astrojs/starlight-tailwind": "^5.0.0",
    "@tailwindcss/typography": "^0.5.20",
    "tailwind-variants": "^3.3.1",
    "wrangler": "^4.123.0"
  },
  "overrides": {
    "zod": "^4.3.6"
  }
}
