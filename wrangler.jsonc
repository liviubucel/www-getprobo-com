{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "www-getprobo-com",
  "main": "./worker/index.ts",
  "compatibility_date": "2026-06-11",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": true,
    "not_found_handling": "404-page"
  },
  "observability": {
    "enabled": true
  },
  "send_email": [
    {
      "name": "EMAIL"
    }
  ],
  "vars": {
    "PUBLIC_TURNSTILE_SITE_KEY": "0x4AAAAAABBpDfopxKwUIKF_",
    "CONTACT_TO_EMAIL": "info@zebrabyte.ro",
    "CONTACT_FROM_EMAIL": "noreply@zebrabyte.ro"
  },
  "secrets": {
    "required": [
      "TURNSTILE_SECRET_KEY"
    ]
  }
}
