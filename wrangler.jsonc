{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "www-getprobo-com",
  "main": "./worker/index.ts",
  "compatibility_date": "2025-01-10",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": true,
    "not_found_handling": "404-page"
  },
  "observability": {
    "enabled": true
  }
}
