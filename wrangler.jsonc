{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "zebrabyte-website",
  "main": "./worker/main.ts",
  "compatibility_date": "2026-06-11",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": true,
    "not_found_handling": "404-page"
  },
  "ai": {
    "binding": "AI"
  },
  "observability": {
    "enabled": true
  },
  "kv_namespaces": [
    {
      "binding": "NEWSLETTER",
      "id": "a3474e304aeb47168fb65edfaad5ead1"
    }
  ],
  "queues": {
    "producers": [
      {
        "binding": "MAIL_QUEUE",
        "queue": "zebrabyte-mail"
      }
    ],
    "consumers": [
      {
        "queue": "zebrabyte-mail",
        "max_batch_size": 10,
        "max_batch_timeout": 5,
        "max_retries": 5,
        "dead_letter_queue": "zebrabyte-mail-dlq",
        "max_concurrency": 1
      }
    ]
  },
  "services": [
    {
      "binding": "STATUS_ENGINE",
      "service": "status-page",
      "entrypoint": "FooterStatusEntrypoint"
    }
  ],
  "send_email": [
    {
      "name": "EMAIL",
      "allowed_sender_addresses": [
        "noreply@zebrabyte.ro",
        "newsletter@zebrabyte.ro"
      ]
    }
  ],
  "vars": {
    "PUBLIC_TURNSTILE_SITE_KEY": "0x4AAAAAABBpDfopxKwUIKF_",
    "CONTACT_TO_EMAIL": "info@zebrabyte.ro",
    "CONTACT_FROM_EMAIL": "noreply@zebrabyte.ro",
    "NEWSLETTER_FROM_EMAIL": "newsletter@zebrabyte.ro",
    "SENTRY_DSN": "https://3911779244253b927f077fff97216671@o4511598677852160.ingest.de.sentry.io/4511598685323344",
    "SENTRY_ENVIRONMENT": "production"
  }
}
