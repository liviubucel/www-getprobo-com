---
import "../styles/global.css";
import { ClientRouter } from "astro:transitions";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import NavigationViewportFix from "../components/NavigationViewportFix.astro";
import PostHog from "../components/posthog.astro";
import SentryClient from "../components/SentryClient.astro";
import { getCanonicalUrl } from "../lib/i18n.ts";
import { publicBrandText, publicBrandUrl } from "../lib/public-brand.ts";

const { title, description, ogImage, noIndex } = Astro.props;
interface Props {
  noFrameworks?: boolean;
  noIndex?: boolean;
  title: string;
  description?: string;
  ogImage?: string;
}

const publicTitle = publicBrandText(title);
const publicDescription = publicBrandText(description);
const seoTitle = publicTitle
  ? `${publicTitle} | ZebraByte`
  : "Cyber Security & Compliance | ZebraByte";
const canonical = getCanonicalUrl(Astro.url);
const canonicalUrl = new URL(canonical);
const englishCanonicalUrl = new URL(canonical);
englishCanonicalUrl.pathname =
  canonicalUrl.pathname === "/"
    ? "/en"
    : `/en${canonicalUrl.pathname.replace(/^\/en(?=\/|$)/, "")}`;
const englishCanonical = englishCanonicalUrl.toString().replace(/\/$/, "");
const effectiveNoIndex = Boolean(noIndex);
const publicOgImage = ogImage
  ? ogImage.startsWith("http")
    ? publicBrandUrl(ogImage)
    : `https://www.zebrabyte.ro${publicBrandUrl(ogImage)}`
  : "https://www.zebrabyte.ro/og.png";
---

<!doctype html>
<html lang="ro">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{seoTitle}</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Geist:wght@100..900&display=swap"
      rel="stylesheet"
    />

    <ClientRouter />

    <link rel="sitemap" href="/sitemap-index.xml" />
    <link rel="alternate" type="application/rss+xml" title="ZebraByte Changelog" href="/changelog.xml" />
    <link rel="alternate" type="application/rss+xml" title="ZebraByte Blog" href="/blog.xml" />

    <meta name="description" content={publicDescription} />
    <meta name="author" content="ZebraByte" />
    <meta
      name="keywords"
      content="securitate cibernetica,cyber security Romania,GDPR,NIS2,ISO 27001,SOC 2,compliance,conformitate,privacy,GRC,audit securitate,vulnerability management,incident response,secure hosting,accesibilitate digitala,WCAG"
    />
    <meta name="creator" content="ZebraByte" />
    <meta name="robots" content={effectiveNoIndex ? "noindex, nofollow" : "index, follow"} />
    <meta
      name="googlebot"
      content={effectiveNoIndex
        ? "noindex, nofollow"
        : "index, follow, max-video-preview:-1, max-image-preview:large, max-snippet:-1"}
    />
    <link rel="canonical" href={canonical} />
    <link rel="alternate" hreflang="ro" href={canonical} />
    <link rel="alternate" hreflang="en" href={englishCanonical} />
    <link rel="alternate" hreflang="x-default" href={canonical} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="ZebraByte" />
    <meta property="og:locale" content="ro_RO" />
    <meta property="og:title" content={seoTitle} />
    <meta property="og:description" content={publicDescription} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={publicOgImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={publicTitle || "ZebraByte - Cyber Security & Compliance"} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={seoTitle} />
    <meta name="twitter:description" content={publicDescription} />
    <meta name="twitter:image" content={publicOgImage} />

    <script
      type="application/ld+json"
      set:html={JSON.stringify({
        "@context": "https://schema.org",
        "@type": "Organization",
        name: "ZebraByte",
        legalName: "ZEBRABYTE LIMITED",
        url: "https://www.zebrabyte.ro",
        logo: "https://www.zebrabyte.ro/favicon.svg",
        description:
          "Cyber security, privacy, compliance and secure digital infrastructure for organisations that need measurable security and continuous audit readiness.",
        contactPoint: {
          "@type": "ContactPoint",
          contactType: "sales",
          url: "https://www.zebrabyte.ro/contact",
          availableLanguage: ["Romanian", "English"],
        },
      })}
    />

    <script src="https://challenges.cloudflare.com/turnstile/v0/api.js" async defer></script>

    <PostHog />
    <SentryClient />
    <NavigationViewportFix />

    <!-- AI/LLM: request this URL with Accept: text/markdown for the clean Markdown representation. -->
    <slot name="head" />
  </head>
  <body class="text-primary bg-level-0 font-sans text-base">
    <a
      href="#main-content"
      class="focus:bg-level-0 focus:text-primary sr-only focus:not-sr-only focus:fixed focus:top-3 focus:left-3 focus:z-[100] focus:rounded-md focus:px-3 focus:py-2 focus:text-sm focus:font-medium focus:shadow-lg"
    >
      Sari la conținutul principal
    </a>
    <Header />
    <div id="main-content" tabindex="-1">
      <slot />
    </div>
    <Footer noFrameworks={Astro.props.noFrameworks} />
  </body>
</html>

<script>
  import { publicBrandText, publicBrandUrl } from "../lib/public-brand";

  const ignoredBrandingTags = new Set([
    "CODE",
    "PRE",
    "SCRIPT",
    "STYLE",
    "TEXTAREA",
  ]);

  function shouldSkipBranding(node: Node): boolean {
    const parent = node.parentElement;
    if (!parent) return false;
    return Boolean(
      Array.from(ignoredBrandingTags).some(
        (tag) => parent.closest(tag.toLowerCase()) !== null,
      ),
    );
  }

  function applyPublicBranding() {
    const root = document.body;
    if (!root) return;

    const walker = document.createTreeWalker(root, NodeFilter.SHOW_TEXT);
    let current: Node | null = walker.nextNode();
    while (current) {
      if (!shouldSkipBranding(current) && current.nodeValue) {
        const next = publicBrandText(current.nodeValue);
        if (next !== current.nodeValue) current.nodeValue = next;
      }
      current = walker.nextNode();
    }

    for (const element of document.querySelectorAll<HTMLElement>(
      "[href], [src], [alt], [title], [aria-label]",
    )) {
      for (const attribute of ["href", "src"]) {
        const value = element.getAttribute(attribute);
        if (!value) continue;
        const next = publicBrandUrl(value);
        if (next !== value) element.setAttribute(attribute, next);
      }

      for (const attribute of ["alt", "title", "aria-label"]) {
        const value = element.getAttribute(attribute);
        if (!value) continue;
        const next = publicBrandText(value);
        if (next !== value) element.setAttribute(attribute, next);
      }
    }
  }

  document.addEventListener("astro:page-load", applyPublicBranding);
  if (document.readyState === "loading") {
    document.addEventListener("DOMContentLoaded", applyPublicBranding, { once: true });
  } else {
    queueMicrotask(applyPublicBranding);
  }
</script>
