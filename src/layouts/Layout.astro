---
import "../styles/global.css";
import "../styles/mobile-audit.css";
import { ClientRouter } from "astro:transitions";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import NavigationViewportFix from "../components/NavigationViewportFix.astro";
import ProgressiveForms from "../components/ProgressiveForms.astro";
import SentryClient from "../components/SentryClient.astro";
import { getCanonicalUrl } from "../lib/i18n.ts";
import { publicBrandText, publicBrandUrl } from "../lib/public-brand.ts";
import {
  getCmsSiteSettings,
  type CmsLocale,
} from "../lib/cms/content";

interface Props {
  noFrameworks?: boolean;
  noIndex?: boolean;
  title: string;
  description?: string;
  ogImage?: string;
  locale?: CmsLocale;
  canonicalPath?: string;
  showHeader?: boolean;
  showFooter?: boolean;
  cmsManaged?: boolean;
}

const {
  title,
  description,
  ogImage,
  noIndex,
  locale = "ro",
  canonicalPath,
  showHeader = true,
  showFooter = true,
  cmsManaged = false,
} = Astro.props;

const publicTitle = publicBrandText(title);
const publicDescription = publicBrandText(description);
const seoTitle = publicTitle
  ? `${publicTitle} | ZebraByte`
  : "Cyber Security & Compliance | ZebraByte";

const normalizeCanonicalPath = (value: string) => {
  if (!value || value === "/") return "/";
  return `/${value.replace(/^\/+|\/+$/g, "")}`;
};

let romanianCanonical: string;
let englishCanonical: string;
if (canonicalPath) {
  const normalized = normalizeCanonicalPath(canonicalPath.replace(/^\/en(?=\/|$)/, "") || "/");
  romanianCanonical = new URL(normalized, "https://www.zebrabyte.ro").toString().replace(/\/$/, normalized === "/" ? "/" : "");
  const englishPath = normalized === "/" ? "/en" : `/en${normalized}`;
  englishCanonical = new URL(englishPath, "https://www.zebrabyte.ro").toString().replace(/\/$/, "");
} else {
  romanianCanonical = getCanonicalUrl(Astro.url);
  const canonicalUrl = new URL(romanianCanonical);
  const englishCanonicalUrl = new URL(romanianCanonical);
  englishCanonicalUrl.pathname =
    canonicalUrl.pathname === "/"
      ? "/en"
      : `/en${canonicalUrl.pathname.replace(/^\/en(?=\/|$)/, "")}`;
  englishCanonical = englishCanonicalUrl.toString().replace(/\/$/, "");
}
const canonical = locale === "en" ? englishCanonical : romanianCanonical;
const effectiveNoIndex = Boolean(noIndex);
const publicOgImage = ogImage
  ? ogImage.startsWith("http")
    ? publicBrandUrl(ogImage)
    : `https://www.zebrabyte.ro${publicBrandUrl(ogImage)}`
  : "https://www.zebrabyte.ro/og.png";
const geistStylesheet =
  "https://fonts.googleapis.com/css2?family=Geist:wght@100..900&display=swap";
const cmsSettings = getCmsSiteSettings(locale);
const announcement = cmsSettings?.announcement?.enabled ? cmsSettings.announcement : null;
const announcementTone = {
  info: "bg-subtle text-primary",
  success: "bg-secondary text-primary",
  warning: "bg-secondary text-primary",
  critical: "bg-primary text-primary-foreground",
}[announcement?.tone ?? "info"];
const skipLabel = locale === "en" ? "Skip to main content" : "Sari la conținutul principal";
---

<!doctype html>
<html lang={locale} data-cms-managed={cmsManaged ? "true" : undefined}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{seoTitle}</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href={geistStylesheet}
      rel="stylesheet"
      media="print"
      onload="this.media='all'"
    />
    <noscript><link href={geistStylesheet} rel="stylesheet" /></noscript>

    <ClientRouter />

    <link rel="sitemap" href="/sitemap-index.xml" />
    <link rel="alternate" type="application/rss+xml" title="ZebraByte Changelog" href="/changelog.xml" />
    <link rel="alternate" type="application/rss+xml" title="ZebraByte Blog" href="/blog.xml" />

    <meta name="description" content={publicDescription} />
    <meta name="author" content="ZebraByte" />
    <meta
      name="keywords"
      content="securitate cibernetica,cyber security Romania,GDPR,NIS2,ISO 27001,SOC 2,compliance,conformitate,privacy,GRC,audit securitate,vulnerability management,incident response,secure hosting,accesibilitate digitala,WCAG"
    />
    <meta name="creator" content="ZebraByte" />
    <meta name="robots" content={effectiveNoIndex ? "noindex, nofollow" : "index, follow"} />
    <meta
      name="googlebot"
      content={effectiveNoIndex
        ? "noindex, nofollow"
        : "index, follow, max-video-preview:-1, max-image-preview:large, max-snippet:-1"}
    />
    <link rel="canonical" href={canonical} />
    <link rel="alternate" hreflang="ro" href={romanianCanonical} />
    <link rel="alternate" hreflang="en" href={englishCanonical} />
    <link rel="alternate" hreflang="x-default" href={romanianCanonical} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="ZebraByte" />
    <meta property="og:locale" content={locale === "en" ? "en_GB" : "ro_RO"} />
    <meta property="og:title" content={seoTitle} />
    <meta property="og:description" content={publicDescription} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={publicOgImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={publicTitle || "ZebraByte - Cyber Security & Compliance"} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={seoTitle} />
    <meta name="twitter:description" content={publicDescription} />
    <meta name="twitter:image" content={publicOgImage} />

    <script
      type="application/ld+json"
      set:html={JSON.stringify({
        "@context": "https://schema.org",
        "@type": "Organization",
        name: "ZebraByte",
        legalName: "ZEBRABYTE LIMITED",
        url: "https://www.zebrabyte.ro",
        logo: "https://www.zebrabyte.ro/favicon.svg",
        description:
          "Cyber security, privacy, compliance and secure digital infrastructure for organisations that need measurable security and continuous audit readiness.",
        contactPoint: {
          "@type": "ContactPoint",
          contactType: "sales",
          url: "https://www.zebrabyte.ro/contact",
          availableLanguage: ["Romanian", "English"],
        },
      })}
    />

    <SentryClient />
    <NavigationViewportFix />
    <ProgressiveForms />

    <!-- AI/LLM: request this URL with Accept: text/markdown for the clean Markdown representation. -->
    <slot name="head" />
  </head>
  <body class="text-primary bg-level-0 font-sans text-base">
    <a
      href="#main-content"
      class="focus:bg-level-0 focus:text-primary sr-only focus:not-sr-only focus:fixed focus:top-3 focus:left-3 focus:z-[100] focus:rounded-md focus:px-3 focus:py-2 focus:text-sm focus:font-medium focus:shadow-lg"
    >
      {skipLabel}
    </a>
    {announcement && (
      <aside class:list={["border-b px-4 py-2.5 text-center text-sm", announcementTone]} data-cms-announcement>
        <span>{announcement.message}</span>
        {announcement.link && (
          <a
            href={announcement.link.href}
            target={announcement.link.newTab ? "_blank" : undefined}
            rel={announcement.link.newTab ? "noopener noreferrer" : undefined}
            class="ml-2 font-semibold underline underline-offset-4"
          >
            {announcement.link.label}
          </a>
        )}
      </aside>
    )}
    {showHeader && <Header locale={locale} canonicalPath={canonicalPath} />}
    <div id="main-content" tabindex="-1">
      <slot />
    </div>
    {showFooter && <Footer noFrameworks={Astro.props.noFrameworks} locale={locale} />}
  </body>
</html>
