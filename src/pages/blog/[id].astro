---
import { getCollection, render } from "astro:content";
import Layout from "../../layouts/Layout.astro";
import Prose from "../../components/Prose.astro";
import Sharer from "../../components/block/Sharer.svelte";
import WrittenBy from "../../components/block/WrittenBy.astro";
import Newsletter from "../../components/block/Newsletter.astro";
import Breadcrumbs from "../../components/Breadcrumbs.astro";
import { getCanonicalUrl } from "../../lib/i18n.ts";
import { getBlogSlug } from "../../lib/blog";
import { getBlogCategory, getBlogCategoryHref } from "../../lib/blog-categories";

export async function getStaticPaths() {
  const posts = await getCollection("blog");
  return posts.map((post) => ({
    params: { id: getBlogSlug(post) },
    props: { post },
  }));
}

const { post } = Astro.props;
const { Content } = await render(post);
const category = getBlogCategory(post);
const dateFormatter = Intl.DateTimeFormat("ro-RO", {
  year: "numeric",
  month: "long",
  day: "numeric",
});

const articleImage = post.data.ogImage
  ? new URL(post.data.ogImage, "https://www.zebrabyte.ro").toString()
  : post.data.titleImage
    ? new URL(post.data.titleImage, "https://www.zebrabyte.ro").toString()
    : "https://www.zebrabyte.ro/og.png";
const visibleHeroImage = post.data.titleImage
  ? post.data.titleImage
  : post.data.source === "zebrabyte"
    ? post.data.ogImage
    : undefined;
const isZebraByteAuthor = /zebrabyte/i.test(post.data.author.name);

const articleSchema = {
  "@context": "https://schema.org",
  "@type": "Article",
  headline: post.data.title,
  description: post.data.excerpt,
  articleSection: category.label,
  keywords: post.data.tags?.join(", ") || undefined,
  image: articleImage,
  datePublished: post.data.date.toISOString(),
  dateModified: (post.data.dateModified ?? post.data.date).toISOString(),
  author: isZebraByteAuthor
    ? {
        "@type": "Organization",
        name: post.data.author.name,
        url: "https://www.zebrabyte.ro/about",
      }
    : {
        "@type": "Person",
        name: post.data.author.name,
      },
  publisher: {
    "@type": "Organization",
    name: "ZebraByte",
    logo: {
      "@type": "ImageObject",
      url: "https://www.zebrabyte.ro/og.png",
    },
  },
  mainEntityOfPage: {
    "@type": "WebPage",
    "@id": getCanonicalUrl(Astro.url),
  },
};

const faqSchema = post.data.faqs
  ? {
      "@context": "https://schema.org",
      "@type": "FAQPage",
      mainEntity: post.data.faqs.map(
        (faq: { question: string; answer: string }) => ({
          "@type": "Question",
          name: faq.question,
          acceptedAnswer: {
            "@type": "Answer",
            text: faq.answer,
          },
        }),
      ),
    }
  : null;
---

<Layout
  title={post.data.title}
  description={post.data.excerpt}
  ogImage={post.data.ogImage ?? post.data.titleImage}
>
  <meta slot="head" property="og:type" content="article" />
  <meta
    slot="head"
    property="article:published_time"
    content={post.data.date.toISOString()}
  />
  <meta
    slot="head"
    property="article:modified_time"
    content={(post.data.dateModified ?? post.data.date).toISOString()}
  />
  <meta
    slot="head"
    property="article:author"
    content={isZebraByteAuthor ? "https://www.zebrabyte.ro/about" : post.data.author.name}
  />
  <meta slot="head" property="article:section" content={category.label} />
  {visibleHeroImage && <link slot="head" rel="preload" as="image" href={visibleHeroImage} />}
  <script type="application/ld+json" set:html={JSON.stringify(articleSchema)} />
  {
    faqSchema && (
      <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />
    )
  }
  <main class="@container container my-10 max-w-[720px] sm:my-20">
    <Breadcrumbs
      items={[
        { label: "Blog", href: "/blog" },
        { label: category.label, href: getBlogCategoryHref(category) },
        { label: post.data.title },
      ]}
      class="animate-fade-in animation-delay-100 mb-4"
    />
    <a
      href="/blog"
      class="text-quaternary animate-fade-in animation-delay-200 mb-4 flex items-center gap-2"
    >
      <svg xmlns="http://www.w3.org/2000/svg" width="32" height="32"
        ><path
          fill="#C3C8C2"
          fill-rule="evenodd"
          d="M18.566 10.234a.8.8 0 0 1 0 1.132L13.93 16l4.635 4.634a.8.8 0 0 1-1.132 1.132l-5.2-5.2a.8.8 0 0 1 0-1.132l5.2-5.2a.8.8 0 0 1 1.132 0Z"
          clip-rule="evenodd"></path></svg
      >
      Înapoi la Blog
    </a>
    <div class="animate-fade-in animation-delay-100 mb-5 flex flex-wrap items-center gap-x-3 gap-y-2 text-sm">
      <span class="text-muted-foreground">
        {dateFormatter.format(new Date(post.data.date))}, de {post.data.author.name}
      </span>
      <span aria-hidden="true" class="text-border">•</span>
      <a href={getBlogCategoryHref(category)} class="font-medium hover:opacity-70">
        {category.label}
      </a>
    </div>
    {
      post.data.titleImage ? (
        <div class="animate-slide-in mb-10 flex flex-col gap-6 sm:flex-row sm:items-center sm:gap-8">
          <h1 class="text-h3 sm:text-h2 flex-1 font-medium">
            {post.data.title}
          </h1>
          <img
            src={post.data.titleImage}
            alt=""
            width={280}
            height={280}
            class="mx-auto h-auto w-full max-w-[160px] shrink-0 object-contain sm:mx-0 sm:max-w-[200px]"
            loading="eager"
            decoding="async"
            fetchpriority="high"
          />
        </div>
      ) : (
        <>
          <h1 class="text-h3 sm:text-h2 animate-slide-in mb-8 font-medium">
            {post.data.title}
          </h1>
          {post.data.source === "zebrabyte" && post.data.ogImage && (
            <img
              src={post.data.ogImage}
              alt={post.data.title}
              class="animate-slide-in animation-delay-100 mb-10 h-auto w-full rounded-2xl border object-cover"
              loading="eager"
              decoding="async"
              fetchpriority="high"
              sizes="(max-width: 760px) calc(100vw - 2.5rem), 720px"
            />
          )}
        </>
      )
    }
    <p
      class="text-h5 animate-slide-in animation-delay-100 mb-10 font-medium whitespace-pre-line"
    >
      {post.data.excerpt}
    </p>
    <Prose class="animate-slide-in animation-delay-200">
      <Content />
    </Prose>
    <hr class="my-10 sm:mb-20" />
    <Sharer
      client:only
      url={Astro.url.toString()}
      title={post.data.title}
      class="my-10 sm:mt-20"
    />
    <WrittenBy class="my-10 sm:mb-20" author={post.data.author.name} />
    <Newsletter />
  </main>
</Layout>