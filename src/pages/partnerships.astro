---
import Layout from "../layouts/Layout.astro";
import Button from "../components/ui/Button.svelte";

const partnerTypes = [
  {
    title: "Agencies & developers",
    description: "Pentru agenții care construiesc și administrează website-uri sau aplicații și vor să adauge security, compliance ori managed infrastructure fără să își construiască intern toate aceste capabilități.",
  },
  {
    title: "Security & compliance specialists",
    description: "Pentru consultanți și echipe care au nevoie de platformă, evidence workflows, infrastructură sau suport tehnic pentru proiectele lor de GRC, privacy și cyber security.",
  },
  {
    title: "Technology partners",
    description: "Pentru furnizori SaaS, platforme și integratori care vor să conecteze produse, API-uri și workflow-uri la ecosistemul ZebraByte.",
  },
  {
    title: "White-label delivery",
    description: "Pentru parteneri care doresc să păstreze relația comercială cu clientul final, în timp ce ZebraByte livrează în spate infrastructura sau capabilitățile tehnice convenite.",
  },
];

const capabilities = [
  {
    title: "Managed Compliance",
    description: "Program, evidence workflows și suport operațional pentru proiecte de conformitate care au nevoie de ownership continuu.",
    href: "/managed-compliance",
  },
  {
    title: "Cyber Security",
    description: "Assessment, website/email security, incident response și hardening pot fi incluse în proiecte comune sau livrate sub un model stabilit cu partenerul.",
    href: "/cyber-security",
  },
  {
    title: "Compliance & Privacy",
    description: "GDPR, NIS2 și ISO 27001 readiness pot fi conectate la platformă și la măsurile tehnice implementate în infrastructura clientului.",
    href: "/gdpr",
  },
  {
    title: "Secure Infrastructure",
    description: "Managed hosting, recovery, edge security și operațiuni tehnice pentru proiectele care au nevoie de ownership continuu după lansare.",
    href: "/secure-hosting",
  },
];

const workflow = [
  { step: "01", title: "Context", text: "Înțelegem modelul tău de business, clientul final și ce vrei să păstrezi sub propriul brand." },
  { step: "02", title: "Boundary", text: "Stabilim exact cine vinde, cine livrează, cine oferă suport și cine are acces la date sau infrastructură." },
  { step: "03", title: "Integration", text: "Alegem între referral, co-delivery, white-label, API/integration sau un model custom documentat." },
  { step: "04", title: "Operation", text: "Definim SLA-uri, escaladări, comunicare și evidence astfel încât relația să rămână predictibilă după onboarding." },
];
---

<Layout
  title="Partnerships"
  description="Parteneriate ZebraByte pentru agenții, dezvoltatori, consultanți, integratori și furnizori care vor security, compliance și infrastructură securizată."
>
  <main>
    <animated-hero class="relative -mt-16 block overflow-hidden px-5 pb-16 pt-32 sm:pb-24 sm:pt-40">
      <div class="container text-center">
        <div class="border-border-low text-tertiary-foreground animate-perspective-in mx-auto mb-6 w-max rounded-lg border px-2 py-0.5 text-sm font-medium">Partnerships</div>
        <h1 class="text-h2 sm:text-h1 mx-auto mb-6 max-w-230 font-medium text-balance">Construiește peste ZebraByte fără să îți pierzi relația cu clientul.</h1>
        <p class="text-muted-foreground mx-auto mb-8 max-w-190 text-lg text-balance">
          Colaborăm cu agenții, dezvoltatori, consultanți și furnizori care au nevoie de security, compliance sau infrastructură în spate. Modelul comercial și tehnic este stabilit transparent înainte de onboarding.
        </p>
        <div class="flex flex-col justify-center gap-3 sm:flex-row">
          <Button href="/contact" size="lg">Discută despre parteneriat</Button>
          <Button href="/managed-compliance" variant="secondary" size="lg">Vezi platforma</Button>
        </div>
      </div>
    </animated-hero>

    <section class="container py-16 sm:py-24">
      <div class="mx-auto mb-12 max-w-180 text-center">
        <p class="text-muted-foreground mb-3 text-sm font-medium uppercase tracking-[0.12em]">Models</p>
        <h2 class="text-h3 sm:text-h2 mb-4 font-medium">Parteneriatul trebuie să se potrivească modului în care lucrezi deja.</h2>
        <p class="text-muted-foreground text-lg">Nu publicăm niveluri sau comisioane vechi ca promisiuni actuale. Stabilim termenii în funcție de responsabilitate, volum, suport și modelul de livrare.</p>
      </div>
      <div class="grid gap-4 sm:grid-cols-2">
        {partnerTypes.map((partner) => (
          <article class="rounded-2xl border p-6 sm:p-8">
            <h3 class="mb-3 text-xl font-medium">{partner.title}</h3>
            <p class="text-muted-foreground leading-relaxed">{partner.description}</p>
          </article>
        ))}
      </div>
    </section>

    <section class="bg-active py-16 sm:py-24">
      <div class="container">
        <div class="mb-12 max-w-180">
          <p class="text-muted-foreground mb-3 text-sm font-medium uppercase tracking-[0.12em]">What you can build with us</p>
          <h2 class="text-h3 sm:text-h2 mb-4 font-medium">Capabilități ZebraByte într-un singur model de livrare.</h2>
        </div>
        <div class="grid gap-px overflow-hidden rounded-2xl border bg-border sm:grid-cols-2">
          {capabilities.map((capability) => (
            <a href={capability.href} class="bg-level-0 hover:bg-subtle p-6 transition-colors sm:p-8">
              <h3 class="mb-3 text-xl font-medium">{capability.title}</h3>
              <p class="text-muted-foreground leading-relaxed">{capability.description}</p>
            </a>
          ))}
        </div>
      </div>
    </section>

    <section class="container py-16 sm:py-24">
      <div class="grid gap-12 lg:grid-cols-[0.85fr_1.15fr] lg:gap-20">
        <div>
          <p class="text-muted-foreground mb-3 text-sm font-medium uppercase tracking-[0.12em]">Onboarding</p>
          <h2 class="text-h3 sm:text-h2 mb-5 font-medium text-balance">Clarificăm responsabilitățile înainte să apară primul ticket.</h2>
          <p class="text-muted-foreground text-lg leading-relaxed">Un parteneriat white-label sau co-delivery funcționează doar dacă accesul, comunicarea, suportul și ownership-ul sunt clare. Le documentăm de la început.</p>
        </div>
        <div class="space-y-3">
          {workflow.map((item) => (
            <div class="grid grid-cols-[48px_1fr] gap-4 rounded-xl border p-5 sm:p-6">
              <div class="text-muted-foreground text-sm font-medium">{item.step}</div>
              <div><h3 class="mb-2 font-medium">{item.title}</h3><p class="text-muted-foreground text-sm leading-relaxed">{item.text}</p></div>
            </div>
          ))}
        </div>
      </div>
    </section>

    <section class="container py-16 text-center sm:py-24">
      <h2 class="text-h3 sm:text-h2 mx-auto mb-4 max-w-180 font-medium">Spune-ne ce vrei să livrezi și ce vrei să rămână în spatele scenei.</h2>
      <p class="text-muted-foreground mx-auto mb-8 max-w-160 text-lg">Putem construi un model simplu de referral sau o integrare tehnică și operațională mai profundă.</p>
      <Button href="/contact" size="lg">Începe o discuție de parteneriat</Button>
    </section>
  </main>
</Layout>

<script>
  import { AnimatedHero } from "../lib/elements/hero";
  import { customElementDefine } from "../lib/dom";
  customElementDefine("animated-hero", () => AnimatedHero);
</script>
