---
import Layout from "../layouts/Layout.astro";
import Logos from "../components/block/Logos.astro";
import ZebraByteTestimonials from "../components/block/ZebraByteTestimonials.astro";
import Button from "../components/ui/Button.svelte";
import Badges from "../components/Badges.svelte";
import YCImage from "../assets/photos/ycombinator.png";
import ResponsiveImage from "../components/ui/ResponsiveImage.astro";
import DealForm from "../components/DealForm.svelte";
import YCcompany from "../components/YCcompany.astro";
import { YCombinatorCompanies } from "../content/yc-companies.ts";
---

<Layout
  title="YC Startup Compliance Deal"
  description="A ZebraByte compliance onboarding offer for eligible Y Combinator startups, verified through the official YC verification flow. This promotion does not imply Y Combinator affiliation or endorsement."
>
  <section
    class="container my-10 flex flex-col gap-6 sm:my-20 sm:flex-row sm:items-center sm:justify-between"
  >
    <div class="max-w-[424px]">
      <div class="overflow-hidden">
        <h1 class="text-h2 animate-perspective-in mb-4 font-medium">
          From chaos to compliance in a few weeks.
        </h1>
      </div>
      <div class="overflow-hidden">
        <p class="text-muted-foreground animate-perspective-in animation-delay-100 mb-6 text-lg">
          ZebraByte combines managed compliance, platform workflows and security expertise to help startup teams move from scattered requirements to an operational compliance program.
        </p>
      </div>
      <DealForm class="flex flex-col gap-3" client:load>
        <input
          class="border-border-mid placeholder:text-quaternary animate-perspective-in animation-delay-200 h-12 w-full rounded-lg border px-3"
          type="email"
          name="email"
          required
          placeholder="Enter your email"
          aria-label="Enter your email"
        />
        <input
          class="border-border-mid placeholder:text-quaternary animate-perspective-in animation-delay-300 h-12 w-full rounded-lg border px-3"
          name="link"
          type="url"
          required
          placeholder="Your YC verification link"
          aria-label="Your YC verification link"
        />
        <Button
          type="submit"
          size="lg"
          class="animate-perspective-in animation-delay-350 text-base"
          >Claim deal</Button
        >
        <a
          href="https://www.ycombinator.com/verify"
          class="text-tertiary-foreground animate-fade-in animation-delay-450 text-center underline sm:text-start"
        >
          Get your verification link
        </a>
        <p class="text-muted-foreground animate-fade-in animation-delay-500 text-xs leading-relaxed">
          This is a ZebraByte promotional offer for eligible startups. It does not imply affiliation with, endorsement by, or investment from Y Combinator.
        </p>
      </DealForm>
    </div>
    <Badges
      count={9}
      countMobile={3}
      client:load
      class="animate-fade-in animation-delay-150 grid grid-cols-3 sm:w-[380px] sm:gap-10"
    />
  </section>

  <section class="container">
    <h2 class="text-tertiary-foreground animate-perspective-in animation-delay-300 text-center">
      Organizations featured across the compliance reference library
    </h2>
    <Logos class="animate-slide-in animation-delay-300 my-6" constrained />
  </section>

  <section class="container my-20 flex flex-col gap-10 sm:my-30 sm:flex-row sm:items-center sm:gap-20">
    <ResponsiveImage
      src={YCImage}
      alt="Startup program"
      mobile={[500, 500]}
      sm={[500, 660]}
      class="shadow-image animate-slide-in animation-delay-350 aspect-square w-full max-w-[500px] flex-none rounded-2xl object-cover sm:aspect-500/660 sm:w-[500px]"
      fetchpriority="high"
    />
    <div class="text-muted-foreground space-y-6 text-lg">
      <h2 class="text-h3 text-foreground animate-slide-in animation-delay-450 font-medium">
        Built for startup constraints
      </h2>
      <div class="animate-slide-in animation-delay-550 space-y-4">
        <p>
          Fast-moving startups often hit compliance requirements at exactly the moment their product and sales teams have the least spare capacity. Enterprise questionnaires, SOC 2 requests, privacy reviews and security evidence can quickly become a second operating system for the company.
        </p>
        <p>
          The ZebraByte model is designed to reduce that overhead: a managed compliance program, structured evidence and controls, plus technical security work where remediation is required.
        </p>
        <p>
          Eligible YC companies can use the verification flow on this page to request the startup deal. Eligibility and commercial terms are confirmed by ZebraByte before activation.
        </p>
      </div>
    </div>
  </section>

  <section class="container my-20 sm:my-30">
    <h2 class="text-h3 mb-4 text-center font-medium">
      YC companies in the reference library
    </h2>
    <p class="text-muted-foreground mx-auto mb-12 max-w-2xl text-center text-sm">
      These logos are retained as part of the platform's startup/compliance reference library. Their presence does not, by itself, represent a ZebraByte customer relationship or endorsement.
    </p>
    <div class="companies-grid grid grid-cols-2 place-items-center sm:grid-cols-4">
      {YCombinatorCompanies.map((company) => (
        <YCcompany
          logo={company.logo}
          badge={company.badge}
          name={company.name}
          href={company.href}
          height={company.height}
        />
      ))}
    </div>
  </section>

  <ZebraByteTestimonials />
</Layout>

<style>
  @media (max-width: 639px) {
    .companies-grid > *:nth-child(8) ~ * {
      display: none;
    }
  }
</style>
