---
import Layout from "../layouts/Layout.astro";
import Button from "../components/ui/Button.svelte";
import ZebraByteTestimonials from "../components/block/ZebraByteTestimonials.astro";

const layers = [
  {
    step: "01",
    title: "Edge & traffic",
    text: "DNS, TLS, caching, WAF și alte controls de edge sunt configurate în jurul aplicației și al traficului legitim.",
  },
  {
    step: "02",
    title: "Application & origin",
    text: "Hardening, access paths, runtime configuration și expunerea origin-ului sunt tratate ca parte din postura aplicației.",
  },
  {
    step: "03",
    title: "Operations",
    text: "Schimbările, patching-ul și activitățile administrative sunt operate controlat, cu ownership clar și reducerea intervențiilor ad-hoc.",
  },
  {
    step: "04",
    title: "Monitoring",
    text: "Disponibilitatea și semnalele relevante sunt urmărite după deploy, nu doar în timpul migrării sau al unui incident.",
  },
  {
    step: "05",
    title: "Backup & recovery",
    text: "Backup-ul este legat de un proces de restaurare și de deciziile necesare pentru revenirea controlată după o problemă.",
  },
];

const workloads = [
  ["WordPress & CMS", "Site-uri care au nevoie de patching, hardening, backup și ownership după lansare."],
  ["E-commerce", "Magazine unde indisponibilitatea, integritatea și recovery-ul afectează direct operațiunile și veniturile."],
  ["Web applications", "Aplicații custom și backends unde infrastructura trebuie operată împreună cu echipa care deține codul."],
  ["APIs", "Servicii expuse care au nevoie de TLS, access controls, rate limiting și monitoring proporțional cu utilizarea lor."],
  ["Static & modern frontends", "Proiecte moderne care pot păstra hosting-ul simplu, dar au nevoie de DNS, edge security și ownership clar."],
  ["Sensitive workloads", "Servicii unde datele, disponibilitatea sau cerințele de recovery justifică un model administrat continuu."],
];

const migration = [
  {
    step: "01",
    title: "Inventory",
    text: "Aplicație, DNS, baze de date, storage, email dependencies, integrări și alte componente care pot fi afectate de mutare.",
  },
  {
    step: "02",
    title: "Prepare",
    text: "Pregătim mediul țintă, hardening-ul, accesul și configurațiile înainte să schimbăm traficul de producție.",
  },
  {
    step: "03",
    title: "Copy & validate",
    text: "Copiem datele și verificăm aplicația separat, inclusiv funcțiile care pot depinde de DNS, caching, webhooks sau servicii externe.",
  },
  {
    step: "04",
    title: "Cutover",
    text: "Mutăm traficul controlat, urmărim erorile și păstrăm o cale de revenire potrivită arhitecturii dacă apar probleme neașteptate.",
  },
  {
    step: "05",
    title: "Operate",
    text: "Monitoring, patching, backup, recovery și security controls continuă după migrare. Cutover-ul nu este finalul serviciului managed.",
  },
];

const responsibilities = [
  {
    title: "Platform & infrastructure",
    zebra: "Configurația și operațiunile infrastructurii incluse în serviciul managed.",
    client: "Cerințele aplicației și aprobarea schimbărilor care afectează business-ul.",
  },
  {
    title: "Application code",
    zebra: "Putem identifica probleme și sprijini remediation-ul în scope-ul agreat.",
    client: "Echipa care deține aplicația rămâne owner-ul logicii de business și al schimbărilor de cod dacă nu există un scope separat.",
  },
  {
    title: "Security controls",
    zebra: "Edge, hardening, monitoring și alte controls incluse sunt operate ca parte din serviciu.",
    client: "Identity, endpoints și sisteme din afara hosting-ului rămân în responsabilitatea ownerilor lor dacă nu sunt incluse separat.",
  },
  {
    title: "Backup & recovery",
    zebra: "Operăm procesele incluse de backup/restoration și coordonăm recovery-ul pentru mediul managed.",
    client: "Prioritățile de business și validarea funcțională după restore necesită contextul owner-ului aplicației.",
  },
];

const operations = [
  ["Changes", "Configurările importante sunt tratate ca schimbări controlate, nu ca intervenții fără context."],
  ["Patching", "Actualizările sunt prioritizate după risc, compatibilitate și impactul asupra aplicației."],
  ["Monitoring", "Disponibilitatea și semnalele relevante sunt urmărite pentru a identifica degradarea sau comportamentul neobișnuit."],
  ["Backup", "Retenția și frecvența depind de serviciul și planul aplicabil, nu de o promisiune universală pentru orice workload."],
  ["Recovery", "Restaurarea și verificarea sunt parte din procesul de recovery; existența unui backup singură nu este suficientă."],
  ["Incidents", "Evenimentele relevante pot fi escaladate către incident response și apoi transformate în remediation și hardening."],
];

const choices = [
  {
    title: "Păstrează hosting-ul actual",
    text: "Dacă furnizorul actual funcționează bine, Website Security poate adăuga edge controls, WAF, DNS și hardening fără o migrare inutilă.",
    href: "/website-security",
  },
  {
    title: "Migrează într-un model managed",
    text: "Când origin-ul, patching-ul, backup-ul și recovery-ul trebuie să aibă același owner operațional, Secure Managed Hosting devine opțiunea potrivită.",
    href: "/contact",
  },
  {
    title: "Începe cu un assessment",
    text: "Dacă nu este clar dacă problema este hosting-ul sau aplicația, evaluăm mediul înainte să recomandăm o migrare.",
    href: "/security-assessment",
  },
];

const faqs = [
  {
    question: "Este Secure Managed Hosting un produs de hosting shared generic?",
    answer:
      "Nu îl poziționăm astfel. Serviciul este destinat proiectelor unde hardening-ul, monitoring-ul, backup/recovery și ownership-ul operațional justifică administrarea continuă. Pentru proiecte simple poate exista o opțiune mai potrivită.",
  },
  {
    question: "Trebuie să migrez pentru a folosi Website Security?",
    answer:
      "Nu. Putem proteja anumite aplicații la furnizorul actual. Migrarea este recomandată doar atunci când ownership-ul origin-ului, configurația sau recovery-ul fac parte din problema pe care vrem să o rezolvăm.",
  },
  {
    question: "Promiteți zero downtime la migrare?",
    answer:
      "Nu facem o promisiune universală de zero downtime indiferent de arhitectură. Pregătim și testăm mediul înainte de cutover și construim o tranziție potrivită aplicației și dependențelor sale.",
  },
  {
    question: "Cine face update-urile aplicației?",
    answer:
      "Depinde de workload și scope. Patching-ul infrastructurii sau al componentelor managed poate fi inclus, în timp ce schimbările de cod și anumite update-uri ale aplicației pot rămâne la owner-ul produsului. Responsabilitățile se stabilesc înainte de migrare.",
  },
  {
    question: "Hosting-ul înseamnă automat conformitate cu ISO 27001, NIS2 sau GDPR?",
    answer:
      "Nu. Infrastructura și operațiunile pot furniza controls și evidence relevante, dar conformitatea depinde de scope-ul, procesele și obligațiile întregii organizații. Hosting-ul singur nu certifică programul.",
  },
];
---

<Layout
  title="Secure Managed Hosting"
  description="Secure Managed Hosting ZebraByte pentru WordPress, e-commerce și aplicații web: hardening, WAF, monitoring, patching, backup/recovery și migrare controlată."
>
  <main>
    <animated-hero
      class="relative -mt-16 block overflow-hidden px-5 py-10 pt-26 sm:pt-36 sm:pb-12"
    >
      <div
        class="text-muted-foreground animate-perspective-in animation-delay-300 mx-auto mb-6 w-max rounded-lg border px-4 py-2 text-sm font-medium sm:mb-8"
      >
        Secure Managed Hosting
      </div>

      <h1
        class="text-h2 sm:text-h1 mb-6 overflow-hidden text-center font-medium text-balance sm:mb-8"
      >
        <span class="animate-perspective-in block">Hosting pentru aplicații care au</span>
        <span class="animate-perspective-in block delay-50"> nevoie de ownership după deploy. </span>
      </h1>

      <p
        class="text-muted-foreground animate-perspective-in animation-delay-150 mx-auto mb-6 max-w-200 text-center text-lg text-balance sm:mb-8"
      >
        Hardening, edge protection, monitoring, patching și recovery operate împreună cu
        infrastructura. Nu mutăm un proiect doar pentru a schimba furnizorul; migrarea trebuie
        să rezolve o nevoie reală de securitate sau operare.
      </p>

      <div
        class="mb-10 flex flex-col items-stretch justify-center gap-3 sm:flex-row sm:items-center"
      >
        <Button
          class="animate-perspective-in animation-delay-200"
          variant="secondary"
          size="lg"
          href="/website-security"
        >
          Vezi Website Security
        </Button>
        <Button
          class="animate-perspective-in animation-delay-300"
          size="lg"
          href="/contact"
        >
          Discută despre infrastructură
        </Button>
      </div>
    </animated-hero>

    <section class="container py-10 sm:py-20">
      <div class="mx-auto mb-10 max-w-180 text-center sm:mb-14">
        <h2 class="text-h3 sm:text-h2 mb-3 font-medium">Infrastructura este un strat din programul de securitate</h2>
        <p class="text-muted-foreground text-lg">
          Edge-ul, origin-ul, operațiunile și recovery-ul trebuie să poată lucra împreună.
          Altfel, responsabilitatea se pierde între mai multe servicii care nu au același context.
        </p>
      </div>

      <div class="mx-auto max-w-5xl border-y">
        {layers.map((item) => (
          <article class="grid gap-3 border-b py-7 last:border-b-0 sm:grid-cols-[64px_0.75fr_1.25fr] sm:gap-8">
            <span class="text-muted-foreground font-mono text-sm">{item.step}</span>
            <h3 class="text-h5 font-medium">{item.title}</h3>
            <p class="text-muted-foreground leading-relaxed">{item.text}</p>
          </article>
        ))}
      </div>
    </section>

    <section class="bg-active py-10 sm:py-20">
      <div class="container">
        <div class="mx-auto mb-10 max-w-180 text-center sm:mb-14">
          <h2 class="text-h3 sm:text-h2 mb-3 font-medium">Pentru workload-uri unde operarea continuă contează</h2>
          <p class="text-muted-foreground text-lg">
            Nu orice site are nevoie de managed hosting. Îl folosim când disponibilitatea,
            securitatea sau recovery-ul justifică ownership-ul continuu.
          </p>
        </div>

        <div class="mx-auto max-w-5xl border-y">
          {workloads.map(([title, text]) => (
            <div class="grid gap-3 border-b py-5 last:border-b-0 sm:grid-cols-[0.65fr_1.35fr] sm:gap-10">
              <h3 class="font-medium">{title}</h3>
              <p class="text-muted-foreground leading-relaxed">{text}</p>
            </div>
          ))}
        </div>
      </div>
    </section>

    <section class="container py-10 sm:py-20">
      <div class="mx-auto mb-10 max-w-180 text-center sm:mb-14">
        <h2 class="text-h3 sm:text-h2 mb-3 font-medium">Migrarea este un proiect de risc, nu un copy/paste</h2>
        <p class="text-muted-foreground text-lg">
          Pregătim și validăm mediul înainte de cutover. DNS-ul, baza de date, storage-ul,
          webhooks și integrările pot fi la fel de importante ca fișierele aplicației.
        </p>
      </div>

      <div class="mx-auto max-w-5xl border-y">
        {migration.map((item) => (
          <article class="grid gap-3 border-b py-7 last:border-b-0 sm:grid-cols-[64px_0.75fr_1.25fr] sm:gap-8">
            <span class="text-muted-foreground font-mono text-sm">{item.step}</span>
            <h3 class="text-h5 font-medium">{item.title}</h3>
            <p class="text-muted-foreground leading-relaxed">{item.text}</p>
          </article>
        ))}
      </div>
    </section>

    <section class="container py-10 sm:py-20">
      <div class="mx-auto max-w-5xl">
        <h2 class="text-h3 sm:text-h2 mb-5 font-medium">Responsabilitățile trebuie să fie clare după migrare</h2>
        <p class="text-muted-foreground mb-8 max-w-3xl text-lg leading-relaxed">
          Managed nu înseamnă că orice componentă a aplicației devine automat responsabilitatea
          ZebraByte. Scope-ul definește ce operăm și ce rămâne la owner-ul produsului.
        </p>

        <div class="border-y">
          <div class="text-muted-foreground hidden grid-cols-[0.6fr_1.2fr_1.2fr] gap-8 border-b py-4 text-sm sm:grid">
            <span>Arie</span><span>ZebraByte</span><span>Echipa ta</span>
          </div>
          {responsibilities.map((item) => (
            <div class="grid gap-3 border-b py-6 last:border-b-0 sm:grid-cols-[0.6fr_1.2fr_1.2fr] sm:gap-8">
              <h3 class="font-medium">{item.title}</h3>
              <p class="text-muted-foreground leading-relaxed">{item.zebra}</p>
              <p class="text-muted-foreground leading-relaxed">{item.client}</p>
            </div>
          ))}
        </div>
      </div>
    </section>

    <section class="bg-active py-10 sm:py-20">
      <div class="container grid gap-12 lg:grid-cols-2 lg:gap-20">
        <div>
          <h2 class="text-h3 sm:text-h2 mb-5 font-medium">Hosting-ul începe după deploy</h2>
          <p class="text-muted-foreground text-lg leading-relaxed">
            Valoarea unui model managed apare în schimbările, patching-ul, monitoring-ul și
            recovery-ul care se întâmplă după ce aplicația este deja live.
          </p>
        </div>
        <div class="border-y">
          {operations.map(([title, text]) => (
            <div class="border-b py-5 last:border-b-0">
              <h3 class="font-medium">{title}</h3>
              <p class="text-muted-foreground mt-2 leading-relaxed">{text}</p>
            </div>
          ))}
        </div>
      </div>
    </section>

    <section class="container py-10 sm:py-20">
      <div class="mx-auto max-w-5xl">
        <h2 class="text-h3 sm:text-h2 mb-8 font-medium">Nu orice problemă cere o migrare</h2>
        <div class="border-y">
          {choices.map((item) => (
            <a href={item.href} class="group grid gap-3 border-b py-6 last:border-b-0 sm:grid-cols-[0.7fr_1.3fr] sm:gap-10">
              <h3 class="text-h5 font-medium group-hover:underline group-hover:underline-offset-4">{item.title}</h3>
              <p class="text-muted-foreground leading-relaxed">{item.text}</p>
            </a>
          ))}
        </div>
      </div>
    </section>

    <ZebraByteTestimonials />

    <section class="container py-10 sm:py-20">
      <div class="mx-auto max-w-3xl">
        <h2 class="text-h3 sm:text-h2 mb-8 text-center font-medium">Întrebări frecvente</h2>
        <div class="border-y">
          {faqs.map((faq) => (
            <details class="group border-b py-5 last:border-b-0">
              <summary class="flex cursor-pointer list-none items-center justify-between gap-6 font-medium">
                <span>{faq.question}</span>
                <span class="text-muted-foreground text-xl transition-transform group-open:rotate-45">+</span>
              </summary>
              <p class="text-muted-foreground max-w-2xl pt-4 leading-relaxed">{faq.answer}</p>
            </details>
          ))}
        </div>
      </div>
    </section>

    <section class="container py-12 text-center sm:py-24">
      <h2 class="text-h3 sm:text-h2 mx-auto mb-4 max-w-190 font-medium text-balance">
        Mută infrastructura doar dacă managed ownership rezolvă problema reală.
      </h2>
      <p class="text-muted-foreground mx-auto mb-8 max-w-160 text-lg">
        Trimite-ne stack-ul actual și cerințele de disponibilitate. Stabilim dacă este nevoie
        de migrare sau dacă aplicația poate fi securizată acolo unde este deja.
      </p>
      <Button href="/contact" size="lg">Discută despre Secure Managed Hosting</Button>
    </section>
  </main>
</Layout>

<script>
  import { AnimatedHero } from "../lib/elements/hero";
  import { customElementDefine } from "../lib/dom";
  customElementDefine("animated-hero", () => AnimatedHero);
</script>
