---
import Layout from "../layouts/Layout.astro";
import Button from "../components/ui/Button.svelte";

const architectureLayers = [
  {
    title: "Edge",
    text: "DNS, TLS, caching, WAF și trafic filtrat înainte de origin.",
  },
  {
    title: "Runtime",
    text: "Application environment, access paths și configurația origin-ului.",
  },
  {
    title: "Operations",
    text: "Patching, changes, monitoring și intervenții administrative controlate.",
  },
  {
    title: "Recovery",
    text: "Backup, restore și decizii de revenire atunci când serviciul este afectat.",
  },
];

const migration = [
  {
    step: "01",
    title: "Inventory",
    text: "Aplicație, DNS, baze de date, storage, email dependencies, integrări și componente care pot fi afectate de mutare.",
  },
  {
    step: "02",
    title: "Prepare",
    text: "Pregătim mediul țintă, hardening-ul, accesul și configurațiile înainte să schimbăm traficul de producție.",
  },
  {
    step: "03",
    title: "Validate",
    text: "Copiem datele și testăm aplicația separat, inclusiv DNS, caching, webhooks și servicii externe.",
  },
  {
    step: "04",
    title: "Cutover",
    text: "Mutăm traficul controlat, urmărim erorile și păstrăm o cale de revenire potrivită arhitecturii.",
  },
  {
    step: "05",
    title: "Operate",
    text: "Monitoring, patching, backup, recovery și security controls continuă după migrare.",
  },
];

const responsibilities = [
  {
    area: "Platform & infrastructure",
    zebra: "Configurația și operațiunile infrastructurii incluse în serviciul managed.",
    client: "Cerințele aplicației și aprobarea schimbărilor cu impact de business.",
  },
  {
    area: "Application code",
    zebra: "Identificăm probleme și sprijinim remediation-ul în scope-ul agreat.",
    client: "Echipa care deține aplicația rămâne owner-ul logicii de business dacă nu există un scope separat.",
  },
  {
    area: "Security controls",
    zebra: "Edge, hardening, monitoring și controls incluse sunt operate ca parte din serviciu.",
    client: "Identity, endpoints și sisteme din afara hosting-ului rămân la ownerii lor dacă nu sunt incluse separat.",
  },
  {
    area: "Backup & recovery",
    zebra: "Operăm procesele incluse de backup/restoration și coordonăm recovery-ul mediului managed.",
    client: "Prioritățile de business și validarea funcțională după restore necesită contextul owner-ului aplicației.",
  },
];

const operations = [
  ["Changes", "Configurațiile importante sunt tratate ca schimbări controlate, nu ca intervenții fără context."],
  ["Patching", "Actualizările sunt prioritizate după risc, compatibilitate și impact asupra aplicației."],
  ["Monitoring", "Disponibilitatea și semnalele relevante sunt urmărite după deploy, nu doar în timpul incidentelor."],
  ["Backup", "Frecvența și retenția depind de serviciul și planul aplicabil, nu de o promisiune universală."],
  ["Recovery", "Restore-ul și verificarea fac parte din control; existența unui backup singură nu este suficientă."],
  ["Incidents", "Evenimentele relevante pot fi escaladate către incident response și apoi transformate în remediation."],
];

const workloads = [
  "WordPress & CMS",
  "E-commerce",
  "Web applications",
  "APIs & backends",
  "Modern frontends",
  "Sensitive workloads",
];

const faqs = [
  {
    question: "Este Secure Managed Hosting un produs de hosting shared generic?",
    answer:
      "Nu îl poziționăm astfel. Serviciul este destinat proiectelor unde hardening-ul, monitoring-ul, backup/recovery și ownership-ul operațional justifică administrarea continuă. Pentru proiecte simple poate exista o opțiune mai potrivită.",
  },
  {
    question: "Trebuie să migrez pentru a folosi Website Security?",
    answer:
      "Nu. Putem proteja anumite aplicații la furnizorul actual. Migrarea este recomandată doar atunci când ownership-ul origin-ului, configurația sau recovery-ul fac parte din problema pe care vrem să o rezolvăm.",
  },
  {
    question: "Promiteți zero downtime la migrare?",
    answer:
      "Nu facem o promisiune universală de zero downtime indiferent de arhitectură. Pregătim și testăm mediul înainte de cutover și construim o tranziție potrivită aplicației și dependențelor sale.",
  },
  {
    question: "Cine face update-urile aplicației?",
    answer:
      "Depinde de workload și scope. Patching-ul infrastructurii sau al componentelor managed poate fi inclus, în timp ce schimbările de cod și anumite update-uri ale aplicației pot rămâne la owner-ul produsului. Responsabilitățile se stabilesc înainte de migrare.",
  },
  {
    question: "Hosting-ul înseamnă automat conformitate cu ISO 27001, NIS2 sau GDPR?",
    answer:
      "Nu. Infrastructura și operațiunile pot furniza controls și evidence relevante, dar conformitatea depinde de scope-ul, procesele și obligațiile întregii organizații. Hosting-ul singur nu certifică programul.",
  },
];
---

<Layout
  title="Secure Managed Hosting"
  description="Secure Managed Hosting ZebraByte pentru WordPress, e-commerce și aplicații web: hardening, WAF, monitoring, patching, backup/recovery și migrare controlată."
>
  <main>
    <animated-hero class="relative -mt-16 block overflow-hidden px-5 py-10 pt-26 sm:pt-36 sm:pb-12">
      <div class="text-muted-foreground animate-perspective-in animation-delay-300 mx-auto mb-6 w-max rounded-lg border px-4 py-2 text-sm font-medium sm:mb-8">
        Secure Managed Hosting
      </div>

      <h1 class="text-h2 sm:text-h1 mb-6 overflow-hidden text-center font-medium text-balance sm:mb-8">
        <span class="animate-perspective-in block">Hosting pentru aplicații care au</span>
        <span class="animate-perspective-in block delay-50"> nevoie de ownership după deploy. </span>
      </h1>

      <p class="text-muted-foreground animate-perspective-in animation-delay-150 mx-auto mb-6 max-w-200 text-center text-lg text-balance sm:mb-8">
        Hardening, edge protection, monitoring, patching și recovery operate împreună cu infrastructura. Migrarea are sens doar când rezolvă o nevoie reală de securitate sau operare.
      </p>

      <div class="mb-11 flex flex-col items-stretch justify-center gap-3 sm:mb-17 sm:flex-row sm:items-center">
        <Button class="animate-perspective-in animation-delay-200" variant="secondary" size="lg" href="/website-security">Vezi Website Security</Button>
        <Button class="animate-perspective-in animation-delay-300" size="lg" href="/contact">Discută despre infrastructură</Button>
      </div>
    </animated-hero>

    <section class="container pb-12 sm:pb-24">
      <div class="overflow-hidden rounded-2xl border bg-level-1">
        <div class="border-b px-6 py-5 sm:px-9">
          <span class="text-muted-foreground text-sm uppercase tracking-wide">Managed architecture</span>
        </div>
        <div class="grid lg:grid-cols-4">
          {architectureLayers.map((layer, index) => (
            <article class:list={["p-7 sm:p-9", index < architectureLayers.length - 1 && "border-b lg:border-r lg:border-b-0"]}>
              <span class="text-muted-foreground mb-10 block font-mono text-sm">0{index + 1}</span>
              <h2 class="text-h4 mb-3 font-medium">{layer.title}</h2>
              <p class="text-muted-foreground leading-relaxed">{layer.text}</p>
            </article>
          ))}
        </div>
      </div>
    </section>

    <section class="container py-12 sm:py-24">
      <div class="grid gap-8 lg:grid-cols-2 lg:gap-0">
        <div class="border p-8 sm:p-12 lg:rounded-l-2xl lg:border-r-0">
          <p class="text-muted-foreground mb-3 text-sm font-medium uppercase tracking-wide">Option 01</p>
          <h2 class="text-h3 mb-5 font-medium">Păstrează hosting-ul actual.</h2>
          <p class="text-muted-foreground mb-7 text-lg leading-relaxed">
            Dacă furnizorul actual funcționează bine, Website Security poate adăuga edge controls, DNS, WAF și hardening fără o migrare inutilă.
          </p>
          <Button href="/website-security" variant="secondary">Protejează infrastructura existentă</Button>
        </div>

        <div class="bg-level-3 p-8 text-level-0-foreground sm:p-12 lg:rounded-r-2xl">
          <p class="text-level-0-foreground/55 mb-3 text-sm font-medium uppercase tracking-wide">Option 02</p>
          <h2 class="text-h3 mb-5 font-medium">Mută ownership-ul în managed.</h2>
          <p class="text-level-0-foreground/65 mb-7 text-lg leading-relaxed">
            Când origin-ul, patching-ul, backup-ul și recovery-ul trebuie să aibă același owner operațional, migrarea într-un model managed poate simplifica responsabilitatea.
          </p>
          <Button href="/contact" variant="secondary">Planifică migrarea</Button>
        </div>
      </div>
    </section>

    <section class="bg-active py-12 sm:py-24">
      <div class="container">
        <div class="mx-auto mb-12 max-w-190 text-center sm:mb-16">
          <p class="text-muted-foreground mb-3 text-sm font-medium uppercase tracking-wide">Migration path</p>
          <h2 class="text-h3 sm:text-h2 mb-4 font-medium">Migrarea este un proiect de risc, nu un copy/paste.</h2>
          <p class="text-muted-foreground text-lg leading-relaxed">
            DNS-ul, baza de date, storage-ul, webhooks și integrările pot fi la fel de importante ca fișierele aplicației. Pregătim și validăm mediul înainte de cutover.
          </p>
        </div>

        <div class="relative mx-auto max-w-6xl">
          <div class="absolute top-5 right-[10%] left-[10%] hidden h-px bg-border lg:block"></div>
          <div class="grid gap-10 lg:grid-cols-5 lg:gap-7">
            {migration.map((item) => (
              <article class="relative">
                <div class="mb-5 flex size-10 items-center justify-center rounded-full border bg-background font-mono text-xs">{item.step}</div>
                <h3 class="text-h5 mb-3 font-medium">{item.title}</h3>
                <p class="text-muted-foreground leading-relaxed">{item.text}</p>
              </article>
            ))}
          </div>
        </div>
      </div>
    </section>

    <section class="container py-12 sm:py-24">
      <div class="mb-10 max-w-3xl sm:mb-14">
        <p class="text-muted-foreground mb-3 text-sm font-medium uppercase tracking-wide">Shared responsibility</p>
        <h2 class="text-h3 sm:text-h2 mb-5 font-medium">Managed nu înseamnă că totul devine automat responsabilitatea ZebraByte.</h2>
        <p class="text-muted-foreground text-lg leading-relaxed">
          Scope-ul definește ce operăm și ce rămâne la owner-ul produsului. Claritatea responsabilității este parte din securitate, nu doar un detaliu contractual.
        </p>
      </div>

      <div class="overflow-x-auto border-y">
        <div class="min-w-[760px]">
          <div class="text-muted-foreground grid grid-cols-[0.7fr_1.15fr_1.15fr] gap-8 border-b py-4 text-sm">
            <span>Arie</span><span>ZebraByte</span><span>Echipa ta</span>
          </div>
          {responsibilities.map((item) => (
            <div class="grid grid-cols-[0.7fr_1.15fr_1.15fr] gap-8 border-b py-6 last:border-b-0">
              <h3 class="font-medium">{item.area}</h3>
              <p class="text-muted-foreground leading-relaxed">{item.zebra}</p>
              <p class="text-muted-foreground leading-relaxed">{item.client}</p>
            </div>
          ))}
        </div>
      </div>
    </section>

    <section class="bg-level-3 py-12 text-level-0-foreground sm:py-24">
      <div class="container grid gap-14 lg:grid-cols-[0.75fr_1.25fr] lg:gap-24">
        <div>
          <p class="text-level-0-foreground/55 mb-3 text-sm font-medium uppercase tracking-wide">Operate continuously</p>
          <h2 class="text-h3 sm:text-h2 mb-5 font-medium">Cutover-ul nu este finalul serviciului managed.</h2>
          <p class="text-level-0-foreground/65 text-lg leading-relaxed">
            Valoarea apare după deploy: changes, patching, monitoring, backup și recovery operate cu același context și cu o cale clară de escaladare când ceva se schimbă.
          </p>
        </div>

        <div class="grid gap-x-12 sm:grid-cols-2">
          {operations.map(([title, text]) => (
            <article class="border-t border-level-0-foreground/15 py-6">
              <h3 class="text-h5 mb-2 font-medium">{title}</h3>
              <p class="text-level-0-foreground/65 leading-relaxed">{text}</p>
            </article>
          ))}
        </div>
      </div>
    </section>

    <section class="container py-12 sm:py-24">
      <div class="grid items-center gap-14 lg:grid-cols-2 lg:gap-24">
        <div class="overflow-hidden rounded-2xl border bg-active p-8 sm:p-12">
          <div class="mb-10 flex items-center justify-between">
            <span class="text-muted-foreground text-sm uppercase tracking-wide">Recovery chain</span>
            <span class="font-mono text-xs">backup ≠ recovery</span>
          </div>
          <div class="space-y-8">
            <div>
              <span class="text-muted-foreground text-sm">01</span>
              <h3 class="text-h4 mt-2 font-medium">Known restore point</h3>
            </div>
            <div class="h-px bg-border"></div>
            <div>
              <span class="text-muted-foreground text-sm">02</span>
              <h3 class="text-h4 mt-2 font-medium">Controlled restoration</h3>
            </div>
            <div class="h-px bg-border"></div>
            <div>
              <span class="text-muted-foreground text-sm">03</span>
              <h3 class="text-h4 mt-2 font-medium">Functional validation</h3>
            </div>
          </div>
        </div>

        <div>
          <p class="text-muted-foreground mb-3 text-sm font-medium uppercase tracking-wide">Workloads</p>
          <h2 class="text-h3 sm:text-h2 mb-5 font-medium">Pentru proiecte unde operarea continuă chiar contează.</h2>
          <p class="text-muted-foreground mb-8 text-lg leading-relaxed">
            Nu orice site are nevoie de managed hosting. Îl folosim când disponibilitatea, securitatea sau recovery-ul justifică ownership-ul continuu.
          </p>
          <div class="grid grid-cols-2 gap-x-8 border-y sm:grid-cols-3">
            {workloads.map((item) => (
              <div class="border-b py-5 font-medium">{item}</div>
            ))}
          </div>
        </div>
      </div>
    </section>

    <section class="container py-10 sm:py-20">
      <div class="mx-auto max-w-3xl">
        <h2 class="text-h3 sm:text-h2 mb-8 text-center font-medium">Întrebări frecvente</h2>
        <div class="border-y">
          {faqs.map((faq) => (
            <details class="group border-b py-5 last:border-b-0">
              <summary class="flex cursor-pointer list-none items-center justify-between gap-6 font-medium">
                <span>{faq.question}</span>
                <span class="text-muted-foreground text-xl transition-transform group-open:rotate-45">+</span>
              </summary>
              <p class="text-muted-foreground max-w-2xl pt-4 leading-relaxed">{faq.answer}</p>
            </details>
          ))}
        </div>
      </div>
    </section>

    <section class="container py-12 text-center sm:py-24">
      <h2 class="text-h3 sm:text-h2 mx-auto mb-4 max-w-190 font-medium text-balance">
        Mută infrastructura doar dacă mutarea rezolvă o problemă reală.
      </h2>
      <p class="text-muted-foreground mx-auto mb-8 max-w-160 text-lg">
        Putem începe cu arhitectura actuală și decide dacă ai nevoie de edge security, remediation sau de un model managed complet.
      </p>
      <Button href="/contact" size="lg">Discută despre Secure Managed Hosting</Button>
    </section>
  </main>
</Layout>

<script>
  import { AnimatedHero } from "../lib/elements/hero";
  import { customElementDefine } from "../lib/dom";
  customElementDefine("animated-hero", () => AnimatedHero);
</script>
