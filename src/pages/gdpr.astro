---
import Layout from "../layouts/Layout.astro";
import Button from "../components/ui/Button.svelte";

const privacyFlow = [
  {
    step: "01",
    title: "Data records",
    text: "Inventariem categoriile de date relevante, sensibilitatea lor și contextul de business în care sunt folosite.",
  },
  {
    step: "02",
    title: "Processing activities & RoPA",
    text: "Documentăm scopurile, categoriile de persoane vizate și date, destinatarii, transferurile, retenția și măsurile relevante pentru activitățile de prelucrare.",
  },
  {
    step: "03",
    title: "Risk & impact assessments",
    text: "DPIA, TIA și alte evaluări sunt legate de processing, vendors, risks și măsurile care tratează riscul.",
  },
  {
    step: "04",
    title: "Rights requests",
    text: "Cereri precum acces, rectificare sau ștergere sunt urmărite ca procese cu owners, termene și acțiuni verificabile.",
  },
  {
    step: "05",
    title: "Continuous review",
    text: "Actualizăm records, policies, third parties și evidence atunci când procesele, datele sau infrastructura se schimbă.",
  },
];

const processingFields = [
  ["Purpose", "De ce există prelucrarea și ce rezultat urmărește organizația."],
  ["Data & people", "Categorii de persoane vizate și categorii de date implicate."],
  ["Recipients", "Cine primește sau poate accesa datele, inclusiv third parties relevanți."],
  ["Transfers", "Transferuri către țări terțe sau organizații internaționale, unde se aplică."],
  ["Retention", "Termenele sau criteriile de păstrare și ștergere, unde pot fi stabilite."],
  ["Security measures", "Descrierea generală a măsurilor tehnice și organizatorice relevante."],
];

const assessments = [
  {
    title: "DPIA",
    subtitle: "Data Protection Impact Assessment",
    text: "Pentru prelucrări care pot genera risc ridicat pentru drepturile și libertățile persoanelor, structurăm evaluarea riscului, măsurile de reducere și deciziile care trebuie documentate.",
  },
  {
    title: "TIA",
    subtitle: "Transfer Impact Assessment",
    text: "Pentru transferurile internaționale relevante, păstrăm contextul transferului, părțile implicate, garanțiile și măsurile suplimentare într-o evaluare legată de processing și furnizori.",
  },
];

const thirdPartyRows = [
  {
    title: "Processors & subprocessors",
    text: "Inventar, roluri, servicii, DPA-uri și contextul în care furnizorii prelucrează sau pot accesa date personale.",
  },
  {
    title: "Contracts & safeguards",
    text: "Legăm documentele și garanțiile relevante de furnizor și de activitățile de prelucrare pe care le susține.",
  },
  {
    title: "Third-country transfers",
    text: "Identificăm transferurile relevante și păstrăm evaluările și documentația asociată acolo unde sunt necesare.",
  },
  {
    title: "Review cadence",
    text: "Schimbările furnizorilor, serviciilor sau condițiilor de prelucrare se întorc în privacy program și în risk review.",
  },
];

const securityMeasures = [
  "identity, MFA și access control",
  "encryption și managementul secretelor unde sunt relevante",
  "logging, monitoring și audit trails",
  "backup, recovery și resilience",
  "vulnerability management și hardening",
  "incident response și breach readiness",
  "supplier și third-party security",
  "data minimisation și retention controls",
];

const faqs = [
  {
    question: "ZebraByte oferă consultanță juridică GDPR?",
    answer:
      "ZebraByte ajută la structurarea și operarea programului de privacy, la evidence și la măsurile tehnice. Atunci când este necesară o interpretare juridică specifică, aceasta trebuie validată cu specialistul juridic sau DPO-ul competent.",
  },
  {
    question: "RoPA este doar un document pentru audit?",
    answer:
      "Nu ar trebui să fie. Evidențele activităților de prelucrare sunt utile atunci când reflectă procesele reale, destinatarii, transferurile, retenția și măsurile de securitate și sunt actualizate când prelucrarea se schimbă.",
  },
  {
    question: "Când este necesară o DPIA?",
    answer:
      "GDPR cere o DPIA înaintea unei prelucrări susceptibile să genereze un risc ridicat pentru drepturile și libertățile persoanelor. Evaluarea concretă depinde de natura, contextul, scopul și riscurile prelucrării.",
  },
  {
    question: "Putem gestiona cererile persoanelor vizate în platformă?",
    answer:
      "Da. Rights requests pot fi urmărite printr-un workflow cu owners și task-uri. Trebuie limitat accesul la persoanele care au nevoie să proceseze cererea și evitată introducerea inutilă de date personale în câmpuri libere.",
  },
  {
    question: "GDPR se poate lega de ISO 27001 sau NIS2?",
    answer:
      "Da, atunci când măsurile și riscurile se suprapun. Același control tehnic sau aceeași dovadă poate susține mai multe obligații, fără a presupune că framework-urile sunt echivalente juridic.",
  },
];

const regulationSchema = {
  "@context": "https://schema.org",
  "@type": "Service",
  name: "GDPR & Privacy Program",
  provider: {
    "@type": "Organization",
    name: "ZebraByte",
    url: "https://www.zebrabyte.ro",
  },
  areaServed: "EU",
  serviceType: "GDPR readiness, privacy governance and technical security alignment",
  url: "https://www.zebrabyte.ro/gdpr",
};
---

<Layout
  title="GDPR & Privacy"
  description="Program GDPR și privacy ZebraByte: data mapping, RoPA, DPIA, TIA, rights requests, vendor management, măsuri tehnice și evidence continuu."
>
  <script type="application/ld+json" set:html={JSON.stringify(regulationSchema)} />

  <main>
    <animated-hero class="relative -mt-16 block overflow-hidden px-5 py-10 pt-26 sm:pt-36 sm:pb-12">
      <div class="text-muted-foreground animate-perspective-in animation-delay-300 mx-auto mb-6 w-max rounded-lg border px-4 py-2 text-sm font-medium sm:mb-8">
        GDPR · Privacy · Security
      </div>

      <h1 class="text-h2 sm:text-h1 mb-6 overflow-hidden text-center font-medium text-balance sm:mb-8">
        <span class="animate-perspective-in block">Privacy governance</span>
        <span class="animate-perspective-in block delay-50"> conectat la operațiunile reale. </span>
      </h1>

      <p class="text-muted-foreground animate-perspective-in animation-delay-150 mx-auto mb-6 max-w-200 text-center text-lg text-balance sm:mb-8">
        Date, processing activities, DPIA, transferuri, furnizori, rights requests și
        evidence — organizate în același program cu risks, controls și măsurile tehnice de securitate.
      </p>

      <div class="mb-10 flex flex-col items-stretch justify-center gap-3 sm:flex-row sm:items-center">
        <Button class="animate-perspective-in animation-delay-200" variant="secondary" size="lg" href="/compliance-platform">Vezi platforma</Button>
        <Button class="animate-perspective-in animation-delay-300" size="lg" href="/contact">Discută despre GDPR</Button>
      </div>
    </animated-hero>

    <section class="container pb-12 sm:pb-24">
      <div class="grid gap-12 lg:grid-cols-[0.62fr_1.38fr] lg:items-start lg:gap-20">
        <div>
          <p class="text-muted-foreground mb-3 text-sm font-medium uppercase tracking-wide">Privacy graph</p>
          <h2 class="text-h3 sm:text-h2 mb-5 font-medium">Privacy management este un sistem de records conectate.</h2>
          <p class="text-muted-foreground mb-5 text-lg leading-relaxed">
            RoPA, DPIA, vendor reviews și security nu trebuie să trăiască în documente fără
            legătură între ele. În ZebraByte, processing activities, risks, vendors, controls și
            evidence pot fi urmărite ca elemente ale aceluiași program cloud.
          </p>
          <p class="text-muted-foreground leading-relaxed">
            Platforma ajută la organizare și trasabilitate. Nu determină singură ce lege se
            aplică și nu înlocuiește interpretarea juridică atunci când aceasta este necesară.
          </p>
        </div>

        <div class="relative border p-5 sm:p-8">
          <div class="absolute left-1/2 top-10 bottom-10 hidden w-px -translate-x-1/2 bg-border sm:block"></div>
          {privacyFlow.map((item, index) => (
            <article class:list={["relative grid gap-4 py-5 sm:grid-cols-[1fr_62px_1fr] sm:items-center", index > 0 && "border-t sm:border-t-0"]}>
              <div class:list={[index % 2 === 0 ? "sm:text-right" : "sm:col-start-3", index % 2 === 1 && "sm:col-start-3"]}>
                <h3 class="mb-2 font-medium">{item.title}</h3>
                <p class="text-muted-foreground text-sm leading-relaxed">{item.text}</p>
              </div>
              <div class:list={["z-10 flex size-11 items-center justify-center rounded-full border bg-level-0 font-mono text-xs sm:col-start-2 sm:row-start-1 sm:mx-auto", index % 2 === 1 && "sm:col-start-2"]}>
                {item.step}
              </div>
              {index % 2 === 1 && <div class="hidden sm:col-start-1 sm:row-start-1 sm:block"></div>}
            </article>
          ))}
        </div>
      </div>
    </section>

    <section class="bg-active py-12 sm:py-24">
      <div class="container">
        <div class="mb-10 max-w-3xl">
          <p class="text-muted-foreground mb-3 text-sm font-medium uppercase tracking-wide">RoPA / processing record</p>
          <h2 class="text-h3 sm:text-h2 mb-4 font-medium">RoPA trebuie să reflecte processing-ul real.</h2>
          <p class="text-muted-foreground text-lg leading-relaxed">
            Evidența activităților de prelucrare devine utilă când păstrează context suficient
            pentru review și este actualizată atunci când procesul se schimbă.
          </p>
        </div>

        <div class="overflow-hidden border bg-level-0">
          <div class="grid grid-cols-[1fr_auto] gap-4 border-b bg-level-0 px-6 py-4 font-mono text-xs text-muted-foreground">
            <span>PROCESSING ACTIVITY / RECORD</span><span>6 CORE FIELDS</span>
          </div>
          <div class="grid sm:grid-cols-2 lg:grid-cols-3">
            {processingFields.map(([field, text], index) => (
              <article class:list={["min-h-48 p-6", index % 3 !== 2 && "lg:border-r", index < 3 && "lg:border-b", index % 2 === 0 && "sm:border-r lg:border-r", index < 4 && "sm:border-b"]}>
                <span class="text-muted-foreground mb-7 block font-mono text-xs">FIELD-{String(index + 1).padStart(2, "0")}</span>
                <h3 class="mb-3 font-medium">{field}</h3>
                <p class="text-muted-foreground text-sm leading-relaxed">{text}</p>
              </article>
            ))}
          </div>
        </div>
      </div>
    </section>

    <section class="container py-12 sm:py-24">
      <div class="mb-10 grid gap-6 lg:grid-cols-[0.72fr_1.28fr] lg:items-end lg:gap-16">
        <div>
          <p class="text-muted-foreground mb-3 text-sm font-medium uppercase tracking-wide">Impact assessments</p>
          <h2 class="text-h3 sm:text-h2 font-medium">Evaluarea rămâne legată de context.</h2>
        </div>
        <p class="text-muted-foreground text-lg leading-relaxed">
          DPIA și TIA nu trebuie să fie fișiere izolate. Le legăm de processing, transferuri,
          furnizori, risks și măsurile care justifică decizia.
        </p>
      </div>

      <div class="grid gap-6 lg:grid-cols-2">
        {assessments.map((assessment, index) => (
          <article class="border p-7 sm:p-9">
            <div class="mb-12 flex items-start justify-between gap-5">
              <div>
                <div class="text-h2 font-medium">{assessment.title}</div>
                <p class="text-muted-foreground mt-2 text-sm">{assessment.subtitle}</p>
              </div>
              <span class="text-muted-foreground font-mono text-xs">ASSESS-{String(index + 1).padStart(2, "0")}</span>
            </div>
            <p class="text-muted-foreground text-lg leading-relaxed">{assessment.text}</p>
          </article>
        ))}
      </div>
    </section>

    <section class="border-y py-12 sm:py-24">
      <div class="container grid items-center gap-12 lg:grid-cols-[0.9fr_1.1fr] lg:gap-20">
        <div>
          <p class="text-muted-foreground mb-3 text-sm font-medium uppercase tracking-wide">Data subject requests</p>
          <h2 class="text-h3 sm:text-h2 mb-4 font-medium">Rights requests ca workflow, nu inbox improvizat.</h2>
          <p class="text-muted-foreground mb-5 text-lg leading-relaxed">
            Cererile persoanelor vizate pot fi urmărite printr-un proces controlat, cu owner,
            task-uri și status, fără să împrăștii informația între email, documente și liste separate.
          </p>
          <p class="text-muted-foreground mb-6 leading-relaxed">
            Accesul trebuie limitat la persoanele care au nevoie să proceseze cererea, iar
            datele personale inutile nu trebuie introduse în câmpuri libere doar pentru comoditate.
          </p>
          <Button href="/docs/product/privacy-management" variant="secondary">Vezi documentația Privacy Management</Button>
        </div>
        <div class="bg-active p-6 sm:p-10">
          <img
            src="/trust-center/data-requests.svg"
            alt="Workflow pentru data rights requests în platforma ZebraByte"
            width="1024"
            height="192"
            loading="lazy"
            decoding="async"
            class="h-auto w-full"
          />
        </div>
      </div>
    </section>

    <section class="container py-12 sm:py-24">
      <div class="grid gap-12 lg:grid-cols-[0.66fr_1.34fr] lg:gap-20">
        <div>
          <p class="text-muted-foreground mb-3 text-sm font-medium uppercase tracking-wide">Processor chain</p>
          <h2 class="text-h3 sm:text-h2 mb-5 font-medium">Third parties fac parte din privacy program.</h2>
          <p class="text-muted-foreground text-lg leading-relaxed">
            Vendors, processors, subprocessors și transferurile trebuie urmărite împreună cu
            processing activities și riscurile pe care le introduc.
          </p>
        </div>

        <div class="border-y">
          {thirdPartyRows.map((item, index) => (
            <article class="grid gap-3 border-b py-5 last:border-b-0 sm:grid-cols-[48px_0.75fr_1.25fr] sm:gap-7">
              <span class="text-muted-foreground font-mono text-xs">0{index + 1}</span>
              <h3 class="font-medium">{item.title}</h3>
              <p class="text-muted-foreground leading-relaxed">{item.text}</p>
            </article>
          ))}
        </div>
      </div>
    </section>

    <section class="bg-level-3 py-12 text-invert sm:py-24">
      <div class="container grid gap-12 lg:grid-cols-[0.68fr_1.32fr] lg:gap-20">
        <div>
          <p class="mb-3 text-sm font-medium uppercase tracking-wide opacity-55">Technical measures</p>
          <h2 class="text-h3 sm:text-h2 mb-5 font-medium">GDPR nu este separat de cybersecurity.</h2>
          <p class="mb-7 text-lg leading-relaxed opacity-65">
            Riscul pentru datele personale nu poate fi tratat doar prin policies și notices.
            Măsurile tehnice și organizatorice trebuie legate de riscurile și processing activities
            pentru care există.
          </p>
          <Button href="/cyber-security" variant="secondary">Vezi Cyber Security</Button>
        </div>

        <div class="grid sm:grid-cols-2">
          {securityMeasures.map((item, index) => (
            <div class="grid min-h-28 grid-cols-[42px_1fr] gap-4 border-t border-invert/15 py-5 sm:px-5">
              <span class="font-mono text-xs opacity-40">0{index + 1}</span>
              <span class="leading-relaxed opacity-80">{item}</span>
            </div>
          ))}
        </div>
      </div>
    </section>

    <section class="container py-12 sm:py-20">
      <div class="mx-auto max-w-4xl border-y py-8 sm:py-10">
        <div class="grid gap-6 sm:grid-cols-[0.72fr_1.28fr] sm:gap-12">
          <div>
            <p class="text-muted-foreground mb-3 text-sm font-medium uppercase tracking-wide">Legal reference</p>
            <h2 class="text-h3 font-medium">Cadrul legal</h2>
          </div>
          <div>
            <p class="text-muted-foreground mb-5 leading-relaxed">
              GDPR este Regulamentul (UE) 2016/679. ZebraByte ajută la organizarea și operarea
              programului de privacy și la măsurile tehnice asociate; serviciul nu înlocuiește
              consultanța juridică atunci când o interpretare legală specifică este necesară.
            </p>
            <a
              href="https://eur-lex.europa.eu/legal-content/RO/TXT/?uri=CELEX:32016R0679"
              target="_blank"
              rel="noopener noreferrer"
              class="font-medium underline underline-offset-4"
            >
              Regulamentul (UE) 2016/679 — EUR-Lex
            </a>
          </div>
        </div>
      </div>
    </section>

    <section class="container py-12 sm:py-24">
      <div class="mx-auto max-w-3xl">
        <h2 class="text-h3 sm:text-h2 mb-8 font-medium">Întrebări frecvente</h2>
        <div class="border-y">
          {faqs.map((faq) => (
            <details class="group border-b py-5 last:border-b-0">
              <summary class="flex cursor-pointer list-none items-center justify-between gap-6 font-medium">
                <span>{faq.question}</span>
                <span class="text-muted-foreground text-xl transition-transform group-open:rotate-45">+</span>
              </summary>
              <p class="text-muted-foreground max-w-2xl pt-4 leading-relaxed">{faq.answer}</p>
            </details>
          ))}
        </div>
      </div>
    </section>

    <section class="border-t py-16 text-center sm:py-24">
      <div class="container">
        <h2 class="text-h3 sm:text-h2 mx-auto mb-4 max-w-180 font-medium text-balance">Privacy devine administrabil când records, risks și evidence sunt conectate.</h2>
        <p class="text-muted-foreground mx-auto mb-8 max-w-160 text-lg">
          Putem începe cu un gap assessment și transforma rezultatul într-un program urmărit
          continuu în platforma ZebraByte.
        </p>
        <Button href="/contact" size="lg">Discută despre GDPR</Button>
      </div>
    </section>
  </main>
</Layout>

<script>
  import { AnimatedHero } from "../lib/elements/hero";
  import { customElementDefine } from "../lib/dom";
  customElementDefine("animated-hero", () => AnimatedHero);
</script>
