---
import Layout from "../layouts/Layout.astro";
import Button from "../components/ui/Button.svelte";

const processingFields = [
  ["Purpose", "De ce există prelucrarea și ce rezultat urmărește organizația."],
  ["People & data", "Categoriile de persoane vizate și datele implicate."],
  ["Recipients", "Cine primește sau poate accesa datele, inclusiv third parties relevanți."],
  ["Transfers", "Transferurile către țări terțe sau organizații internaționale, unde se aplică."],
  ["Retention", "Termenele sau criteriile de păstrare și ștergere."],
  ["Security", "Măsurile tehnice și organizatorice relevante pentru activitatea respectivă."],
];

const thirdPartyRows = [
  ["Processors & subprocessors", "Roluri, servicii, DPA-uri și contextul în care furnizorul prelucrează sau poate accesa date personale."],
  ["Contracts & safeguards", "Documentele și garanțiile relevante rămân legate de furnizor și de processing-ul pe care îl susține."],
  ["Third-country transfers", "Transferurile relevante sunt legate de evaluările și documentația necesară pentru contextul respectiv."],
  ["Review cadence", "Schimbarea serviciului, furnizorului sau condițiilor de prelucrare revine în privacy și risk review."],
];

const securityMeasures = [
  "Identity, MFA și access control",
  "Encryption și secret management",
  "Logging, monitoring și audit trails",
  "Backup, recovery și resilience",
  "Vulnerability management și hardening",
  "Incident response și breach readiness",
  "Supplier security",
  "Data minimisation și retention controls",
];

const faqs = [
  {
    question: "ZebraByte oferă consultanță juridică GDPR?",
    answer:
      "ZebraByte ajută la structurarea și operarea programului de privacy, la evidence și la măsurile tehnice. Când este necesară o interpretare juridică specifică, aceasta trebuie validată cu specialistul juridic sau DPO-ul competent.",
  },
  {
    question: "RoPA este doar un document pentru audit?",
    answer:
      "Nu ar trebui să fie. Evidențele activităților de prelucrare sunt utile atunci când reflectă procesele reale, destinatarii, transferurile, retenția și măsurile de securitate și sunt actualizate când prelucrarea se schimbă.",
  },
  {
    question: "Când este necesară o DPIA?",
    answer:
      "GDPR cere o DPIA înaintea unei prelucrări susceptibile să genereze un risc ridicat pentru drepturile și libertățile persoanelor. Evaluarea concretă depinde de natura, contextul, scopul și riscurile prelucrării.",
  },
  {
    question: "Putem gestiona cererile persoanelor vizate în platformă?",
    answer:
      "Da. Rights requests pot fi urmărite printr-un workflow cu owners și task-uri. Accesul trebuie limitat la persoanele care au nevoie să proceseze cererea și trebuie evitată introducerea inutilă de date personale în câmpuri libere.",
  },
];

const regulationSchema = {
  "@context": "https://schema.org",
  "@type": "Service",
  name: "GDPR & Privacy Program",
  provider: { "@type": "Organization", name: "ZebraByte", url: "https://www.zebrabyte.ro" },
  areaServed: "EU",
  serviceType: "GDPR readiness, privacy governance and technical security alignment",
  url: "https://www.zebrabyte.ro/gdpr",
};
---

<Layout
  title="GDPR & Privacy"
  description="Program GDPR și privacy ZebraByte: data mapping, RoPA, DPIA, TIA, rights requests, vendor management, măsuri tehnice și evidence continuu."
>
  <script type="application/ld+json" set:html={JSON.stringify(regulationSchema)} />

  <main class="-mt-16 overflow-hidden pt-16">
    <section class="container py-16 sm:py-24">
      <div class="grid items-center gap-12 lg:grid-cols-[0.86fr_1.14fr] lg:gap-20">
        <div>
          <div class="text-muted-foreground mb-6 w-max rounded-lg border px-3 py-1 text-sm font-medium">GDPR · Privacy Management</div>
          <h1 class="text-h2 sm:text-h1 mb-6 max-w-195 font-medium text-balance">Privacy governance conectat la datele și procesele reale.</h1>
          <p class="text-muted-foreground mb-8 max-w-165 text-lg leading-relaxed">
            Data records, processing activities, DPIA, transferuri, third parties și rights requests într-un program conectat la risks, controls și măsurile tehnice de securitate.
          </p>
          <div class="flex flex-col gap-3 sm:flex-row">
            <Button href="/contact" size="lg">Discută despre GDPR</Button>
            <Button href="/compliance-platform" variant="secondary" size="lg">Vezi platforma</Button>
          </div>
        </div>

        <div class="grid gap-3 overflow-hidden rounded-[32px] bg-[#f8faf4] p-4 sm:p-6 lg:relative lg:min-h-[600px] lg:block lg:p-8">
          <img
            src="/trust-center/security-privacy.svg"
            alt="Privacy management în ZebraByte"
            width="331"
            height="272"
            loading="eager"
            decoding="async"
            class="block aspect-[331/272] h-auto w-full max-w-[420px] rounded-2xl border bg-white object-contain shadow-sm lg:absolute lg:top-12 lg:left-10 lg:w-[58%] lg:max-w-none"
          />
          <div class="w-max rounded-full border bg-level-0 px-4 py-2 text-sm font-medium shadow-sm lg:absolute lg:top-[42%] lg:right-12">Processing activity</div>
          <img
            src="/trust-center/data-requests.svg"
            alt="Data rights request workflow"
            width="1024"
            height="192"
            loading="eager"
            decoding="async"
            class="block h-auto w-full rounded-2xl border bg-white object-contain shadow-[0_16px_36px_rgba(30,42,20,0.10)] lg:absolute lg:right-10 lg:bottom-12 lg:w-[82%]"
          />
        </div>
      </div>
    </section>

    <section class="bg-active py-14 sm:py-24">
      <div class="container">
        <div class="mx-auto mb-12 max-w-180 text-center">
          <p class="text-muted-foreground mb-3 text-sm font-medium uppercase tracking-[0.12em]">Record of processing activities</p>
          <h2 class="text-h3 sm:text-h2 mb-4 font-medium">RoPA devine util când descrie processing-ul real.</h2>
          <p class="text-muted-foreground text-lg">Nu îl tratăm ca pe o foaie separată de restul programului. Fiecare activitate păstrează contextul necesar pentru privacy, security și review.</p>
        </div>

        <div class="mx-auto max-w-6xl overflow-hidden rounded-[28px] border bg-level-0">
          <div class="grid lg:grid-cols-[0.9fr_1.1fr]">
            <div class="bg-[#001a00] p-7 text-white sm:p-10">
              <p class="mb-4 text-sm font-medium text-[#e6ff03]">Processing activity</p>
              <h3 class="text-h3 mb-5 font-medium text-white">Customer account management</h3>
              <p class="mb-10 max-w-110 leading-relaxed text-white/65">Un exemplu conceptual de structură: scopul, datele, destinatarii și controls rămân legate de aceeași activitate, nu împrăștiate în documente independente.</p>
              <div class="space-y-3 text-sm text-white/75">
                <div class="grid grid-cols-[auto_1fr] gap-4 border-b border-white/10 pb-3"><span>Owner</span><span class="text-right">Privacy / Operations</span></div>
                <div class="grid grid-cols-[auto_1fr] gap-4 border-b border-white/10 pb-3"><span>Risk link</span><span class="text-right">Connected</span></div>
                <div class="grid grid-cols-[auto_1fr] gap-4"><span>Review</span><span class="text-right">Continuous</span></div>
              </div>
            </div>
            <div class="grid sm:grid-cols-2">
              {processingFields.map(([field, text], index) => (
                <article class:list={["p-6 sm:p-8", index % 2 === 0 && "sm:border-r", index < 4 && "border-b"]}>
                  <p class="text-muted-foreground mb-7 font-mono text-sm">0{index + 1}</p>
                  <h3 class="text-h5 mb-3 font-medium">{field}</h3>
                  <p class="text-muted-foreground text-sm leading-relaxed">{text}</p>
                </article>
              ))}
            </div>
          </div>
        </div>
      </div>
    </section>

    <section class="container py-14 sm:py-24">
      <div class="grid items-center gap-12 lg:grid-cols-[1.15fr_0.85fr] lg:gap-20">
        <div class="overflow-hidden rounded-[28px] border bg-[#f8faf4] p-4 sm:p-7 lg:p-8">
          <div class="rounded-2xl bg-white p-2 sm:p-4">
            <img
              src="/trust-center/data-requests.svg"
              alt="Workflow pentru cereri privind drepturile persoanelor vizate"
              width="1024"
              height="192"
              loading="lazy"
              decoding="async"
              class="mx-auto block aspect-[16/3] h-auto w-full object-contain"
            />
          </div>
        </div>
        <div>
          <p class="text-muted-foreground mb-3 text-sm font-medium uppercase tracking-[0.12em]">Data subject rights</p>
          <h2 class="text-h3 sm:text-h2 mb-5 font-medium text-balance">Rights requests ca workflow, nu ca inbox improvizat.</h2>
          <p class="text-muted-foreground mb-5 text-lg leading-relaxed">Access, rectification, erasure și alte requests pot avea owner, task-uri și un traseu controlat fără să împrăștii informația între email, documente și liste separate.</p>
          <p class="text-muted-foreground mb-7 leading-relaxed">Accesul la informația din request trebuie limitat la persoanele care chiar au nevoie să îl proceseze.</p>
          <Button href="/docs/product/privacy-management" variant="secondary">Privacy Management docs</Button>
        </div>
      </div>
    </section>

    <section class="bg-[#001a00] py-14 text-white sm:py-24">
      <div class="container">
        <div class="mb-12 max-w-175">
          <p class="mb-3 text-sm font-medium uppercase tracking-[0.12em] text-[#e6ff03]">Impact & transfers</p>
          <h2 class="text-h3 sm:text-h2 mb-4 font-medium text-white">DPIA și TIA rămân legate de contextul care le-a făcut necesare.</h2>
          <p class="text-lg leading-relaxed text-white/65">Evaluările nu sunt formulare izolate; ele trebuie să păstreze relația cu processing-ul, risk-ul, vendors și măsurile care reduc riscul.</p>
        </div>

        <div class="grid gap-5 lg:grid-cols-2">
          <article class="flex flex-col overflow-hidden rounded-[28px] border border-white/15 bg-white/5 p-7 sm:min-h-[360px] sm:p-9">
            <p class="mb-5 text-sm font-medium text-[#e6ff03]">DPIA</p>
            <h3 class="text-h3 mb-4 max-w-115 font-medium text-white">Data Protection Impact Assessment</h3>
            <p class="max-w-120 leading-relaxed text-white/65">Pentru processing susceptibil să genereze risc ridicat, structurăm riscurile, măsurile, residual risk și deciziile care trebuie documentate.</p>
            <div class="mt-8 grid size-20 place-items-center self-end rounded-full border border-white/15 text-2xl text-white sm:mt-auto sm:size-24 sm:text-3xl">D</div>
          </article>
          <article class="flex flex-col overflow-hidden rounded-[28px] bg-[#e6ff03] p-7 text-[#001a00] sm:min-h-[360px] sm:p-9">
            <p class="mb-5 text-sm font-medium text-[#001a00]">TIA</p>
            <h3 class="text-h3 mb-4 max-w-115 font-medium text-[#001a00]">Transfer Impact Assessment</h3>
            <p class="max-w-120 leading-relaxed text-[#001a00]/65">Pentru transferurile internaționale relevante, păstrăm contextul transferului, garanțiile și măsurile suplimentare lângă furnizor și processing.</p>
            <div class="mt-8 grid size-20 place-items-center self-end rounded-full border border-[#001a00]/15 text-2xl sm:mt-auto sm:size-24 sm:text-3xl">T</div>
          </article>
        </div>
      </div>
    </section>

    <section class="container py-14 sm:py-24">
      <div class="grid gap-12 lg:grid-cols-[0.78fr_1.22fr] lg:gap-20">
        <div>
          <p class="text-muted-foreground mb-3 text-sm font-medium uppercase tracking-[0.12em]">Processors & subprocessors</p>
          <h2 class="text-h3 sm:text-h2 mb-5 font-medium text-balance">Third parties fac parte din data map.</h2>
          <p class="text-muted-foreground text-lg leading-relaxed">Un furnizor nou poate schimba destinatarii, transferurile, safeguards și riscul. De aceea vendor inventory și privacy context trebuie să rămână conectate.</p>
        </div>
        <div>
          <div class="mb-5 grid grid-cols-2 gap-3 sm:grid-cols-4">
            <img src="/trust-center/subprocessor-docusign.svg" alt="" width="200" height="120" loading="lazy" decoding="async" class="block aspect-[5/3] h-auto w-full rounded-2xl border bg-level-0 object-contain" />
            <img src="/trust-center/subprocessor-hubspot.svg" alt="" width="200" height="120" loading="lazy" decoding="async" class="block aspect-[5/3] h-auto w-full rounded-2xl border bg-level-0 object-contain" />
            <img src="/trust-center/subprocessor-linear.svg" alt="" width="200" height="120" loading="lazy" decoding="async" class="block aspect-[5/3] h-auto w-full rounded-2xl border bg-level-0 object-contain" />
            <img src="/trust-center/subprocessor-stripe.svg" alt="" width="200" height="120" loading="lazy" decoding="async" class="block aspect-[5/3] h-auto w-full rounded-2xl border bg-level-0 object-contain" />
          </div>
          <div class="border-y">
            {thirdPartyRows.map(([title, text]) => (
              <div class="grid gap-2 border-b py-4 last:border-b-0 sm:grid-cols-[0.65fr_1.35fr] sm:gap-8">
                <h3 class="font-medium">{title}</h3>
                <p class="text-muted-foreground text-sm leading-relaxed">{text}</p>
              </div>
            ))}
          </div>
        </div>
      </div>
    </section>

    <section class="bg-[#f8faf4] py-14 sm:py-24">
      <div class="container grid items-center gap-12 lg:grid-cols-[1.08fr_0.92fr] lg:gap-20">
        <div class="grid gap-3 overflow-hidden rounded-[28px] border bg-level-0 p-4 sm:p-6 lg:relative lg:min-h-[540px] lg:block lg:p-9">
          <img src="/trust-center/security-encryption.svg" alt="Encryption și privacy security" width="600" height="360" loading="lazy" decoding="async" class="block aspect-[5/3] h-auto w-full rounded-xl border bg-white object-contain lg:absolute lg:top-8 lg:left-8 lg:w-[64%]" />
          <img src="/trust-center/security-vulnerability.svg" alt="Vulnerability management" width="600" height="360" loading="lazy" decoding="async" class="block aspect-[5/3] h-auto w-full rounded-xl border bg-white object-contain shadow-sm lg:absolute lg:right-8 lg:bottom-8 lg:w-[64%]" />
        </div>
        <div>
          <p class="text-muted-foreground mb-3 text-sm font-medium uppercase tracking-[0.12em]">Technical & organisational measures</p>
          <h2 class="text-h3 sm:text-h2 mb-5 font-medium text-balance">Privacy nu se oprește la notices și policies.</h2>
          <p class="text-muted-foreground mb-7 text-lg leading-relaxed">Riscul pentru date trebuie legat de controls care există efectiv în identity, infrastructure, application security, monitoring și incident response.</p>
          <div class="flex flex-wrap gap-2">
            {securityMeasures.map((item) => <span class="rounded-full border bg-level-0 px-3 py-1.5 text-sm">{item}</span>)}
          </div>
        </div>
      </div>
    </section>

    <section class="container py-14 sm:py-24">
      <div class="mx-auto max-w-4xl rounded-[28px] border p-7 sm:p-10">
        <p class="text-muted-foreground mb-3 text-sm font-medium uppercase tracking-[0.12em]">Legal framework</p>
        <h2 class="text-h3 mb-4 font-medium">Regulamentul (UE) 2016/679</h2>
        <p class="text-muted-foreground mb-6 text-lg leading-relaxed">ZebraByte ajută la organizarea și operarea programului de privacy și la măsurile tehnice asociate; serviciul nu înlocuiește consultanța juridică atunci când este necesară o interpretare legală specifică.</p>
        <a href="https://eur-lex.europa.eu/legal-content/RO/TXT/?uri=CELEX:32016R0679" target="_blank" rel="noopener noreferrer" class="font-medium underline underline-offset-4">Regulamentul (UE) 2016/679 — EUR-Lex</a>
      </div>
    </section>

    <section class="container py-14 sm:py-24">
      <div class="mx-auto max-w-[768px]">
        <h2 class="text-h3 sm:text-h2 mb-7 text-center font-medium">Întrebări frecvente</h2>
        <div class="divide-y border-y">
          {faqs.map((faq) => (
            <details class="group py-1">
              <summary class="flex cursor-pointer list-none items-center justify-between gap-6 py-4 font-medium"><span>{faq.question}</span><span class="text-muted-foreground text-xl leading-none transition-transform group-open:rotate-45">+</span></summary>
              <p class="text-muted-foreground max-w-2xl pb-5 pr-8 leading-relaxed">{faq.answer}</p>
            </details>
          ))}
        </div>
      </div>
    </section>

    <section class="border-t py-16 text-center sm:py-24">
      <div class="container">
        <h2 class="text-h3 sm:text-h2 mx-auto mb-4 max-w-185 font-medium text-balance">Privacy devine administrabil când datele, risks și evidence sunt conectate.</h2>
        <p class="text-muted-foreground mx-auto mb-8 max-w-160 text-lg">Putem începe cu data mapping sau un gap assessment și continua într-un program urmărit continuu.</p>
        <Button href="/contact" size="lg">Discută despre GDPR</Button>
      </div>
    </section>
  </main>
</Layout>