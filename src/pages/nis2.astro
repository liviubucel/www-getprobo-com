---
import Layout from "../layouts/Layout.astro";
import Button from "../components/ui/Button.svelte";
import Stories from "../components/block/Stories.astro";

const readinessFlow = [
  {
    step: "01",
    title: "Scope & applicability",
    text: "Analizăm serviciile, sectorul, dimensiunea, jurisdicția și contextul organizației pentru a identifica obligațiile care trebuie validate.",
  },
  {
    step: "02",
    title: "Risk assessment",
    text: "Legăm activele, serviciile, amenințările, dependențele și furnizorii de scenarii de risc și impact operațional.",
  },
  {
    step: "03",
    title: "Measures & remediation",
    text: "Transformăm gap-urile într-un program de măsuri tehnice, operaționale și organizaționale cu owners și priorități clare.",
  },
  {
    step: "04",
    title: "Incident readiness",
    text: "Definim trierea, escaladarea, comunicarea, păstrarea dovezilor și procesul necesar pentru notificările aplicabile.",
  },
  {
    step: "05",
    title: "Continuous evidence",
    text: "Reviews, tests, supplier assessments, training și schimbările de infrastructură rămân legate de măsurile pe care trebuie să le poți demonstra.",
  },
];

const riskMeasures = [
  ["Risk analysis & security policies", "Metodologie de risc, politici și ownership care reflectă serviciile și sistemele reale."],
  ["Incident handling", "Detectare, triere, containment, comunicare și proces de response care poate funcționa sub presiune."],
  ["Business continuity", "Backup, disaster recovery, crisis management și testarea scenariilor de recuperare."],
  ["Supply-chain security", "Riscurile introduse de furnizori și service providers sunt evaluate și urmărite pe durata relației."],
  ["Secure acquisition & maintenance", "Security în achiziție, dezvoltare și mentenanță, inclusiv vulnerability handling și disclosure."],
  ["Effectiveness reviews", "Proceduri pentru a verifica dacă măsurile de cybersecurity chiar funcționează și trebuie ajustate."],
  ["Cyber hygiene & training", "Practici de bază, awareness și training pentru management și personal, proporțional cu rolurile și riscul."],
  ["Cryptography & encryption", "Politici și proceduri pentru utilizarea criptografiei și, unde este adecvat, a criptării."],
  ["Access & asset management", "Human resources security, access control, inventar și ownership asupra activelor relevante."],
  ["MFA & secure communications", "Multi-factor authentication și canale de comunicare securizate acolo unde contextul le cere."],
];

const incidentFlow = [
  {
    title: "Detect & qualify",
    text: "Stabilești ce s-a întâmplat, ce servicii sunt afectate și dacă incidentul poate intra în categoria celor care trebuie raportate.",
  },
  {
    title: "Escalate & contain",
    text: "Activezi ownerii tehnici și de management, limitezi impactul și păstrezi informația necesară pentru investigație și raportare.",
  },
  {
    title: "Notify when required",
    text: "Procesul intern trebuie să poată susține etapele de notificare prevăzute de cadrul aplicabil, fără să improvizezi destinatarii și informațiile în timpul incidentului.",
  },
  {
    title: "Recover & learn",
    text: "Recovery, root-cause analysis și corrective actions se întorc în risk register, controls și programul de continuitate.",
  },
];

const supplyChainRows = [
  {
    title: "Critical suppliers",
    text: "Identifici furnizorii și serviciile de care depind operațiunile sau securitatea sistemelor aflate în scope.",
  },
  {
    title: "Security expectations",
    text: "Cerințele tehnice, contractuale și operaționale sunt aliniate cu riscul pe care relația îl introduce.",
  },
  {
    title: "Evidence & review",
    text: "Evaluările, documentele și findings nu rămân o verificare one-off; sunt revizuite când relația sau serviciul se schimbă.",
  },
  {
    title: "Concentration & dependency",
    text: "Analizezi dependențele care pot transforma indisponibilitatea unui singur furnizor într-un incident de business semnificativ.",
  },
];

const governanceRows = [
  {
    title: "Management approval",
    text: "Măsurile de risk management nu rămân exclusiv la echipa tehnică; managementul trebuie să aibă vizibilitate și ownership asupra programului aplicabil.",
  },
  {
    title: "Oversight",
    text: "Statusul măsurilor, riscurilor, incidentelor și gap-urilor trebuie să poată fi revizuit la nivelul potrivit al organizației.",
  },
  {
    title: "Training",
    text: "Membrii organelor de conducere și personalul relevant trebuie să aibă suficient context pentru a înțelege riscurile și practicile de cybersecurity care le afectează serviciile.",
  },
  {
    title: "Evidence of decisions",
    text: "Aprobările, risk acceptance și acțiunile semnificative trebuie să poată fi urmărite, nu doar discutate informal.",
  },
];

const faqs = [
  {
    question: "Poate ZebraByte decide dacă organizația mea intră sigur sub NIS2?",
    answer:
      "Putem face un scope assessment tehnic și operațional și putem identifica indicii relevante privind sectorul, dimensiunea, serviciile și jurisdicția. Pentru o încadrare juridică definitivă sau o excepție specifică trebuie folosită forma legală în vigoare și, după caz, specialistul juridic competent.",
  },
  {
    question: "NIS2 este doar despre documentație și politici?",
    answer:
      "Nu. Cadrul include măsuri tehnice, operaționale și organizaționale privind risk management, incident handling, business continuity, supply-chain security, vulnerability handling, access control, training și alte arii. Evidence-ul trebuie să reflecte modul în care acestea funcționează în practică.",
  },
  {
    question: "Trebuie să înlocuim toate sistemele existente pentru NIS2?",
    answer:
      "Nu automat. Readiness-ul pornește de la mediul existent, riscuri și gap-uri. Măsurile trebuie să fie adecvate și proporționale cu riscul, iar remediation-ul se prioritizează în jurul impactului real.",
  },
  {
    question: "Cum se leagă NIS2 de ISO 27001?",
    answer:
      "Un ISMS ISO 27001 poate furniza structură utilă pentru risk management, controls și evidence, dar cele două cadre nu sunt identice și unul nu înlocuiește automat obligațiile celuilalt. Mapping-ul trebuie făcut pe cerințele concrete aplicabile organizației.",
  },
  {
    question: "ZebraByte poate ajuta și cu măsurile tehnice, nu doar cu GRC?",
    answer:
      "Da, în scope-ul agreat. Security assessment, identity hardening, website/email security, vulnerability remediation, incident readiness și secure managed hosting pot susține controls și măsuri atunci când acestea sunt relevante pentru program.",
  },
];

const serviceSchema = {
  "@context": "https://schema.org",
  "@type": "Service",
  name: "NIS2 Readiness & Cyber Security Program",
  provider: {
    "@type": "Organization",
    name: "ZebraByte",
    url: "https://www.zebrabyte.ro",
  },
  areaServed: "Romania",
  serviceType: "NIS2 readiness, cyber risk management and continuous evidence",
  url: "https://www.zebrabyte.ro/nis2",
};
---

<Layout
  title="NIS2 Readiness & Cyber Security"
  description="NIS2 readiness ZebraByte pentru organizații din România: scope assessment, cyber risk management, incident readiness, supply-chain security, resilience și evidence."
>
  <script type="application/ld+json" set:html={JSON.stringify(serviceSchema)} />

  <main>
    <animated-hero
      class="relative -mt-16 block overflow-hidden px-5 py-10 pt-26 sm:pt-36 sm:pb-12"
    >
      <div
        class="text-muted-foreground animate-perspective-in animation-delay-300 mx-auto mb-6 flex w-max items-center gap-2 rounded-lg border px-4 py-2 text-sm font-medium sm:mb-8"
      >
        <img src="/frameworks/NIS2.svg" alt="" class="size-6" aria-hidden="true" />
        <span>NIS2 · România · Cyber Risk</span>
      </div>

      <h1
        class="text-h2 sm:text-h1 mb-6 overflow-hidden text-center font-medium text-balance sm:mb-8"
      >
        <span class="animate-perspective-in block">NIS2 în operațiuni,</span>
        <span class="animate-perspective-in block delay-50"> nu doar în documentație. </span>
      </h1>

      <p
        class="text-muted-foreground animate-perspective-in animation-delay-150 mx-auto mb-6 max-w-200 text-center text-lg text-balance sm:mb-8"
      >
        Risk management, incidente, continuitate, supply chain, identity, vulnerability
        management și governance — organizate într-un program care poate fi operat și
        demonstrat continuu.
      </p>

      <div
        class="mb-10 flex flex-col items-stretch justify-center gap-3 sm:flex-row sm:items-center"
      >
        <Button
          class="animate-perspective-in animation-delay-200"
          variant="secondary"
          size="lg"
          href="/cyber-security"
        >
          Vezi Cyber Security
        </Button>
        <Button
          class="animate-perspective-in animation-delay-300"
          size="lg"
          href="/contact"
        >
          Discută despre NIS2
        </Button>
      </div>
    </animated-hero>

    <section class="container py-10 sm:py-20">
      <div class="mx-auto max-w-4xl">
        <h2 class="text-h3 sm:text-h2 mb-5 font-medium">Ce înseamnă NIS2 pentru programul de cybersecurity</h2>
        <div class="text-muted-foreground space-y-5 text-lg leading-relaxed">
          <p>
            NIS2 mută cybersecurity din zona unei verificări tehnice izolate într-un program
            care combină risk management, governance, incident readiness, resilience și
            relația cu furnizorii. Măsurile trebuie să fie tehnice, operaționale și
            organizaționale și adaptate riscului organizației.
          </p>
          <p>
            Pentru ZebraByte, readiness înseamnă să pornești de la serviciile și sistemele
            reale, să identifici gap-urile și să poți demonstra în timp cum sunt operate
            măsurile relevante — fără să presupunem că aceeași arhitectură se potrivește
            tuturor organizațiilor.
          </p>
        </div>
      </div>
    </section>

    <section class="container py-10 sm:py-20">
      <div class="mx-auto mb-10 max-w-180 text-center sm:mb-14">
        <h2 class="text-h3 sm:text-h2 mb-3 font-medium">De la scope la evidence continuu</h2>
        <p class="text-muted-foreground text-lg">
          Readiness-ul nu începe cu o listă de produse. Începe cu serviciile, riscurile și
          responsabilitățile organizației.
        </p>
      </div>

      <div class="mx-auto max-w-5xl border-y">
        {readinessFlow.map((item) => (
          <article class="grid gap-3 border-b py-7 last:border-b-0 sm:grid-cols-[64px_0.8fr_1.2fr] sm:gap-8">
            <span class="text-muted-foreground font-mono text-sm">{item.step}</span>
            <h3 class="text-h5 font-medium">{item.title}</h3>
            <p class="text-muted-foreground leading-relaxed">{item.text}</p>
          </article>
        ))}
      </div>
    </section>

    <section class="bg-active py-10 sm:py-20">
      <div class="container">
        <div class="mx-auto max-w-5xl">
          <h2 class="text-h3 sm:text-h2 mb-5 font-medium">Măsurile de risk management acoperă întregul ciclu operațional</h2>
          <p class="text-muted-foreground mb-8 max-w-3xl text-lg leading-relaxed">
            Directiva descrie un set larg de arii care trebuie tratate proporțional cu riscul,
            nu doar controls tehnice izolate.
          </p>

          <div class="border-y">
            {riskMeasures.map(([area, text], index) => (
              <article class="grid gap-3 border-b py-6 last:border-b-0 sm:grid-cols-[64px_0.75fr_1.25fr] sm:gap-8">
                <span class="text-muted-foreground font-mono text-sm">{String(index + 1).padStart(2, "0")}</span>
                <h3 class="font-medium">{area}</h3>
                <p class="text-muted-foreground leading-relaxed">{text}</p>
              </article>
            ))}
          </div>
        </div>
      </div>
    </section>

    <section class="container py-10 sm:py-20">
      <div class="mx-auto max-w-5xl">
        <h2 class="text-h3 sm:text-h2 mb-5 font-medium">Managementul trebuie să vadă și să conducă programul</h2>
        <p class="text-muted-foreground mb-8 max-w-3xl text-lg leading-relaxed">
          NIS2 tratează governance-ul ca parte din cybersecurity. Asta înseamnă ownership,
          oversight și suficient context pentru ca deciziile de risc să nu rămână exclusiv
          în echipa tehnică.
        </p>
        <div class="border-y">
          {governanceRows.map((item) => (
            <article class="grid gap-3 border-b py-6 last:border-b-0 sm:grid-cols-[0.7fr_1.3fr] sm:gap-10">
              <h3 class="text-h5 font-medium">{item.title}</h3>
              <p class="text-muted-foreground leading-relaxed">{item.text}</p>
            </article>
          ))}
        </div>
      </div>
    </section>

    <section class="bg-active py-10 sm:py-20">
      <div class="container">
        <div class="mx-auto mb-10 max-w-180 text-center sm:mb-14">
          <h2 class="text-h3 sm:text-h2 mb-3 font-medium">Incident reporting începe înainte de incident</h2>
          <p class="text-muted-foreground text-lg">
            Dacă procesul de triere, escaladare și comunicare nu este pregătit, obligațiile
            de notificare devin mult mai greu de executat atunci când serviciul este deja sub
            presiune.
          </p>
        </div>

        <div class="mx-auto max-w-5xl border-y">
          {incidentFlow.map((item, index) => (
            <article class="grid gap-3 border-b py-7 last:border-b-0 sm:grid-cols-[64px_0.75fr_1.25fr] sm:gap-8">
              <span class="text-muted-foreground font-mono text-sm">0{index + 1}</span>
              <h3 class="text-h5 font-medium">{item.title}</h3>
              <p class="text-muted-foreground leading-relaxed">{item.text}</p>
            </article>
          ))}
        </div>
      </div>
    </section>

    <section class="container py-10 sm:py-20">
      <div class="grid gap-12 lg:grid-cols-2 lg:gap-20">
        <div>
          <h2 class="text-h3 sm:text-h2 mb-5 font-medium">Supply chain este parte din suprafața de risc</h2>
          <p class="text-muted-foreground text-lg leading-relaxed">
            Un serviciu critic poate depinde de cloud, software, telecom, identity, hosting,
            support sau alți furnizori. Programul trebuie să poată explica aceste dependențe
            și cum sunt ele evaluate.
          </p>
        </div>
        <div class="border-y">
          {supplyChainRows.map((item) => (
            <div class="border-b py-5 last:border-b-0">
              <h3 class="font-medium">{item.title}</h3>
              <p class="text-muted-foreground mt-2 leading-relaxed">{item.text}</p>
            </div>
          ))}
        </div>
      </div>
    </section>

    <section class="container py-10 sm:py-20">
      <div class="grid gap-12 lg:grid-cols-2 lg:gap-20">
        <div>
          <h2 class="text-h3 sm:text-h2 mb-5 font-medium">Controls trebuie să existe și în infrastructură</h2>
          <p class="text-muted-foreground mb-6 text-lg leading-relaxed">
            Readiness-ul GRC nu înlocuiește hardening-ul, monitoring-ul, identity security,
            vulnerability management sau incident response. Când există un gap tehnic,
            îl legăm de măsura și riscul pe care trebuie să le trateze.
          </p>
          <Button href="/cyber-security" variant="secondary">Vezi Cyber Security</Button>
        </div>
        <div class="border-y">
          <a href="/security-assessment" class="block border-b py-5 group">
            <h3 class="font-medium group-hover:underline group-hover:underline-offset-4">Security Assessment</h3>
            <p class="text-muted-foreground mt-2">Attack surface, configurații și gap-uri tehnice prioritizate după risc.</p>
          </a>
          <a href="/website-security" class="block border-b py-5 group">
            <h3 class="font-medium group-hover:underline group-hover:underline-offset-4">Website Security</h3>
            <p class="text-muted-foreground mt-2">WAF, hardening, monitoring și recovery pentru aplicații expuse public.</p>
          </a>
          <a href="/email-security" class="block border-b py-5 group">
            <h3 class="font-medium group-hover:underline group-hover:underline-offset-4">Email Security</h3>
            <p class="text-muted-foreground mt-2">Domain authentication, identity hardening și protecție împotriva impersonation.</p>
          </a>
          <a href="/incident-response" class="block py-5 group">
            <h3 class="font-medium group-hover:underline group-hover:underline-offset-4">Incident Response</h3>
            <p class="text-muted-foreground mt-2">Triage, containment, recovery și lessons learned conectate la programul de risc.</p>
          </a>
        </div>
      </div>
    </section>

    <section class="container py-10 sm:py-20">
      <div class="mx-auto max-w-5xl border-y py-8 sm:py-10">
        <div class="grid gap-10 lg:grid-cols-[1.1fr_0.9fr] lg:gap-16">
          <div>
            <h2 class="text-h3 mb-4 font-medium">Cadrul din România</h2>
            <p class="text-muted-foreground mb-5 leading-relaxed">
              Directiva (UE) 2022/2555 a fost transpusă în România prin OUG nr. 155/2024,
              aprobată cu modificări și completări prin Legea nr. 124/2025. DNSC a publicat
              norme privind supravegherea, verificarea și controlul, iar cadrul național a
              fost completat legislativ și în 2026.
            </p>
            <p class="text-muted-foreground leading-relaxed">
              Pagina este orientată spre readiness și operațiuni. Pentru încadrarea juridică
              definitivă sau interpretarea unei obligații specifice trebuie verificată forma
              legală în vigoare și, după caz, specialistul juridic competent.
            </p>
          </div>
          <div class="border-y">
            <a href="https://eur-lex.europa.eu/eli/dir/2022/2555/oj" target="_blank" rel="noopener noreferrer" class="block border-b py-4 font-medium underline underline-offset-4">Directiva (UE) 2022/2555 — EUR-Lex</a>
            <a href="https://legislatie.just.ro/Public/DetaliiDocumentAfis/293121" target="_blank" rel="noopener noreferrer" class="block border-b py-4 font-medium underline underline-offset-4">OUG nr. 155/2024 — Portal Legislativ</a>
            <a href="https://legislatie.just.ro/Public/DetaliiDocument/299675" target="_blank" rel="noopener noreferrer" class="block border-b py-4 font-medium underline underline-offset-4">Legea nr. 124/2025 — Portal Legislativ</a>
            <a href="https://legislatie.just.ro/Public/DetaliiDocument/305129" target="_blank" rel="noopener noreferrer" class="block border-b py-4 font-medium underline underline-offset-4">Normele DNSC — Portal Legislativ</a>
            <a href="https://legislatie.just.ro/Public/DetaliiDocumentAfis/312027" target="_blank" rel="noopener noreferrer" class="block py-4 font-medium underline underline-offset-4">Legea nr. 123/2026 — Portal Legislativ</a>
          </div>
        </div>
      </div>
    </section>

    <Stories />

    <section class="container py-10 sm:py-20">
      <div class="mx-auto max-w-3xl">
        <h2 class="text-h3 sm:text-h2 mb-8 text-center font-medium">Întrebări frecvente</h2>
        <div class="border-y">
          {faqs.map((faq) => (
            <details class="group border-b py-5 last:border-b-0">
              <summary class="flex cursor-pointer list-none items-center justify-between gap-6 font-medium">
                <span>{faq.question}</span>
                <span class="text-muted-foreground text-xl transition-transform group-open:rotate-45">+</span>
              </summary>
              <p class="text-muted-foreground max-w-2xl pt-4 leading-relaxed">{faq.answer}</p>
            </details>
          ))}
        </div>
      </div>
    </section>

    <section class="container py-12 text-center sm:py-24">
      <h2 class="text-h3 sm:text-h2 mx-auto mb-4 max-w-190 font-medium text-balance">
        Începe cu gap-urile care schimbă riscul real al organizației.
      </h2>
      <p class="text-muted-foreground mx-auto mb-8 max-w-160 text-lg">
        Evaluăm situația actuală, prioritizăm măsurile și construim un program pe care îl poți
        menține după prima evaluare.
      </p>
      <Button href="/contact" size="lg">Discută despre NIS2</Button>
    </section>
  </main>
</Layout>

<script>
  import { AnimatedHero } from "../lib/elements/hero";
  import { customElementDefine } from "../lib/dom";
  customElementDefine("animated-hero", () => AnimatedHero);
</script>
