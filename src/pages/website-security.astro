---
import Layout from "../layouts/Layout.astro";
import Button from "../components/ui/Button.svelte";

const edgeControls = [
  ["TLS & headers", "HTTPS, headere relevante și configurare care protejează fără să rupă aplicația legitimă."],
  ["WAF", "Reguli defensive și filtrare adaptate aplicației, rutelor și traficului real."],
  ["Rate limiting", "Reducem abuzul repetitiv pe login, API și alte suprafețe sensibile."],
  ["DDoS protection", "Traficul volumetric este filtrat înainte să consume resursele origin-ului."],
];

const applicationControls = [
  {
    title: "Hardening",
    text: "Configurăm aplicația, panourile administrative și serviciile expuse astfel încât suprafața de atac să rămână cât mai mică.",
  },
  {
    title: "Identity",
    text: "MFA, limitarea accesului și reducerea credential abuse pentru conturile cu privilegii ridicate.",
  },
  {
    title: "Remediation",
    text: "Patching, configuration changes și rezolvarea findings-urilor validate în ordinea impactului real.",
  },
];

const detectionSignals = [
  "schimbări neașteptate de fișiere sau configurație",
  "malware, redirect-uri și persistență suspectă",
  "degradări de disponibilitate sau trafic anormal",
  "regresii după update-uri, deploy-uri sau remediation",
];

const recoverySteps = [
  {
    step: "01",
    title: "Contain",
    text: "Limităm accesul, traficul sau componenta afectată fără să distrugem informația utilă pentru investigație.",
  },
  {
    step: "02",
    title: "Restore",
    text: "Restaurăm dintr-un punct cunoscut ca bun sau reconstruim componenta compromisă atunci când simpla curățare nu este suficientă.",
  },
  {
    step: "03",
    title: "Verify",
    text: "Revalidăm cauza, configurația și funcționalitatea legitimă înainte să considerăm serviciul revenit în stare normală.",
  },
];

const workloads = [
  "WordPress & CMS",
  "WooCommerce & e-commerce",
  "Aplicații web custom",
  "API-uri & backends",
  "Front-end-uri moderne",
  "Hosting existent",
];

const faqs = [
  {
    question: "Trebuie să găzduiesc website-ul la ZebraByte?",
    answer:
      "Nu. Putem aplica anumite controale de edge, DNS, WAF, hardening și monitoring în jurul infrastructurii existente. Secure Managed Hosting este separat și devine relevant când vrei și ownership asupra origin-ului, patching-ului, backup-ului și recovery-ului.",
  },
  {
    question: "Un WAF este suficient pentru a securiza un website?",
    answer:
      "Nu. WAF-ul este un strat util, dar nu repară un plugin vulnerabil, un cont administrativ compromis, un origin expus sau un backup inutilizabil. De aceea combinăm prevenția cu hardening, monitoring și recovery.",
  },
  {
    question: "Puteți curăța un site deja infectat?",
    answer:
      "Da, dar un site compromis trebuie tratat ca incident. Curățarea fără a identifica accesul inițial, persistența și cauza tehnică poate duce la reinfectare. Scope-ul poate include containment, cleanup, hardening și recovery.",
  },
  {
    question: "Funcționează și pentru WordPress?",
    answer:
      "Da. WordPress este unul dintre workload-urile pe care le putem proteja, dar modelul nu depinde de WordPress. Se poate adapta și la e-commerce, aplicații custom, API-uri și front-end-uri moderne.",
  },
  {
    question: "Cum verificăm că remedierea a funcționat?",
    answer:
      "Revalidăm finding-ul sau configurația relevantă, verificăm că aplicația legitimă funcționează și, unde este cazul, urmărim semnalele post-change pentru a evita regresii sau reinfectare.",
  },
];
---

<Layout
  title="Website Security"
  description="Website Security ZebraByte: WAF, DDoS protection, malware monitoring, TLS hardening, identity protection, vulnerability remediation și recovery pentru WordPress, e-commerce și aplicații web."
>
  <main>
    <animated-hero class="relative -mt-16 block overflow-hidden px-5 py-10 pt-26 sm:pt-36 sm:pb-12">
      <div class="text-muted-foreground animate-perspective-in animation-delay-300 mx-auto mb-6 w-max rounded-lg border px-4 py-2 text-sm font-medium sm:mb-8">
        Website Security
      </div>

      <h1 class="text-h2 sm:text-h1 mb-6 overflow-hidden text-center font-medium text-balance sm:mb-8">
        <span class="animate-perspective-in block">Protecție de la primul request</span>
        <span class="animate-perspective-in block delay-50"> până la recovery. </span>
      </h1>

      <p class="text-muted-foreground animate-perspective-in animation-delay-150 mx-auto mb-6 max-w-200 text-center text-lg text-balance sm:mb-8">
        Edge protection, hardening, monitoring și recovery construite în jurul aplicației reale — fără să presupunem că un singur produs poate opri orice atac.
      </p>

      <div class="mb-11 flex flex-col items-stretch justify-center gap-3 sm:mb-17 sm:flex-row sm:items-center">
        <Button class="animate-perspective-in animation-delay-200" variant="secondary" size="lg" href="https://scan.zebrabyte.ro" target="_blank" rel="noopener noreferrer">
          Rulează scanarea web
        </Button>
        <Button class="animate-perspective-in animation-delay-300" size="lg" href="/contact">
          Protejează website-ul
        </Button>
      </div>
    </animated-hero>

    <section class="container pb-10 sm:pb-20">
      <div class="overflow-hidden rounded-2xl border bg-level-1 shadow-sm">
        <div class="flex items-center gap-2 border-b px-5 py-4">
          <span class="size-2.5 rounded-full border"></span>
          <span class="size-2.5 rounded-full border"></span>
          <span class="size-2.5 rounded-full border"></span>
          <span class="text-muted-foreground ml-3 text-xs">request path</span>
        </div>
        <div class="grid gap-0 lg:grid-cols-4">
          <div class="border-b p-7 lg:border-r lg:border-b-0 sm:p-9">
            <p class="text-muted-foreground mb-8 text-sm">01 · Browser</p>
            <h2 class="text-h4 mb-3 font-medium">User request</h2>
            <p class="text-muted-foreground leading-relaxed">Trafic legitim, bots, login attempts și requests către aplicație sau API.</p>
          </div>
          <div class="bg-active border-b p-7 lg:border-r lg:border-b-0 sm:p-9">
            <p class="text-muted-foreground mb-8 text-sm">02 · Edge</p>
            <h2 class="text-h4 mb-3 font-medium">Filter first</h2>
            <p class="text-muted-foreground leading-relaxed">TLS, WAF, rate limiting și DDoS filtering înainte ca traficul să ajungă la origin.</p>
          </div>
          <div class="border-b p-7 lg:border-r lg:border-b-0 sm:p-9">
            <p class="text-muted-foreground mb-8 text-sm">03 · Application</p>
            <h2 class="text-h4 mb-3 font-medium">Reduce exposure</h2>
            <p class="text-muted-foreground leading-relaxed">Hardening, identity, patching și configuration review acolo unde aplicația procesează request-ul.</p>
          </div>
          <div class="p-7 sm:p-9">
            <p class="text-muted-foreground mb-8 text-sm">04 · Origin</p>
            <h2 class="text-h4 mb-3 font-medium">Recover safely</h2>
            <p class="text-muted-foreground leading-relaxed">Monitoring, backup și recovery pentru situațiile în care prevenția nu este suficientă.</p>
          </div>
        </div>
      </div>
    </section>

    <section class="container py-10 sm:py-20">
      <div class="grid items-start gap-12 lg:grid-cols-[0.85fr_1.15fr] lg:gap-24">
        <div class="lg:sticky lg:top-28">
          <p class="text-muted-foreground mb-3 text-sm font-medium uppercase tracking-wide">Edge protection</p>
          <h2 class="text-h3 sm:text-h2 mb-5 font-medium">Oprește zgomotul înainte de aplicație.</h2>
          <p class="text-muted-foreground mb-7 text-lg leading-relaxed">
            Controalele de edge reduc traficul abuziv și expunerea inutilă fără să transforme fiecare request într-o problemă pentru origin. Configurația se adaptează aplicației și traficului legitim.
          </p>
          <Button href="/security-assessment" variant="secondary">Vezi Security Assessment</Button>
        </div>

        <div class="divide-y border-y">
          {edgeControls.map(([title, text]) => (
            <article class="grid gap-3 py-7 sm:grid-cols-[0.7fr_1.3fr] sm:gap-10">
              <h3 class="text-h5 font-medium">{title}</h3>
              <p class="text-muted-foreground leading-relaxed">{text}</p>
            </article>
          ))}
        </div>
      </div>
    </section>

    <section class="bg-level-3 text-level-0-foreground py-12 sm:py-24">
      <div class="container">
        <div class="mb-12 max-w-3xl sm:mb-16">
          <p class="text-level-0-foreground/60 mb-3 text-sm font-medium uppercase tracking-wide">Inside the application</p>
          <h2 class="text-h3 sm:text-h2 mb-4 font-medium">Edge-ul nu poate repara o aplicație vulnerabilă.</h2>
          <p class="text-level-0-foreground/65 text-lg leading-relaxed">
            După ce traficul ajunge în aplicație, securitatea depinde de configurație, identity, componentele instalate și felul în care sunt tratate findings-urile reale.
          </p>
        </div>

        <div class="grid gap-10 md:grid-cols-3 md:gap-14">
          {applicationControls.map((item, index) => (
            <article>
              <div class="text-level-0-foreground/45 mb-8 font-mono text-sm">0{index + 1}</div>
              <h3 class="text-h4 mb-3 font-medium">{item.title}</h3>
              <p class="text-level-0-foreground/65 leading-relaxed">{item.text}</p>
            </article>
          ))}
        </div>
      </div>
    </section>

    <section class="container py-12 sm:py-24">
      <div class="grid items-center gap-12 lg:grid-cols-2 lg:gap-24">
        <div>
          <p class="text-muted-foreground mb-3 text-sm font-medium uppercase tracking-wide">Detect</p>
          <h2 class="text-h3 sm:text-h2 mb-5 font-medium">Schimbările periculoase trebuie să fie observabile.</h2>
          <p class="text-muted-foreground mb-8 text-lg leading-relaxed">
            Monitoring-ul nu înseamnă doar uptime. Urmărim semnalele care pot indica compromitere, reinfectare, degradare sau o regresie după un change legitim.
          </p>
          <div class="space-y-4">
            {detectionSignals.map((signal) => (
              <div class="flex items-start gap-3">
                <span class="mt-2 size-1.5 shrink-0 rounded-full bg-foreground"></span>
                <p class="text-muted-foreground leading-relaxed">{signal}</p>
              </div>
            ))}
          </div>
        </div>

        <div class="relative overflow-hidden rounded-2xl border bg-active p-8 sm:p-12">
          <div class="absolute inset-x-0 top-0 h-20 bg-gradient-to-b from-level-0/35 to-transparent"></div>
          <div class="relative">
            <p class="text-muted-foreground mb-10 text-sm">POST-CHANGE VERIFICATION</p>
            <div class="space-y-7">
              <div>
                <div class="mb-2 flex items-center justify-between gap-4">
                  <span class="font-medium">Application integrity</span>
                  <span class="text-muted-foreground text-sm">verified</span>
                </div>
                <div class="h-px bg-border"></div>
              </div>
              <div>
                <div class="mb-2 flex items-center justify-between gap-4">
                  <span class="font-medium">Admin exposure</span>
                  <span class="text-muted-foreground text-sm">reduced</span>
                </div>
                <div class="h-px bg-border"></div>
              </div>
              <div>
                <div class="mb-2 flex items-center justify-between gap-4">
                  <span class="font-medium">Recovery point</span>
                  <span class="text-muted-foreground text-sm">available</span>
                </div>
                <div class="h-px bg-border"></div>
              </div>
              <div>
                <div class="mb-2 flex items-center justify-between gap-4">
                  <span class="font-medium">Legitimate traffic</span>
                  <span class="text-muted-foreground text-sm">normal</span>
                </div>
                <div class="h-px bg-border"></div>
              </div>
            </div>
          </div>
        </div>
      </div>
    </section>

    <section class="bg-active py-12 sm:py-24">
      <div class="container">
        <div class="mx-auto mb-12 max-w-180 text-center sm:mb-16">
          <p class="text-muted-foreground mb-3 text-sm font-medium uppercase tracking-wide">Recover</p>
          <h2 class="text-h3 sm:text-h2 mb-4 font-medium">Backup-ul devine control doar când poți reveni.</h2>
          <p class="text-muted-foreground text-lg leading-relaxed">
            Un site compromis nu se rezolvă printr-un singur click. Recovery-ul trebuie să limiteze impactul, să readucă serviciul într-o stare cunoscută și să verifice faptul că problema nu a rămas activă.
          </p>
        </div>

        <div class="grid gap-8 sm:grid-cols-3 sm:gap-12">
          {recoverySteps.map((item) => (
            <article>
              <span class="text-muted-foreground mb-7 block font-mono text-sm">{item.step}</span>
              <h3 class="text-h4 mb-3 font-medium">{item.title}</h3>
              <p class="text-muted-foreground leading-relaxed">{item.text}</p>
            </article>
          ))}
        </div>
      </div>
    </section>

    <section class="container py-12 sm:py-24">
      <div class="grid gap-12 lg:grid-cols-[0.8fr_1.2fr] lg:gap-24">
        <div>
          <p class="text-muted-foreground mb-3 text-sm font-medium uppercase tracking-wide">Workloads</p>
          <h2 class="text-h3 sm:text-h2 mb-5 font-medium">Protecția se adaptează stack-ului existent.</h2>
          <p class="text-muted-foreground mb-7 text-lg leading-relaxed">
            Nu cerem automat migrare și nu limităm modelul la un singur CMS. Începem de la arhitectura reală, ownership și riscurile care pot fi controlate în siguranță.
          </p>
          <Button href="/secure-hosting" variant="secondary">Vezi Secure Managed Hosting</Button>
        </div>

        <div class="grid content-start grid-cols-2 gap-x-8 gap-y-0 border-y sm:grid-cols-3">
          {workloads.map((item) => (
            <div class="border-b py-5 font-medium">{item}</div>
          ))}
        </div>
      </div>
    </section>

    <section class="container py-10 sm:py-20">
      <div class="mx-auto max-w-3xl">
        <h2 class="text-h3 sm:text-h2 mb-8 text-center font-medium">Întrebări frecvente</h2>
        <div class="border-y">
          {faqs.map((faq) => (
            <details class="group border-b py-5 last:border-b-0">
              <summary class="flex cursor-pointer list-none items-center justify-between gap-6 font-medium">
                <span>{faq.question}</span>
                <span class="text-muted-foreground text-xl transition-transform group-open:rotate-45">+</span>
              </summary>
              <p class="text-muted-foreground max-w-2xl pt-4 leading-relaxed">{faq.answer}</p>
            </details>
          ))}
        </div>
      </div>
    </section>

    <section class="container py-12 text-center sm:py-24">
      <h2 class="text-h3 sm:text-h2 mx-auto mb-4 max-w-190 font-medium text-balance">
        Securizează aplicația fără să o transformi într-un proiect paralel.
      </h2>
      <p class="text-muted-foreground mx-auto mb-8 max-w-160 text-lg">
        Spune-ne platforma, infrastructura și problemele observate. Stabilim ce controls merită implementați și cine trebuie să îi opereze.
      </p>
      <Button href="/contact" size="lg">Discută despre Website Security</Button>
    </section>
  </main>
</Layout>

<script>
  import { AnimatedHero } from "../lib/elements/hero";
  import { customElementDefine } from "../lib/dom";
  customElementDefine("animated-hero", () => AnimatedHero);
</script>
