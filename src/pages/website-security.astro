---
import Layout from "../layouts/Layout.astro";
import Button from "../components/ui/Button.svelte";
import ZebraByteTestimonials from "../components/block/ZebraByteTestimonials.astro";

const protectionLayers = [
  {
    step: "01",
    title: "Before the application",
    text: "TLS, edge filtering, rate limiting și WAF reduc traficul malițios și cererile abuzive înainte să consume resursele origin-ului.",
  },
  {
    step: "02",
    title: "Inside the application",
    text: "Hardening, access control, patching, configuration review și integrity monitoring reduc șansele ca o vulnerabilitate să devină persistență.",
  },
  {
    step: "03",
    title: "After a change or incident",
    text: "Monitoring, backup, recovery și verification permit revenirea controlată și reduc riscul ca aceeași cauză să rămână activă.",
  },
];

const controls = [
  ["Web Application Firewall", "Reguli defensive și filtrare adaptate aplicației, expunerii și traficului legitim."],
  ["DDoS & edge protection", "Absorbție și filtrare la edge pentru a reduce presiunea pe origin în timpul traficului volumetric sau abuziv."],
  ["TLS & security headers", "HTTPS și headere relevante configurate fără să rupă funcționalitatea aplicației sau integrările legitime."],
  ["Malware & integrity", "Semnale de modificare suspectă, fișiere malițioase și comportamente care pot indica persistență sau reinfectare."],
  ["Admin & identity hardening", "MFA, limitarea accesului, protecția panourilor administrative și reducerea credential abuse."],
  ["Vulnerability remediation", "Patching, configuration changes și reducerea suprafeței de atac în funcție de finding și impact."],
  ["Monitoring", "Disponibilitate, schimbări și semnale relevante urmărite astfel încât degradarea posturii să fie observabilă."],
  ["Backup & recovery", "Restaurarea și recovery-ul sunt parte din control, nu doar existența unei copii de rezervă."],
];

const threats = [
  ["Credential abuse", "Brute force, credential stuffing și acces administrativ obținut prin conturi compromise."],
  ["Application attacks", "Injection, XSS, path abuse, exploatarea componentelor vulnerabile și alte atacuri asupra aplicației."],
  ["Malware & persistence", "Backdoors, fișiere injectate, redirect-uri malițioase și reinfectare după o curățare incompletă."],
  ["Availability attacks", "DDoS, abuse și consum de resurse care pot degrada sau opri serviciul."],
  ["Configuration exposure", "Servicii, fișiere, panouri sau headere configurate într-un mod care expune inutil informații sau acces."],
  ["Recovery failure", "Backup existent dar imposibil de restaurat, incomplet sau contaminat cu aceeași problemă."],
];

const workloads = [
  "WordPress și alte CMS-uri",
  "WooCommerce și magazine online",
  "aplicații web custom",
  "API-uri și backends expuse public",
  "site-uri statice și front-end-uri moderne",
  "aplicații găzduite la furnizorul actual",
];

const operatingModes = [
  {
    title: "Protect existing hosting",
    text: "Păstrăm infrastructura actuală și lucrăm pe controalele care pot fi aplicate în jurul ei: edge, WAF, DNS, hardening și monitoring.",
  },
  {
    title: "Remediate after assessment",
    text: "Pornim de la findings existente și implementăm modificările prioritare, apoi verificăm efectul remedierii.",
  },
  {
    title: "Move to managed hosting",
    text: "Când origin-ul și operațiunile sunt parte din risc, migrarea într-un mediu administrat poate aduce patching, backup și recovery sub același ownership.",
  },
  {
    title: "Recover after compromise",
    text: "Dacă site-ul este deja compromis, engagement-ul pornește ca incident response, nu ca simplă activare a unui WAF peste un origin infectat.",
  },
];

const faqs = [
  {
    question: "Trebuie să găzduiesc website-ul la ZebraByte?",
    answer:
      "Nu. Putem aplica anumite controale de edge, DNS, WAF, hardening și monitoring în jurul infrastructurii existente. Managed Hosting este separat și devine relevant când vrei și ownership asupra origin-ului, patching-ului, backup-ului și recovery-ului.",
  },
  {
    question: "Un WAF este suficient pentru a securiza un website?",
    answer:
      "Nu. WAF-ul este un strat util, dar nu repară un plugin vulnerabil, un cont administrativ compromis, un origin expus sau un backup inutilizabil. De aceea combinăm prevenția cu hardening, monitoring și recovery.",
  },
  {
    question: "Puteți curăța un site deja infectat?",
    answer:
      "Da, dar un site compromis trebuie tratat ca incident. Curățarea fără a identifica accesul inițial, persistența și cauza tehnică poate duce la reinfectare. Scope-ul poate include containment, cleanup, hardening și recovery.",
  },
  {
    question: "Funcționează și pentru WordPress?",
    answer:
      "Da. WordPress este unul dintre workload-urile pe care le putem proteja, dar modelul nu depinde de WordPress. Se poate adapta și la e-commerce, aplicații custom, API-uri și front-end-uri moderne.",
  },
  {
    question: "Cum verificăm că remedierea a funcționat?",
    answer:
      "Revalidăm finding-ul sau configurația relevantă, verificăm că aplicația legitimă funcționează și, unde este cazul, urmărim semnalele post-change pentru a evita regresii sau reinfectare.",
  },
];
---

<Layout
  title="Website Security"
  description="Website Security ZebraByte: WAF, DDoS protection, malware monitoring, TLS hardening, identity protection, vulnerability remediation și recovery pentru WordPress, e-commerce și aplicații web."
>
  <main class="-mt-16 overflow-hidden pt-16">
    <animated-hero class="relative block overflow-hidden">
      <section class="container py-16 text-center sm:py-24">
        <div class="text-muted-foreground animate-perspective-in animation-delay-300 mx-auto mb-6 w-max rounded-lg border px-3 py-1 text-sm font-medium">Website Security</div>
        <h1 class="text-h2 sm:text-h1 mx-auto mb-6 max-w-210 overflow-hidden font-medium text-balance">
          <span class="animate-perspective-in block">Protecție înainte, în timpul</span>
          <span class="animate-perspective-in animation-delay-100 block">și după un atac.</span>
        </h1>
        <p class="text-muted-foreground animate-perspective-in animation-delay-150 mx-auto mb-8 max-w-170 text-lg text-balance">
          WAF, DDoS protection, hardening, malware monitoring și recovery operate ca straturi
          complementare. Poți păstra furnizorul actual sau poți muta origin-ul într-un mediu managed atunci când asta reduce riscul real.
        </p>
        <div class="animate-perspective-in animation-delay-300 flex flex-col justify-center gap-3 sm:flex-row">
          <Button variant="secondary" size="lg" href="/security-assessment">Începe cu un assessment</Button>
          <Button size="lg" href="/contact">Protejează website-ul</Button>
        </div>
      </section>
    </animated-hero>

    <section class="container py-16 sm:py-24">
      <div class="mx-auto grid max-w-6xl gap-12 border-y py-10 lg:grid-cols-[0.72fr_1.28fr] lg:gap-20 sm:py-14">
        <div>
          <p class="text-muted-foreground mb-3 text-sm font-medium uppercase tracking-[0.12em]">Request path</p>
          <h2 class="text-h3 sm:text-h2 font-medium text-balance">Atacul trebuie să treacă prin mai multe straturi.</h2>
        </div>
        <p class="text-muted-foreground text-lg leading-relaxed">
          Nu tratăm website-ul ca pe un singur server. Cererea traversează edge-ul, aplicația,
          identitatea și origin-ul, iar fiecare strat poate reduce impactul următorului.
        </p>
      </div>
    </section>

    <section class="container py-16 sm:py-28">
      <div class="mx-auto mb-14 max-w-190 text-center">
        <p class="text-muted-foreground mb-3 text-sm font-medium uppercase tracking-[0.12em]">Protection layers</p>
        <h2 class="text-h3 sm:text-h2 mb-4 font-medium">Prevenție, hardening și recovery în același traseu.</h2>
      </div>
      <div class="grid border-y lg:grid-cols-3 lg:divide-x">
        {protectionLayers.map((item) => (
          <article class="border-b p-7 last:border-b-0 sm:p-9 lg:border-b-0">
            <span class="text-muted-foreground mb-9 block font-mono text-sm">{item.step}</span>
            <h3 class="text-h5 mb-3 font-medium">{item.title}</h3>
            <p class="text-muted-foreground leading-relaxed">{item.text}</p>
          </article>
        ))}
      </div>
    </section>

    <section class="bg-level-3 py-16 text-invert sm:py-28">
      <div class="container">
        <div class="mx-auto mb-14 max-w-190 text-center">
          <p class="mb-3 text-sm font-medium uppercase tracking-[0.12em] opacity-55">Control plane</p>
          <h2 class="text-h3 sm:text-h2 mb-4 font-medium">Opt controale, un singur scop: reducerea riscului.</h2>
          <p class="text-lg leading-relaxed opacity-65">
            Configurația exactă depinde de stack și de cine controlează infrastructura. Nu prezentăm fiecare control ca fiind universal disponibil pentru orice aplicație.
          </p>
        </div>
        <div class="grid border-y border-invert/15 sm:grid-cols-2 lg:grid-cols-4">
          {controls.map(([control, text], index) => (
            <article class="border-b border-invert/15 p-6 sm:border-r sm:p-7 [&:nth-last-child(-n+2)]:sm:border-b-0 [&:nth-child(2n)]:sm:border-r-0 lg:min-h-60 lg:[&:nth-child(2n)]:border-r lg:[&:nth-child(4n)]:border-r-0 lg:[&:nth-last-child(-n+4)]:border-b-0">
              <span class="mb-8 block font-mono text-sm opacity-40">{String(index + 1).padStart(2, "0")}</span>
              <h3 class="mb-3 font-medium">{control}</h3>
              <p class="text-sm leading-relaxed opacity-65">{text}</p>
            </article>
          ))}
        </div>
      </div>
    </section>

    <section class="container py-16 sm:py-28">
      <div class="grid items-start gap-12 lg:grid-cols-2 lg:gap-20">
        <div>
          <p class="text-muted-foreground mb-3 text-sm font-medium uppercase tracking-[0.12em]">Threat model</p>
          <h2 class="text-h3 sm:text-h2 mb-5 font-medium text-balance">Fără promisiuni de „100% secure”.</h2>
          <p class="text-muted-foreground mb-8 max-w-150 text-lg leading-relaxed">
            Obiectivul este să reducem probabilitatea și impactul, să detectăm schimbările relevante și să avem o cale de recovery. Nicio arhitectură serioasă nu pornește de la ideea că orice atac poate fi blocat.
          </p>
          <Button href="https://scan.zebrabyte.ro" variant="secondary" target="_blank" rel="noopener noreferrer">Rulează scanarea web</Button>
        </div>
        <div class="divide-y border-y">
          {threats.map(([threat, text], index) => (
            <article class="grid grid-cols-[56px_1fr] gap-4 py-6 sm:grid-cols-[72px_0.7fr_1.3fr] sm:gap-8">
              <span class="text-muted-foreground font-mono text-xs">0{index + 1}</span>
              <h3 class="font-medium">{threat}</h3>
              <p class="text-muted-foreground leading-relaxed">{text}</p>
            </article>
          ))}
        </div>
      </div>
    </section>

    <section class="bg-active py-16 sm:py-28">
      <div class="container grid items-start gap-12 lg:grid-cols-2 lg:gap-20">
        <div>
          <p class="text-muted-foreground mb-3 text-sm font-medium uppercase tracking-[0.12em]">Real workloads</p>
          <h2 class="text-h3 sm:text-h2 mb-5 font-medium text-balance">Protecția trebuie să se adapteze aplicației.</h2>
          <p class="text-muted-foreground max-w-150 text-lg leading-relaxed">
            Website Security nu este limitat la un singur CMS și nici nu cere automat o migrare. Începem de la arhitectura actuală și de la controalele care pot fi operate în siguranță în acel context.
          </p>
        </div>
        <div class="divide-y border-y">
          {workloads.map((item, index) => (
            <div class="grid grid-cols-[56px_1fr] gap-4 py-5 sm:py-6">
              <span class="text-muted-foreground font-mono text-xs">0{index + 1}</span>
              <span class="font-medium leading-relaxed">{item}</span>
            </div>
          ))}
        </div>
      </div>
    </section>

    <section class="container py-16 sm:py-28">
      <div class="mx-auto mb-14 max-w-190 text-center">
        <p class="text-muted-foreground mb-3 text-sm font-medium uppercase tracking-[0.12em]">Engagement</p>
        <h2 class="text-h3 sm:text-h2 mb-4 font-medium">Patru puncte de intrare, fără migrare forțată.</h2>
        <p class="text-muted-foreground text-lg leading-relaxed">Alegem traseul după starea actuală a website-ului și după cine deține infrastructura.</p>
      </div>
      <div class="grid border-y lg:grid-cols-4 lg:divide-x">
        {operatingModes.map((item, index) => (
          <article class="border-b p-7 last:border-b-0 sm:p-8 lg:border-b-0">
            <span class="text-muted-foreground mb-8 block font-mono text-xs">MODE-{String(index + 1).padStart(2, "0")}</span>
            <h3 class="text-h5 mb-3 font-medium">{item.title}</h3>
            <p class="text-muted-foreground leading-relaxed">{item.text}</p>
          </article>
        ))}
      </div>
    </section>

    <ZebraByteTestimonials />

    <section class="container py-16 sm:py-28">
      <div class="mx-auto max-w-3xl">
        <h2 class="text-h3 sm:text-h2 mb-8 font-medium">Întrebări frecvente</h2>
        <div class="border-y">
          {faqs.map((faq) => (
            <details class="group border-b py-5 last:border-b-0">
              <summary class="flex cursor-pointer list-none items-center justify-between gap-6 font-medium">
                <span>{faq.question}</span>
                <span class="text-muted-foreground text-xl transition-transform group-open:rotate-45">+</span>
              </summary>
              <p class="text-muted-foreground max-w-2xl pt-4 leading-relaxed">{faq.answer}</p>
            </details>
          ))}
        </div>
      </div>
    </section>

    <section class="border-t py-16 text-center sm:py-28">
      <div class="container">
        <h2 class="text-h3 sm:text-h2 mx-auto mb-4 max-w-190 font-medium text-balance">Protejează aplicația fără să pierzi contextul operațional.</h2>
        <p class="text-muted-foreground mx-auto mb-8 max-w-160 text-lg">Putem începe cu infrastructura existentă și extinde scope-ul doar acolo unde riscul justifică schimbarea.</p>
        <Button href="/contact" size="lg">Discută despre Website Security</Button>
      </div>
    </section>
  </main>
</Layout>

<script>
  import { AnimatedHero } from "../lib/elements/hero";
  import { customElementDefine } from "../lib/dom";
  customElementDefine("animated-hero", () => AnimatedHero);
</script>
