---
import Layout from "../layouts/Layout.astro";
import Button from "../components/ui/Button.svelte";
import FrameworkBadge from "../components/FrameworkBadge.svelte";
import Stories from "../components/block/Stories.astro";

const trustCriteria = [
  {
    name: "Availability",
    text: "Capacitate, backup, recovery, continuitate și monitoring atunci când disponibilitatea face parte din commitments.",
  },
  {
    name: "Processing Integrity",
    text: "Controale care susțin procesarea completă, validă, autorizată și la timp pentru serviciul aflat în scope.",
  },
  {
    name: "Confidentiality",
    text: "Clasificare, access, protecție și eliminare controlată pentru informațiile desemnate confidențiale.",
  },
  {
    name: "Privacy",
    text: "Procese relevante pentru colectare, utilizare, retenție, disclosure și alte commitments privind datele personale.",
  },
];

const readinessPhases = [
  {
    number: "01",
    title: "Scope & design",
    text: "Servicii, sisteme, criteria, risks și controls care trebuie să poată fi explicate și operate.",
  },
  {
    number: "02",
    title: "Operate & evidence",
    text: "Owners, policies, access reviews, change management, vulnerability management și evidence pe perioada relevantă.",
  },
  {
    number: "03",
    title: "Audit & continue",
    text: "Sample-uri, clarificări, findings și apoi același program continuă după emiterea raportului.",
  },
];

const technicalControls = [
  "Identity, MFA și access reviews",
  "Change management și SDLC evidence",
  "Vulnerability management și remediation",
  "Logging, monitoring și alerting",
  "Incident response și lessons learned",
  "Backup, recovery și availability controls",
  "Vendor și third-party risk management",
  "Security policies și review cadence",
];

const faqs = [
  {
    question: "SOC 2 este o certificare?",
    answer:
      "Nu. SOC 2 este un engagement de atestare care rezultă într-un raport emis de un auditor independent calificat. ZebraByte ajută la readiness și operarea programului, nu emite raportul.",
  },
  {
    question: "Care este diferența dintre SOC 2 Type I și Type II?",
    answer:
      "Type I evaluează designul controalelor la un moment dat. Type II evaluează designul și operarea controalelor pe o perioadă definită. Alegerea depinde de obiectivul engagement-ului și de maturitatea programului.",
  },
  {
    question: "Trebuie să includ toate cele cinci Trust Services Criteria?",
    answer:
      "Nu. Security este criteriul de bază pentru fiecare raport, iar celelalte criterii se includ atunci când serviciul, commitments sau contextul justifică scope-ul respectiv.",
  },
  {
    question: "Putem reutiliza controale din ISO 27001?",
    answer:
      "Da, atunci când cerințele se suprapun. Același control sau aceeași dovadă poate susține mai multe obiective fără ca framework-urile să devină echivalente.",
  },
];

const serviceSchema = {
  "@context": "https://schema.org",
  "@type": "Service",
  name: "SOC 2 Readiness",
  provider: { "@type": "Organization", name: "ZebraByte", url: "https://www.zebrabyte.ro" },
  serviceType: "SOC 2 readiness and continuous compliance operations",
  url: "https://www.zebrabyte.ro/soc2",
};
---

<Layout
  title="SOC 2 Readiness"
  description="SOC 2 readiness ZebraByte: scope, Trust Services Criteria, controls, evidence, remediation, audit preparation și operare continuă."
>
  <script type="application/ld+json" set:html={JSON.stringify(serviceSchema)} />

  <main class="-mt-16 overflow-hidden pt-16">
    <section class="relative isolate overflow-hidden py-16 sm:py-24">
      <div aria-hidden="true" class="pointer-events-none absolute top-[-1200px] left-1/2 -z-10 size-[2100px] -translate-x-1/2 rounded-full border-[320px] border-[#E6FF03] blur-[110px]"></div>
      <div class="container text-center">
        <div class="text-muted-foreground mx-auto mb-7 w-max rounded-lg border px-3 py-1 text-sm font-medium">SOC 2 · Assurance</div>
        <h1 class="text-h2 sm:text-h1 mx-auto mb-6 max-w-210 font-medium text-balance">Construiește controls care rezistă și după audit.</h1>
        <p class="text-muted-foreground mx-auto mb-9 max-w-180 text-lg text-balance">
          Scope, Trust Services Criteria, controls, evidence și remediation într-un program care poate susține engagement-ul auditorului independent și continua după raport.
        </p>
        <div class="mb-12 flex flex-col justify-center gap-3 sm:flex-row">
          <Button href="/managed-compliance" variant="secondary" size="lg">Managed Compliance</Button>
          <Button href="/contact" size="lg">Discută despre SOC 2</Button>
        </div>
        <div class="mx-auto flex w-max items-end gap-6 rounded-[28px] border bg-level-0 px-8 py-7 shadow-sm sm:gap-10 sm:px-12">
          <div class="text-center">
            <FrameworkBadge name="SOC2_TYPE1" class="mx-auto size-20 sm:size-28" client:visible />
            <p class="mt-3 text-sm font-medium">Type I</p>
          </div>
          <div class="h-20 w-px bg-border sm:h-28"></div>
          <div class="text-center">
            <FrameworkBadge name="SOC2_TYPE2" class="mx-auto size-20 sm:size-28" client:visible />
            <p class="mt-3 text-sm font-medium">Type II</p>
          </div>
        </div>
      </div>
    </section>

    <section class="container py-14 sm:py-24">
      <div class="mb-10 max-w-165 sm:mb-14">
        <p class="text-muted-foreground mb-3 text-sm font-medium uppercase tracking-[0.12em]">Type I vs Type II</p>
        <h2 class="text-h3 sm:text-h2 mb-4 font-medium">Același program. Două momente diferite de assurance.</h2>
        <p class="text-muted-foreground text-lg leading-relaxed">Type I privește designul controalelor la un moment definit. Type II adaugă întrebarea mai grea: au funcționat controalele pe perioada evaluată?</p>
      </div>

      <div class="grid gap-5 lg:grid-cols-2">
        <article class="relative min-h-[410px] overflow-hidden rounded-[28px] border bg-[#f8faf4] p-7 sm:p-10">
          <p class="text-muted-foreground mb-4 text-sm font-medium">SOC 2 Type I</p>
          <h3 class="text-h3 mb-4 max-w-110 font-medium">Designul controalelor, la un moment dat.</h3>
          <p class="text-muted-foreground max-w-120 leading-relaxed">Util când organizația are nevoie de un prim nivel de assurance sau vrea să demonstreze că mediul și controalele au fost proiectate pentru scope-ul declarat.</p>
          <FrameworkBadge name="SOC2_TYPE1" class="absolute right-7 bottom-7 size-28 sm:right-10 sm:bottom-10 sm:size-36" client:visible />
        </article>
        <article class="relative min-h-[410px] overflow-hidden rounded-[28px] bg-[#001a00] p-7 text-white sm:p-10">
          <p class="mb-4 text-sm font-medium text-[#e6ff03]">SOC 2 Type II</p>
          <h3 class="text-h3 mb-4 max-w-110 font-medium">Design plus operare pe o perioadă definită.</h3>
          <p class="max-w-120 leading-relaxed text-white/70">Evidence-ul, sample-urile și activitatea ownerilor trebuie să poată demonstra nu doar intenția controlului, ci și funcționarea lui în timp.</p>
          <FrameworkBadge name="SOC2_TYPE2" class="absolute right-7 bottom-7 size-28 sm:right-10 sm:bottom-10 sm:size-36" client:visible />
        </article>
      </div>
    </section>

    <section class="bg-active py-14 sm:py-24">
      <div class="container">
        <div class="mx-auto mb-12 max-w-180 text-center">
          <p class="text-muted-foreground mb-3 text-sm font-medium uppercase tracking-[0.12em]">Trust Services Criteria</p>
          <h2 class="text-h3 sm:text-h2 mb-4 font-medium">Security este baza. Restul intră în scope când serviciul o cere.</h2>
        </div>

        <div class="mx-auto max-w-6xl space-y-5">
          <article class="grid min-h-[250px] overflow-hidden rounded-[28px] border bg-level-0 lg:grid-cols-[0.8fr_1.2fr]">
            <div class="p-7 sm:p-10">
              <p class="text-muted-foreground mb-3 text-sm">Common Criteria</p>
              <h3 class="text-h2 mb-4 font-medium">Security</h3>
              <p class="text-muted-foreground max-w-120 text-lg leading-relaxed">Access control, change management, monitoring, incident response și celelalte controls care protejează sistemele împotriva accesului neautorizat.</p>
            </div>
            <div class="relative min-h-64 overflow-hidden bg-[#001a00] p-8">
              <img src="/trust-center/security-monitoring.svg" alt="Security monitoring și controls" width="720" height="420" loading="lazy" class="absolute inset-0 h-full w-full object-contain p-8" />
            </div>
          </article>

          <div class="grid gap-5 sm:grid-cols-2">
            {trustCriteria.map((criterion) => (
              <article class="min-h-[220px] rounded-[24px] border bg-level-0 p-6 sm:p-8">
                <h3 class="text-h4 mb-4 font-medium">{criterion.name}</h3>
                <p class="text-muted-foreground leading-relaxed">{criterion.text}</p>
              </article>
            ))}
          </div>
        </div>
      </div>
    </section>

    <section class="container py-14 sm:py-24">
      <div class="grid items-center gap-12 lg:grid-cols-[0.84fr_1.16fr] lg:gap-20">
        <div>
          <p class="text-muted-foreground mb-3 text-sm font-medium uppercase tracking-[0.12em]">Evidence lifecycle</p>
          <h2 class="text-h3 sm:text-h2 mb-5 font-medium text-balance">Evidence-ul trebuie să apară din operare, nu din panică înainte de audit.</h2>
          <p class="text-muted-foreground mb-7 text-lg leading-relaxed">Reviews, approvals, access records, change evidence și rezultatele tehnice sunt păstrate lângă controls și owners. Asta reduce reconstrucția manuală a lunilor anterioare.</p>
          <Button href="/compliance-platform" variant="secondary">Vezi platforma GRC</Button>
        </div>
        <div class="overflow-hidden rounded-[28px] bg-[#f8faf4] p-5 sm:p-9">
          <img src="/trust-center/documents.svg" alt="Evidence și documente controlate" width="1024" height="420" loading="lazy" class="h-auto w-full" />
        </div>
      </div>
    </section>

    <section class="bg-[#001a00] py-14 text-white sm:py-24">
      <div class="container">
        <div class="mx-auto mb-12 max-w-180 text-center">
          <p class="mb-3 text-sm font-medium uppercase tracking-[0.12em] text-[#e6ff03]">Readiness path</p>
          <h2 class="text-h3 sm:text-h2 mb-4 font-medium">De la scope la operare continuă.</h2>
          <p class="text-lg text-white/65">Nu construim șase mini-proiecte separate. Readiness-ul se mișcă prin trei faze mari care se alimentează una pe alta.</p>
        </div>
        <div class="mx-auto grid max-w-6xl gap-4 lg:grid-cols-3">
          {readinessPhases.map((phase) => (
            <article class="rounded-[24px] border border-white/15 bg-white/5 p-7 sm:p-9">
              <p class="mb-12 font-mono text-sm text-[#e6ff03]">{phase.number}</p>
              <h3 class="text-h4 mb-4 font-medium">{phase.title}</h3>
              <p class="leading-relaxed text-white/65">{phase.text}</p>
            </article>
          ))}
        </div>
      </div>
    </section>

    <section class="container py-14 sm:py-24">
      <div class="grid gap-12 lg:grid-cols-[0.8fr_1.2fr] lg:gap-20">
        <div>
          <p class="text-muted-foreground mb-3 text-sm font-medium uppercase tracking-[0.12em]">Controls that exist in reality</p>
          <h2 class="text-h3 sm:text-h2 mb-5 font-medium">Compliance-ul trebuie susținut de security.</h2>
          <p class="text-muted-foreground mb-7 text-lg leading-relaxed">Un control nu devine real pentru că apare într-o policy. Când scope-ul cere măsuri tehnice, evidence-ul trebuie să vină din procese și sisteme care chiar funcționează.</p>
          <Button href="/cyber-security" variant="secondary">Vezi Cyber Security</Button>
        </div>
        <div class="grid gap-3 sm:grid-cols-2">
          {technicalControls.map((item) => (
            <div class="rounded-2xl bg-active px-5 py-4 font-medium">{item}</div>
          ))}
        </div>
      </div>
    </section>

    <section class="bg-[#f8faf4] py-14 sm:py-24">
      <div class="container grid items-center gap-12 lg:grid-cols-[0.85fr_1.15fr] lg:gap-20">
        <div>
          <p class="text-muted-foreground mb-3 text-sm font-medium uppercase tracking-[0.12em]">After the report</p>
          <h2 class="text-h3 sm:text-h2 mb-5 font-medium text-balance">Assurance-ul devine util când îl poți partaja controlat.</h2>
          <p class="text-muted-foreground mb-7 text-lg leading-relaxed">Raportul SOC 2 și alte documente aprobate pot fi distribuite prin Trust Center fără să expui workspace-ul intern, risk register-ul sau evidence-ul operațional.</p>
          <Button href="/compliance-portal">Vezi Trust Center</Button>
        </div>
        <div class="overflow-hidden rounded-[28px] bg-[#E6FF03]/18 p-5 sm:p-8">
          <img src="/trust-center/browser.svg" alt="Trust Center pentru distribuirea raportului SOC 2" width="1146" height="786" loading="lazy" class="h-auto w-full" />
        </div>
      </div>
    </section>

    <Stories />

    <section class="container py-14 sm:py-24">
      <div class="mx-auto max-w-3xl">
        <h2 class="text-h3 sm:text-h2 mb-8 text-center font-medium">Întrebări frecvente</h2>
        <div class="border-y">
          {faqs.map((faq) => (
            <details class="group border-b py-5 last:border-b-0">
              <summary class="flex cursor-pointer list-none items-center justify-between gap-6 font-medium"><span>{faq.question}</span><span class="text-muted-foreground text-xl transition-transform group-open:rotate-45">+</span></summary>
              <p class="text-muted-foreground max-w-2xl pt-4 leading-relaxed">{faq.answer}</p>
            </details>
          ))}
        </div>
      </div>
    </section>

    <section class="border-t py-16 text-center sm:py-24">
      <div class="container">
        <h2 class="text-h3 sm:text-h2 mx-auto mb-4 max-w-180 font-medium text-balance">SOC 2 ca program continuu, nu ca sprint înainte de audit.</h2>
        <p class="text-muted-foreground mx-auto mb-8 max-w-160 text-lg">Putem începe cu readiness și continua cu controls, evidence și remediation după emiterea raportului.</p>
        <Button href="/contact" size="lg">Discută despre SOC 2</Button>
      </div>
    </section>
  </main>
</Layout>
