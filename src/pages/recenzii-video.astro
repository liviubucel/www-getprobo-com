---
import Layout from "../layouts/Layout.astro";

const turnstileSiteKey = "0x4AAAAAABBpDfopxKwUIKF_";
---

<Layout
  title="Recenzii Clienți ZebraByte"
  description="Feedback verificat despre ZebraByte și formular securizat pentru clienții care doresc să trimită o recenzie."
>
  <main>
    <animated-hero class="relative -mt-16 block overflow-hidden px-5 pb-16 pt-32 sm:pb-24 sm:pt-40">
      <div class="container text-center">
        <p class="text-muted-foreground animate-perspective-in mb-5 text-sm font-medium uppercase tracking-[0.14em]">Customer feedback</p>
        <h1 class="text-h2 sm:text-h1 animate-perspective-in animation-delay-100 mx-auto mb-6 max-w-230 font-medium text-balance">Feedback real, publicat cu context.</h1>
        <p class="text-muted-foreground animate-perspective-in animation-delay-150 mx-auto mb-8 max-w-190 text-lg text-balance">
          Păstrăm separat feedback-ul verificat al clienților ZebraByte, reference insights și studiile de caz. Dacă ai lucrat cu noi, poți trimite o recenzie prin formularul securizat de mai jos.
        </p>
        <a href="#lasa-recenzie" class="bg-primary text-primary-foreground inline-flex h-11 items-center justify-center rounded-lg px-5 text-sm font-medium">Lasă o recenzie</a>
      </div>
    </animated-hero>

    <section class="container pb-12 sm:pb-24">
      <div class="grid gap-14 lg:grid-cols-[0.7fr_1.3fr] lg:items-start lg:gap-24">
        <div>
          <p class="text-muted-foreground mb-3 text-sm font-medium uppercase tracking-wide">Feedback verificat</p>
          <h2 class="text-h3 sm:text-h2 mb-5 font-medium">Publicăm doar ceea ce putem atribui corect.</h2>
          <p class="text-muted-foreground text-lg leading-relaxed">
            Recenziile trimise prin formular intră în verificare înainte de publicare. Nu completăm feedback-ul cu testimoniale generate și nu atribuim unei persoane afirmații pe care nu le-a furnizat.
          </p>
        </div>

        <article class="border-y py-7 sm:py-9">
          <div class="grid gap-6 sm:grid-cols-[0.75fr_1.25fr] sm:gap-12">
            <div>
              <p class="text-h4 font-medium">Diana Ruse</p>
              <p class="text-muted-foreground mt-2 text-sm">Testimonial video · 16 Jul 2025</p>
            </div>
            <div>
              <div class="mb-5 flex items-center gap-4">
                <span class="text-xl tracking-wider" aria-label="5 din 5 stele">★★★★★</span>
                <span class="text-muted-foreground text-sm">5/5</span>
              </div>
              <p class="text-muted-foreground leading-relaxed">
                Înregistrarea testimonialului este păstrată ca material verificat ZebraByte. Pe această pagină publicăm numai informația disponibilă și verificată, fără a reconstrui sau înlocui clipul cu media sintetică.
              </p>
            </div>
          </div>
        </article>
      </div>
    </section>

    <section class="bg-level-3 py-12 text-level-0-foreground sm:py-24">
      <div class="container grid gap-14 lg:grid-cols-[0.8fr_1.2fr] lg:gap-24">
        <div>
          <p class="text-level-0-foreground/55 mb-3 text-sm font-medium uppercase tracking-wide">More context</p>
          <h2 class="text-h3 sm:text-h2 mb-5 font-medium">Feedback, reference insights și stories au roluri diferite.</h2>
          <p class="text-level-0-foreground/65 text-lg leading-relaxed">
            Nu prezentăm automat toate materialele din biblioteca de referință ca testimoniale ZebraByte. Separăm feedback-ul verificat de cazurile și insight-urile păstrate ca material editorial sau de referință.
          </p>
        </div>

        <div class="grid gap-x-10 sm:grid-cols-2">
          <a href="/love-from-customer" class="group border-t border-level-0-foreground/15 py-7">
            <p class="text-level-0-foreground/45 mb-7 text-sm uppercase tracking-wide">Feedback & Reference Insights</p>
            <h3 class="text-h4 font-medium group-hover:underline group-hover:underline-offset-4">Love from Customers</h3>
            <p class="text-level-0-foreground/65 mt-3 leading-relaxed">Feedback verificat și biblioteca de reference insights, cu proveniența păstrată.</p>
          </a>
          <a href="/stories" class="group border-t border-level-0-foreground/15 py-7">
            <p class="text-level-0-foreground/45 mb-7 text-sm uppercase tracking-wide">Reference cases</p>
            <h3 class="text-h4 font-medium group-hover:underline group-hover:underline-offset-4">Stories</h3>
            <p class="text-level-0-foreground/65 mt-3 leading-relaxed">Cazuri și parcursuri folosite pentru context, fără a le prezenta automat ca istoric comercial ZebraByte.</p>
          </a>
        </div>
      </div>
    </section>

    <section id="lasa-recenzie" class="container py-12 sm:py-24">
      <div class="grid gap-14 lg:grid-cols-[0.75fr_1.25fr] lg:gap-24">
        <div class="lg:sticky lg:top-28 lg:self-start">
          <p class="text-muted-foreground mb-3 text-sm font-medium uppercase tracking-wide">Trimite feedback</p>
          <h2 class="text-h3 sm:text-h2 mb-5 font-medium">Ai lucrat cu ZebraByte?</h2>
          <p class="text-muted-foreground mb-7 text-lg leading-relaxed">
            Spune-ne cum a fost experiența. Formularul folosește verificare Turnstile, iar feedback-ul este revizuit înainte de publicare.
          </p>
          <div class="border-y py-5 text-sm leading-relaxed text-muted-foreground">
            Nu include parole, token-uri, chei, date personale ale altor persoane sau informații confidențiale despre infrastructură în textul recenziei.
          </div>
        </div>

        <form id="review-form" class="space-y-6 border-y py-7 sm:py-9">
          <input type="hidden" name="service" value="Altceva" />
          <input type="hidden" name="company" value="Customer review" />
          <input type="hidden" name="phone" value="" />

          <div class="grid gap-5 sm:grid-cols-2">
            <label class="block space-y-2 text-sm font-medium">
              <span>Nume *</span>
              <input name="name" required maxlength="100" autocomplete="name" class="bg-level-0 w-full rounded-lg border px-3 py-2.5" />
            </label>

            <label class="block space-y-2 text-sm font-medium">
              <span>Email *</span>
              <input name="email" type="email" required maxlength="254" autocomplete="email" class="bg-level-0 w-full rounded-lg border px-3 py-2.5" />
            </label>
          </div>

          <fieldset>
            <legend class="mb-3 text-sm font-medium">Rating *</legend>
            <div class="flex flex-wrap gap-2">
              {[1,2,3,4,5].map((rating) => (
                <label class="cursor-pointer">
                  <input class="peer sr-only" type="radio" name="rating" value={rating} required />
                  <span class="peer-checked:bg-active grid size-10 place-items-center rounded-lg border">{rating}</span>
                </label>
              ))}
            </div>
          </fieldset>

          <label class="block space-y-2 text-sm font-medium">
            <span>Recenzia ta *</span>
            <textarea id="review-text" required maxlength="2000" rows="6" class="bg-level-0 w-full rounded-lg border px-3 py-2.5"></textarea>
          </label>

          <input type="hidden" name="message" id="review-message" />

          <label class="flex items-start gap-3 text-sm">
            <input class="mt-1" type="checkbox" name="consent" value="yes" required />
            <span class="text-muted-foreground">Sunt de acord ca feedback-ul și datele furnizate să fie procesate pentru verificarea și publicarea recenziei, conform <a class="underline" href="/privacy">politicii de confidențialitate</a>.</span>
          </label>

          <div
            data-turnstile-container
            data-sitekey={turnstileSiteKey}
            aria-label="Verificare de securitate"
          ></div>
          <div id="review-status" class="hidden rounded-lg border px-4 py-3 text-sm" role="status" aria-live="polite"></div>
          <button id="review-submit" type="submit" class="bg-primary text-primary-foreground rounded-lg px-5 py-3 text-sm font-medium disabled:opacity-50">Trimite recenzia</button>
        </form>
      </div>
    </section>
  </main>
</Layout>

<script>
  import { AnimatedHero } from "../lib/elements/hero";
  import { customElementDefine } from "../lib/dom";
  import { browserT, getBrowserLocale } from "../lib/browser-i18n";
  import {
    ensureTurnstileToken,
    lazyRenderTurnstile,
    resetTurnstile,
  } from "../lib/turnstile";

  customElementDefine("animated-hero", () => AnimatedHero);

  function setupReviewForm() {
    const form = document.querySelector<HTMLFormElement>("#review-form");
    const status = document.querySelector<HTMLElement>("#review-status");
    const submit = document.querySelector<HTMLButtonElement>("#review-submit");
    const text = document.querySelector<HTMLTextAreaElement>("#review-text");
    const message = document.querySelector<HTMLInputElement>("#review-message");
    const turnstile = form?.querySelector<HTMLElement>("[data-turnstile-container]");
    if (!form || !status || !submit || !text || !message || form.dataset.ready === "true") return;
    form.dataset.ready = "true";

    const cleanupTurnstile = lazyRenderTurnstile(turnstile);
    document.addEventListener("astro:before-swap", cleanupTurnstile, { once: true });

    form.addEventListener("submit", async (event) => {
      event.preventDefault();
      const rating = form.querySelector<HTMLInputElement>('input[name="rating"]:checked')?.value;
      if (!rating) return;
      message.value = `[CUSTOMER REVIEW ${rating}/5]\n\n${text.value}`;
      submit.disabled = true;
      status.classList.add("hidden");
      try {
        const verified = await ensureTurnstileToken(turnstile);
        if (!verified) {
          status.classList.remove("hidden");
          status.textContent = browserT(
            "Verificarea de securitate nu este încă disponibilă. Încearcă din nou.",
            "Security verification is not ready yet. Please try again.",
          );
          return;
        }

        const response = await fetch("/api/contact", {
          method: "POST",
          headers: { "Accept-Language": getBrowserLocale() },
          body: new FormData(form),
        });
        const payload = (await response.json()) as { success?: boolean; error?: string };
        status.classList.remove("hidden");
        if (!response.ok || !payload.success) {
          status.textContent = browserT(
            "Recenzia nu a putut fi trimisă.",
            "The review could not be sent.",
          );
          return;
        }
        status.textContent = browserT(
          "Mulțumim! Recenzia a fost trimisă pentru verificare.",
          "Thank you! Your review has been submitted for verification.",
        );
        form.reset();
      } catch {
        status.classList.remove("hidden");
        status.textContent = browserT(
          "A apărut o eroare de rețea. Încearcă din nou.",
          "A network error occurred. Please try again.",
        );
      } finally {
        resetTurnstile(turnstile);
        submit.disabled = false;
      }
    });
  }
  setupReviewForm();
  document.addEventListener("astro:page-load", setupReviewForm);
</script>
