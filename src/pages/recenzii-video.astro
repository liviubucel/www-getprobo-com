---
import { getCollection } from "astro:content";
import Layout from "../layouts/Layout.astro";
import WallCard from "../components/WallCard.astro";

const turnstileSiteKey = "0x4AAAAAABBpDfopxKwUIKF_";

const reviews = (await getCollection("wall"))
  .filter((post) => post.id.startsWith("zebrabyte-"))
  .sort((a, b) => {
    const featuredDiff = Number(Boolean(b.data.featured)) - Number(Boolean(a.data.featured));
    if (featuredDiff !== 0) return featuredDiff;
    return (a.data.order ?? 999) - (b.data.order ?? 999);
  });
---

<Layout
  title="Recenzii clienți ZebraByte"
  description="Feedback și recenzii ZebraByte, împreună cu un formular securizat pentru clienții care vor să trimită o recenzie."
>
  <main>
    <section class="container pb-12 pt-24 sm:pb-20 sm:pt-32">
      <div class="grid gap-10 border-b pb-12 lg:grid-cols-[0.72fr_1.28fr] lg:items-end lg:gap-20 sm:pb-16">
        <div>
          <p class="text-muted-foreground mb-4 text-sm font-medium uppercase tracking-[0.12em]">Customer reviews</p>
          <h1 class="text-h2 sm:text-h1 font-medium text-balance">Feedback de la clienți ZebraByte.</h1>
        </div>
        <div>
          <p class="text-muted-foreground max-w-2xl text-lg leading-relaxed">
            Păstrăm feedback-ul ZebraByte împreună cu sursa lui și separăm recenziile clienților
            de materialele editoriale sau reference insights. Dacă ai lucrat cu noi, poți trimite
            feedback prin formularul securizat de mai jos.
          </p>
          <div class="text-muted-foreground mt-6 flex flex-wrap gap-x-7 gap-y-2 font-mono text-xs">
            <span>{reviews.length} review-uri ZebraByte</span>
            <span>surse păstrate</span>
            <span>feedback moderat înainte de publicare</span>
          </div>
        </div>
      </div>
    </section>

    <section class="container pb-12 sm:pb-24">
      <div class="grid gap-12 lg:grid-cols-[1.15fr_0.85fr] lg:items-start lg:gap-16">
        <div>
          <div class="mb-8 flex items-end justify-between gap-6 border-b pb-5">
            <div>
              <p class="text-muted-foreground mb-2 text-sm font-medium uppercase tracking-wide">Published feedback</p>
              <h2 class="text-h3 font-medium">Recenzii ZebraByte</h2>
            </div>
            <span class="text-muted-foreground hidden font-mono text-xs sm:block">CUSTOMER / SOURCE</span>
          </div>

          <div class="columns-1 gap-5 md:columns-2">
            {reviews.map((post) => <WallCard post={post} />)}
          </div>
        </div>

        <aside class="lg:sticky lg:top-24">
          <section class="border p-6 sm:p-8">
            <div class="mb-8 border-b pb-6">
              <p class="text-muted-foreground mb-2 font-mono text-xs">REVIEW / SUBMISSION</p>
              <h2 class="text-h3 mb-3 font-medium">Lasă o recenzie</h2>
              <p class="text-muted-foreground text-sm leading-relaxed">
                Feedback-ul este verificat înainte de publicare. Formularul folosește Turnstile
                și endpoint-ul securizat ZebraByte.
              </p>
            </div>

            <form id="review-form" class="space-y-5">
              <input type="hidden" name="service" value="Altceva" />
              <input type="hidden" name="company" value="Customer review" />
              <input type="hidden" name="phone" value="" />

              <label class="block space-y-2 text-sm font-medium">
                <span>Nume *</span>
                <input name="name" required maxlength="100" autocomplete="name" class="bg-level-0 w-full border px-3 py-2.5" />
              </label>

              <label class="block space-y-2 text-sm font-medium">
                <span>Email *</span>
                <input name="email" type="email" required maxlength="254" autocomplete="email" class="bg-level-0 w-full border px-3 py-2.5" />
              </label>

              <fieldset>
                <legend class="mb-3 text-sm font-medium">Rating *</legend>
                <div class="grid grid-cols-5 border">
                  {[1, 2, 3, 4, 5].map((rating) => (
                    <label class="cursor-pointer border-r last:border-r-0">
                      <input class="peer sr-only" type="radio" name="rating" value={rating} required />
                      <span class="peer-checked:bg-level-3 peer-checked:text-invert grid h-11 place-items-center text-sm transition-colors">{rating}</span>
                    </label>
                  ))}
                </div>
              </fieldset>

              <label class="block space-y-2 text-sm font-medium">
                <span>Recenzia ta *</span>
                <textarea id="review-text" required maxlength="2000" rows="6" class="bg-level-0 w-full border px-3 py-2.5"></textarea>
              </label>

              <input type="hidden" name="message" id="review-message" />

              <label class="flex items-start gap-3 border-y py-4 text-sm">
                <input class="mt-1" type="checkbox" name="consent" value="yes" required />
                <span class="text-muted-foreground leading-relaxed">
                  Sunt de acord ca feedback-ul și datele furnizate să fie procesate pentru
                  verificarea și publicarea recenziei, conform <a class="underline underline-offset-4" href="/privacy">politicii de confidențialitate</a>.
                </span>
              </label>

              <div
                data-turnstile-container
                data-sitekey={turnstileSiteKey}
                role="group"
                aria-label="Verificare de securitate"
              ></div>

              <div id="review-status" class="hidden border px-4 py-3 text-sm" role="status" aria-live="polite"></div>

              <button id="review-submit" type="submit" class="bg-primary text-primary-foreground w-full px-5 py-3 text-sm font-medium disabled:opacity-50">
                Trimite recenzia
              </button>
            </form>
          </section>
        </aside>
      </div>
    </section>

    <section class="bg-active py-12 sm:py-20">
      <div class="container grid gap-10 lg:grid-cols-[0.62fr_1.38fr] lg:gap-20">
        <div>
          <p class="text-muted-foreground mb-3 text-sm font-medium uppercase tracking-wide">More context</p>
          <h2 class="text-h3 sm:text-h2 mb-5 font-medium">Recenzii, reference insights și stories au roluri diferite.</h2>
          <p class="text-muted-foreground text-lg leading-relaxed">
            Pe această pagină afișăm feedback atribuit clienților ZebraByte. Biblioteca extinsă
            păstrează separat și materialele de referință ale platformei, iar Stories oferă
            context editorial și studii de caz.
          </p>
        </div>

        <div class="border-y">
          <a href="/love-from-customer" class="group grid gap-3 border-b py-6 sm:grid-cols-[0.7fr_1.3fr_auto] sm:items-center sm:gap-8">
            <h3 class="text-h5 font-medium group-hover:underline group-hover:underline-offset-4">Feedback & Reference Insights</h3>
            <p class="text-muted-foreground leading-relaxed">Biblioteca completă de feedback și material editorial de referință, cu provenance separat.</p>
            <span class="text-muted-foreground hidden transition-transform group-hover:translate-x-1 sm:block">→</span>
          </a>
          <a href="/stories" class="group grid gap-3 py-6 sm:grid-cols-[0.7fr_1.3fr_auto] sm:items-center sm:gap-8">
            <h3 class="text-h5 font-medium group-hover:underline group-hover:underline-offset-4">Stories</h3>
            <p class="text-muted-foreground leading-relaxed">Studii de caz și materiale editoriale despre probleme, procese și rezultate.</p>
            <span class="text-muted-foreground hidden transition-transform group-hover:translate-x-1 sm:block">→</span>
          </a>
        </div>
      </div>
    </section>
  </main>
</Layout>

<script>
  import { browserT, getBrowserLocale } from "../lib/browser-i18n";
  import {
    ensureTurnstileToken,
    lazyRenderTurnstile,
    resetTurnstile,
  } from "../lib/turnstile";

  function setupReviewForm() {
    const form = document.querySelector<HTMLFormElement>("#review-form");
    const status = document.querySelector<HTMLElement>("#review-status");
    const submit = document.querySelector<HTMLButtonElement>("#review-submit");
    const text = document.querySelector<HTMLTextAreaElement>("#review-text");
    const message = document.querySelector<HTMLInputElement>("#review-message");
    const turnstile = form?.querySelector<HTMLElement>("[data-turnstile-container]");
    if (!form || !status || !submit || !text || !message || form.dataset.ready === "true") return;
    form.dataset.ready = "true";

    const cleanupTurnstile = lazyRenderTurnstile(turnstile);
    document.addEventListener("astro:before-swap", cleanupTurnstile, { once: true });

    form.addEventListener("submit", async (event) => {
      event.preventDefault();
      const rating = form.querySelector<HTMLInputElement>('input[name="rating"]:checked')?.value;
      if (!rating) return;
      message.value = `[CUSTOMER REVIEW ${rating}/5]\n\n${text.value}`;
      submit.disabled = true;
      status.classList.add("hidden");
      try {
        const verified = await ensureTurnstileToken(turnstile);
        if (!verified) {
          status.classList.remove("hidden");
          status.textContent = browserT(
            "Verificarea de securitate nu este încă disponibilă. Încearcă din nou.",
            "Security verification is not ready yet. Please try again.",
          );
          return;
        }

        const response = await fetch("/api/contact", {
          method: "POST",
          headers: { "Accept-Language": getBrowserLocale() },
          body: new FormData(form),
        });
        const payload = (await response.json()) as { success?: boolean; error?: string };
        status.classList.remove("hidden");
        if (!response.ok || !payload.success) {
          status.textContent = browserT(
            "Recenzia nu a putut fi trimisă.",
            "The review could not be sent.",
          );
          return;
        }
        status.textContent = browserT(
          "Mulțumim! Recenzia a fost trimisă pentru verificare.",
          "Thank you! Your review has been submitted for verification.",
        );
        form.reset();
      } catch {
        status.classList.remove("hidden");
        status.textContent = browserT(
          "A apărut o eroare de rețea. Încearcă din nou.",
          "A network error occurred. Please try again.",
        );
      } finally {
        resetTurnstile(turnstile);
        submit.disabled = false;
      }
    });
  }
  setupReviewForm();
  document.addEventListener("astro:page-load", setupReviewForm);
</script>
