---
import Layout from "../layouts/Layout.astro";
import AboutImg from "../assets/about.png";
import KeyFigures from "../components/block/KeyFigures.astro";
import Team from "../components/block/Team.astro";
import Gallery from "../components/block/Gallery.astro";
import ResponsiveImage from "../components/ui/ResponsiveImage.astro";
---

<Layout
  title="About ZebraByte"
  description="Learn how ZebraByte connects managed compliance, cyber security and security-first infrastructure into one operating model."
>
  <main>
    <section class="container my-10 sm:mt-20 sm:mb-30">
      <h1 class="text-h2 animate-slide-in mb-3 font-medium">About</h1>
      <p class="text-muted-foreground animate-slide-in animation-delay-100 mb-6 sm:mb-12">
        The mission, operating model and platform experience behind ZebraByte.
      </p>

      <figure class="animate-slide-in animation-delay-200 mb-10 sm:mb-30">
        <ResponsiveImage
          src={AboutImg}
          class="aspect-square rounded-lg object-cover sm:aspect-1080/606"
          mobile={[640, 640]}
          sm={[1080, 607]}
          alt="Platform archive team photography"
          fetchpriority="high"
        />
        <figcaption class="text-muted-foreground mt-3 text-xs leading-relaxed">
          Archive photography retained as part of the platform experience. People shown in archived imagery are not presented as ZebraByte employees unless explicitly stated.
        </figcaption>
      </figure>

      <h2 class="text-muted-foreground animate-slide-in animation-delay-300 mb-1">
        Mission
      </h2>
      <p class="text-quote animate-slide-in animation-delay-400">
        We're turning compliance and security from separate, reactive projects into one operational program. Controls, evidence, privacy obligations and technical remediation should stay connected, measurable and continuously ready for review.
      </p>
    </section>

    <KeyFigures />

    <Team />

    <Gallery />
  </main>
</Layout>
