---
import Layout from "../layouts/Layout.astro";
import AboutImg from "../assets/about.png";
import KeyFigures from "../components/block/KeyFigures.astro";
import Team from "../components/block/Team.astro";
import Gallery from "../components/block/Gallery.astro";
import ResponsiveImage from "../components/ui/ResponsiveImage.astro";
---

<Layout
  title="Despre ZebraByte"
  description="ZebraByte combină securitatea cibernetică, privacy, compliance, automatizarea și infrastructura securizată într-un program continuu, construit peste experiența open-source Probo."
>
  <main>
    <section class="container my-10 sm:mt-20 sm:mb-30">
      <h1 class="text-h2 animate-slide-in mb-3 font-medium">Despre ZebraByte</h1>
      <p class="text-muted-foreground animate-slide-in animation-delay-100 mb-6 sm:mb-12">
        Securitate tehnică, conformitate și o platformă open-source pe care o păstrăm complet.
      </p>

      <ResponsiveImage
        src={AboutImg}
        class="animate-slide-in animation-delay-200 mb-4 aspect-square rounded-lg object-cover sm:mb-6 sm:aspect-1080/606"
        mobile={[640, 640]}
        sm={[1080, 607]}
        alt="Fotografie din proiectul original Probo, păstrată în experiența ZebraByte"
        fetchpriority="high"
      />
      <p class="text-muted-foreground animate-slide-in animation-delay-250 mb-10 text-sm sm:mb-30">
        Fotografie originală din proiectul upstream Probo, păstrată intenționat ca parte din istoria și experiența vizuală a platformei.
      </p>

      <h2 class="text-muted-foreground animate-slide-in animation-delay-300 mb-1">Misiune</h2>
      <p class="text-quote animate-slide-in animation-delay-400">
        Vrem să scoatem securitatea și conformitatea din zona de proiecte separate,
        rapoarte uitate și documente făcute doar pentru audit. ZebraByte păstrează
        experiența puternică a Probo și o extinde cu cybersecurity, privacy, NIS2,
        ISO 27001 readiness, infrastructură securizată și servicii gestionate.
      </p>
    </section>

    <KeyFigures />
    <Team />

    <section class="container pt-10 sm:pt-20">
      <div class="mb-8 max-w-3xl">
        <p class="text-muted-foreground mb-2 text-sm font-medium uppercase tracking-[0.14em]">Galerie originală</p>
        <h2 class="text-h3 font-medium">Păstrăm și imaginile Probo</h2>
      </div>
    </section>
    <Gallery />
  </main>
</Layout>
