---
import Layout from "../layouts/Layout.astro";
import AboutImg from "../assets/about.png";
import KeyFigures from "../components/block/KeyFigures.astro";
import ResponsiveImage from "../components/ui/ResponsiveImage.astro";

const principles = [
  {
    title: "Securitate înainte de orice",
    description:
      "Pentru ZebraByte, securitatea nu este un serviciu adăugat la final. Este fundația pe care construim infrastructura, automatizarea și activitatea de conformitate.",
  },
  {
    title: "Relații pe termen lung",
    description:
      "Preferăm să înțelegem contextul tehnic al clientului și să construim continuitate, nu să tratăm fiecare nevoie ca pe un proiect izolat.",
  },
  {
    title: "Transparență și responsabilitate",
    description:
      "Deciziile tehnice, riscurile și remedierea trebuie să poată fi explicate clar. Clientul trebuie să știe ce se întâmplă și de ce.",
  },
];
---

<Layout
  title="Despre ZebraByte | Securitate, conformitate și infrastructură"
  description="Descoperă ZebraByte, misiunea noastră și modul în care conectăm securitatea cibernetică, conformitatea și infrastructura într-o abordare coerentă."
>
  <main>
    <section class="container my-10 sm:mt-20 sm:mb-30">
      <h1 class="text-h2 animate-slide-in mb-3 font-medium">Despre ZebraByte</h1>
      <p class="text-muted-foreground animate-slide-in animation-delay-100 mb-6 sm:mb-12">
        Construim încredere prin tehnologie sigură, operată cu responsabilitate.
      </p>

      <figure class="animate-slide-in animation-delay-200 mb-10 sm:mb-30">
        <ResponsiveImage
          src={AboutImg}
          class="aspect-square rounded-lg object-cover sm:aspect-1080/606"
          mobile={[640, 640]}
          sm={[1080, 607]}
          alt="ZebraByte — securitate, conformitate și infrastructură"
          fetchpriority="high"
        />
      </figure>

      <h2 class="text-muted-foreground animate-slide-in animation-delay-300 mb-1">
        Misiune
      </h2>
      <p class="text-quote animate-slide-in animation-delay-400">
        Facem securitatea o parte firească din modul în care funcționează o organizație. Conectăm tehnologia, conformitatea și operațiunile astfel încât protecția să nu rămână un proiect separat sau o reacție după incident.
      </p>
    </section>

    <KeyFigures />

    <section class="container py-10 sm:py-20">
      <div class="mb-10 max-w-3xl sm:mb-20">
        <p class="text-muted-foreground mb-2">Principiile noastre</p>
        <h2 class="text-h3 font-medium">Cum lucrăm</h2>
      </div>

      <div class="grid gap-10 sm:grid-cols-3 sm:gap-12">
        {principles.map((principle) => (
          <article class="space-y-3">
            <h3 class="text-xl font-medium">{principle.title}</h3>
            <p class="text-muted-foreground text-lg leading-relaxed">
              {principle.description}
            </p>
          </article>
        ))}
      </div>

      <hr class="my-10 sm:my-30" />

      <div class="grid gap-8 sm:grid-cols-[1fr_2fr] sm:gap-20">
        <p class="text-muted-foreground">De ce ZebraByte</p>
        <div class="space-y-8">
          <p class="text-quote">
            Securitatea nu ar trebui să fie un lux sau o opțiune ascunsă. Trebuie să fie fundația pe care se construiesc serviciile digitale.
          </p>
          <p class="text-muted-foreground max-w-3xl text-lg leading-relaxed">
            Am pornit din zona infrastructurii și am extins aceeași responsabilitate către securitate cibernetică, conformitate și automatizare. Păstrăm însă aceeași idee de bază: înțelegem contextul real, reducem fragmentarea și construim servicii care pot fi operate și îmbunătățite în timp.
          </p>
        </div>
      </div>
    </section>
  </main>
</Layout>
