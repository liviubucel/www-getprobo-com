---
import Layout from "../layouts/Layout.astro";
import { frameworks } from "../content/frameworks.ts";
import FrameworkBadge from "../components/FrameworkBadge.svelte";
---

<Layout
  title="Brand Assets"
  description="Official ZebraByte logos, compliance badges and brand assets for presentations, media and partner materials."
>
  <main class="container max-w-[920px] py-10 sm:py-20">
    <h1 class="text-h2 animate-slide-in mb-3 font-medium">Brand Assets</h1>
    <p class="text-muted-foreground animate-slide-in animation-delay-100 mb-10 sm:mb-20">
      Official ZebraByte logos, badges, and brand resources. Use these assets when mentioning ZebraByte in presentations, partner materials or media coverage.
    </p>

    <div class="space-y-16">
      <section class="animate-slide-in animation-delay-200">
        <h2 class="mb-6 text-xl font-medium">Logo</h2>
        <div class="grid grid-cols-1 gap-4 sm:grid-cols-2 lg:grid-cols-3">
          <div>
            <div class="bg-level-1 mb-4 flex h-32 items-center justify-center rounded-lg px-8">
              <img src="/images/zbt-negru.svg" alt="ZebraByte Logo" class="h-12 max-w-[190px] w-auto object-contain" />
            </div>
            <div class="flex justify-center">
              <a href="/images/zbt-negru.svg" download="zebrabyte-logo.svg" class="bg-primary text-primary-foreground hover:bg-primary/90 inline-block rounded-md px-4 py-2 text-sm transition-colors">
                Download SVG
              </a>
            </div>
          </div>

          <div>
            <div class="bg-level-1 mb-4 flex h-32 items-center justify-center rounded-lg">
              <img src="/favicon.svg" alt="ZebraByte Logo Icon" width="64" height="64" class="size-16" />
            </div>
            <div class="flex justify-center">
              <a href="/favicon.svg" download="zebrabyte-mark.svg" class="bg-primary text-primary-foreground hover:bg-primary/90 inline-block rounded-md px-4 py-2 text-sm transition-colors">
                Download SVG
              </a>
            </div>
          </div>

          <div>
            <div class="mb-4 flex h-32 items-center justify-center rounded-lg bg-[#141E12] px-8">
              <img src="/images/zbt-negru.svg" alt="ZebraByte Logo white preview" class="h-12 max-w-[190px] w-auto object-contain brightness-0 invert" />
            </div>
            <div class="flex justify-center">
              <a href="/images/zbt-negru.svg" download="zebrabyte-logo.svg" class="bg-primary text-primary-foreground hover:bg-primary/90 inline-block rounded-md px-4 py-2 text-sm transition-colors">
                Download SVG
              </a>
            </div>
          </div>
        </div>
      </section>

      <section class="animate-slide-in animation-delay-300">
        <h2 class="mb-6 text-xl font-medium">Compliance Badges</h2>
        <p class="text-muted-foreground mb-6 text-sm">
          Framework badges used across the ZebraByte compliance experience for ISO 27001, SOC 2, GDPR, HIPAA and other supported frameworks. A badge identifies a framework; it does not represent a ZebraByte certification claim.
        </p>
        <div class="grid grid-cols-2 gap-6 sm:grid-cols-3 md:grid-cols-4">
          {frameworks.map((framework) => (
            <div>
              <div class="bg-level-1 mb-4 flex h-40 flex-col items-center justify-center rounded-lg p-6">
                <FrameworkBadge name={framework.badge} class="mb-3 block size-16 mix-blend-multiply" client:visible />
                <div class="text-center text-sm">{framework.label}</div>
              </div>
              <div class="flex flex-wrap justify-center gap-2">
                <a href={`/frameworks/${framework.badge}.svg`} download class="bg-primary text-primary-foreground hover:bg-primary/90 inline-block rounded-md px-3 py-1.5 text-xs transition-colors">SVG</a>
                <a href={`/frameworks/${framework.badge}.json`} download class="bg-level-1 text-foreground border-border hover:bg-level-2 inline-block rounded-md border px-3 py-1.5 text-xs transition-colors">JSON</a>
              </div>
            </div>
          ))}
        </div>
      </section>
    </div>
  </main>
</Layout>
