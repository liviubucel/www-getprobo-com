---
import Layout from "../layouts/Layout.astro";
import ZebraByteLogo from "../components/ZebraByteLogo.astro";
import { frameworks } from "../content/frameworks.ts";
import FrameworkBadge from "../components/FrameworkBadge.svelte";
---

<Layout
  title="Brand Assets"
  description="Resurse vizuale ZebraByte și badge-uri pentru framework-urile de securitate și conformitate suportate de platformă."
>
  <main class="container max-w-[920px] py-10 sm:py-20">
    <h1 class="text-h2 animate-slide-in mb-3 font-medium">Brand Assets</h1>
    <p
      class="text-muted-foreground animate-slide-in animation-delay-100 mb-10 sm:mb-20"
    >
      Identitatea ZebraByte și resursele vizuale folosite în prezentări,
      integrări și materiale de parteneriat. Păstrăm această zonă din experiența
      Probo, dar numai cu active care aparțin ZebraByte.
    </p>

    <div class="space-y-16">
      <section class="animate-slide-in animation-delay-200">
        <h2 class="mb-6 text-xl font-medium">Logo & mark</h2>
        <div class="grid grid-cols-1 gap-4 sm:grid-cols-2">
          <div>
            <div
              class="bg-level-1 mb-4 flex h-32 items-center justify-center rounded-lg"
            >
              <ZebraByteLogo />
            </div>
            <p class="text-muted-foreground text-center text-sm">
              Wordmark-ul folosit în interfața curentă.
            </p>
          </div>

          <div>
            <div
              class="bg-level-1 mb-4 flex h-32 items-center justify-center rounded-lg"
            >
              <img
                src="/favicon.svg"
                alt="ZebraByte brand mark"
                width="64"
                height="64"
                class="size-16"
              />
            </div>
            <div class="flex justify-center">
              <a
                href="/favicon.svg"
                download="zebrabyte-mark.svg"
                class="bg-primary text-primary-foreground hover:bg-primary/90 inline-block rounded-md px-4 py-2 text-sm transition-colors"
              >
                Download SVG
              </a>
            </div>
          </div>
        </div>

        <p class="text-muted-foreground mt-6 text-sm leading-relaxed">
          Nu publicăm încă un fișier nou drept „logo oficial complet” dacă nu este
          exact asset-ul aprobat ZebraByte. Brand mark-ul de mai sus este copiat din
          site-ul ZebraByte actual; lockup-urile suplimentare pot fi adăugate aici
          fără schimbarea structurii paginii.
        </p>
      </section>

      <section class="animate-slide-in animation-delay-300">
        <h2 class="mb-6 text-xl font-medium">Security & compliance badges</h2>
        <p class="text-muted-foreground mb-6 text-sm">
          Biblioteca originală de framework badges rămâne parte din platformă.
          Badge-urile descriu standarde și framework-uri suportate; nu reprezintă,
          prin simpla afișare, certificări deținute de ZebraByte.
        </p>
        <div class="grid grid-cols-2 gap-6 sm:grid-cols-3 md:grid-cols-4">
          {
            frameworks.map((framework) => (
              <div>
                <div class="bg-level-1 mb-4 flex h-40 flex-col items-center justify-center rounded-lg p-6">
                  <FrameworkBadge
                    name={framework.badge}
                    class="mb-3 block size-16 mix-blend-multiply"
                    client:visible
                  />
                  <div class="text-center text-sm">{framework.label}</div>
                </div>
                <div class="flex flex-wrap justify-center gap-2">
                  <a
                    href={`/frameworks/${framework.badge}.svg`}
                    download
                    class="bg-primary text-primary-foreground hover:bg-primary/90 inline-block rounded-md px-3 py-1.5 text-xs transition-colors"
                  >
                    SVG
                  </a>
                  <a
                    href={`/frameworks/${framework.badge}.json`}
                    download
                    class="bg-level-1 text-foreground border-border hover:bg-level-2 inline-block rounded-md border px-3 py-1.5 text-xs transition-colors"
                  >
                    JSON
                  </a>
                </div>
              </div>
            ))
          }
        </div>
      </section>
    </div>
  </main>
</Layout>
