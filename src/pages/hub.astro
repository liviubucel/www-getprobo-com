---
import { getCollection } from "astro:content";
import Layout from "../layouts/Layout.astro";
import FrameworkBadge from "../components/FrameworkBadge.svelte";

const frameworks = [
  {
    id: "soc2",
    title: "SOC 2",
    description:
      "Ghid despre SOC 2: trust service criteria, Type 1 vs Type 2, pregătirea controalelor și procesul de audit.",
    features: ["Cum funcționează SOC 2", "Controale și dovezi", "Type 1 vs Type 2"],
    href: "/hub/soc2",
    accentColor: "from-emerald-400 to-teal-500",
    badges: ["SOC2_TYPE1", "SOC2_TYPE2"],
  },
  {
    id: "iso27001",
    title: "ISO 27001",
    description:
      "Ghid practic despre ISMS, risk management, Annex A, audit readiness și drumul către certificarea ISO 27001.",
    features: ["ISMS și risk management", "Annex A și controale", "Audit readiness"],
    href: "/hub/iso27001",
    accentColor: "from-blue-400 to-indigo-500",
    badges: ["ISO27001"],
  },
  {
    id: "nis2",
    title: "NIS2",
    description:
      "Resurse despre cerințele NIS2, măsurile tehnice și organizaționale, supply-chain risk și incident reporting.",
    features: ["Scope și governance", "Article 21", "Incident reporting"],
    href: "/hub/nis2-compliance",
    accentColor: "from-purple-400 to-violet-500",
    badges: ["NIS2"],
  },
];

const tools = [
  {
    id: "compliance-recommender",
    title: "Compliance Framework Recommender",
    description:
      "Instrument gratuit pentru a identifica framework-urile care pot fi relevante în funcție de industrie, tipul de business și clienții țintă.",
    href: "/hub/compliance-recommender",
    accentColor: "from-yellow-400 to-lime-500",
    tag: "Free Tool",
  },
];

const zebraByteResources = [
  {
    title: "Cyber Security",
    description: "Assessment, hardening, vulnerability management, continuous security și incident support.",
    href: "/cyber-security",
    tag: "ZebraByte",
  },
  {
    title: "Compliance Portal",
    description: "Trust Center, documente controlate, NDA, access workflows și informații conectate la programul GRC.",
    href: "/compliance-portal",
    tag: "Platform",
  },
  {
    title: "Secure Managed Hosting",
    description: "Infrastructură administrată ca parte din programul de securitate, nu ca produs generic de hosting.",
    href: "/secure-hosting",
    tag: "Infrastructure",
  },
  {
    title: "Accesibilitate digitală",
    description: "WCAG assessment, remediation guidance și tooling complementar pentru experiențe digitale incluzive.",
    href: "/accessibility",
    tag: "Accessibility",
  },
];

const legacyArticles = [
  {
    id: "probo-vs-fractional-ciso",
    title: "Probo vs Hiring a Fractional CISO",
    description:
      "Materialul original compară rolul unui fractional CISO cu modelul de compliance execution oferit de Probo.",
    href: "/hub/probo-vs-fractional-ciso",
    accentColor: "from-slate-400 to-emerald-500",
    tag: "Upstream comparison",
  },
  {
    id: "iso-27001-after-soc-2-the-30-percent-shortcut",
    title: "ISO 27001 for Companies That Already Have SOC 2: The 30% Shortcut",
    description:
      "Material upstream despre reutilizarea controalelor și dovezilor SOC 2 într-un program ISO 27001.",
    href: "/hub/iso-27001-after-soc-2-the-30-percent-shortcut",
    accentColor: "from-blue-400 to-emerald-500",
    tag: "Upstream guide",
  },
  {
    id: "which-compliance-framework",
    title: "Which Compliance Framework Do You Need?",
    description:
      "Ghid upstream pentru diferențele dintre SOC 2, GDPR, HIPAA, PCI DSS și alte cerințe uzuale.",
    href: "/hub/which-compliance-framework",
    accentColor: "from-yellow-400 to-amber-500",
    tag: "Upstream guide",
  },
  {
    id: "probo-vs-vanta",
    title: "Probo vs Vanta: Full-Service Compliance vs DIY Tools",
    description:
      "Comparația comercială originală Probo vs Vanta, păstrată cu atribuirea upstream și fără a fi rebotezată drept comparație ZebraByte.",
    href: "/hub/probo-vs-vanta",
    accentColor: "from-emerald-400 to-teal-500",
    tag: "Upstream comparison",
  },
  {
    id: "vanta-alternatives-2026",
    title: "Vanta Alternatives in 2026: 7 Platforms Compared Honestly",
    description:
      "Comparație upstream între platforme de compliance automation. Afirmațiile despre Probo din articol aparțin materialului original.",
    href: "/hub/vanta-alternatives-2026",
    accentColor: "from-teal-400 to-cyan-500",
    tag: "Upstream comparison",
  },
  {
    id: "nis2-tech-teams",
    title: "NIS2 for Tech Teams: What Actually Changes in 2026",
    description:
      "Ghid practic upstream pentru CTO și echipe tehnice privind măsurile NIS2 și incident response.",
    href: "/hub/nis2-tech-teams",
    accentColor: "from-purple-400 to-violet-500",
    tag: "Upstream guide",
  },
  {
    id: "nis2-compliance-checklist-tech-companies-2026",
    title: "NIS2 Compliance Checklist for Tech Companies (2026 Edition)",
    description:
      "Checklist upstream despre governance, technical controls, supply chain și notificarea incidentelor.",
    href: "/hub/nis2-compliance-checklist-tech-companies-2026",
    accentColor: "from-purple-400 to-fuchsia-500",
    tag: "Upstream checklist",
  },
  {
    id: "ai-coding-tools-soc2-compliance",
    title: "Using AI Coding Tools While Staying SOC 2 Compliant",
    description:
      "Material upstream despre utilizarea instrumentelor AI de coding în contexte SOC 2.",
    href: "/hub/ai-coding-tools-soc2-compliance",
    accentColor: "from-indigo-400 to-purple-500",
    tag: "Upstream guide",
  },
  {
    id: "top-compliance-automation-tools-2026",
    title: "Top 5 Compliance Automation Tools in 2026",
    description:
      "Comparație upstream care include evaluări comerciale despre Probo; este păstrată ca material original, nu ca ranking ZebraByte.",
    href: "/hub/top-compliance-automation-tools-2026",
    accentColor: "from-lime-400 to-green-500",
    tag: "Upstream comparison",
  },
  {
    id: "soc2-type1-vs-type2",
    title: "SOC 2 Type 1 vs Type 2: Which Certification Do You Need?",
    description:
      "Ghid upstream privind diferențele între rapoartele SOC 2 Type 1 și Type 2.",
    href: "/hub/soc2-type1-vs-type2",
    accentColor: "from-emerald-400 to-teal-500",
    tag: "Upstream guide",
  },
  {
    id: "evaluate-soc2-report-quality",
    title: "How to Evaluate SOC 2 Report Quality",
    description:
      "Ghid upstream pentru verificarea calității unui raport SOC 2 și a procedurilor de audit.",
    href: "/hub/evaluate-soc2-report-quality",
    accentColor: "from-emerald-400 to-teal-500",
    tag: "Upstream guide",
  },
  {
    id: "iso27001-certification-cost",
    title: "ISO 27001 Certification Cost",
    description:
      "Material upstream despre factorii care influențează costul unui program și audit ISO 27001.",
    href: "/hub/iso27001-certification-cost",
    accentColor: "from-blue-400 to-indigo-500",
    tag: "Upstream guide",
  },
  {
    id: "what-is-compliance-software",
    title: "What Is Compliance Software?",
    description:
      "Material upstream despre GRC/compliance software; afirmațiile comerciale referitoare la Probo rămân atribuite proiectului original.",
    href: "/hub/what-is-compliance-software",
    accentColor: "from-emerald-400 to-cyan-500",
    tag: "Upstream guide",
  },
  {
    id: "top-grc-tools-2026",
    title: "Top 5 GRC Tools in 2026",
    description:
      "Comparație upstream între Probo, Vanta, Drata, Hyperproof și OneTrust.",
    href: "/hub/top-grc-tools-2026",
    accentColor: "from-violet-400 to-purple-500",
    tag: "Upstream comparison",
  },
  {
    id: "third-party-risk-management",
    title: "What Is Third-Party Risk Management (TPRM)?",
    description:
      "Ghid upstream despre vendor risk, suppliers, subprocessors și lifecycle-ul third-party risk management.",
    href: "/hub/third-party-risk-management",
    accentColor: "from-amber-400 to-orange-500",
    tag: "Upstream guide",
  },
  {
    id: "cloud-security-best-practices",
    title: "Cloud Security Best Practices for Audit-Ready Teams",
    description:
      "Ghid upstream despre cloud misconfiguration, credential risk și audit-ready evidence.",
    href: "/hub/cloud-security-best-practices",
    accentColor: "from-sky-400 to-blue-500",
    tag: "Upstream guide",
  },
  {
    id: "top-compliance-officer-services-2026",
    title: "Top 5 Compliance Officer Services in 2026",
    description:
      "Comparație upstream între modele de compliance officer service, păstrată cu atribuirea editorială originală.",
    href: "/hub/top-compliance-officer-services-2026",
    accentColor: "from-teal-400 to-green-500",
    tag: "Upstream comparison",
  },
];

const collectionArticles = (await getCollection("hub", ({ data }) => !data.draft))
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())
  .map((entry) => ({
    id: entry.id,
    title: entry.data.title,
    description: entry.data.description,
    href: `/hub/${entry.id}`,
    accentColor: entry.data.accentColor,
    tag: `Upstream · ${entry.data.tag}`,
  }));

const upstreamArticles = [...collectionArticles, ...legacyArticles];
---

<Layout
  title="Security & Compliance Hub"
  description="Hub ZebraByte cu ghiduri despre SOC 2, ISO 27001, NIS2, cyber security, privacy și GRC, plus biblioteca editorială upstream Probo păstrată separat."
>
  <main class="container my-10 sm:my-20">
    <div class="mb-10 text-center sm:mb-16">
      <div class="border-border-low bg-level-0 text-muted-foreground animate-slide-in mb-6 inline-flex items-center gap-2 rounded-full border px-4 py-2 text-xs">
        Security · Privacy · Compliance
      </div>
      <h1 class="text-h2 sm:text-h1 animate-slide-in animation-delay-100 mb-6 font-medium">
        ZebraByte Hub
      </h1>
      <p class="text-muted-foreground animate-slide-in animation-delay-200 mx-auto max-w-170 text-lg font-medium sm:text-xl">
        Ghiduri, instrumente și explicații practice pentru echipe care vor să lege
        securitatea tehnică de privacy și compliance.
      </p>
    </div>

    <section class="animate-slide-in animation-delay-250 mb-12 sm:mb-20">
      <div class="mb-8">
        <h2 class="text-h3 mb-3 font-medium">ZebraByte</h2>
        <p class="text-muted-foreground text-lg">
          Punctele de intrare pentru serviciile și platforma pe care le construim în jurul programului de securitate și conformitate.
        </p>
      </div>
      <div class="grid gap-4 sm:grid-cols-2">
        {zebraByteResources.map((resource) => (
          <a href={resource.href} class="group rounded-2xl border p-6 transition-shadow hover:shadow-lg sm:p-8">
            <span class="bg-highlight mb-4 inline-block rounded-full px-3 py-1 text-xs font-medium">{resource.tag}</span>
            <h3 class="text-h4 mb-3 font-medium group-hover:underline">{resource.title}</h3>
            <p class="text-muted-foreground leading-relaxed">{resource.description}</p>
          </a>
        ))}
      </div>
    </section>

    <section class="animate-slide-in animation-delay-300">
      <div class="mb-10">
        <h2 class="text-h3 sm:text-[40px] sm:leading-[54px] mb-3 font-medium tracking-[-0.8px]">
          Ghiduri principale
        </h2>
        <p class="text-muted-foreground text-lg">
          Framework-uri și obligații întâlnite frecvent în programele de securitate și compliance.
        </p>
      </div>

      <div class="grid grid-cols-1 gap-6 sm:grid-cols-2 sm:gap-8">
        {frameworks.map((framework) => (
          <article class="group relative overflow-hidden rounded-3xl border border-gray-200 bg-white shadow-xl transition-all duration-300 hover:border-gray-300 hover:shadow-2xl">
            <div class={`absolute top-0 right-0 h-64 w-64 bg-gradient-to-br ${framework.accentColor} opacity-10 blur-3xl transition-opacity group-hover:opacity-20`} />
            <div class="relative p-6 sm:p-8">
              <h3 class="mb-4 text-[28px] leading-[1.15] font-bold tracking-[-0.5px] text-gray-900 sm:text-[32px]">{framework.title}</h3>
              <p class="mb-8 leading-relaxed text-gray-600">{framework.description}</p>
              <ul class="mb-8 space-y-3">
                {framework.features.map((feature) => (
                  <li class="flex items-start gap-3 text-gray-700">
                    <span class="mt-2 size-2 shrink-0 rounded-full bg-emerald-500"></span>
                    <span>{feature}</span>
                  </li>
                ))}
              </ul>
              <div class="flex items-center justify-between gap-4 border-t border-gray-200 pt-6">
                <a href={framework.href} class="inline-flex items-center gap-2 rounded-full bg-gray-900 px-6 py-3 font-medium text-white transition-all hover:bg-gray-800">
                  Deschide ghidul →
                </a>
                <div class="flex gap-2">
                  {framework.badges.map((badge) => (
                    <div class="flex size-12 items-center justify-center overflow-hidden rounded-full border-2 border-gray-200 bg-gray-100">
                      <FrameworkBadge name={badge} class="size-8" client:visible />
                    </div>
                  ))}
                </div>
              </div>
            </div>
          </article>
        ))}
      </div>
    </section>

    <section class="animate-slide-in animation-delay-325 mt-10 sm:mt-16">
      <div class="mb-10">
        <h2 class="text-h3 sm:text-[40px] sm:leading-[54px] mb-3 font-medium tracking-[-0.8px]">Instrumente</h2>
        <p class="text-muted-foreground text-lg">Instrumente gratuite care ajută la orientarea inițială în zona de compliance.</p>
      </div>
      <div class="grid grid-cols-1 gap-6">
        {tools.map((tool) => (
          <a href={tool.href} class="group relative block overflow-hidden rounded-3xl border border-gray-200 bg-white shadow-xl transition-all duration-300 hover:border-gray-300 hover:shadow-2xl">
            <div class={`absolute top-0 right-0 h-64 w-64 bg-gradient-to-br ${tool.accentColor} opacity-10 blur-3xl transition-opacity group-hover:opacity-20`} />
            <div class="relative p-6 sm:p-8">
              <span class="mb-4 inline-block rounded-full bg-[#f0f7e4] px-3 py-1 text-xs font-medium text-[#5d770d]">{tool.tag}</span>
              <h3 class="mb-3 text-[24px] leading-[1.15] font-bold tracking-[-0.5px] text-gray-900 transition-colors group-hover:text-[#5d770d] sm:text-[28px]">{tool.title}</h3>
              <p class="text-gray-600">{tool.description}</p>
            </div>
          </a>
        ))}
      </div>
    </section>

    <section class="animate-slide-in animation-delay-350 mt-10 sm:mt-16">
      <div class="mb-8 max-w-190">
        <p class="text-muted-foreground mb-2 text-sm font-medium uppercase tracking-[0.12em]">Upstream Probo library</p>
        <h2 class="text-h3 sm:text-[40px] sm:leading-[54px] mb-3 font-medium tracking-[-0.8px]">Articole & comparații originale</h2>
        <p class="text-muted-foreground text-lg leading-relaxed">
          Păstrăm biblioteca editorială Probo pentru valoarea ei tehnică și educațională.
          Materialele de mai jos au fost create pentru produsul Probo; rankings, comparațiile
          și afirmațiile comerciale din ele nu sunt prezentate ca afirmații ZebraByte.
          Le rescriem individual doar atunci când ZebraByte poate susține factual aceleași capabilități.
        </p>
      </div>

      <div class="grid grid-cols-1 gap-6">
        {upstreamArticles.map((article) => (
          <a href={article.href} class="group relative block overflow-hidden rounded-3xl border border-gray-200 bg-white shadow-lg transition-all duration-300 hover:border-gray-300 hover:shadow-xl">
            <div class={`absolute top-0 right-0 h-64 w-64 bg-gradient-to-br ${article.accentColor} opacity-10 blur-3xl`} />
            <div class="relative p-6 sm:p-8">
              <span class="mb-4 inline-block rounded-full bg-[#f0f7e4] px-3 py-1 text-xs font-medium text-[#5d770d]">{article.tag}</span>
              <h3 class="mb-3 text-[23px] leading-[1.2] font-bold tracking-[-0.4px] text-gray-900 group-hover:underline sm:text-[27px]">{article.title}</h3>
              <p class="text-gray-600 leading-relaxed">{article.description}</p>
            </div>
          </a>
        ))}
      </div>
    </section>

    <section class="animate-slide-in animation-delay-400 mt-10 sm:mt-16">
      <div class="rounded-3xl bg-gradient-to-br from-[#e4f7c7] to-[#d0e8b3] p-8 text-center sm:p-12">
        <div class="mx-auto max-w-180">
          <h3 class="text-h4 sm:text-[32px] sm:leading-[42px] mb-3 font-medium tracking-[-0.8px] text-[#141e12]">Hub-ul ZebraByte continuă să crească</h3>
          <p class="text-muted-foreground text-lg">
            Următoarele ghiduri vor acoperi mai profund GDPR, DORA, incident response,
            vulnerability management, accessibility și securitatea infrastructurii.
          </p>
        </div>
      </div>
    </section>
  </main>
</Layout>
