---
import Layout from "../layouts/Layout.astro";

const complianceGuides = [
  {
    title: "SOC 2",
    description: "Controls, evidence, risk management și audit readiness într-un program continuu.",
    features: ["Scope & risk", "Controls & evidence", "Audit preparation"],
    href: "/soc2",
  },
  {
    title: "ISO/IEC 27001",
    description: "ISMS, risk treatment, control ownership și pregătirea organizației pentru audit.",
    features: ["ISMS", "Risk treatment", "Audit readiness"],
    href: "/iso-27001",
  },
  {
    title: "GDPR & Privacy",
    description: "Privacy governance, evidence și măsuri tehnice conectate la procesele și infrastructura reală.",
    features: ["Privacy governance", "Technical measures", "Evidence"],
    href: "/gdpr",
  },
  {
    title: "NIS2",
    description: "Governance, risk management, incident readiness și reziliență pentru organizațiile relevante.",
    features: ["Governance", "Risk & resilience", "Incident readiness"],
    href: "/nis2",
  },
];

const securityResources = [
  {
    title: "Security Assessment",
    description: "Înțelege expunerea publică, configurațiile și vulnerabilitățile înainte de remediation.",
    href: "/security-assessment",
    tag: "Assess",
  },
  {
    title: "Website Security",
    description: "WAF, DDoS, malware, hardening și recovery pentru aplicații și website-uri expuse public.",
    href: "/website-security",
    tag: "Protect",
  },
  {
    title: "Email Security",
    description: "SPF, DKIM, DMARC, anti-spoofing și account hardening pentru reducerea riscului de phishing/BEC.",
    href: "/email-security",
    tag: "Identity",
  },
  {
    title: "Incident Response",
    description: "Triage, containment, eradication și recovery atunci când prevenția nu mai este suficientă.",
    href: "/incident-response",
    tag: "Respond",
  },
  {
    title: "Secure Managed Hosting",
    description: "Infrastructură administrată în model security-first, cu hardening, backup și change control.",
    href: "/secure-hosting",
    tag: "Infrastructure",
  },
  {
    title: "Accessibility",
    description: "Instrumente gratuite, WCAG assessment și remediation urmărite în zona de compliance.",
    href: "/accessibility",
    tag: "Free tools",
  },
];
---

<Layout
  title="Security & Compliance Hub"
  description="Centrul ZebraByte pentru managed compliance, SOC 2, ISO 27001, GDPR, NIS2, accessibility și cyber security."
>
  <main class="container my-10 sm:my-20">
    <div class="mb-10 text-center sm:mb-16">
      <div class="animate-slide-in text-muted-foreground mb-6 inline-flex items-center gap-2 rounded-full border bg-white/60 px-4 py-2 text-xs backdrop-blur-[50px]">
        Resource Center
      </div>
      <h1 class="text-h2 sm:text-h1 animate-slide-in animation-delay-100 mb-6 font-medium">Hub</h1>
      <p class="text-muted-foreground animate-slide-in animation-delay-200 mx-auto max-w-[600px] text-lg font-medium sm:text-xl">
        Ghiduri și puncte de intrare pentru compliance, security și infrastructură security-first.
      </p>
    </div>

    <section class="animate-slide-in animation-delay-300">
      <div class="mb-10">
        <h2 class="text-h3 mb-3 font-medium tracking-[-0.8px] sm:text-[40px] sm:leading-[54px]">Compliance Guides</h2>
        <p class="text-muted-foreground text-lg">Framework-urile principale gestionate în programul ZebraByte</p>
      </div>

      <div class="grid grid-cols-1 gap-6 sm:grid-cols-2 sm:gap-8">
        {complianceGuides.map((guide) => (
          <article class="group relative overflow-hidden rounded-3xl border border-gray-200 bg-white shadow-xl transition-all duration-300 hover:border-gray-300 hover:shadow-2xl">
            <div class="relative p-6 sm:p-8">
              <h3 class="mb-4 text-[28px] leading-[1.15] font-bold tracking-[-0.5px] text-gray-900 sm:text-[32px]">{guide.title}</h3>
              <p class="mb-8 leading-relaxed text-gray-600">{guide.description}</p>
              <ul class="mb-8 space-y-3">
                {guide.features.map((feature) => (
                  <li class="flex items-start gap-3">
                    <span class="mt-1.5 size-2 shrink-0 rounded-full bg-[#93c926]" />
                    <span class="text-gray-700">{feature}</span>
                  </li>
                ))}
              </ul>
              <div class="flex items-center justify-between border-t border-gray-200 pt-6">
                <a href={guide.href} class="inline-flex items-center gap-2 rounded-full bg-gray-900 px-6 py-3 font-medium text-white transition-all hover:gap-3 hover:bg-gray-800">
                  Explorează <span aria-hidden="true">→</span>
                </a>
              </div>
            </div>
          </article>
        ))}
      </div>
    </section>

    <section class="mt-20 sm:mt-28">
      <div class="mb-10">
        <h2 class="text-h3 mb-3 font-medium tracking-[-0.8px] sm:text-[40px] sm:leading-[54px]">Security Resources</h2>
        <p class="text-muted-foreground text-lg">De la assessment la protection, response și secure infrastructure</p>
      </div>

      <div class="grid grid-cols-1 gap-5 sm:grid-cols-2 lg:grid-cols-3">
        {securityResources.map((resource) => (
          <a href={resource.href} class="group rounded-2xl border bg-level-0 p-6 transition-all hover:-translate-y-1 hover:bg-subtle hover:shadow-lg sm:p-8">
            <span class="text-muted-foreground mb-8 block text-sm font-medium">{resource.tag}</span>
            <h3 class="mb-3 text-xl font-medium group-hover:underline group-hover:underline-offset-4">{resource.title}</h3>
            <p class="text-muted-foreground leading-relaxed">{resource.description}</p>
          </a>
        ))}
      </div>
    </section>

    <section class="mt-20 overflow-hidden rounded-3xl bg-active p-8 sm:mt-28 sm:p-12">
      <div class="grid gap-8 lg:grid-cols-[1fr_auto] lg:items-center">
        <div>
          <p class="text-muted-foreground mb-3 text-sm font-medium uppercase tracking-[0.12em]">Managed Compliance</p>
          <h2 class="text-h3 sm:text-h2 mb-4 font-medium">Nu ești sigur de unde să începi?</h2>
          <p class="text-muted-foreground max-w-2xl text-lg">Pornim de la risc, obligațiile aplicabile și infrastructura reală, apoi construim programul potrivit fără un catalog inutil de servicii IT.</p>
        </div>
        <a href="/contact" class="bg-primary text-primary-foreground inline-flex w-max items-center rounded-full px-6 py-3 font-medium">Discută cu un expert</a>
      </div>
    </section>
  </main>
</Layout>
