---
import { getCollection } from "astro:content";
import Layout from "../layouts/Layout.astro";
import FrameworkBadge from "../components/FrameworkBadge.svelte";

const guides = [
  {
    title: "SOC 2",
    description:
      "Ghid practic despre SOC 2: criterii de încredere, pregătirea controalelor, dovezi, diferența dintre Type 1 și Type 2 și modul în care te pregătești pentru raportare.",
    topics: ["Ce este SOC 2", "Controale și dovezi", "Type 1 vs Type 2"],
    href: "/hub/soc2",
    badges: ["SOC2_TYPE1", "SOC2_TYPE2"],
  },
  {
    title: "ISO/IEC 27001",
    description:
      "Înțelege cerințele ISO/IEC 27001, ISMS-ul, analiza riscurilor, controalele Annex A și etapele necesare pentru pregătirea unei organizații pentru certificare.",
    topics: ["ISMS și analiza riscurilor", "Annex A și controale", "Pregătirea pentru audit"],
    href: "/hub/iso27001",
    badges: ["ISO27001"],
  },
  {
    title: "NIS2",
    description:
      "Resurse pentru organizațiile care trebuie să înțeleagă NIS2: domeniul de aplicare, guvernanță, măsuri de securitate, supply-chain risk și raportarea incidentelor.",
    topics: ["Cine intră în domeniul NIS2", "Măsuri tehnice și guvernanță", "Raportarea incidentelor"],
    href: "/hub/nis2-compliance",
    badges: ["NIS2"],
  },
];

const tools = [
  {
    tag: "Instrument gratuit",
    title: "Recomandare framework de conformitate",
    description:
      "Identifică framework-urile de securitate și conformitate relevante pentru compania ta pe baza industriei, modelului de business, datelor procesate și piețelor în care operezi.",
    href: "/hub/compliance-recommender",
  },
  {
    tag: "Instrumente ZebraByte",
    title: "Instrumente gratuite pentru securitate și conformitate",
    description:
      "Accesează instrumentele publice ZebraByte pentru verificări rapide, evaluări și activități de securitate care pot susține un program de conformitate.",
    href: "/tools",
  },
];

const curatedArticles = [
  {
    tag: "Ghid",
    title: "Ce framework de conformitate are nevoie compania ta?",
    description:
      "Un ghid pentru alegerea între SOC 2, ISO 27001, GDPR, NIS2 și alte cerințe, în funcție de clienți, jurisdicție, industrie și tipurile de date procesate.",
    href: "/hub/which-compliance-framework",
  },
  {
    tag: "Checklist",
    title: "Checklist NIS2 pentru companii de tehnologie",
    description:
      "O structură practică pentru guvernanță, controale tehnice, supply-chain security, incident response și cerințele de notificare relevante NIS2.",
    href: "/hub/nis2-compliance-checklist-tech-companies-2026",
  },
  {
    tag: "Ghid",
    title: "NIS2 pentru echipe tehnice",
    description:
      "Ce se schimbă concret pentru CTO, engineering și security teams și cum se transformă cerințele de guvernanță în măsuri tehnice și dovezi verificabile.",
    href: "/hub/nis2-tech-teams",
  },
  {
    tag: "Ghid",
    title: "SOC 2 Type 1 vs Type 2",
    description:
      "Diferențele dintre cele două tipuri de raport SOC 2, perioada de evaluare, tipul de dovezi necesare și situațiile în care fiecare variantă este relevantă.",
    href: "/hub/soc2-type1-vs-type2",
  },
  {
    tag: "Ghid",
    title: "Cum evaluezi calitatea unui raport SOC 2",
    description:
      "Ce trebuie verificat într-un raport SOC 2 înainte să te bazezi pe el într-un proces de vendor risk management sau due diligence de securitate.",
    href: "/hub/evaluate-soc2-report-quality",
  },
  {
    tag: "Ghid",
    title: "Costurile certificării ISO 27001",
    description:
      "Factorii care influențează costul unui program ISO 27001: dimensiunea scope-ului, maturitatea controalelor, consultanța, auditul și mentenanța ISMS-ului.",
    href: "/hub/iso27001-certification-cost",
  },
  {
    tag: "Ghid",
    title: "Third-Party Risk Management (TPRM)",
    description:
      "Cum identifici, evaluezi și monitorizezi riscurile furnizorilor și de ce TPRM este important pentru ISO 27001, SOC 2, NIS2 și reziliența operațională.",
    href: "/hub/third-party-risk-management",
  },
  {
    tag: "Securitate",
    title: "Cloud security pentru echipe audit-ready",
    description:
      "Practici de securitate cloud pentru reducerea configurărilor greșite, a riscului de credentiale și pentru generarea dovezilor necesare în audituri.",
    href: "/hub/cloud-security-best-practices",
  },
  {
    tag: "Ghid",
    title: "AI coding tools și conformitatea SOC 2",
    description:
      "Cum poți utiliza instrumente AI de dezvoltare fără să pierzi controlul asupra codului, datelor, accesului, furnizorilor și dovezilor necesare unui program SOC 2.",
    href: "/hub/ai-coding-tools-soc2-compliance",
  },
  {
    tag: "Analiză",
    title: "Ce este software-ul de conformitate?",
    description:
      "Rolul platformelor GRC și compliance în gestionarea riscurilor, controalelor, dovezilor, politicilor, vendorilor și audit readiness.",
    href: "/hub/what-is-compliance-software",
  },
  {
    tag: "Comparație",
    title: "Instrumente GRC importante în 2026",
    description:
      "O analiză a modului în care platformele GRC abordează guvernanța, risk management, controalele, automatizarea și colaborarea cu echipele tehnice.",
    href: "/hub/top-grc-tools-2026",
  },
  {
    tag: "Comparație",
    title: "Alternative pentru platformele de compliance automation",
    description:
      "Cum compari soluțiile de compliance automation și managed compliance în funcție de cost operațional, implicarea echipei și nivelul de suport necesar.",
    href: "/hub/vanta-alternatives-2026",
  },
];

const collectionArticles = (await getCollection("hub", ({ data }) => !data.draft))
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())
  .map((entry) => ({
    tag: entry.data.tag,
    title: entry.data.title,
    description: entry.data.description,
    href: `/hub/${entry.id}`,
  }));

const articleMap = new Map<string, (typeof curatedArticles)[number]>();
for (const article of [...collectionArticles, ...curatedArticles]) {
  if (!articleMap.has(article.href)) articleMap.set(article.href, article);
}
const articles = [...articleMap.values()];

const hubSchema = {
  "@context": "https://schema.org",
  "@type": "CollectionPage",
  name: "ZebraByte Hub",
  description:
    "Ghiduri, analize și instrumente ZebraByte despre securitate cibernetică, SOC 2, ISO 27001, NIS2, privacy, risk management și compliance.",
  url: "https://www.zebrabyte.ro/hub",
  hasPart: [...guides, ...tools, ...articles].map((item) => ({
    "@type": "CreativeWork",
    name: item.title,
    url: new URL(item.href, "https://www.zebrabyte.ro").toString(),
  })),
};
---

<Layout
  title="Hub: ghiduri de securitate, SOC 2, ISO 27001, NIS2 și GRC"
  description="Hub-ul ZebraByte reunește ghiduri practice despre securitate cibernetică, SOC 2, ISO 27001, NIS2, GRC, privacy, cloud security și managementul riscurilor."
>
  <script type="application/ld+json" set:html={JSON.stringify(hubSchema)} />

  <main class="container my-10 max-w-[1040px] sm:my-20">
    <header class="mx-auto mb-16 max-w-[720px] text-center sm:mb-20">
      <p class="text-muted-foreground animate-slide-in mb-4 text-sm font-medium uppercase tracking-[0.14em]">
        Centru de resurse
      </p>
      <h1 class="text-h2 sm:text-h1 animate-slide-in animation-delay-100 mb-5 font-medium">
        Hub
      </h1>
      <p class="text-muted-foreground animate-slide-in animation-delay-200 text-lg leading-relaxed sm:text-xl">
        Ghiduri, analize și instrumente practice pentru echipe care trebuie să gestioneze securitatea,
        riscul și conformitatea fără să transforme totul într-un proiect separat.
      </p>
    </header>

    <section class="mb-18 sm:mb-24" aria-labelledby="hub-guides">
      <div class="mb-8">
        <h2 id="hub-guides" class="text-h3 mb-2 font-medium">Ghiduri de conformitate</h2>
        <p class="text-muted-foreground text-base sm:text-lg">
          Puncte de pornire pentru framework-urile și cerințele pe care le întâlnim cel mai des.
        </p>
      </div>

      <div class="grid gap-5 md:grid-cols-3">
        {guides.map((guide) => (
          <article class="border-border-mid flex h-full flex-col rounded-2xl border p-6 sm:p-7">
            <div class="mb-5 flex min-h-10 items-center gap-2">
              {guide.badges.map((badge) => (
                <FrameworkBadge name={badge} class="size-9" client:visible />
              ))}
            </div>
            <h3 class="mb-3 text-2xl font-medium">{guide.title}</h3>
            <p class="text-muted-foreground mb-6 text-sm leading-relaxed">{guide.description}</p>
            <ul class="text-muted-foreground mb-7 space-y-2 text-sm">
              {guide.topics.map((topic) => (
                <li class="flex gap-2"><span aria-hidden="true">✓</span><span>{topic}</span></li>
              ))}
            </ul>
            <a href={guide.href} class="mt-auto inline-flex items-center gap-2 text-sm font-medium hover:underline">
              Deschide ghidul <span aria-hidden="true">→</span>
            </a>
          </article>
        ))}
      </div>
    </section>

    <section class="mb-18 sm:mb-24" aria-labelledby="hub-tools">
      <div class="mb-8">
        <h2 id="hub-tools" class="text-h3 mb-2 font-medium">Instrumente</h2>
        <p class="text-muted-foreground text-base sm:text-lg">
          Instrumente care te ajută să treci de la întrebare la o decizie concretă.
        </p>
      </div>

      <div class="grid gap-4 md:grid-cols-2">
        {tools.map((tool) => (
          <a
            href={tool.href}
            class="border-border-mid hover:border-primary/30 group rounded-2xl border p-6 transition-colors sm:p-7"
          >
            <span class="bg-highlight mb-4 inline-flex rounded-full px-2.5 py-1 text-xs font-medium">{tool.tag}</span>
            <div class="flex items-start justify-between gap-5">
              <div>
                <h3 class="mb-2 text-xl font-medium group-hover:underline">{tool.title}</h3>
                <p class="text-muted-foreground text-sm leading-relaxed">{tool.description}</p>
              </div>
              <span class="text-muted-foreground text-xl" aria-hidden="true">→</span>
            </div>
          </a>
        ))}
      </div>
    </section>

    <section aria-labelledby="hub-library">
      <div class="mb-8">
        <h2 id="hub-library" class="text-h3 mb-2 font-medium">Bibliotecă de ghiduri și analize</h2>
        <p class="text-muted-foreground text-base sm:text-lg">
          Resurse aprofundate pentru decizii de securitate, conformitate, audit și risk management.
        </p>
      </div>

      <div class="border-border-mid divide-border-mid divide-y border-y">
        {articles.map((article) => (
          <a
            href={article.href}
            class="group grid gap-3 py-6 sm:grid-cols-[110px_minmax(0,1fr)_24px] sm:gap-5"
          >
            <div>
              <span class="border-border-mid text-muted-foreground inline-flex rounded-full border px-2.5 py-1 text-xs font-medium">
                {article.tag}
              </span>
            </div>
            <div>
              <h3 class="mb-1.5 text-lg font-medium group-hover:underline">{article.title}</h3>
              <p class="text-muted-foreground text-sm leading-relaxed">{article.description}</p>
            </div>
            <span class="text-muted-foreground hidden self-center text-lg sm:block" aria-hidden="true">→</span>
          </a>
        ))}
      </div>
    </section>

    <section class="mt-18 border-t pt-10 sm:mt-24 sm:pt-12">
      <div class="grid gap-5 sm:grid-cols-[1fr_auto] sm:items-center">
        <div>
          <h2 class="mb-2 text-2xl font-medium">Nu știi de unde să începi?</h2>
          <p class="text-muted-foreground max-w-[650px] leading-relaxed">
            Spune-ne ce tip de companie ai, unde operezi și ce îți cer clienții. Putem identifica împreună
            framework-urile și măsurile de securitate care au prioritate.
          </p>
        </div>
        <a
          href="/contact"
          class="bg-primary text-primary-foreground inline-flex h-11 items-center justify-center rounded-full px-5 text-sm font-medium"
        >
          Discută cu un expert
        </a>
      </div>
    </section>
  </main>
</Layout>
