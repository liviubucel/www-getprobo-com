---
import { getCollection } from "astro:content";
import Layout from "../layouts/Layout.astro";
import FrameworkBadge from "../components/FrameworkBadge.svelte";

const zebraByteResources = [
  {
    title: "Cyber Security",
    description: "Assessment, hardening, vulnerability management, monitoring și incident support.",
    href: "/cyber-security",
    tag: "Security",
  },
  {
    title: "GDPR & Privacy",
    description: "Privacy governance, technical measures, evidence și procese GDPR conectate la infrastructura reală.",
    href: "/gdpr",
    tag: "Privacy",
  },
  {
    title: "NIS2 Readiness",
    description: "Risk management, governance, security controls și incident readiness pentru NIS2.",
    href: "/nis2",
    tag: "NIS2",
  },
  {
    title: "ISO/IEC 27001 Readiness",
    description: "ISMS, risk treatment, controls, evidence și audit preparation.",
    href: "/iso-27001",
    tag: "ISMS",
  },
  {
    title: "Compliance Portal",
    description: "Documente, NDA, approvals, trust information și evidence într-o experiență controlată.",
    href: "/compliance-portal",
    tag: "Platform",
  },
  {
    title: "Secure Managed Hosting",
    description: "Infrastructură administrată, hardening, backup și operațiuni security-first.",
    href: "/secure-hosting",
    tag: "Infrastructure",
  },
];

const frameworks = [
  {
    id: "soc2",
    label: "SOC 2",
    title: "SOC 2",
    description:
      "Learn everything about SOC 2 compliance: requirements, costs, timeline, and Type 1 vs Type 2 differences. Your complete guide to achieving SOC 2 certification.",
    features: ["Understanding SOC 2", "Requirements to get compliant", "Cost and timeline"],
    href: "/hub/soc2",
    accentColor: "from-emerald-400 to-teal-500",
    badges: ["SOC2_TYPE1", "SOC2_TYPE2"],
  },
  {
    id: "iso27001",
    label: "ISO 27001",
    title: "ISO 27001",
    description:
      "Learn what ISO 27001 is, why it matters for your business, and how to achieve certification. Complete 2026 guide covering requirements, costs, and timelines.",
    features: ["Understanding ISO 27001", "Requirements to get compliant", "Cost and timeline"],
    href: "/hub/iso27001",
    accentColor: "from-blue-400 to-indigo-500",
    badges: ["ISO27001"],
  },
  {
    id: "nis2",
    label: "NIS2",
    title: "NIS2",
    description:
      "Everything you need to know about NIS2 compliance in 2026: requirements, costs, deadlines, and how to prepare your organization. Expert guide for tech teams.",
    features: ["Understanding NIS2", "Requirements and Article 21", "Cost and timeline"],
    href: "/hub/nis2-compliance",
    accentColor: "from-purple-400 to-violet-500",
    badges: ["NIS2"],
  },
];

const tools = [
  {
    id: "compliance-recommender",
    title: "Compliance Framework Recommender",
    description:
      "Find the right security and compliance frameworks for your business. Get a free personalized report based on your industry, business model, and target customers.",
    href: "/hub/compliance-recommender",
    accentColor: "from-yellow-400 to-lime-500",
    tag: "Free Tool",
  },
];

const articles = [
  {
    id: "probo-vs-fractional-ciso",
    title: "Probo vs Hiring a Fractional CISO",
    description:
      "Fractional CISO vs Probo: leadership and buyer narrative vs compliance execution. Role boundaries, sequencing, year-one TCO, and when to add each.",
    href: "/hub/probo-vs-fractional-ciso",
    accentColor: "from-slate-400 to-emerald-500",
    tag: "Comparison",
  },
  {
    id: "iso-27001-after-soc-2-the-30-percent-shortcut",
    title: "ISO 27001 for Companies That Already Have SOC 2: The 30% Shortcut",
    description:
      "You are roughly 70% of the way to ISO 27001 if SOC 2 Type 2 is done. Map Annex A overlap, the reformat layer, and the 8% net-new — plus sequencing and realistic marginal cost.",
    href: "/hub/iso-27001-after-soc-2-the-30-percent-shortcut",
    accentColor: "from-blue-400 to-emerald-500",
    tag: "Guide",
  },
  {
    id: "which-compliance-framework",
    title: "Which Compliance Framework Do You Need?",
    description:
      "Not sure if you need SOC 2, GDPR, HIPAA, or PCI DSS? Use our guide to identify the right compliance frameworks based on your business type, customers, and data.",
    href: "/hub/which-compliance-framework",
    accentColor: "from-yellow-400 to-amber-500",
    tag: "Guide",
  },
  {
    id: "probo-vs-vanta",
    title: "Probo vs Vanta: Full-Service Compliance vs DIY Tools",
    description:
      "Probo vs Vanta: One gives you a tool, the other does the work. Compare full-service compliance with hands-off experts vs DIY automation platforms.",
    href: "/hub/probo-vs-vanta",
    accentColor: "from-emerald-400 to-teal-500",
    tag: "Comparison",
  },
  {
    id: "vanta-alternatives-2026",
    title: "Vanta Alternatives in 2026: 7 Platforms Compared Honestly (Including a Free One)",
    description:
      "Honest comparison of 7 Vanta alternatives for compliance automation. Probo is the only open-source, free-tier option with a dedicated compliance officer included.",
    href: "/hub/vanta-alternatives-2026",
    accentColor: "from-teal-400 to-cyan-500",
    tag: "Comparison",
  },
  {
    id: "nis2-tech-teams",
    title: "NIS2 for Tech Teams: What Actually Changes in 2026",
    description:
      "A practical NIS2 guide for CTOs and developers. Learn the 10 security measures you must implement, incident response requirements, and automation strategies.",
    href: "/hub/nis2-tech-teams",
    accentColor: "from-purple-400 to-violet-500",
    tag: "Guide",
  },
  {
    id: "nis2-compliance-checklist-tech-companies-2026",
    title: "NIS2 Compliance Checklist for Tech Companies (2026 Edition)",
    description:
      "Practical step-by-step NIS2 checklist: governance, technical controls, supply chain, 24–72 hour notifications, registration — and what you can skip until you're in scope.",
    href: "/hub/nis2-compliance-checklist-tech-companies-2026",
    accentColor: "from-purple-400 to-fuchsia-500",
    tag: "Checklist",
  },
  {
    id: "ai-coding-tools-soc2-compliance",
    title: "Using AI Coding Tools While Staying SOC 2 Compliant",
    description:
      "Can you use Claude, Copilot, or Cursor and stay SOC 2 compliant? Here's the practical checklist for startups using AI coding assistants in 2026.",
    href: "/hub/ai-coding-tools-soc2-compliance",
    accentColor: "from-indigo-400 to-purple-500",
    tag: "Guide",
  },
  {
    id: "top-compliance-automation-tools-2026",
    title: "Top 5 Compliance Automation Tools in 2026",
    description:
      "Compare the top 5 compliance automation tools for 2026. Discover why open source Probo ranks #1 and how its hands-on service eliminates the DIY compliance burden.",
    href: "/hub/top-compliance-automation-tools-2026",
    accentColor: "from-lime-400 to-green-500",
    tag: "Comparison",
  },
  {
    id: "soc2-type1-vs-type2",
    title: "SOC 2 Type 1 vs Type 2: Which Certification Do You Need?",
    description:
      "SOC 2 Type 1 vs Type 2 explained: Type 1 is point-in-time (3-6 months, $15K-$40K), Type 2 requires 6-12 month observation ($30K-$100K). Learn which fits your stage and when to upgrade.",
    href: "/hub/soc2-type1-vs-type2",
    accentColor: "from-emerald-400 to-teal-500",
    tag: "Guide",
  },
  {
    id: "evaluate-soc2-report-quality",
    title: "How to Evaluate SOC 2 Report Quality",
    description:
      "Learn 6 expert checks to evaluate SOC 2 report quality. Verify auditor legitimacy, test procedures, and sample sizes before relying on vendor assessments.",
    href: "/hub/evaluate-soc2-report-quality",
    accentColor: "from-emerald-400 to-teal-500",
    tag: "Guide",
  },
  {
    id: "iso27001-certification-cost",
    title: "ISO 27001 certification cost: what founders actually pay in 2026",
    description:
      "The real number ranges from $15,000 to over $80,000. Here is exactly what drives the difference, and how to avoid paying for things you don't need.",
    href: "/hub/iso27001-certification-cost",
    accentColor: "from-blue-400 to-indigo-500",
    tag: "Guide",
  },
  {
    id: "what-is-compliance-software",
    title: "What is a Compliance Software?",
    description:
      "Discover what defines GRC software in 2026 and why Probo is the platform of choice for companies that want to move fast with qualitative compliance report and process.",
    href: "/hub/what-is-compliance-software",
    accentColor: "from-emerald-400 to-cyan-500",
    tag: "Guide",
  },
  {
    id: "top-grc-tools-2026",
    title: "Top 5 GRC Tools in 2026",
    description:
      "A practical guide for modern Risk & Compliance teams. We compare Probo, Vanta, Drata, Hyperproof, and OneTrust based on risk management, governance, and compliance capabilities.",
    href: "/hub/top-grc-tools-2026",
    accentColor: "from-violet-400 to-purple-500",
    tag: "Comparison",
  },
  {
    id: "third-party-risk-management",
    title: "What Is Third-Party Risk Management (TPRM)?",
    description:
      "Learn what TPRM is, why it matters for compliance frameworks like ISO 27001 and SOC 2, and best practices for managing vendor and supplier risks throughout the relationship lifecycle.",
    href: "/hub/third-party-risk-management",
    accentColor: "from-amber-400 to-orange-500",
    tag: "Guide",
  },
  {
    id: "cloud-security-best-practices",
    title: "Cloud Security Best Practices for Audit-Ready Teams",
    description:
      "Learn cloud security best practices to prevent misconfigurations, cut credential risk, and generate audit-ready evidence for SOC 2 and ISO 27001.",
    href: "/hub/cloud-security-best-practices",
    accentColor: "from-sky-400 to-blue-500",
    tag: "Guide",
  },
  {
    id: "top-compliance-officer-services-2026",
    title: "Top 5 Compliance Officer Services in 2026",
    description:
      "For founders who don't want to become compliance experts. Compare the best compliance officer services for SOC 2 in 2026 — real teams, not just software.",
    href: "/hub/top-compliance-officer-services-2026",
    accentColor: "from-teal-400 to-green-500",
    tag: "Comparison",
  },
];

const hubArticles = (await getCollection("hub", ({ data }) => !data.draft))
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())
  .map((entry) => ({
    id: entry.id,
    title: entry.data.title,
    description: entry.data.description,
    href: `/hub/${entry.id}`,
    accentColor: entry.data.accentColor,
    tag: entry.data.tag,
  }));

const seen = new Set<string>();
const allArticles = [...hubArticles, ...articles].filter((article) => {
  if (seen.has(article.id)) return false;
  seen.add(article.id);
  return true;
});
---

<Layout
  title="Security & Compliance Hub"
  description="ZebraByte Security & Compliance Hub, built on top of the complete Probo resource center with SOC 2, ISO 27001, NIS2, GRC guides, tools and comparisons."
>
  <main class="container my-10 sm:my-20">
    <div class="mb-10 text-center sm:mb-16">
      <div
        class="border-border-low bg-level-0 text-muted-foreground animate-slide-in mb-6 inline-flex items-center gap-2 rounded-full border px-4 py-2 text-xs"
      >
        ZebraByte · Security · Privacy · Compliance
      </div>
      <h1 class="text-h2 sm:text-h1 animate-slide-in animation-delay-100 mb-6 font-medium">
        Hub
      </h1>
      <p class="text-muted-foreground animate-slide-in animation-delay-200 mx-auto max-w-[680px] text-lg font-medium sm:text-xl">
        Păstrăm integral Resource Center-ul Probo și îl extindem cu servicii și ghiduri ZebraByte pentru cybersecurity, privacy și infrastructură securizată.
      </p>
    </div>

    <section class="animate-slide-in animation-delay-250 mb-16 sm:mb-24">
      <div class="mb-8">
        <p class="text-muted-foreground mb-2 text-sm font-medium uppercase tracking-[0.12em]">ZebraByte layer</p>
        <h2 class="text-h3 sm:text-[40px] sm:leading-[54px] mb-3 font-medium tracking-[-0.8px]">
          Security & Compliance Services
        </h2>
        <p class="text-muted-foreground text-lg">
          Noile direcții ZebraByte adăugate peste platforma și biblioteca Probo.
        </p>
      </div>
      <div class="grid grid-cols-1 gap-4 sm:grid-cols-2 lg:grid-cols-3">
        {zebraByteResources.map((resource) => (
          <a
            href={resource.href}
            class="bg-level-0 border-border-low hover:border-border-mid group rounded-2xl border p-6 transition-all hover:-translate-y-0.5 hover:shadow-lg"
          >
            <span class="bg-highlight mb-8 inline-flex rounded-full px-3 py-1 text-xs font-medium">{resource.tag}</span>
            <h3 class="mb-3 text-xl font-medium group-hover:underline group-hover:underline-offset-4">{resource.title}</h3>
            <p class="text-muted-foreground leading-relaxed">{resource.description}</p>
          </a>
        ))}
      </div>
    </section>

    <div class="border-border-low mb-16 border-t pt-16 sm:mb-24 sm:pt-24">
      <div class="mb-5 flex flex-wrap items-end justify-between gap-4">
        <div>
          <p class="text-muted-foreground mb-2 text-sm font-medium uppercase tracking-[0.12em]">Original Probo Resource Center</p>
          <h2 class="text-h3 sm:text-[40px] sm:leading-[54px] font-medium tracking-[-0.8px]">Complete upstream library</h2>
        </div>
        <a href="https://github.com/getprobo/probo" target="_blank" rel="noopener noreferrer" class="text-muted-foreground text-sm underline underline-offset-4">Probo upstream ↗</a>
      </div>
      <p class="text-muted-foreground max-w-180 text-lg">
        Ghidurile, tool-urile, comparațiile și textele originale Probo rămân aici cu identitatea și afirmațiile lor upstream; nu le comprimăm și nu le rebotezăm artificial.
      </p>
    </div>

    <section class="animate-slide-in animation-delay-300">
      <div class="mb-10">
        <h2 class="text-h3 sm:text-[40px] sm:leading-[54px] mb-3 font-medium tracking-[-0.8px]">
          Compliance Guides
        </h2>
        <p class="text-muted-foreground text-lg">
          Start your compliance journey with the original comprehensive guides.
        </p>
      </div>

      <div class="grid grid-cols-1 gap-6 sm:grid-cols-2 sm:gap-8">
        {frameworks.map((framework) => (
          <article class="group relative overflow-hidden rounded-3xl border border-gray-200 bg-white shadow-xl transition-all duration-300 hover:border-gray-300 hover:shadow-2xl">
            <div class={`absolute top-0 right-0 h-64 w-64 bg-gradient-to-br ${framework.accentColor} opacity-10 blur-3xl transition-opacity group-hover:opacity-20`} />
            <div class="relative p-6 sm:p-8">
              <h3 class="mb-4 text-[28px] leading-[1.15] font-bold tracking-[-0.5px] text-gray-900 sm:text-[32px]">{framework.title}</h3>
              <p class="mb-8 leading-relaxed text-gray-600">{framework.description}</p>
              <ul class="mb-8 space-y-3">
                {framework.features.map((feature) => (
                  <li class="flex items-start gap-3">
                    <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="#10b981" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="mt-0.5 shrink-0">
                      <path d="M22 11.08V12a10 10 0 1 1-5.93-9.14" />
                      <polyline points="22 4 12 14.01 9 11.01" />
                    </svg>
                    <span class="text-gray-700">{feature}</span>
                  </li>
                ))}
              </ul>
              <div class="flex items-center justify-between gap-4 border-t border-gray-200 pt-6">
                <a href={framework.href} class="inline-flex items-center gap-2 rounded-full bg-gray-900 px-6 py-3 font-medium text-white shadow-lg transition-all hover:gap-3 hover:bg-gray-800 hover:shadow-xl">
                  Access guide
                  <span>→</span>
                </a>
                <div class="flex items-center gap-2">
                  {framework.badges.map((badge) => (
                    <FrameworkBadge name={badge} class="size-10 mix-blend-multiply" client:visible />
                  ))}
                </div>
              </div>
            </div>
          </article>
        ))}
      </div>
    </section>

    <section class="animate-slide-in animation-delay-325 mt-10 sm:mt-16">
      <div class="mb-10">
        <h2 class="text-h3 sm:text-[40px] sm:leading-[54px] mb-3 font-medium tracking-[-0.8px]">Tools</h2>
        <p class="text-muted-foreground text-lg">Free tools from the original Probo resource center.</p>
      </div>

      <div class="grid grid-cols-1 gap-6 sm:grid-cols-2">
        {tools.map((tool) => (
          <a href={tool.href} class="group relative block overflow-hidden rounded-3xl border border-gray-200 bg-white shadow-xl transition-all duration-300 hover:border-gray-300 hover:shadow-2xl">
            <div class={`absolute top-0 right-0 h-64 w-64 bg-gradient-to-br ${tool.accentColor} opacity-10 blur-3xl transition-opacity group-hover:opacity-20`} />
            <div class="relative p-6 sm:p-8">
              <div class="mb-5 flex items-start justify-between gap-4">
                <span class="rounded-full bg-[#efffc0] px-3 py-1 text-xs font-medium text-gray-800">{tool.tag}</span>
                <span class="text-2xl text-gray-400 transition-transform group-hover:translate-x-1">→</span>
              </div>
              <h3 class="mb-4 text-[26px] leading-tight font-bold tracking-[-0.4px] text-gray-900">{tool.title}</h3>
              <p class="leading-relaxed text-gray-600">{tool.description}</p>
            </div>
          </a>
        ))}
      </div>
    </section>

    <section class="animate-slide-in animation-delay-350 mt-10 sm:mt-16">
      <div class="mb-10">
        <h2 class="text-h3 sm:text-[40px] sm:leading-[54px] mb-3 font-medium tracking-[-0.8px]">Articles & Comparisons</h2>
        <p class="text-muted-foreground text-lg">
          Biblioteca completă Probo: guides, checklists și comparații comerciale păstrate cu contextul lor original.
        </p>
      </div>

      <div class="grid grid-cols-1 gap-6">
        {allArticles.map((article) => (
          <a href={article.href} class="group relative block overflow-hidden rounded-3xl border border-gray-200 bg-white shadow-xl transition-all duration-300 hover:border-gray-300 hover:shadow-2xl">
            <div class={`absolute top-0 right-0 h-48 w-72 bg-gradient-to-br ${article.accentColor} opacity-10 blur-3xl transition-opacity group-hover:opacity-20`} />
            <div class="relative flex flex-col gap-6 p-6 sm:flex-row sm:items-center sm:justify-between sm:p-8">
              <div class="max-w-3xl">
                <span class="mb-4 inline-flex rounded-full bg-gray-100 px-3 py-1 text-xs font-medium text-gray-600">{article.tag}</span>
                <h3 class="mb-3 text-[24px] leading-tight font-bold tracking-[-0.35px] text-gray-900 sm:text-[28px]">{article.title}</h3>
                <p class="leading-relaxed text-gray-600">{article.description}</p>
              </div>
              <span class="shrink-0 text-3xl text-gray-400 transition-transform group-hover:translate-x-1">→</span>
            </div>
          </a>
        ))}
      </div>
    </section>
  </main>
</Layout>
