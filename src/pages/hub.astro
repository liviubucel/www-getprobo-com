---
import { getCollection } from "astro:content";
import Layout from "../layouts/Layout.astro";
import FrameworkBadge from "../components/FrameworkBadge.svelte";

const guides = [
  {
    title: "SOC 2",
    description: "Controale, dovezi și pregătire pentru un raport SOC 2, fără a confunda readiness cu atestarea independentă.",
    detail: "Trust Services Criteria · evidence · readiness",
    href: "/soc2",
    badges: ["SOC2_TYPE1", "SOC2_TYPE2"],
  },
  {
    title: "ISO/IEC 27001",
    description: "ISMS, analiza riscurilor, controale și pregătirea pentru auditul de certificare.",
    detail: "ISMS · risc · Annex A · audit",
    href: "/iso-27001",
    badges: ["ISO27001"],
  },
  {
    title: "NIS2",
    description: "Scope, guvernanță, măsuri tehnice, supply chain și incident response pentru organizațiile vizate.",
    detail: "scope · Articolul 21 · furnizori · incidente",
    href: "/nis2",
    badges: ["NIS2"],
  },
];

const tools = [
  {
    label: "Evaluare",
    title: "Security Assessment & Cyber Audit",
    description: "Un punct de pornire pentru a identifica riscurile și prioritățile tehnice înainte de un program mai amplu.",
    href: "/security-assessment",
  },
  {
    label: "Instrumente publice",
    title: "Verificări rapide de securitate",
    description: "Instrumentele ZebraByte pentru verificări punctuale, fără cont și fără să pornești un proiect de audit.",
    href: "/tools",
  },
];

const curatedArticles = [
  {
    tag: "Comparație",
    title: "ZebraByte vs Vanta",
    description: "Două modele diferite: platformă de automatizare versus un program administrat cu componentă de execuție.",
    href: "/hub/zebrabyte-vs-vanta",
  },
  {
    tag: "Ghid de decizie",
    title: "ZebraByte vs Fractional CISO",
    description: "Când ai nevoie de execuție operațională și când ai nevoie de leadership și guvernanță senior de securitate.",
    href: "/hub/zebrabyte-vs-fractional-ciso",
  },
];

const collectionArticles = (await getCollection("hub", ({ data }) => !data.draft))
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())
  .map((entry) => ({
    tag: entry.data.tag,
    title: entry.data.title,
    description: entry.data.description,
    href: `/hub/${entry.id}`,
  }));

type HubArticle = { tag: string; title: string; description: string; href: string };
const articleMap = new Map<string, HubArticle>();
for (const article of [...collectionArticles, ...curatedArticles]) {
  if (!articleMap.has(article.href)) articleMap.set(article.href, article);
}
const articles = [...articleMap.values()];

const hubSchema = {
  "@context": "https://schema.org",
  "@type": "CollectionPage",
  name: "ZebraByte Hub",
  description: "Ghiduri și resurse ZebraByte despre securitate cibernetică, conformitate, privacy și managementul riscurilor.",
  url: "https://www.zebrabyte.ro/hub",
  hasPart: [...guides, ...tools, ...articles].map((item) => ({
    "@type": "CreativeWork",
    name: item.title,
    url: new URL(item.href, "https://www.zebrabyte.ro").toString(),
  })),
};
---

<Layout
  title="Hub: securitate, conformitate și GRC"
  description="Ghiduri și resurse ZebraByte despre securitate cibernetică, SOC 2, ISO 27001, NIS2, privacy și managementul riscurilor."
>
  <script type="application/ld+json" set:html={JSON.stringify(hubSchema)} />

  <main class="container my-10 max-w-[960px] sm:my-20">
    <header class="mb-16 max-w-[680px] sm:mb-24">
      <h1 class="text-h2 sm:text-h1 animate-slide-in mb-5 font-medium">Hub</h1>
      <p class="text-muted-foreground animate-slide-in animation-delay-100 text-lg leading-relaxed sm:text-xl">
        Note, ghiduri și explicații ZebraByte despre securitate și conformitate. Publicăm aici numai materiale validate pentru ZebraByte.
      </p>
    </header>

    <section class="mb-16 sm:mb-24" aria-labelledby="hub-start">
      <div class="mb-7 border-b pb-4"><h2 id="hub-start" class="text-2xl font-medium">Începe de aici</h2></div>
      <div class="grid gap-10 md:grid-cols-3 md:gap-0">
        {guides.map((guide, index) => (
          <article class:list={["md:pr-8", index > 0 && "md:border-l md:pl-8"]}>
            <div class="mb-5 flex h-9 items-center gap-2">
              {guide.badges.map((badge) => <FrameworkBadge name={badge} class="size-8" client:visible />)}
            </div>
            <h3 class="mb-3 text-xl font-medium">{guide.title}</h3>
            <p class="text-muted-foreground mb-4 text-sm leading-relaxed">{guide.description}</p>
            <p class="text-quaternary mb-5 text-xs leading-relaxed">{guide.detail}</p>
            <a href={guide.href} class="text-sm font-medium hover:underline">Vezi serviciul →</a>
          </article>
        ))}
      </div>
    </section>

    <section class="mb-16 sm:mb-24" aria-labelledby="hub-tools">
      <div class="mb-3 border-b pb-4"><h2 id="hub-tools" class="text-2xl font-medium">Instrumente</h2></div>
      <div class="divide-y">
        {tools.map((tool) => (
          <a href={tool.href} class="group grid gap-2 py-6 sm:grid-cols-[170px_minmax(0,1fr)_24px] sm:gap-6">
            <span class="text-muted-foreground text-sm">{tool.label}</span>
            <div><h3 class="mb-1.5 font-medium group-hover:underline">{tool.title}</h3><p class="text-muted-foreground max-w-[620px] text-sm leading-relaxed">{tool.description}</p></div>
            <span class="text-muted-foreground hidden self-center sm:block" aria-hidden="true">→</span>
          </a>
        ))}
      </div>
    </section>

    <section aria-labelledby="hub-library">
      <div class="mb-3 border-b pb-4"><h2 id="hub-library" class="text-2xl font-medium">Ghiduri și analize</h2></div>
      <div class="divide-y">
        {articles.map((article) => (
          <a href={article.href} class="group grid gap-2 py-6 sm:grid-cols-[110px_minmax(0,1fr)_24px] sm:gap-6">
            <span class="text-muted-foreground text-sm">{article.tag}</span>
            <div><h3 class="mb-1.5 text-[17px] font-medium leading-snug group-hover:underline">{article.title}</h3><p class="text-muted-foreground max-w-[650px] text-sm leading-relaxed">{article.description}</p></div>
            <span class="text-muted-foreground hidden self-center sm:block" aria-hidden="true">→</span>
          </a>
        ))}
      </div>
    </section>

    <p class="text-muted-foreground mt-16 border-t pt-8 text-sm sm:mt-20">
      Ai o întrebare care nu apare aici? <a href="/contact" class="text-primary font-medium hover:underline">Scrie-ne</a> și îți spunem de unde merită să începi.
    </p>
  </main>
</Layout>
