---
import { getCollection } from "astro:content";
import Layout from "../layouts/Layout.astro";
import FrameworkBadge from "../components/FrameworkBadge.svelte";

const frameworks = [
  {
    id: "soc2",
    title: "SOC 2",
    description:
      "Ghid complet pentru cerințe, costuri, calendar și diferențele dintre Type 1 și Type 2. Un punct de pornire clar pentru pregătirea unui program SOC 2.",
    features: ["Înțelegerea SOC 2", "Cerințe și controale", "Cost și calendar"],
    href: "/hub/soc2",
    accentColor: "from-emerald-400 to-teal-500",
    badges: ["SOC2_TYPE1", "SOC2_TYPE2"],
  },
  {
    id: "iso27001",
    title: "ISO/IEC 27001",
    description:
      "Ce înseamnă un ISMS, cum abordezi analiza riscurilor, Annex A și pregătirea pentru auditul de certificare ISO/IEC 27001.",
    features: ["ISMS și scope", "Risk treatment și Annex A", "Audit și certificare"],
    href: "/hub/iso27001",
    accentColor: "from-blue-400 to-indigo-500",
    badges: ["ISO27001"],
  },
  {
    id: "nis2",
    title: "NIS2",
    description:
      "Ghid pentru echipe care trebuie să înțeleagă dacă intră în domeniul NIS2 și cum se transformă cerințele de guvernanță în măsuri tehnice și operaționale.",
    features: ["Scope și responsabilități", "Articolul 21", "Incidente și supply chain"],
    href: "/hub/nis2-compliance",
    accentColor: "from-purple-400 to-violet-500",
    badges: ["NIS2"],
  },
];

const tools = [
  {
    id: "compliance-recommender",
    title: "Recomandator de framework-uri",
    description:
      "Află rapid ce framework-uri de securitate și conformitate sunt relevante pentru organizația ta în funcție de industrie, clienți, jurisdicție și tipurile de date procesate.",
    href: "/hub/compliance-recommender",
    accentColor: "from-yellow-400 to-lime-500",
    tag: "Instrument gratuit",
  },
  {
    id: "security-tools",
    title: "Instrumente publice de securitate",
    description:
      "Verificări rapide ZebraByte pentru securitate, expunere și configurări de bază, fără cont și fără să pornești un proiect de audit.",
    href: "/tools",
    accentColor: "from-lime-400 to-emerald-500",
    tag: "Instrumente",
  },
];

const curatedArticles = [
  {
    id: "which-compliance-framework",
    tag: "Ghid",
    title: "Ce framework de conformitate are nevoie compania ta?",
    description:
      "SOC 2, ISO 27001, GDPR sau NIS2? Alegerea pornește de la clienți, jurisdicție, industrie și datele pe care le procesezi.",
    href: "/hub/which-compliance-framework",
    accentColor: "from-yellow-400 to-amber-500",
  },
  {
    id: "nis2-compliance-checklist-tech-companies-2026",
    tag: "Checklist",
    title: "Checklist NIS2 pentru companii de tehnologie",
    description:
      "Guvernanță, măsuri tehnice, furnizori și raportarea incidentelor, într-o ordine utilă pentru o echipă tehnică.",
    href: "/hub/nis2-compliance-checklist-tech-companies-2026",
    accentColor: "from-purple-400 to-fuchsia-500",
  },
  {
    id: "nis2-tech-teams",
    tag: "Ghid",
    title: "NIS2 pentru echipe tehnice",
    description:
      "Ce ajunge concret la CTO, engineering și security atunci când cerințele de guvernanță trebuie implementate și demonstrate.",
    href: "/hub/nis2-tech-teams",
    accentColor: "from-purple-400 to-violet-500",
  },
  {
    id: "soc2-type1-vs-type2",
    tag: "Ghid",
    title: "SOC 2 Type 1 vs Type 2",
    description:
      "Două tipuri de raport, două momente diferite. Explicăm ce verifică fiecare și când are sens să alegi unul sau celălalt.",
    href: "/hub/soc2-type1-vs-type2",
    accentColor: "from-emerald-400 to-teal-500",
  },
  {
    id: "evaluate-soc2-report-quality",
    tag: "Ghid",
    title: "Cum evaluezi calitatea unui raport SOC 2",
    description:
      "Ce merită verificat înainte să te bazezi pe raportul unui furnizor într-un proces de due diligence sau vendor risk management.",
    href: "/hub/evaluate-soc2-report-quality",
    accentColor: "from-emerald-400 to-teal-500",
  },
  {
    id: "iso27001-certification-cost",
    tag: "Ghid",
    title: "Cât costă, de fapt, ISO 27001?",
    description:
      "Costul depinde mai ales de scope, maturitatea controalelor, audit și câtă muncă trebuie făcută înainte de certificare.",
    href: "/hub/iso27001-certification-cost",
    accentColor: "from-blue-400 to-indigo-500",
  },
  {
    id: "third-party-risk-management",
    tag: "Ghid",
    title: "Third-Party Risk Management (TPRM)",
    description:
      "Cum evaluezi furnizorii, ce urmărești după onboarding și unde se leagă TPRM de ISO 27001, SOC 2 și NIS2.",
    href: "/hub/third-party-risk-management",
    accentColor: "from-amber-400 to-orange-500",
  },
  {
    id: "cloud-security-best-practices",
    tag: "Ghid",
    title: "Cloud security pentru echipe audit-ready",
    description:
      "Configurări, identități, credentiale și logging: lucrurile care reduc riscul și, în același timp, produc dovezi utile la audit.",
    href: "/hub/cloud-security-best-practices",
    accentColor: "from-sky-400 to-blue-500",
  },
  {
    id: "ai-coding-tools-soc2-compliance",
    tag: "Ghid",
    title: "AI coding tools și SOC 2",
    description:
      "Ce trebuie controlat când echipa folosește instrumente AI pentru cod: date, acces, furnizori, politici și urmele care rămân pentru audit.",
    href: "/hub/ai-coding-tools-soc2-compliance",
    accentColor: "from-indigo-400 to-purple-500",
  },
  {
    id: "what-is-compliance-software",
    tag: "Ghid",
    title: "Ce face, de fapt, un software de conformitate?",
    description:
      "Unde ajută o platformă GRC și unde nu: riscuri, controale, dovezi, politici, furnizori și pregătirea pentru audit.",
    href: "/hub/what-is-compliance-software",
    accentColor: "from-emerald-400 to-cyan-500",
  },
  {
    id: "top-grc-tools-2026",
    tag: "Comparație",
    title: "Instrumente GRC importante în 2026",
    description:
      "O privire comparativă asupra platformelor GRC și a modului în care abordează riscul, controalele și automatizarea.",
    href: "/hub/top-grc-tools-2026",
    accentColor: "from-violet-400 to-purple-500",
  },
  {
    id: "vanta-alternatives-2026",
    tag: "Comparație",
    title: "Alternative pentru compliance automation",
    description:
      "Ce diferă între software-only și managed compliance atunci când compari efortul intern, costul și nivelul de suport.",
    href: "/hub/vanta-alternatives-2026",
    accentColor: "from-teal-400 to-cyan-500",
  },
];

const collectionArticles = (await getCollection("hub", ({ data }) => !data.draft))
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())
  .map((entry) => ({
    id: entry.id,
    tag: entry.data.tag,
    title: entry.data.title,
    description: entry.data.description,
    href: `/hub/${entry.id}`,
    accentColor: entry.data.accentColor,
  }));

type HubArticle = {
  id: string;
  tag: string;
  title: string;
  description: string;
  href: string;
  accentColor: string;
};

const articleMap = new Map<string, HubArticle>();
for (const article of [...collectionArticles, ...curatedArticles]) {
  if (!articleMap.has(article.href)) articleMap.set(article.href, article);
}
const articles = [...articleMap.values()];

const hubSchema = {
  "@context": "https://schema.org",
  "@type": "CollectionPage",
  name: "ZebraByte Hub",
  description:
    "Ghiduri și resurse ZebraByte despre securitate cibernetică, SOC 2, ISO 27001, NIS2, privacy, risk management și compliance.",
  url: "https://www.zebrabyte.ro/hub",
  hasPart: [...frameworks, ...tools, ...articles].map((item) => ({
    "@type": "CreativeWork",
    name: item.title,
    url: new URL(item.href, "https://www.zebrabyte.ro").toString(),
  })),
};
---

<Layout
  title="Hub: securitate, SOC 2, ISO 27001, NIS2 și GRC"
  description="Ghiduri și resurse ZebraByte despre securitate cibernetică, SOC 2, ISO 27001, NIS2, GRC, cloud security și managementul riscurilor."
>
  <script type="application/ld+json" set:html={JSON.stringify(hubSchema)} />

  <main class="container my-10 sm:my-20">
    <div class="mb-10 text-center sm:mb-16">
      <div
        class="animate-slide-in mb-6 inline-flex items-center gap-2 rounded-full border border-[rgba(147,201,38,0.12)] bg-white/60 px-4 py-2 text-xs text-muted-foreground backdrop-blur-[50px]"
      >
        <svg
          xmlns="http://www.w3.org/2000/svg"
          width="14"
          height="14"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
          aria-hidden="true"
        >
          <path d="M3 9l9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"></path>
          <polyline points="9 22 9 12 15 12 15 22"></polyline>
        </svg>
        Centru de resurse
      </div>
      <h1 class="text-h2 sm:text-h1 animate-slide-in animation-delay-100 mb-6 font-medium">
        Hub
      </h1>
      <p
        class="text-muted-foreground animate-slide-in animation-delay-200 mx-auto max-w-[600px] text-lg font-medium sm:text-xl"
      >
        Resurse practice despre conformitate, securitate, risc și operarea unui program GRC.
      </p>
    </div>

    <section class="animate-slide-in animation-delay-300">
      <div class="mb-10">
        <h2 class="text-h3 mb-3 font-medium tracking-[-0.8px] sm:text-[40px] sm:leading-[54px]">
          Ghiduri de conformitate
        </h2>
        <p class="text-muted-foreground text-lg">
          Începe cu ghidurile complete pentru framework-urile pe care le întâlnim cel mai des.
        </p>
      </div>

      <div class="grid grid-cols-1 gap-6 sm:grid-cols-2 sm:gap-8">
        {frameworks.map((framework) => (
          <article
            class="group relative overflow-hidden rounded-3xl border border-gray-200 bg-white shadow-xl transition-all duration-300 hover:border-gray-300 hover:shadow-2xl"
          >
            <div
              class={`absolute top-0 right-0 h-64 w-64 bg-gradient-to-br ${framework.accentColor} opacity-10 blur-3xl transition-opacity group-hover:opacity-20`}
              aria-hidden="true"
            />

            <div class="relative p-6 sm:p-8">
              <h3 class="mb-4 text-[28px] leading-[1.15] font-bold tracking-[-0.5px] text-gray-900 sm:text-[32px]">
                {framework.title}
              </h3>

              <p class="mb-8 leading-relaxed text-gray-600">{framework.description}</p>

              <ul class="mb-8 space-y-3">
                {framework.features.map((feature) => (
                  <li class="flex items-start gap-3">
                    <svg
                      xmlns="http://www.w3.org/2000/svg"
                      width="20"
                      height="20"
                      viewBox="0 0 24 24"
                      fill="none"
                      stroke="#10b981"
                      stroke-width="2"
                      stroke-linecap="round"
                      stroke-linejoin="round"
                      class="mt-0.5 shrink-0"
                      aria-hidden="true"
                    >
                      <path d="M22 11.08V12a10 10 0 1 1-5.93-9.14" />
                      <polyline points="22 4 12 14.01 9 11.01" />
                    </svg>
                    <span class="text-gray-700">{feature}</span>
                  </li>
                ))}
              </ul>

              <div class="flex items-center justify-between gap-4 border-t border-gray-200 pt-6">
                <a
                  href={framework.href}
                  class="group/btn inline-flex items-center gap-2 rounded-full bg-gray-900 px-6 py-3 font-medium text-white shadow-lg transition-all hover:gap-3 hover:bg-gray-800 hover:shadow-xl"
                >
                  Deschide ghidul complet
                  <svg
                    xmlns="http://www.w3.org/2000/svg"
                    width="16"
                    height="16"
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="2"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    aria-hidden="true"
                  >
                    <path d="M5 12h14" />
                    <path d="m12 5 7 7-7 7" />
                  </svg>
                </a>

                <div class="flex shrink-0 gap-2">
                  {framework.badges.map((badge) => (
                    <div
                      class="flex size-12 items-center justify-center overflow-hidden rounded-full border-2 border-gray-200 bg-gray-100 transition-colors group-hover:border-gray-300"
                    >
                      <FrameworkBadge name={badge} class="size-8" client:visible />
                    </div>
                  ))}
                </div>
              </div>
            </div>
          </article>
        ))}
      </div>
    </section>

    <section class="animate-slide-in animation-delay-325 mt-10 sm:mt-16">
      <div class="mb-10">
        <h2 class="text-h3 mb-3 font-medium tracking-[-0.8px] sm:text-[40px] sm:leading-[54px]">
          Instrumente
        </h2>
        <p class="text-muted-foreground text-lg">
          Instrumente gratuite pentru a începe mai repede o evaluare de securitate sau conformitate.
        </p>
      </div>

      <div class="grid grid-cols-1 gap-6">
        {tools.map((tool) => (
          <a
            href={tool.href}
            class="group relative block overflow-hidden rounded-3xl border border-gray-200 bg-white shadow-xl transition-all duration-300 hover:border-gray-300 hover:shadow-2xl"
          >
            <div
              class={`absolute top-0 right-0 h-64 w-64 bg-gradient-to-br ${tool.accentColor} opacity-10 blur-3xl transition-opacity group-hover:opacity-20`}
              aria-hidden="true"
            />

            <div class="relative flex flex-col gap-6 p-6 sm:flex-row sm:items-center sm:p-8">
              <div class="flex-1">
                <span class="mb-4 inline-block rounded-full bg-[#f0f7e4] px-3 py-1 text-xs font-medium text-[#5d770d]">
                  {tool.tag}
                </span>
                <h3
                  class="mb-3 text-[24px] leading-[1.15] font-bold tracking-[-0.5px] text-gray-900 transition-colors group-hover:text-[#5d770d] sm:text-[28px]"
                >
                  {tool.title}
                </h3>
                <p class="leading-relaxed text-gray-600">{tool.description}</p>
              </div>

              <div
                class="hidden size-12 shrink-0 items-center justify-center rounded-full bg-gray-100 transition-colors group-hover:bg-[#D7EDBA] sm:flex"
                aria-hidden="true"
              >
                <svg
                  xmlns="http://www.w3.org/2000/svg"
                  width="20"
                  height="20"
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="2"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  class="text-gray-600 transition-colors group-hover:text-[#141e12]"
                >
                  <path d="M5 12h14" />
                  <path d="m12 5 7 7-7 7" />
                </svg>
              </div>
            </div>
          </a>
        ))}
      </div>
    </section>

    <section class="animate-slide-in animation-delay-350 mt-10 sm:mt-16">
      <div class="mb-10">
        <h2 class="text-h3 mb-3 font-medium tracking-[-0.8px] sm:text-[40px] sm:leading-[54px]">
          Ghiduri și comparații
        </h2>
        <p class="text-muted-foreground text-lg">
          Analize detaliate care te ajută să alegi framework-uri, procese și instrumente potrivite contextului tău.
        </p>
      </div>

      <div class="grid grid-cols-1 gap-6">
        {articles.map((article) => (
          <a
            href={article.href}
            class="group relative block overflow-hidden rounded-3xl border border-gray-200 bg-white shadow-xl transition-all duration-300 hover:border-gray-300 hover:shadow-2xl"
          >
            <div
              class={`absolute top-0 right-0 h-64 w-64 bg-gradient-to-br ${article.accentColor} opacity-10 blur-3xl transition-opacity group-hover:opacity-20`}
              aria-hidden="true"
            />

            <div class="relative flex flex-col gap-6 p-6 sm:flex-row sm:items-center sm:p-8">
              <div class="flex-1">
                <span class="mb-4 inline-block rounded-full bg-[#f0f7e4] px-3 py-1 text-xs font-medium text-[#5d770d]">
                  {article.tag}
                </span>
                <h3
                  class="mb-3 text-[24px] leading-[1.15] font-bold tracking-[-0.5px] text-gray-900 transition-colors group-hover:text-[#5d770d] sm:text-[28px]"
                >
                  {article.title}
                </h3>
                <p class="leading-relaxed text-gray-600">{article.description}</p>
              </div>

              <div
                class="hidden size-12 shrink-0 items-center justify-center rounded-full bg-gray-100 transition-colors group-hover:bg-[#D7EDBA] sm:flex"
                aria-hidden="true"
              >
                <svg
                  xmlns="http://www.w3.org/2000/svg"
                  width="20"
                  height="20"
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="2"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  class="text-gray-600 transition-colors group-hover:text-[#141e12]"
                >
                  <path d="M5 12h14" />
                  <path d="m12 5 7 7-7 7" />
                </svg>
              </div>
            </div>
          </a>
        ))}
      </div>
    </section>

    <section class="animate-slide-in animation-delay-400 mt-10 sm:mt-16">
      <div class="rounded-3xl bg-gradient-to-br from-[#e4f7c7] to-[#d0e8b3] p-8 sm:p-12">
        <div class="flex flex-col items-center gap-6 text-center">
          <div class="flex size-16 items-center justify-center rounded-2xl bg-[#141e12]">
            <svg
              xmlns="http://www.w3.org/2000/svg"
              width="32"
              height="32"
              viewBox="0 0 24 24"
              fill="none"
              stroke="#e4f7c7"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"
              aria-hidden="true"
            >
              <path d="M4 19.5v-15A2.5 2.5 0 0 1 6.5 2H20v20H6.5a2.5 2.5 0 0 1 0-5H20"></path>
            </svg>
          </div>
          <div class="flex flex-col gap-3">
            <h3 class="text-h4 font-medium tracking-[-0.8px] text-[#141e12] sm:text-[32px] sm:leading-[42px]">
              Biblioteca continuă să crească
            </h3>
            <p class="text-muted-foreground max-w-[600px] text-lg">
              Adăugăm constant ghiduri despre GDPR, NIS2, cloud security, third-party risk și alte zone care apar în proiectele reale.
            </p>
          </div>
        </div>
      </div>
    </section>
  </main>
</Layout>
