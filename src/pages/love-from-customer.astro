---
import Layout from "../layouts/Layout.astro";
import ZebraByteTestimonials from "../components/block/ZebraByteTestimonials.astro";
---

<Layout
  title="Recenzii ZebraByte"
  description="Feedback real de la clienții ZebraByte despre securizare, secure managed hosting, suport și proiecte livrate."
>
  <main>
    <section class="container py-16 text-center sm:py-24">
      <p class="text-muted-foreground mb-3 text-sm font-medium uppercase tracking-[0.14em]">Customer reviews</p>
      <h1 class="text-h2 sm:text-h1 mx-auto mb-6 max-w-3xl font-medium text-balance">Ce spun clienții ZebraByte.</h1>
      <p class="text-muted-foreground mx-auto max-w-2xl text-lg leading-relaxed">
        Feedback despre securizarea website-urilor, migrarea în infrastructură security-first, suport și proiecte livrate de echipa ZebraByte.
      </p>
    </section>

    <ZebraByteTestimonials />

    <section class="container py-12 sm:py-20">
      <div class="grid gap-4 sm:grid-cols-3">
        <a href="/recenzii-video" class="bg-subtle hover:bg-active rounded-2xl border p-6 transition-colors">
          <p class="text-muted-foreground mb-6 text-sm">Video reviews</p>
          <h2 class="mb-2 text-xl font-medium">Recenzii video</h2>
          <p class="text-muted-foreground">Experiențe video păstrate din website-ul ZebraByte.</p>
        </a>
        <a href="/stories" class="bg-subtle hover:bg-active rounded-2xl border p-6 transition-colors">
          <p class="text-muted-foreground mb-6 text-sm">Case studies</p>
          <h2 class="mb-2 text-xl font-medium">Stories</h2>
          <p class="text-muted-foreground">Vezi contexte tehnice, probleme și rezultate.</p>
        </a>
        <a href="/contact" class="bg-subtle hover:bg-active rounded-2xl border p-6 transition-colors">
          <p class="text-muted-foreground mb-6 text-sm">Start</p>
          <h2 class="mb-2 text-xl font-medium">Discută cu ZebraByte</h2>
          <p class="text-muted-foreground">Spune-ne ce trebuie protejat sau adus în compliance.</p>
        </a>
      </div>
    </section>
  </main>
</Layout>
