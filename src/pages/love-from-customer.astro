---
import Layout from "../layouts/Layout.astro";
import { getCollection } from "astro:content";
import WallCard from "../components/WallCard.astro";

const posts = (await getCollection("wall"))
  .filter((post) => import.meta.env.DEV || !post.data.draft)
  .sort((a, b) => {
    const aOwned = a.id.startsWith("zebrabyte-");
    const bOwned = b.id.startsWith("zebrabyte-");
    if (aOwned !== bOwned) return aOwned ? -1 : 1;
    if (a.data.featured !== b.data.featured) return a.data.featured ? -1 : 1;
    const ao = a.data.order ?? Number.POSITIVE_INFINITY;
    const bo = b.data.order ?? Number.POSITIVE_INFINITY;
    if (ao !== bo) return ao - bo;
    return (b.data.followers ?? 0) - (a.data.followers ?? 0);
  });
---

<Layout
  title="Customer feedback & compliance insights"
  description="Feedback din proiecte ZebraByte și insight-uri de referință din experiențe reale de securitate și conformitate, păstrate pentru valoarea lor practică."
>
  <main class="-mt-16 overflow-hidden pt-16">
    <div class="relative isolate">
      <div
        aria-hidden="true"
        class="trust-hero-orb pointer-events-none absolute top-[-1314px] left-1/2 z-0 size-[2265px] rounded-full border-[350px] border-[#E6FF03] blur-[96px]"
      >
      </div>

      <section class="relative z-10 container py-16 text-center sm:py-24">
        <div
          class="border-border-low text-tertiary-foreground animate-perspective-in mx-auto mb-6 w-max rounded-lg border px-2 py-0.5 text-sm font-medium"
          style="animation-delay: 100ms"
        >
          Feedback & Reference Insights
        </div>
        <h1
          class="mx-auto mb-6 max-w-[760px] text-[2.75rem] leading-none font-semibold tracking-[-1.4px] text-balance sm:text-5xl sm:tracking-[-1.6px]"
          aria-label="Experiențe reale și lecții practice de securitate și conformitate."
        >
          <span aria-hidden="true" class="block overflow-hidden">
            <span class="animate-perspective-in block" style="animation-delay: 150ms">
              Experiențe reale.
            </span>
          </span>
          <span aria-hidden="true" class="block overflow-hidden">
            <span class="animate-perspective-in block" style="animation-delay: 200ms">
              Lecții care se pot aplica.
            </span>
          </span>
        </h1>
        <p
          class="text-muted-foreground animate-perspective-in mx-auto max-w-[650px] text-base"
          style="animation-delay: 350ms"
        >
          Aici păstrăm feedback-ul verificabil din proiecte ZebraByte și o
          bibliotecă de referință cu perspective publice din programe reale de
          compliance. Cardurile sunt etichetate clar ca să distingă cele două
          categorii.
        </p>
      </section>
    </div>

    <div class="container mt-10 pb-16 sm:mt-14 sm:pb-24">
      {
        posts.length > 0 ? (
          <div class="animate-slide-in animation-delay-250 gap-5 sm:columns-2 lg:columns-3">
            {posts.map((post) => <WallCard post={post} />)}
          </div>
        ) : (
          <p class="text-muted-foreground py-16 text-center text-base">
            Materialele de feedback sunt în curs de pregătire.
          </p>
        )
      }
    </div>
  </main>
</Layout>

<script>
  function initWall() {
    document
      .querySelectorAll<HTMLButtonElement>("[data-wall-lang]")
      .forEach((btn) => {
        if (btn.dataset.bound) return;
        btn.dataset.bound = "1";
        const card = btn.closest("article");
        const post = card?.querySelector<HTMLElement>("[data-wall-post]");
        if (!post) return;
        const original = btn.dataset.original ?? "";
        const translated = btn.dataset.translated ?? "";
        const lang = btn.dataset.langLabel ?? "RO";
        let showingOriginal = false;
        btn.addEventListener("click", () => {
          showingOriginal = !showingOriginal;
          post.textContent = showingOriginal ? original : translated;
          btn.textContent = showingOriginal ? "EN" : lang;
          btn.title = showingOriginal
            ? "Show translation (EN)"
            : `Show original (${lang})`;
        });
      });
  }

  initWall();
  document.addEventListener("astro:page-load", initWall);
</script>

<style>
  .trust-hero-orb {
    opacity: 1;
    transform: translateX(-50%) scale(1);
    transform-origin: center;
  }

  @media (prefers-reduced-motion: no-preference) {
    .trust-hero-orb {
      animation: trust-hero-orb-scale-in cubic-bezier(0.785, 0.135, 0.15, 0.86) 3s both;
      animation-delay: -1200ms;
    }
  }

  @keyframes trust-hero-orb-scale-in {
    from {
      transform: translateX(-50%) scale(0);
    }

    to {
      transform: translateX(-50%) scale(1);
    }
  }
</style>
