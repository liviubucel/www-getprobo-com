---
import Layout from "../layouts/Layout.astro";
import { getCollection } from "astro:content";
import Logos from "../components/block/Logos.astro";
import Testimonials from "../components/block/Testimonials.astro";
import WallCard from "../components/WallCard.astro";

const upstreamPosts = (await getCollection("wall"))
  .filter((p) => import.meta.env.DEV || !p.data.draft)
  .sort((a, b) => {
    if (a.data.featured !== b.data.featured) return a.data.featured ? -1 : 1;
    const ao = a.data.order ?? Number.POSITIVE_INFINITY;
    const bo = b.data.order ?? Number.POSITIVE_INFINITY;
    if (ao !== bo) return ao - bo;
    return (b.data.followers ?? 0) - (a.data.followers ?? 0);
  });
---

<Layout
  title="Ce spun clienții"
  description="Recenzii ZebraByte și wall-ul original Probo, păstrate împreună în aceeași experiență vizuală."
>
  <main class="-mt-16 overflow-hidden pt-16">
    <div class="relative isolate">
      <div
        aria-hidden="true"
        class="trust-hero-orb pointer-events-none absolute top-[-1314px] left-1/2 z-0 size-[2265px] rounded-full border-[350px] border-[#E6FF03] blur-[96px]"
      ></div>

      <section class="relative z-10 container py-16 text-center sm:py-24">
        <div
          class="border-border-low text-tertiary-foreground animate-perspective-in mx-auto mb-6 w-max rounded-lg border px-2 py-0.5 text-sm font-medium"
          style="animation-delay: 100ms"
        >
          Love from Customers
        </div>
        <h1
          class="mx-auto mb-6 max-w-[720px] text-[2.75rem] leading-none font-semibold tracking-[-1.4px] text-balance sm:text-5xl sm:tracking-[-1.6px]"
        >
          <span class="animate-perspective-in block" style="animation-delay: 150ms">
            Experiențe reale,
          </span>
          <span class="animate-perspective-in block" style="animation-delay: 200ms">
            păstrate în aceeași poveste.
          </span>
        </h1>
        <p
          class="text-muted-foreground animate-perspective-in mx-auto max-w-[600px] text-base"
          style="animation-delay: 350ms"
        >
          ZebraByte adaugă propriile recenzii și rezultate peste experiența vizuală
          originală Probo. Păstrăm inclusiv logo-urile, fotografiile și wall-ul upstream,
          cu atribuirea lor originală.
        </p>
      </section>

      <section class="relative z-10 pb-4">
        <p class="text-tertiary-foreground mb-4 text-center text-xs uppercase tracking-[0.12em]">
          Companii din experiența originală Probo
        </p>
        <Logos class="animate-slide-in animation-delay-300" />
      </section>
    </div>

    <Testimonials />

    {
      upstreamPosts.length > 0 && (
        <section class="container py-16 sm:py-24">
          <div class="mb-10 max-w-190">
            <p class="text-muted-foreground mb-2 text-sm font-medium uppercase tracking-[0.12em]">
              Upstream Probo wall
            </p>
            <h2 class="text-h3 sm:text-h2 mb-3 font-medium">Wall-ul original Probo</h2>
            <p class="text-muted-foreground text-lg leading-relaxed">
              Postările, fotografiile, numele și organizațiile originale rămân vizibile.
              Ele documentează experiența Probo upstream și sunt păstrate integral ca
              parte din produsul și designul pe care ZebraByte îl extinde.
            </p>
          </div>

          <div class="animate-slide-in gap-5 sm:columns-2 lg:columns-3">
            {upstreamPosts.map((post) => <WallCard post={post} />)}
          </div>
        </section>
      )
    }
  </main>
</Layout>

<script>
  function initWall() {
    document
      .querySelectorAll<HTMLButtonElement>("[data-wall-lang]")
      .forEach((btn) => {
        if (btn.dataset.bound) return;
        btn.dataset.bound = "1";
        const card = btn.closest("article");
        const post = card?.querySelector<HTMLElement>("[data-wall-post]");
        if (!post) return;
        const original = btn.dataset.original ?? "";
        const translated = btn.dataset.translated ?? "";
        const lang = btn.dataset.langLabel ?? "FR";
        let showingOriginal = false;
        btn.addEventListener("click", () => {
          showingOriginal = !showingOriginal;
          post.textContent = showingOriginal ? original : translated;
          btn.textContent = showingOriginal ? "EN" : lang;
          btn.title = showingOriginal
            ? "Show translation (EN)"
            : `Show original (${lang})`;
        });
      });
  }

  initWall();
  document.addEventListener("astro:page-load", initWall);
</script>

<style>
  .trust-hero-orb {
    opacity: 1;
    transform: translateX(-50%) scale(1);
    transform-origin: center;
  }

  @media (prefers-reduced-motion: no-preference) {
    .trust-hero-orb {
      animation: trust-hero-orb-scale-in cubic-bezier(0.785, 0.135, 0.15, 0.86)
        3s both;
      animation-delay: -1200ms;
    }
  }

  @keyframes trust-hero-orb-scale-in {
    from {
      transform: translateX(-50%) scale(0);
    }

    to {
      transform: translateX(-50%) scale(1);
    }
  }
</style>
