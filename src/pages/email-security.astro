---
import Layout from "../layouts/Layout.astro";
import Button from "../components/ui/Button.svelte";

const senderTypes = [
  "Microsoft 365 / Google Workspace",
  "Transactional email",
  "Marketing platforms",
  "CRM, billing & support systems",
];

const identityControls = [
  {
    title: "MFA & privileged access",
    text: "O parolă compromisă nu ar trebui să fie suficientă pentru acces la mailbox-uri sau roluri cu impact mare.",
  },
  {
    title: "Sessions & sign-ins",
    text: "Investigăm sesiuni, sign-ins și comportamente neobișnuite atunci când există suspiciune de account compromise.",
  },
  {
    title: "Forwarding & mailbox rules",
    text: "Regulile ascunse pot menține accesul sau exfiltra conversații după compromiterea inițială.",
  },
];

const providerRows = [
  ["Microsoft 365", "Domain authentication, identity controls și review în contextul tenantului existent."],
  ["Google Workspace", "DNS authentication și account security fără migrare forțată către alt furnizor."],
  ["Proton", "Configurarea domeniului și controalele disponibile în modelul furnizorului."],
  ["Zoho", "SPF, DKIM, DMARC și posture review pentru organizațiile care folosesc ecosistemul Zoho."],
  ["SMTP / transactional", "Mapăm sursele aplicațiilor, billing-ului, marketingului și altor sisteme care trimit email automat."],
];

const monitoringSignals = [
  {
    step: "01",
    title: "Watch senders",
    text: "Surse noi sau necunoscute apar în rapoarte înainte să devină o excepție permanentă în DNS.",
  },
  {
    step: "02",
    title: "Watch alignment",
    text: "Eșecurile SPF/DKIM și schimbările de selector sau provider sunt tratate ca drift, nu ca zgomot ignorat.",
  },
  {
    step: "03",
    title: "Watch identity",
    text: "Sign-ins, forwarding și alte semnale de compromise rămân parte din posture, chiar dacă DMARC este configurat corect.",
  },
];

const faqs = [
  {
    question: "DMARC poate fi pus direct pe reject?",
    answer:
      "Tehnic este posibil, dar nu este o strategie bună fără inventarul surselor legitime și verificarea alignment-ului. O politică strictă aplicată prea devreme poate bloca fluxuri valide pe care organizația nu le-a documentat încă.",
  },
  {
    question: "SPF, DKIM și DMARC opresc phishing-ul complet?",
    answer:
      "Nu. Ele reduc impersonation-ul direct al domeniului și oferă control și vizibilitate asupra autentificării mesajelor. Phishing-ul poate folosi domenii asemănătoare, conturi compromise sau alte tehnici, de aceea identity security și incident response rămân importante.",
  },
  {
    question: "Trebuie să schimb furnizorul de email?",
    answer:
      "Nu în mod normal. Lucrăm cu platforma existentă și separăm ce trebuie schimbat în DNS, în tenant și în procesele de identity/security. Migrarea are sens doar dacă există motive separate pentru ea.",
  },
  {
    question: "Ce facem dacă un mailbox este deja compromis?",
    answer:
      "Situația trebuie tratată ca incident: sesiuni, parole, MFA, forwarding rules, sign-ins, privilegii și alte mecanisme de persistență trebuie analizate înainte să considerăm problema închisă.",
  },
  {
    question: "Email Security poate susține compliance?",
    answer:
      "Da. Identity controls, MFA, domain authentication, incident handling și evidence-ul asociat pot susține controls relevante din ISO 27001, SOC 2, NIS2 sau alte programe, fără ca o configurație DNS să însemne automat conformitate cu un framework.",
  },
];
---

<Layout
  title="Email Security"
  description="Email Security ZebraByte: SPF, DKIM, DMARC, anti-spoofing, identity hardening, BEC response și monitoring pentru Microsoft 365, Google Workspace și alte platforme."
>
  <main>
    <animated-hero class="relative -mt-16 block overflow-hidden px-5 py-10 pt-26 sm:pt-36 sm:pb-12">
      <div class="text-muted-foreground animate-perspective-in animation-delay-300 mx-auto mb-6 w-max rounded-lg border px-4 py-2 text-sm font-medium sm:mb-8">
        Email Security
      </div>

      <h1 class="text-h2 sm:text-h1 mb-6 overflow-hidden text-center font-medium text-balance sm:mb-8">
        <span class="animate-perspective-in block">Protejează domeniul,</span>
        <span class="animate-perspective-in block delay-50"> nu doar inbox-ul. </span>
      </h1>

      <p class="text-muted-foreground animate-perspective-in animation-delay-150 mx-auto mb-6 max-w-200 text-center text-lg text-balance sm:mb-8">
        Inventariem cine trimite în numele domeniului, aliniem SPF și DKIM, introducem DMARC gradual și conectăm autentificarea domeniului cu identity security și incident response.
      </p>

      <div class="mb-11 flex flex-col items-stretch justify-center gap-3 sm:mb-17 sm:flex-row sm:items-center">
        <Button class="animate-perspective-in animation-delay-200" variant="secondary" size="lg" href="https://mail-scan.zebrabyte.ro" target="_blank" rel="noopener noreferrer">
          Rulează Email Scan
        </Button>
        <Button class="animate-perspective-in animation-delay-300" size="lg" href="/contact">
          Discută despre Email Security
        </Button>
      </div>
    </animated-hero>

    <section class="container pb-12 sm:pb-24">
      <div class="overflow-hidden rounded-2xl border bg-level-1">
        <div class="grid lg:grid-cols-[0.9fr_1.1fr]">
          <div class="border-b p-7 sm:p-10 lg:border-r lg:border-b-0">
            <p class="text-muted-foreground mb-8 text-sm uppercase tracking-wide">Who sends for your domain?</p>
            <div class="space-y-5">
              {senderTypes.map((sender, index) => (
                <div class="flex items-center gap-4">
                  <span class="text-muted-foreground w-7 shrink-0 font-mono text-xs">0{index + 1}</span>
                  <span class="font-medium">{sender}</span>
                </div>
              ))}
            </div>
          </div>

          <div class="bg-active p-7 sm:p-10">
            <p class="text-muted-foreground mb-8 text-sm uppercase tracking-wide">Authentication path</p>
            <div class="grid gap-5 sm:grid-cols-4">
              <div>
                <div class="mb-3 flex size-10 items-center justify-center rounded-full border bg-level-0 font-mono text-xs">01</div>
                <h2 class="font-medium">Sender</h2>
                <p class="text-muted-foreground mt-1 text-sm">Known source</p>
              </div>
              <div>
                <div class="mb-3 flex size-10 items-center justify-center rounded-full border bg-level-0 font-mono text-xs">02</div>
                <h2 class="font-medium">SPF</h2>
                <p class="text-muted-foreground mt-1 text-sm">Authorized path</p>
              </div>
              <div>
                <div class="mb-3 flex size-10 items-center justify-center rounded-full border bg-level-0 font-mono text-xs">03</div>
                <h2 class="font-medium">DKIM</h2>
                <p class="text-muted-foreground mt-1 text-sm">Signed message</p>
              </div>
              <div>
                <div class="mb-3 flex size-10 items-center justify-center rounded-full border bg-level-0 font-mono text-xs">04</div>
                <h2 class="font-medium">DMARC</h2>
                <p class="text-muted-foreground mt-1 text-sm">Aligned policy</p>
              </div>
            </div>
          </div>
        </div>
      </div>
    </section>

    <section class="container py-12 sm:py-24">
      <div class="mx-auto mb-12 max-w-190 text-center sm:mb-16">
        <p class="text-muted-foreground mb-3 text-sm font-medium uppercase tracking-wide">DMARC rollout</p>
        <h2 class="text-h3 sm:text-h2 mb-4 font-medium">Enforcement-ul vine după vizibilitate.</h2>
        <p class="text-muted-foreground text-lg leading-relaxed">
          O politică strictă este utilă doar după ce sursele legitime sunt cunoscute. Începem cu observație și alignment, remediem fluxurile reale, apoi creștem politica fără să sacrificăm emailul legitim.
        </p>
      </div>

      <div class="mx-auto max-w-5xl">
        <div class="relative grid gap-8 sm:grid-cols-4 sm:gap-6">
          <div class="absolute top-5 right-[12.5%] left-[12.5%] hidden h-px bg-border sm:block"></div>
          <article class="relative">
            <div class="mb-5 size-10 rounded-full border bg-background"></div>
            <h3 class="text-h5 mb-2 font-medium">Inventory</h3>
            <p class="text-muted-foreground leading-relaxed">Documentăm fiecare sender legitim și ownership-ul lui.</p>
          </article>
          <article class="relative">
            <div class="mb-5 size-10 rounded-full border bg-active"></div>
            <h3 class="text-h5 mb-2 font-medium">Observe</h3>
            <p class="text-muted-foreground leading-relaxed">Folosim rapoarte și alignment pentru a vedea ce ar fi afectat.</p>
          </article>
          <article class="relative">
            <div class="mb-5 size-10 rounded-full border bg-active"></div>
            <h3 class="text-h5 mb-2 font-medium">Quarantine</h3>
            <p class="text-muted-foreground leading-relaxed">Creștem controlul după ce fluxurile valide sunt remediate.</p>
          </article>
          <article class="relative">
            <div class="mb-5 size-10 rounded-full bg-foreground"></div>
            <h3 class="text-h5 mb-2 font-medium">Reject</h3>
            <p class="text-muted-foreground leading-relaxed">Blocăm impersonation-ul nealiniat când domeniul este pregătit.</p>
          </article>
        </div>
      </div>
    </section>

    <section class="bg-level-3 text-level-0-foreground py-12 sm:py-24">
      <div class="container grid items-start gap-14 lg:grid-cols-[0.8fr_1.2fr] lg:gap-24">
        <div>
          <p class="text-level-0-foreground/55 mb-3 text-sm font-medium uppercase tracking-wide">Identity & BEC</p>
          <h2 class="text-h3 sm:text-h2 mb-5 font-medium">Un mesaj autentic poate veni dintr-un cont compromis.</h2>
          <p class="text-level-0-foreground/65 text-lg leading-relaxed">
            SPF, DKIM și DMARC protejează domeniul de impersonation direct, dar nu pot opri un atacator care a obținut acces într-un mailbox legitim. De aceea domain authentication și identity security trebuie operate împreună.
          </p>
        </div>

        <div class="grid gap-10 sm:grid-cols-3">
          {identityControls.map((item, index) => (
            <article>
              <span class="text-level-0-foreground/40 mb-7 block font-mono text-sm">0{index + 1}</span>
              <h3 class="text-h4 mb-3 font-medium">{item.title}</h3>
              <p class="text-level-0-foreground/65 leading-relaxed">{item.text}</p>
            </article>
          ))}
        </div>
      </div>
    </section>

    <section class="container py-12 sm:py-24">
      <div class="grid gap-12 lg:grid-cols-[0.8fr_1.2fr] lg:gap-24">
        <div class="lg:sticky lg:top-28">
          <p class="text-muted-foreground mb-3 text-sm font-medium uppercase tracking-wide">Keep your provider</p>
          <h2 class="text-h3 sm:text-h2 mb-5 font-medium">Securitatea nu trebuie să fie o migrare comercială mascată.</h2>
          <p class="text-muted-foreground text-lg leading-relaxed">
            Lucrăm cu platforma existentă atunci când ea poate susține cerințele. Separăm ce trebuie schimbat în DNS, ce ține de tenant și ce ține de aplicațiile care trimit automat.
          </p>
        </div>

        <div class="divide-y border-y">
          {providerRows.map(([provider, text]) => (
            <article class="grid gap-3 py-6 sm:grid-cols-[0.65fr_1.35fr] sm:gap-10">
              <h3 class="font-medium">{provider}</h3>
              <p class="text-muted-foreground leading-relaxed">{text}</p>
            </article>
          ))}
        </div>
      </div>
    </section>

    <section class="bg-active py-12 sm:py-24">
      <div class="container">
        <div class="mx-auto mb-12 max-w-180 text-center sm:mb-16">
          <p class="text-muted-foreground mb-3 text-sm font-medium uppercase tracking-wide">After rollout</p>
          <h2 class="text-h3 sm:text-h2 mb-4 font-medium">Email security se degradează dacă nu urmărești schimbarea.</h2>
          <p class="text-muted-foreground text-lg leading-relaxed">
            Un provider nou, o migrare sau o aplicație SaaS poate schimba sender inventory-ul într-o singură zi. Monitoring-ul menține configurația aliniată cu operațiunile reale.
          </p>
        </div>

        <div class="mx-auto grid max-w-5xl gap-10 sm:grid-cols-3 sm:gap-12">
          {monitoringSignals.map((item) => (
            <article>
              <span class="text-muted-foreground mb-7 block font-mono text-sm">{item.step}</span>
              <h3 class="text-h4 mb-3 font-medium">{item.title}</h3>
              <p class="text-muted-foreground leading-relaxed">{item.text}</p>
            </article>
          ))}
        </div>
      </div>
    </section>

    <section class="container py-12 sm:py-24">
      <div class="grid overflow-hidden rounded-2xl border lg:grid-cols-2">
        <div class="p-8 sm:p-12">
          <p class="text-muted-foreground mb-3 text-sm font-medium uppercase tracking-wide">Already compromised?</p>
          <h2 class="text-h3 mb-5 font-medium">Mailbox compromise este incident response.</h2>
          <p class="text-muted-foreground mb-7 text-lg leading-relaxed">
            Resetarea parolei nu este suficientă dacă au rămas sesiuni active, forwarding rules, privilegii sau alte mecanisme de persistență. Triage-ul trebuie să verifice întregul context al identității.
          </p>
          <Button href="/incident-response">Vezi Incident Response</Button>
        </div>
        <div class="bg-level-3 p-8 text-level-0-foreground sm:p-12">
          <p class="text-level-0-foreground/55 mb-8 text-sm uppercase tracking-wide">Containment checklist</p>
          <div class="space-y-5 text-lg">
            <p>Revoke suspicious sessions</p>
            <p>Reset credentials & MFA paths</p>
            <p>Review forwarding & inbox rules</p>
            <p>Review privileges and recovery methods</p>
            <p>Preserve evidence before cleanup</p>
          </div>
        </div>
      </div>
    </section>

    <section class="container py-10 sm:py-20">
      <div class="mx-auto max-w-3xl">
        <h2 class="text-h3 sm:text-h2 mb-8 text-center font-medium">Întrebări frecvente</h2>
        <div class="border-y">
          {faqs.map((faq) => (
            <details class="group border-b py-5 last:border-b-0">
              <summary class="flex cursor-pointer list-none items-center justify-between gap-6 font-medium">
                <span>{faq.question}</span>
                <span class="text-muted-foreground text-xl transition-transform group-open:rotate-45">+</span>
              </summary>
              <p class="text-muted-foreground max-w-2xl pt-4 leading-relaxed">{faq.answer}</p>
            </details>
          ))}
        </div>
      </div>
    </section>

    <section class="container py-12 text-center sm:py-24">
      <h2 class="text-h3 sm:text-h2 mx-auto mb-4 max-w-190 font-medium text-balance">
        Începe cu domeniul real și senderii reali.
      </h2>
      <p class="text-muted-foreground mx-auto mb-8 max-w-160 text-lg">
        Verificăm autentificarea, identity posture și fluxurile legitime înainte să întărim politica sau să schimbăm furnizorul.
      </p>
      <Button href="/contact" size="lg">Discută despre Email Security</Button>
    </section>
  </main>
</Layout>

<script>
  import { AnimatedHero } from "../lib/elements/hero";
  import { customElementDefine } from "../lib/dom";
  customElementDefine("animated-hero", () => AnimatedHero);
</script>
