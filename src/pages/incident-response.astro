---
import Layout from "../layouts/Layout.astro";
import Button from "../components/ui/Button.svelte";

const phases = [
  {
    step: "01",
    title: "Triage",
    text: "Separăm simptomele de fapte, stabilim sistemele afectate și impactul care trebuie tratat primul.",
  },
  {
    step: "02",
    title: "Contain",
    text: "Limităm accesul și propagarea fără să distrugem inutil contextul necesar investigației.",
  },
  {
    step: "03",
    title: "Investigate",
    text: "Căutăm vectorul inițial, persistența, conturile și schimbările tehnice relevante pentru incident.",
  },
  {
    step: "04",
    title: "Recover",
    text: "Restaurăm controlat, verificăm configurația și monitorizăm serviciile înainte de revenirea completă.",
  },
  {
    step: "05",
    title: "Improve",
    text: "Findings și lessons learned devin hardening, controls și acțiuni cu owner și prioritate.",
  },
];

const scenarios = [
  ["Website compromise", "Malware, redirect-uri, injected code, backdoors sau schimbări pe care echipa nu le poate explica."],
  ["Mailbox / identity compromise", "Sign-ins neautorizate, sesiuni suspecte, forwarding rules, MFA bypass sau credential theft."],
  ["Ransomware / endpoint activity", "Fișiere modificate în masă, acces pierdut sau comportament care indică malware ori lateral movement."],
  ["Data exposure", "Date publicate, accesate sau transferate într-un mod care nu era intenționat sau autorizat."],
  ["Application / infrastructure attack", "Abuse, exploatare sau acces neautorizat care afectează aplicații și servicii expuse."],
  ["Third-party compromise", "Suspiciunea că un furnizor, integration sau cont extern a devenit calea de acces către organizație."],
];

const roles = [
  {
    title: "Technical owner",
    text: "Oferă contextul sistemelor, accesul aprobat și validează schimbările tehnice necesare pentru containment și recovery.",
  },
  {
    title: "Decision owner",
    text: "Prioritizează impactul de business și aprobă acțiunile care pot afecta disponibilitatea sau operațiunile.",
  },
  {
    title: "Privacy / legal / compliance",
    text: "Intră în workflow când natura incidentului poate declanșa obligații de evaluare, comunicare sau notificare.",
  },
  {
    title: "Third parties",
    text: "Hosting, email, identity și SaaS sunt implicați acolo unde dețin loguri, acces sau componente relevante.",
  },
];

const recoveryChecks = [
  "vectorul sau cauza tehnică identificată a fost tratată suficient pentru revenire",
  "conturile, sesiunile și privilegiile relevante au fost revizuite",
  "persistența observată sau suspectată a fost eliminată ori izolată",
  "sistemele restaurate pornesc dintr-o stare cunoscută și verificată",
  "monitoring-ul necesar este activ după revenirea în producție",
  "riscurile rămase și acțiunile ulterioare au owner și prioritate",
];

const outputs = [
  ["Incident timeline", "Ce s-a observat, când, ce acțiuni au fost luate și ce informații au fost confirmate."],
  ["Technical findings", "Vectori, sisteme, conturi, configurații sau vulnerabilități relevante identificate în scope."],
  ["Containment & recovery record", "Schimbările făcute pentru limitarea impactului și readucerea serviciilor în operare."],
  ["Remediation plan", "Hardening, patching, identity changes, monitoring și alte acțiuni necesare după incident."],
  ["Lessons learned", "Ce trebuie schimbat în controls, ownership, backup, incident readiness sau supplier management."],
];

const faqs = [
  {
    question: "Ce ar trebui să trimit prin formularul public?",
    answer:
      "Descrie simptomele, serviciul afectat și impactul observat. Nu trimite parole, private keys, recovery codes, token-uri sau alte secrete prin formularul public. Accesul necesar se stabilește ulterior prin canalul potrivit.",
  },
  {
    question: "Trebuie să închid imediat toate sistemele?",
    answer:
      "Nu există o singură acțiune corectă pentru orice incident. Containment-ul trebuie adaptat impactului și sistemelor implicate. O oprire neplanificată poate afecta business-ul sau evidence-ul, deci decizia se ia în context.",
  },
  {
    question: "Puteți ajuta dacă site-ul a fost deja curățat?",
    answer:
      "Da, dar informația disponibilă poate fi mai limitată. Putem analiza configurația actuală, logurile care au rămas, indicatorii cunoscuți și hardening-ul necesar pentru reducerea riscului de reinfectare.",
  },
  {
    question: "Incident Response include și obligațiile GDPR sau NIS2?",
    answer:
      "Putem organiza informația tehnică necesară pentru evaluarea incidentului și o putem conecta la programul de compliance. Interpretarea juridică și decizia finală privind obligațiile specifice trebuie făcute pe cadrul aplicabil organizației și, unde este necesar, cu specialistul competent.",
  },
  {
    question: "Ce se întâmplă după recovery?",
    answer:
      "Incidentul se transformă într-un backlog de remediation: hardening, access controls, monitoring, vulnerability management, backup/recovery și alte acțiuni cu owner și prioritate.",
  },
];
---

<Layout
  title="Incident Response"
  description="Incident Response ZebraByte pentru website-uri, conturi, infrastructură și incidente de securitate: triage, containment, investigation, recovery și remediation post-incident."
>
  <main>
    <animated-hero class="relative -mt-16 block overflow-hidden px-5 py-10 pt-26 sm:pt-36 sm:pb-12">
      <div class="text-muted-foreground animate-perspective-in animation-delay-300 mx-auto mb-6 w-max rounded-lg border px-4 py-2 text-sm font-medium sm:mb-8">
        Incident Response
      </div>

      <h1 class="text-h2 sm:text-h1 mb-6 overflow-hidden text-center font-medium text-balance sm:mb-8">
        <span class="animate-perspective-in block">Limitează impactul.</span>
        <span class="animate-perspective-in block delay-50"> Păstrează controlul și informația. </span>
      </h1>

      <p class="text-muted-foreground animate-perspective-in animation-delay-150 mx-auto mb-6 max-w-200 text-center text-lg text-balance sm:mb-8">
        Triage, containment, investigation support și recovery pentru website-uri, conturi, aplicații și infrastructură. Reacționăm rapid fără să transformăm cleanup-ul într-o pierdere de context.
      </p>

      <div class="mb-5 flex flex-col items-stretch justify-center gap-3 sm:flex-row sm:items-center">
        <Button class="animate-perspective-in animation-delay-200" variant="secondary" size="lg" href="/cyber-security">Cyber Security</Button>
        <Button class="animate-perspective-in animation-delay-300" size="lg" href="/contact">Contactează ZebraByte</Button>
      </div>

      <p class="text-muted-foreground mx-auto max-w-160 text-center text-sm">
        Nu trimite parole, private keys, recovery codes sau token-uri prin formularul public.
      </p>
    </animated-hero>

    <section class="container pb-12 pt-6 sm:pb-24 sm:pt-10">
      <div class="overflow-hidden rounded-2xl bg-level-3 text-level-0-foreground">
        <div class="border-b border-level-0-foreground/10 px-7 py-5 sm:px-10">
          <span class="text-level-0-foreground/55 text-sm uppercase tracking-wide">Primele 60 de minute</span>
        </div>
        <div class="grid gap-0 md:grid-cols-3">
          <article class="border-b border-level-0-foreground/10 p-7 md:border-r md:border-b-0 sm:p-10">
            <span class="text-level-0-foreground/40 mb-8 block font-mono text-sm">01</span>
            <h2 class="text-h4 mb-3 font-medium">Preserve</h2>
            <p class="text-level-0-foreground/65 leading-relaxed">Nu șterge loguri, mailbox rules, fișiere sau sesiuni înainte să știi dacă sunt relevante pentru incident.</p>
          </article>
          <article class="border-b border-level-0-foreground/10 p-7 md:border-r md:border-b-0 sm:p-10">
            <span class="text-level-0-foreground/40 mb-8 block font-mono text-sm">02</span>
            <h2 class="text-h4 mb-3 font-medium">Contain</h2>
            <p class="text-level-0-foreground/65 leading-relaxed">Limitează accesul sau propagarea cu schimbarea minimă necesară pentru a reduce impactul imediat.</p>
          </article>
          <article class="p-7 sm:p-10">
            <span class="text-level-0-foreground/40 mb-8 block font-mono text-sm">03</span>
            <h2 class="text-h4 mb-3 font-medium">Decide</h2>
            <p class="text-level-0-foreground/65 leading-relaxed">Stabilește cine aprobă opriri, resetări, recovery și comunicarea către părțile relevante.</p>
          </article>
        </div>
      </div>
    </section>

    <section class="container py-12 sm:py-24">
      <div class="mx-auto mb-12 max-w-190 text-center sm:mb-16">
        <p class="text-muted-foreground mb-3 text-sm font-medium uppercase tracking-wide">Incident lifecycle</p>
        <h2 class="text-h3 sm:text-h2 mb-4 font-medium">Din alertă până la control recâștigat.</h2>
        <p class="text-muted-foreground text-lg leading-relaxed">
          Ordinea exactă se poate schimba în funcție de impact, dar fiecare incident trebuie să aibă un fir coerent de decizie, containment și recovery.
        </p>
      </div>

      <div class="relative mx-auto max-w-6xl">
        <div class="absolute top-5 right-[10%] left-[10%] hidden h-px bg-border lg:block"></div>
        <div class="grid gap-10 lg:grid-cols-5 lg:gap-7">
          {phases.map((item) => (
            <article class="relative">
              <div class="mb-5 flex size-10 items-center justify-center rounded-full border bg-background font-mono text-xs">{item.step}</div>
              <h3 class="text-h5 mb-3 font-medium">{item.title}</h3>
              <p class="text-muted-foreground leading-relaxed">{item.text}</p>
            </article>
          ))}
        </div>
      </div>
    </section>

    <section class="bg-active py-12 sm:py-24">
      <div class="container grid items-center gap-12 lg:grid-cols-[0.8fr_1.2fr] lg:gap-24">
        <div>
          <p class="text-muted-foreground mb-3 text-sm font-medium uppercase tracking-wide">Evidence before cleanup</p>
          <h2 class="text-h3 sm:text-h2 mb-5 font-medium">Un timeline bun poate valora mai mult decât un reinstall rapid.</h2>
          <p class="text-muted-foreground mb-5 text-lg leading-relaxed">
            Orele, simptomele, schimbările, logurile și acțiunile luate ajută la separarea vectorului inițial de efectele incidentului. Nu păstrăm date fără motiv, dar evităm să distrugem exact contextul de care avem nevoie.
          </p>
          <p class="text-muted-foreground leading-relaxed">
            Evidence-ul colectat poate conține informații sensibile; accesul trebuie limitat la persoanele care au nevoie de el pentru incident.
          </p>
        </div>

        <div class="overflow-hidden rounded-2xl border bg-level-0 shadow-sm">
          <div class="flex items-center justify-between border-b px-5 py-4">
            <span class="font-medium">incident-timeline.log</span>
            <span class="text-muted-foreground text-xs">preserve context</span>
          </div>
          <div class="divide-y font-mono text-sm">
            <div class="grid grid-cols-[82px_1fr] gap-5 px-5 py-4">
              <span class="text-muted-foreground">09:14</span>
              <span>Unusual sign-in confirmed</span>
            </div>
            <div class="grid grid-cols-[82px_1fr] gap-5 px-5 py-4">
              <span class="text-muted-foreground">09:22</span>
              <span>Suspicious session isolated</span>
            </div>
            <div class="grid grid-cols-[82px_1fr] gap-5 px-5 py-4">
              <span class="text-muted-foreground">09:37</span>
              <span>Forwarding rule preserved and reviewed</span>
            </div>
            <div class="grid grid-cols-[82px_1fr] gap-5 px-5 py-4">
              <span class="text-muted-foreground">10:05</span>
              <span>Containment decision approved</span>
            </div>
            <div class="grid grid-cols-[82px_1fr] gap-5 px-5 py-4">
              <span class="text-muted-foreground">10:41</span>
              <span>Recovery validation started</span>
            </div>
          </div>
        </div>
      </div>
    </section>

    <section class="container py-12 sm:py-24">
      <div class="grid gap-12 lg:grid-cols-[0.8fr_1.2fr] lg:gap-24">
        <div class="lg:sticky lg:top-28">
          <p class="text-muted-foreground mb-3 text-sm font-medium uppercase tracking-wide">Escalation</p>
          <h2 class="text-h3 sm:text-h2 mb-5 font-medium">Nu orice alertă este incident major. Unele însă nu trebuie tratate cu „restart și vedem”.</h2>
          <p class="text-muted-foreground text-lg leading-relaxed">
            Escalarea depinde de acces, persistență, date, disponibilitate și impactul asupra serviciului. Aceste scenarii sunt puncte de pornire, nu clasificări automate.
          </p>
        </div>

        <div class="grid gap-x-10 sm:grid-cols-2">
          {scenarios.map(([title, text]) => (
            <article class="border-t py-6">
              <h3 class="text-h5 mb-2 font-medium">{title}</h3>
              <p class="text-muted-foreground leading-relaxed">{text}</p>
            </article>
          ))}
        </div>
      </div>
    </section>

    <section class="bg-level-3 py-12 text-level-0-foreground sm:py-24">
      <div class="container">
        <div class="mb-12 max-w-3xl sm:mb-16">
          <p class="text-level-0-foreground/55 mb-3 text-sm font-medium uppercase tracking-wide">Decision owners</p>
          <h2 class="text-h3 sm:text-h2 mb-4 font-medium">Un incident tehnic devine rapid o problemă de business.</h2>
          <p class="text-level-0-foreground/65 text-lg leading-relaxed">
            Echipa tehnică nu ar trebui să decidă singură opriri majore, notificări sau risk acceptance. Rolurile trebuie clare înainte ca presiunea incidentului să le facă neclare.
          </p>
        </div>

        <div class="grid gap-10 sm:grid-cols-2 lg:grid-cols-4 lg:gap-12">
          {roles.map((item, index) => (
            <article>
              <span class="text-level-0-foreground/40 mb-7 block font-mono text-sm">0{index + 1}</span>
              <h3 class="text-h4 mb-3 font-medium">{item.title}</h3>
              <p class="text-level-0-foreground/65 leading-relaxed">{item.text}</p>
            </article>
          ))}
        </div>
      </div>
    </section>

    <section class="container py-12 sm:py-24">
      <div class="grid gap-14 lg:grid-cols-2 lg:gap-24">
        <div>
          <p class="text-muted-foreground mb-3 text-sm font-medium uppercase tracking-wide">Recovery criteria</p>
          <h2 class="text-h3 sm:text-h2 mb-5 font-medium">„Site-ul merge” nu înseamnă automat „incident închis”.</h2>
          <p class="text-muted-foreground mb-7 text-lg leading-relaxed">
            Revenirea în producție trebuie să ia în calcul cauza, persistența, identity, starea backup-ului și monitoring-ul activ după restore.
          </p>
          <div class="space-y-4">
            {recoveryChecks.map((item) => (
              <div class="flex items-start gap-3">
                <span class="mt-2 size-1.5 shrink-0 rounded-full bg-foreground"></span>
                <p class="text-muted-foreground leading-relaxed">{item}</p>
              </div>
            ))}
          </div>
        </div>

        <div>
          <p class="text-muted-foreground mb-3 text-sm font-medium uppercase tracking-wide">What remains after recovery</p>
          <h2 class="text-h3 sm:text-h2 mb-7 font-medium">Incidentul trebuie să lase în urmă un program mai bun.</h2>
          <div class="divide-y border-y">
            {outputs.map(([title, text]) => (
              <article class="py-5">
                <h3 class="font-medium">{title}</h3>
                <p class="text-muted-foreground mt-2 leading-relaxed">{text}</p>
              </article>
            ))}
          </div>
        </div>
      </div>
    </section>

    <section class="container py-10 sm:py-20">
      <div class="mx-auto max-w-3xl">
        <h2 class="text-h3 sm:text-h2 mb-8 text-center font-medium">Întrebări frecvente</h2>
        <div class="border-y">
          {faqs.map((faq) => (
            <details class="group border-b py-5 last:border-b-0">
              <summary class="flex cursor-pointer list-none items-center justify-between gap-6 font-medium">
                <span>{faq.question}</span>
                <span class="text-muted-foreground text-xl transition-transform group-open:rotate-45">+</span>
              </summary>
              <p class="text-muted-foreground max-w-2xl pt-4 leading-relaxed">{faq.answer}</p>
            </details>
          ))}
        </div>
      </div>
    </section>

    <section class="container py-12 text-center sm:py-24">
      <h2 class="text-h3 sm:text-h2 mx-auto mb-4 max-w-190 font-medium text-balance">
        Dacă există un incident activ, începe cu simptomele și impactul observat.
      </h2>
      <p class="text-muted-foreground mx-auto mb-8 max-w-160 text-lg">
        Nu trimite secrete prin formularul public. Stabilim canalul și accesul necesar după primul contact.
      </p>
      <Button href="/contact" size="lg">Contactează ZebraByte</Button>
    </section>
  </main>
</Layout>

<script>
  import { AnimatedHero } from "../lib/elements/hero";
  import { customElementDefine } from "../lib/dom";
  customElementDefine("animated-hero", () => AnimatedHero);
</script>
