---
import "@phosphor-icons/web/regular";
import Layout from "../layouts/Layout.astro";
import Button from "../components/ui/Button.svelte";
import LottiePlayer from "../components/LottiePlayer.svelte";

const features = [
  {
    icon: "ph-file-lock",
    title: "Documente cu acces controlat",
    description:
      "Publică politici, rapoarte, dovezi și materiale de securitate într-un singur portal și decide ce este public, restricționat sau disponibil doar după aprobare.",
  },
  {
    icon: "ph-signature",
    title: "NDA înainte de documentele sensibile",
    description:
      "Documentele sensibile pot fi protejate printr-un flux de acces care cere acceptarea unui NDA înainte de vizualizare sau descărcare.",
  },
  {
    icon: "ph-key",
    title: "Magic link și SSO",
    description:
      "Reduce fricțiunea pentru clienți și parteneri prin autentificare simplă, fără a sacrifica controlul asupra accesului.",
  },
  {
    icon: "ph-bell-simple",
    title: "Actualizări controlate",
    description:
      "Abonații pot fi informați când se schimbă documentele, subprocessors, rapoartele sau alte informații relevante pentru evaluarea lor.",
  },
  {
    icon: "ph-shield-check",
    title: "Trust Center conectat la programul GRC",
    description:
      "Portalul nu este o pagină de marketing izolată: informațiile publicate provin din programul de securitate și conformitate gestionat în platformă.",
  },
];

const workflows = [
  {
    title: "Aprobă accesul fără workflow-uri paralele",
    lottie: "/lottie/trust-center/slack.json",
    bullets: [
      "Primești și procesezi cererile de acces din fluxurile echipei.",
      "Decizia rămâne sincronizată cu portalul și istoricul de acces.",
      "Poți separa documentele publice de cele care cer aprobare explicită.",
    ],
  },
  {
    title: "Protejează documentele sensibile prin NDA",
    lottie: "/lottie/trust-center/nda.json",
    reverse: true,
    bullets: [
      "Solicită acceptarea unui NDA înainte de acces la materiale protejate.",
      "Păstrează procesul în aceeași experiență, fără schimburi inutile de emailuri.",
      "Aplică watermarking și reguli de acces acolo unde sunt suportate de platformă.",
    ],
  },
  {
    title: "Autentificare cu fricțiune redusă",
    lottie: "/lottie/trust-center/authentication.json",
    bullets: [
      "Magic links sau SSO pentru vizitatorii autorizați.",
      "Fără conturi suplimentare create doar pentru un security review.",
      "Controlul accesului rămâne centralizat și auditabil.",
    ],
  },
  {
    title: "Ține stakeholderii informați",
    lottie: "/lottie/trust-center/updates.json",
    reverse: true,
    bullets: [
      "Alege ce schimbări merită comunicate abonaților.",
      "Actualizează materialele fără a recrea manual un trust page separat.",
      "Menține informația relevantă pentru clienți și due-diligence.",
    ],
  },
];

const publish = [
  {
    title: "Documente",
    description: "Politici, rapoarte, certificări și alte materiale organizate într-o bibliotecă controlată.",
  },
  {
    title: "Protected assets",
    description: "Fișiere sensibile accesibile numai utilizatorilor sau organizațiilor autorizate.",
  },
  {
    title: "Audituri și findings",
    description: "Context despre evaluări, istoricul auditurilor și materialele aprobate pentru partajare.",
  },
  {
    title: "Subprocessors",
    description: "Lista furnizorilor relevanți și informațiile necesare pentru evaluarea third-party risk.",
  },
  {
    title: "Data requests",
    description: "Fluxuri pentru solicitări privind datele, cu pași și responsabilități mai clare.",
  },
  {
    title: "Security commitments",
    description: "Explică într-o formă verificabilă măsurile și angajamentele de securitate asumate de organizație.",
  },
];

const faqs = [
  {
    q: "Poate rula pe domeniul companiei?",
    a: "Da. Modelul de Compliance Portal suportă publicarea pe un domeniu dedicat al organizației, de exemplu trust.company.tld, în funcție de configurația deployment-ului.",
  },
  {
    q: "Putem publica rapoarte de pentest sau audit?",
    a: "Da. Documentele pot fi adăugate în platformă și expuse cu nivelul de vizibilitate potrivit: public, restricționat sau ascuns.",
  },
  {
    q: "Putem cere NDA înainte de acces?",
    a: "Da. Fluxul portalului poate proteja documentele sensibile printr-un pas NDA înainte de acces, astfel încât security review-ul să rămână controlat.",
  },
  {
    q: "Ce se întâmplă când un document se schimbă?",
    a: "Portalul este gândit să reflecte versiunea curentă a informației din programul de compliance, reducând nevoia de actualizare manuală a unui trust page separat.",
  },
  {
    q: "Este doar un trust page?",
    a: "Nu. Valoarea vine din legătura cu programul GRC: documente, riscuri, third parties, audits, access decisions și alte înregistrări pot fi gestionate în același model operațional.",
  },
];

const softwareApplicationSchema = {
  "@context": "https://schema.org",
  "@type": "SoftwareApplication",
  name: "ZebraByte Compliance Portal",
  applicationCategory: "BusinessApplication",
  operatingSystem: "Web",
  description:
    "Portal securizat pentru publicarea și controlul accesului la documente de securitate, privacy și compliance.",
  url: "https://www.zebrabyte.ro/compliance-portal",
  publisher: {
    "@type": "Organization",
    name: "ZebraByte",
    url: "https://www.zebrabyte.ro",
  },
};
---

<Layout
  title="Compliance Portal & Trust Center"
  description="Compliance Portal ZebraByte pentru documente de securitate și conformitate, NDA, acces controlat, autentificare și actualizări conectate la programul GRC."
>
  <script
    type="application/ld+json"
    set:html={JSON.stringify(softwareApplicationSchema)}
  />

  <main class="-mt-16 overflow-hidden pt-16">
    <section class="relative isolate overflow-hidden">
      <div
        aria-hidden="true"
        class="pointer-events-none absolute top-[-1280px] left-1/2 z-0 size-[2200px] -translate-x-1/2 rounded-full border-[340px] border-[#E6FF03] blur-[100px]"
      ></div>

      <div class="relative z-10 container py-16 text-center sm:py-24">
        <div class="border-border-low text-tertiary-foreground animate-perspective-in mx-auto mb-6 w-max rounded-lg border px-2 py-0.5 text-sm font-medium">
          ZebraByte Compliance Portal
        </div>
        <h1 class="text-h2 sm:text-h1 mx-auto mb-6 max-w-190 font-medium text-balance">
          <span class="animate-perspective-in block">Documentația de securitate,</span>
          <span class="animate-perspective-in animation-delay-100 block">cu accesul sub control.</span>
        </h1>
        <p class="text-muted-foreground animate-perspective-in animation-delay-200 mx-auto mb-8 max-w-150 text-lg text-balance">
          Oferă clienților și partenerilor un singur loc pentru security reviews,
          documente, subprocessors și dovezi — fără să expui mai mult decât trebuie.
        </p>
        <div class="animate-perspective-in animation-delay-300 flex flex-col justify-center gap-3 sm:flex-row">
          <Button href="/contact" size="lg">Discută cu un expert</Button>
          <Button
            href="https://trust.zebrabyte.ro"
            variant="secondary"
            size="lg"
            target="_blank"
            rel="noopener noreferrer"
          >
            Vezi Trust Center-ul ZebraByte
          </Button>
        </div>
      </div>

      <div class="relative z-10 container pb-6 sm:pb-12">
        <img
          src="/trust-center/browser.svg"
          alt="Previzualizare Compliance Portal"
          width="1146"
          height="786"
          loading="eager"
          decoding="async"
          fetchpriority="high"
          class="animate-slide-in mx-auto h-auto w-full"
        />
      </div>
    </section>

    <section class="container py-16 sm:py-28">
      <div class="mx-auto mb-12 max-w-180 text-center">
        <p class="text-muted-foreground mb-3 text-sm font-medium uppercase tracking-[0.12em]">
          Trust, fără oversharing
        </p>
        <h2 class="text-h3 sm:text-h2 mb-4 font-medium text-balance">
          Publici exact ce trebuie. Restul rămâne protejat.
        </h2>
        <p class="text-muted-foreground text-lg">
          Păstrăm modelul Probo care ne place: portalul este parte din programul de
          compliance, nu un microsite separat care trebuie întreținut manual.
        </p>
      </div>

      <div class="grid gap-px overflow-hidden rounded-2xl border bg-border sm:grid-cols-2 lg:grid-cols-3">
        {
          features.map((feature) => (
            <article class="bg-level-0 p-6 sm:p-8">
              <i class={`ph ${feature.icon} mb-5 block text-2xl`} aria-hidden="true"></i>
              <h3 class="text-h5 mb-2 font-medium">{feature.title}</h3>
              <p class="text-muted-foreground leading-relaxed">{feature.description}</p>
            </article>
          ))
        }
      </div>
    </section>

    <section class="bg-active py-16 sm:py-28">
      <div class="container">
        <div class="mx-auto mb-12 max-w-180 text-center">
          <h2 class="text-h3 sm:text-h2 mb-4 font-medium">Controlul accesului, integrat în workflow</h2>
          <p class="text-muted-foreground text-lg">
            Păstrăm animațiile și fluxurile originale ale portalului, dar le prezentăm
            în contextul ZebraByte și al deployment-ului real al platformei.
          </p>
        </div>

        <div class="space-y-12 sm:space-y-20">
          {
            workflows.map((workflow) => (
              <article
                class:list={[
                  "grid items-center gap-8 lg:grid-cols-2 lg:gap-16",
                  workflow.reverse && "lg:[&>*:first-child]:order-2",
                ]}
              >
                <div class="bg-level-0 overflow-hidden rounded-2xl border p-4 sm:p-8">
                  <LottiePlayer src={workflow.lottie} client:visible />
                </div>
                <div>
                  <h3 class="text-h3 mb-5 font-medium text-balance">{workflow.title}</h3>
                  <ul class="space-y-3">
                    {workflow.bullets.map((bullet) => (
                      <li class="text-muted-foreground flex gap-3 leading-relaxed">
                        <span class="mt-2 size-1.5 shrink-0 rounded-full bg-current"></span>
                        <span>{bullet}</span>
                      </li>
                    ))}
                  </ul>
                </div>
              </article>
            ))
          }
        </div>
      </div>
    </section>

    <section class="container py-16 sm:py-28">
      <div class="mx-auto mb-12 max-w-170 text-center">
        <h2 class="text-h3 sm:text-h2 mb-4 font-medium">Ce poți publica în portal</h2>
        <p class="text-muted-foreground text-lg">
          Security reviews cer mai mult decât un badge. Portalul poate organiza
          informațiile care ajută un client să îți evalueze postura reală.
        </p>
      </div>

      <div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
        {
          publish.map((item) => (
            <article class="rounded-2xl border p-6 sm:p-8">
              <h3 class="text-h5 mb-2 font-medium">{item.title}</h3>
              <p class="text-muted-foreground leading-relaxed">{item.description}</p>
            </article>
          ))
        }
      </div>
    </section>

    <section class="bg-level-0 border-y py-16 sm:py-24">
      <div class="container grid gap-10 lg:grid-cols-[0.8fr_1.2fr] lg:gap-20">
        <div>
          <p class="text-muted-foreground mb-3 text-sm font-medium uppercase tracking-[0.12em]">FAQ</p>
          <h2 class="text-h3 sm:text-h2 font-medium">Compliance Portal</h2>
        </div>
        <div class="divide-y border-y">
          {
            faqs.map((faq) => (
              <details class="group py-5">
                <summary class="flex cursor-pointer list-none items-center justify-between gap-4 font-medium">
                  {faq.q}
                  <span class="text-muted-foreground text-xl transition-transform group-open:rotate-45">+</span>
                </summary>
                <p class="text-muted-foreground max-w-180 pt-3 leading-relaxed">{faq.a}</p>
              </details>
            ))
          }
        </div>
      </div>
    </section>

    <section class="container py-16 text-center sm:py-28">
      <h2 class="text-h3 sm:text-h2 mx-auto mb-4 max-w-180 font-medium text-balance">
        Transformă due diligence-ul într-o experiență controlată.
      </h2>
      <p class="text-muted-foreground mx-auto mb-8 max-w-150 text-lg">
        Portalul, security program-ul și compliance-ul trebuie să spună aceeași poveste — cu dovezi actuale, nu cu documente împrăștiate.
      </p>
      <Button href="/contact" size="lg">Discută cu ZebraByte</Button>
    </section>
  </main>
</Layout>
