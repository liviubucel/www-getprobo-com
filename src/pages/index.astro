---
import Layout from "../layouts/Layout.astro";
import Button from "../components/ui/Button.svelte";
import Badges from "../components/Badges.svelte";
import Logos from "../components/block/Logos.astro";
import ZebraByteTestimonials from "../components/block/ZebraByteTestimonials.astro";
import SaleArg from "../components/ui/SaleArg.astro";
import Stories from "../components/block/Stories.astro";
import ComplianceTrack from "../components/block/ComplianceTrack.astro";

const websiteSchema = {
  "@context": "https://schema.org",
  "@type": "WebSite",
  name: "ZebraByte",
  alternateName: "ZebraByte Conformitate Administrată & Securitate Cibernetică",
  url: "https://www.zebrabyte.ro",
  publisher: {
    "@type": "Organization",
    name: "ZebraByte",
    url: "https://www.zebrabyte.ro",
  },
};
---

<Layout
  title="Conformitate administrată & securitate cibernetică"
  description="Conformitate administrată, securitate cibernetică și găzduire securizată într-un singur program ZebraByte, cu controale, dovezi și pregătire continuă pentru audit."
>
  <script type="application/ld+json" set:html={JSON.stringify(websiteSchema)} />

  <animated-hero
    class="relative -mt-16 block overflow-hidden px-5 py-10 pt-26 sm:pt-36 sm:pb-12"
  >
    <div
      class="yc-btn text-muted-foreground animate-perspective-in animation-delay-300 mx-auto mb-6 flex w-max items-center gap-2 px-4 py-2 sm:mb-8"
    >
      Conformitate administrată · Securitate cibernetică
    </div>

    <h1
      class="text-h2 sm:text-h1 mb-6 overflow-hidden text-center font-medium text-balance sm:mb-8"
    >
      <span class="animate-perspective-in block">Conformitate și securitate,</span>
      <span class="animate-perspective-in block delay-50"> gestionate pentru tine. </span>
    </h1>

    <p
      class="text-muted-foreground animate-perspective-in animation-delay-150 mx-auto mb-6 max-w-200 text-center text-lg text-balance sm:mb-8"
    >
      Un expert coordonează programul de conformitate de la început până la final, iar echipa
      de securitate cibernetică leagă controalele de măsuri tehnice reale: protecția
      aplicațiilor, securitatea emailului, răspunsul la incidente și infrastructura
      construită cu securitatea în centru.
    </p>

    <div
      class="mb-11 flex flex-col items-stretch justify-center gap-3 sm:mb-17 sm:flex-row sm:items-center"
    >
      <Button
        class="animate-perspective-in animation-delay-200"
        variant="secondary"
        size="lg"
        href="/managed-compliance"
      >
        Conformitate administrată
      </Button>
      <Button
        class="animate-perspective-in animation-delay-300"
        size="lg"
        rel="nofollow noreferrer"
        href="/contact"
      >
        Discută cu un expert
      </Button>
    </div>

    <Badges
      count={10}
      countMobile={6}
      client:load
      border
      class="mx-auto grid max-w-[960px] grid-cols-3 sm:grid-cols-5"
    />

    <section class="mt-11 mix-blend-multiply sm:mt-17">
      <h2 class="text-tertiary-foreground animate-perspective-in animation-delay-300 text-center">
        Organizații din biblioteca de referință a platformei
      </h2>
      <Logos class="animate-slide-in animation-delay-300" constrained />
    </section>
  </animated-hero>

  <ComplianceTrack />

  <section class="container py-10 sm:py-20">
    <h2 class="text-h3 sm:text-h2 mb-3 text-center font-medium">
      Pune conformitatea și securitatea pe pilot automat
    </h2>
    <p
      class="text-muted-foreground mx-auto mb-10 max-w-180 text-center text-lg sm:mb-12"
    >
      Rulează programul cu o combinație de expertiză și automatizare. ZebraByte urmărește
      controalele, dovezile și riscurile, iar măsurile tehnice sunt implementate și menținute
      în același model operațional.
    </p>

    <div
      class="flex grid-cols-2 flex-col items-start gap-10 sm:grid sm:gap-x-20 sm:gap-y-12"
    >
      <SaleArg
        title="Expert dedicat pentru conformitate"
        video="/videos/keyshot1.mp4"
      >
        <p>
          Un specialist coordonează politicile, controalele, evaluările de risc,
          evaluările furnizorilor, cerințele de accesibilitate și pregătirea pentru audit,
          ca extensie a echipei tale.
        </p>
      </SaleArg>

      <SaleArg
        title="Conformitate care rulează în fundal"
        video="/videos/keyshot2.mp4"
      >
        <p>
          Colectarea dovezilor, aprobările și acțiunile repetitive sunt automatizate, iar
          echipa urmărește schimbările care pot afecta postura de conformitate.
        </p>
      </SaleArg>

      <SaleArg
        title="Transformă controalele în securitate reală"
        video="/videos/keyshot3.mp4"
      >
        <p>
          Evaluarea de securitate, protecția site-ului și a emailului, consolidarea
          configurațiilor, gestionarea vulnerabilităților și găzduirea securizată susțin
          direct tratarea riscurilor și controalele asumate.
        </p>
      </SaleArg>

      <SaleArg
        title="Lucrează dintr-un singur program"
        video="/videos/keyshot4.mp4"
      >
        <p>
          Documentele, acțiunile, dovezile, verificările și integrarea cu fluxurile de lucru
          ale echipei rămân centralizate, fără un catalog fragmentat de servicii fără
          legătură între ele.
        </p>
      </SaleArg>
    </div>
  </section>

  <ZebraByteTestimonials />

  <Stories />
</Layout>

<script>
  import { AnimatedHero } from "../lib/elements/hero";
  import { customElementDefine } from "../lib/dom";

  customElementDefine("animated-hero", () => AnimatedHero);
</script>
