---
import Layout from "../layouts/Layout.astro";
import Button from "../components/ui/Button.svelte";
import Badges from "../components/Badges.svelte";
import Logos from "../components/block/Logos.astro";
import Testimonials from "../components/block/Testimonials.astro";
import SaleArg from "../components/ui/SaleArg.astro";
import Stories from "../components/block/Stories.astro";
import ComplianceTrack from "../components/block/ComplianceTrack.astro";

const websiteSchema = {
  "@context": "https://schema.org",
  "@type": "WebSite",
  name: "ZebraByte",
  alternateName: "ZebraByte Cyber Security & Compliance",
  url: "https://www.zebrabyte.ro",
  publisher: {
    "@type": "Organization",
    name: "ZebraByte",
    url: "https://www.zebrabyte.ro",
  },
};
---

<Layout
  title="Cyber Security & Compliance"
  description="Securitate cibernetică, GDPR, NIS2, ISO 27001 readiness, compliance automation și infrastructură securizată, gestionate într-un singur loc de ZebraByte."
>
  <script type="application/ld+json" set:html={JSON.stringify(websiteSchema)} />

  <animated-hero
    class="relative -mt-16 block overflow-hidden px-5 py-10 pt-26 sm:pt-36 sm:pb-12"
  >
    <div
      class="yc-btn text-muted-foreground animate-perspective-in animation-delay-300 mx-auto mb-6 flex w-max items-center gap-2 px-4 py-2 sm:mb-8"
    >
      Cyber Security · Privacy · Compliance
    </div>

    <h1
      class="text-h2 sm:text-h1 mb-6 overflow-hidden text-center font-medium text-balance sm:mb-8"
    >
      <span class="animate-perspective-in block">Securitate și conformitate,</span>
      <span class="animate-perspective-in block delay-50"> gestionate pentru tine. </span>
    </h1>

    <p
      class="text-muted-foreground animate-perspective-in animation-delay-150 mx-auto mb-6 max-w-200 text-center text-lg text-balance sm:mb-8"
    >
      ZebraByte combină expertiza tehnică de securitate cu privacy și compliance.
      De la evaluarea riscului și hardening până la GDPR, NIS2 și pregătire pentru
      ISO 27001, programul este gestionat cap-coadă și menținut continuu audit-ready.
    </p>

    <div
      class="mb-11 flex flex-col items-stretch justify-center gap-3 sm:mb-17 sm:flex-row sm:items-center"
    >
      <Button
        class="animate-perspective-in animation-delay-200"
        variant="secondary"
        size="lg"
        href="/docs/deployment/self-hosting/docker-compose"
        data-ph-event="deploy_open_source_click">Vezi platforma open-source</Button
      >
      <Button
        class="animate-perspective-in animation-delay-300"
        size="lg"
        rel="nofollow noreferrer"
        href="/contact">Discută cu un expert</Button
      >
    </div>

    <Badges
      count={10}
      countMobile={6}
      client:load
      border
      class="mx-auto grid max-w-[960px] grid-cols-3 sm:grid-cols-5"
    />

    <section class="mt-11 mix-blend-multiply sm:mt-17">
      <h2
        class="text-tertiary-foreground animate-perspective-in animation-delay-300 text-center"
      >
        Tehnologii și infrastructură folosite de ZebraByte
      </h2>
      <Logos class="animate-slide-in animation-delay-300" constrained />
    </section>
  </animated-hero>

  <ComplianceTrack />

  <section class="container py-10 sm:py-20">
    <h2 class="text-h3 sm:text-h2 mb-3 text-center font-medium">
      Securitate și compliance care rulează în fundal
    </h2>
    <p
      class="text-muted-foreground mx-auto mb-10 max-w-180 text-center text-lg sm:mb-12"
    >
      Păstrăm modelul care face platforma simplă: experți care preiau munca grea și
      automatizare care ține controalele, dovezile și riscurile sub control. Tu intri
      în proces doar când este nevoie de o decizie reală.
    </p>

    <div
      class="flex grid-cols-2 flex-col items-start gap-10 sm:grid sm:gap-x-20 sm:gap-y-12"
    >
      <SaleArg
        title="Expert dedicat pentru securitate și conformitate"
        video="/videos/keyshot1.mp4"
      >
        <p>
          Ai un punct unic de contact care înțelege infrastructura, riscul, politicile
          și cerințele de conformitate. Nu primești doar ticket-uri și checklist-uri,
          ci un program coordonat și urmărit de la început până la rezultat.
        </p>
      </SaleArg>

      <SaleArg
        title="Controale și dovezi menținute continuu"
        video="/videos/keyshot2.mp4"
      >
        <p>
          Platforma automatizează colectarea și urmărirea dovezilor, iar echipa
          ZebraByte menține controalele, evaluările și documentația sincronizate cu
          realitatea tehnică a organizației.
        </p>
      </SaleArg>

      <SaleArg
        title="Securitate tehnică + governance, nu doar documente"
        video="/videos/keyshot3.mp4"
      >
        <p>
          Compliance-ul nu are valoare dacă infrastructura rămâne vulnerabilă. Legăm
          politicile de hardening, protecția aplicațiilor, email security, monitorizare,
          vulnerability management și măsuri tehnice verificabile.
        </p>
      </SaleArg>

      <SaleArg title="Lucrezi din instrumentele pe care deja le folosești" video="/videos/keyshot4.mp4">
        <p>
          Accesezi documente, urmărești acțiuni, declanșezi workflow-uri și comunici
          direct cu echipa fără procese inutile. Integrările și automatizarea rămân o
          parte centrală a experienței platformei.
        </p>
      </SaleArg>
    </div>
  </section>

  <Testimonials />

  <!-- Open-source section from the original Probo experience remains available for reactivation. -->

  <Stories />
</Layout>

<script>
  import { AnimatedHero } from "../lib/elements/hero";
  import { customElementDefine } from "../lib/dom";

  customElementDefine("animated-hero", () => AnimatedHero);
</script>
