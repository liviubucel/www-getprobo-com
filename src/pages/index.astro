---
import Layout from "../layouts/Layout.astro";
import YCombinator from "../assets/ycombinator.svg";
import { Image } from "astro:assets";
import Button from "../components/ui/Button.svelte";
import Badges from "../components/Badges.svelte";
import Logos from "../components/block/Logos.astro";
import Testimonials from "../components/block/Testimonials.astro";
import SaleArg from "../components/ui/SaleArg.astro";
import Stories from "../components/block/Stories.astro";
import ComplianceTrack from "../components/block/ComplianceTrack.astro";

const websiteSchema = {
  "@context": "https://schema.org",
  "@type": "WebSite",
  name: "ZebraByte",
  alternateName: "ZebraByte Cyber Security & Compliance",
  url: "https://www.zebrabyte.ro",
  publisher: {
    "@type": "Organization",
    name: "ZebraByte",
    url: "https://www.zebrabyte.ro",
  },
};

const solutions = [
  {
    eyebrow: "Protect",
    title: "Cyber Security",
    description: "Evaluare, hardening, vulnerability management, protecția aplicațiilor și suport pentru incidente.",
    href: "/cyber-security",
  },
  {
    eyebrow: "Privacy",
    title: "GDPR & Privacy",
    description: "Maparea datelor, măsuri tehnice, politici, evidențe și procese de privacy legate de infrastructura reală.",
    href: "/gdpr",
  },
  {
    eyebrow: "Resilience",
    title: "NIS2 Readiness",
    description: "Risk management, governance, controale, incident readiness și evidence pentru organizațiile vizate de NIS2.",
    href: "/nis2",
  },
  {
    eyebrow: "ISMS",
    title: "ISO/IEC 27001 Readiness",
    description: "Construirea și operarea unui ISMS cu riscuri, controale, dovezi și îmbunătățire continuă.",
    href: "/iso-27001",
  },
  {
    eyebrow: "Infrastructure",
    title: "Secure Managed Hosting",
    description: "Infrastructură administrată cu hardening, izolare, backup, monitorizare și operațiuni security-first.",
    href: "/secure-hosting",
  },
  {
    eyebrow: "Inclusive",
    title: "Digital Accessibility",
    description: "Evaluare WCAG, remediere și procese care mențin experiențele digitale accesibile în timp.",
    href: "/accessibility",
  },
];
---

<Layout
  title="Cyber Security & Compliance"
  description="Securitate cibernetică, GDPR, NIS2, ISO 27001 readiness, compliance automation și infrastructură securizată, gestionate într-un singur loc de ZebraByte."
>
  <script type="application/ld+json" set:html={JSON.stringify(websiteSchema)} />

  <animated-hero
    class="relative -mt-16 block overflow-hidden px-5 py-10 pt-26 sm:pt-36 sm:pb-12"
  >
    <a
      href="https://www.ycombinator.com/companies/probo"
      target="_blank"
      rel="noopener noreferrer"
      class="yc-btn text-muted-foreground animate-perspective-in animation-delay-300 mx-auto mb-6 flex w-max items-center gap-2 px-4 py-2 sm:mb-8"
      aria-label="Probo upstream is backed by Y Combinator"
    >
      Platform core upstream · Probo backed by
      <Image src={YCombinator} alt="Y Combinator" width={77} height={15} />
    </a>

    <h1 class="text-h2 sm:text-h1 mb-6 overflow-hidden text-center font-medium text-balance sm:mb-8">
      <span class="animate-perspective-in block">Securitate și conformitate,</span>
      <span class="animate-perspective-in block delay-50"> gestionate pentru tine. </span>
    </h1>

    <p class="text-muted-foreground animate-perspective-in animation-delay-150 mx-auto mb-6 max-w-200 text-center text-lg text-balance sm:mb-8">
      ZebraByte extinde experiența Probo cu securitate cibernetică, privacy și infrastructură gestionată.
      De la evaluarea riscului și hardening până la GDPR, NIS2 și ISO 27001 readiness,
      programul este coordonat într-un singur loc și menținut continuu audit-ready.
    </p>

    <div class="mb-11 flex flex-col items-stretch justify-center gap-3 sm:mb-17 sm:flex-row sm:items-center">
      <Button class="animate-perspective-in animation-delay-200" variant="secondary" size="lg" href="/docs/deployment/self-hosting/docker-compose" data-ph-event="deploy_open_source_click">Vezi platforma open-source</Button>
      <Button class="animate-perspective-in animation-delay-300" size="lg" rel="nofollow noreferrer" href="/contact">Discută cu un expert</Button>
    </div>

    <Badges count={10} countMobile={6} client:load border class="mx-auto grid max-w-[960px] grid-cols-3 sm:grid-cols-5" />

    <section class="mt-11 mix-blend-multiply sm:mt-17">
      <h2 class="text-tertiary-foreground animate-perspective-in animation-delay-300 text-center">
        Companiile și logo-urile păstrate din experiența originală Probo
      </h2>
      <p class="text-muted-foreground mx-auto mt-2 max-w-180 text-center text-sm">
        Biblioteca vizuală upstream este păstrată integral; aceste logo-uri nu sunt prezentate drept clienți ZebraByte.
      </p>
      <Logos class="animate-slide-in animation-delay-300" constrained />
    </section>
  </animated-hero>

  <ComplianceTrack />

  <section class="container py-10 sm:py-20">
    <div class="mx-auto mb-10 max-w-190 text-center sm:mb-14">
      <p class="text-muted-foreground mb-3 text-sm font-medium uppercase tracking-[0.14em]">ZebraByte</p>
      <h2 class="text-h3 sm:text-h2 mb-4 font-medium">Un singur program pentru security, privacy și compliance</h2>
      <p class="text-muted-foreground text-lg">
        Nu separăm documentația de infrastructura care trebuie protejată. Fiecare verticală se conectează la aceleași riscuri, controale, dovezi și operațiuni.
      </p>
    </div>

    <div class="grid gap-px overflow-hidden rounded-2xl border bg-[var(--color-border-low)] sm:grid-cols-2 lg:grid-cols-3">
      {
        solutions.map((solution) => (
          <a href={solution.href} class="bg-level-0 group min-h-56 p-6 transition-colors hover:bg-subtle sm:p-8">
            <p class="text-muted-foreground mb-10 text-sm font-medium">{solution.eyebrow}</p>
            <h3 class="mb-3 text-xl font-medium group-hover:underline group-hover:underline-offset-4">{solution.title}</h3>
            <p class="text-muted-foreground leading-relaxed">{solution.description}</p>
          </a>
        ))
      }
    </div>
  </section>

  <section class="container py-10 sm:py-20">
    <h2 class="text-h3 sm:text-h2 mb-3 text-center font-medium">Securitate și compliance care rulează în fundal</h2>
    <p class="text-muted-foreground mx-auto mb-10 max-w-180 text-center text-lg sm:mb-12">
      Păstrăm modelul Probo care face compliance-ul simplu: experți care preiau munca grea și automatizare care ține controalele, dovezile și riscurile sub control. ZebraByte extinde același model către securitatea tehnică și infrastructură.
    </p>

    <div class="flex grid-cols-2 flex-col items-start gap-10 sm:grid sm:gap-x-20 sm:gap-y-12">
      <SaleArg title="Expert dedicat pentru securitate și conformitate" video="/videos/keyshot1.mp4">
        <p>Ai un punct unic de contact care înțelege infrastructura, riscul, politicile și cerințele de conformitate. Nu primești doar ticket-uri și checklist-uri, ci un program coordonat și urmărit de la început până la rezultat.</p>
      </SaleArg>

      <SaleArg title="Controale și dovezi menținute continuu" video="/videos/keyshot2.mp4">
        <p>Platforma automatizează colectarea și urmărirea dovezilor, iar echipa menține controalele, evaluările și documentația sincronizate cu realitatea tehnică a organizației.</p>
      </SaleArg>

      <SaleArg title="Securitate tehnică + governance, nu doar documente" video="/videos/keyshot3.mp4">
        <p>Compliance-ul nu are valoare dacă infrastructura rămâne vulnerabilă. Legăm politicile de hardening, protecția aplicațiilor, email security, monitorizare, vulnerability management și măsuri tehnice verificabile.</p>
      </SaleArg>

      <SaleArg title="Lucrezi din instrumentele pe care deja le folosești" video="/videos/keyshot4.mp4">
        <p>Accesezi documente, urmărești acțiuni, declanșezi workflow-uri și comunici direct cu echipa fără procese inutile. Integrările și automatizarea rămân o parte centrală a experienței originale Probo.</p>
      </SaleArg>
    </div>
  </section>

  <Testimonials />
  <Stories />
</Layout>

<script>
  import { AnimatedHero } from "../lib/elements/hero";
  import { customElementDefine } from "../lib/dom";
  customElementDefine("animated-hero", () => AnimatedHero);
</script>
