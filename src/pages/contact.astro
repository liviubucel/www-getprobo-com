---
import Layout from "../layouts/Layout.astro";

const turnstileSiteKey = "0x4AAAAAABBpDfopxKwUIKF_";
---

<Layout
  title="Contact ZebraByte"
  description="Discută cu ZebraByte despre managed compliance, SOC 2, ISO 27001, GDPR, NIS2, accessibility, cyber security sau secure managed hosting."
>
  <main>
    <animated-hero class="relative block overflow-hidden py-10 sm:py-20">
      <section class="container">
        <div class="mx-auto mb-10 max-w-180 text-center sm:mb-14">
          <p class="text-muted-foreground mb-4 text-sm font-medium uppercase tracking-[0.14em]">
            Contact
          </p>
          <h1 class="text-h2 animate-slide-in mb-4 font-medium text-balance">
            Discută cu un expert ZebraByte
          </h1>
          <p class="text-muted-foreground animate-slide-in animation-delay-100 text-lg text-balance">
            Spune-ne ce vrei să securizezi, ce obligații de conformitate ai sau unde
            ai nevoie de ajutor. Pornim de la contextul real, nu de la un pachet generic.
          </p>
        </div>

        <div class="mx-auto grid max-w-240 gap-8 lg:grid-cols-[1fr_1.6fr] lg:gap-12">
          <aside class="lg:pt-2">
            <div class="divide-y border-y">
              <section class="py-5 sm:py-6">
                <h2 class="mb-3 font-medium">Contact direct</h2>
                <div class="text-muted-foreground space-y-2 text-sm">
                  <p><a class="hover:underline" href="mailto:contact@zebrabyte.ro">contact@zebrabyte.ro</a></p>
                  <p><a class="hover:underline" href="tel:+40316302226">+40 316 302 226</a></p>
                </div>
              </section>

              <section class="py-5 sm:py-6">
                <h2 class="mb-3 font-medium">Pentru incidente urgente</h2>
                <p class="text-muted-foreground text-sm leading-relaxed">
                  Dacă ai un incident activ, selectează „Incident / urgență de securitate”
                  în formular și descrie pe scurt ce observi. Nu include parole, chei API
                  sau alte secrete în mesaj.
                </p>
              </section>

              <section class="py-5 sm:py-6">
                <h2 class="mb-3 font-medium">Portal clienți</h2>
                <p class="text-muted-foreground mb-3 text-sm leading-relaxed">
                  Clienții existenți pot continua direct în portalul ZebraByte.
                </p>
                <a
                  class="text-sm font-medium underline underline-offset-4"
                  href="https://portal.zebrabyte.ro"
                >
                  Deschide portalul
                </a>
              </section>
            </div>
          </aside>

          <form id="contact-form" class="space-y-5 rounded-2xl border p-5 sm:p-8">
            <div class="grid gap-5 sm:grid-cols-2">
              <label class="space-y-2 text-sm font-medium">
                <span>Nume *</span>
                <input
                  class="bg-level-0 w-full rounded-lg border px-3 py-2.5 outline-none focus:ring-2 focus:ring-black/10"
                  type="text"
                  name="name"
                  maxlength="100"
                  autocomplete="name"
                  required
                />
              </label>

              <label class="space-y-2 text-sm font-medium">
                <span>Email *</span>
                <input
                  class="bg-level-0 w-full rounded-lg border px-3 py-2.5 outline-none focus:ring-2 focus:ring-black/10"
                  type="email"
                  name="email"
                  maxlength="254"
                  autocomplete="email"
                  required
                />
              </label>

              <label class="space-y-2 text-sm font-medium">
                <span>Telefon</span>
                <input
                  class="bg-level-0 w-full rounded-lg border px-3 py-2.5 outline-none focus:ring-2 focus:ring-black/10"
                  type="tel"
                  name="phone"
                  maxlength="20"
                  autocomplete="tel"
                />
              </label>

              <label class="space-y-2 text-sm font-medium">
                <span>Companie</span>
                <input
                  class="bg-level-0 w-full rounded-lg border px-3 py-2.5 outline-none focus:ring-2 focus:ring-black/10"
                  type="text"
                  name="company"
                  maxlength="150"
                  autocomplete="organization"
                />
              </label>
            </div>

            <label class="block space-y-2 text-sm font-medium">
              <span>Cu ce te putem ajuta?</span>
              <select
                class="bg-level-0 w-full rounded-lg border px-3 py-2.5 outline-none focus:ring-2 focus:ring-black/10"
                name="service"
              >
                <option value="">Selectează</option>
                <option value="Managed Compliance">Managed Compliance</option>
                <option value="SOC 2">SOC 2</option>
                <option value="ISO/IEC 27001">ISO/IEC 27001</option>
                <option value="GDPR & Privacy">GDPR & Privacy</option>
                <option value="NIS2 & Compliance">NIS2 & Compliance</option>
                <option value="Accessibility">Accessibility</option>
                <option value="Cyber Security">Cyber Security</option>
                <option value="Security Assessment">Security Assessment</option>
                <option value="Website Security">Website Security</option>
                <option value="Email Security">Email Security</option>
                <option value="Incident / urgență de securitate">Incident / urgență de securitate</option>
                <option value="Secure Managed Hosting">Secure Managed Hosting</option>
                <option value="Altceva">Altceva</option>
              </select>
              <span class="text-muted-foreground block text-xs font-normal">
                Accessibility și instrumentele gratuite sunt gestionate în zona de Compliance, nu ca linie comercială separată.
              </span>
            </label>

            <label class="block space-y-2 text-sm font-medium">
              <span>Mesaj *</span>
              <textarea
                class="bg-level-0 min-h-36 w-full resize-y rounded-lg border px-3 py-2.5 outline-none focus:ring-2 focus:ring-black/10"
                name="message"
                maxlength="5000"
                required
              ></textarea>
            </label>

            <label class="flex items-start gap-3 text-sm">
              <input class="mt-1" type="checkbox" name="consent" value="yes" required />
              <span class="text-muted-foreground">
                Sunt de acord ca datele furnizate să fie folosite pentru a răspunde
                solicitării mele, conform <a class="underline" href="/privacy">politicii de confidențialitate</a>.
              </span>
            </label>

            <div
              data-turnstile-container
              data-sitekey={turnstileSiteKey}
              aria-label="Verificare de securitate"
            ></div>

            <div id="contact-status" class="hidden rounded-lg border px-4 py-3 text-sm" role="status" aria-live="polite"></div>

            <button
              id="contact-submit"
              type="submit"
              class="bg-primary text-primary-foreground inline-flex h-11 items-center justify-center rounded-lg px-5 text-sm font-medium disabled:cursor-not-allowed disabled:opacity-50"
            >
              Trimite mesajul
            </button>
          </form>
        </div>
      </section>
    </animated-hero>
  </main>
</Layout>

<script>
  import { AnimatedHero } from "../lib/elements/hero";
  import { customElementDefine } from "../lib/dom";
  import { browserT, getBrowserLocale } from "../lib/browser-i18n";
  import {
    ensureTurnstileToken,
    lazyRenderTurnstile,
    resetTurnstile,
  } from "../lib/turnstile";

  customElementDefine("animated-hero", () => AnimatedHero);

  const setupContactForm = () => {
    const form = document.querySelector<HTMLFormElement>("#contact-form");
    const status = document.querySelector<HTMLElement>("#contact-status");
    const submit = document.querySelector<HTMLButtonElement>("#contact-submit");
    const turnstile = form?.querySelector<HTMLElement>("[data-turnstile-container]");

    if (!form || !status || !submit || form.dataset.ready === "true") return;
    form.dataset.ready = "true";
    const cleanupTurnstile = lazyRenderTurnstile(turnstile);
    document.addEventListener("astro:before-swap", cleanupTurnstile, { once: true });

    form.addEventListener("submit", async (event) => {
      event.preventDefault();
      submit.disabled = true;
      status.classList.add("hidden");

      try {
        const verified = await ensureTurnstileToken(turnstile);
        if (!verified) {
          status.classList.remove("hidden");
          status.textContent = browserT(
            "Verificarea de securitate nu este încă disponibilă. Încearcă din nou.",
            "Security verification is not ready yet. Please try again.",
          );
          return;
        }

        const response = await fetch("/api/contact", {
          method: "POST",
          headers: { "Accept-Language": getBrowserLocale() },
          body: new FormData(form),
        });
        const payload = (await response.json()) as {
          success?: boolean;
          error?: string;
        };

        status.classList.remove("hidden");
        if (!response.ok || !payload.success) {
          status.textContent = browserT(
            "Mesajul nu a putut fi trimis.",
            "The message could not be sent.",
          );
          return;
        }

        status.textContent = browserT(
          "Mesajul a fost trimis. Mulțumim!",
          "Your message has been sent. Thank you!",
        );
        form.reset();
      } catch {
        status.classList.remove("hidden");
        status.textContent = browserT(
          "A apărut o eroare de rețea. Încearcă din nou.",
          "A network error occurred. Please try again.",
        );
      } finally {
        resetTurnstile(turnstile);
        submit.disabled = false;
      }
    });
  };

  document.addEventListener("astro:page-load", setupContactForm);
  setupContactForm();
</script>
