---
import Layout from "../layouts/Layout.astro";
import Button from "../components/ui/Button.svelte";
import Badges from "../components/Badges.svelte";
import SaleArg from "../components/ui/SaleArg.astro";
import ComplianceTrack from "../components/block/ComplianceTrack.astro";
import Testimonials from "../components/block/Testimonials.astro";
import Stories from "../components/block/Stories.astro";

const responsibilityRows = [
  {
    area: "Program & governance",
    zebra: "Structură, calendar de review, follow-up și coordonarea programului.",
    client: "Deciziile de business, risk acceptance și ownerii interni.",
  },
  {
    area: "Controls & evidence",
    zebra: "Mapping, evidence plan, review de calitate și urmărirea gap-urilor.",
    client: "Execută sau confirmă activitățile care aparțin proceselor interne.",
  },
  {
    area: "Policies & documents",
    zebra: "Structură, draft, versioning, approvals și calendar de revizuire.",
    client: "Aprobă conținutul și confirmă că reflectă modul real de lucru.",
  },
  {
    area: "Risk & third parties",
    zebra: "Metodologie, register, reviews și legătura cu măsurile de tratare.",
    client: "Context operațional, priorități și decizii privind acceptarea riscului.",
  },
  {
    area: "Audit readiness",
    zebra: "Gap tracking, evidence pack, pregătirea ownerilor și follow-up.",
    client: "Participă acolo unde auditorul are nevoie de owner-ul real al procesului.",
  },
];

const frameworks = [
  {
    name: "ISO/IEC 27001",
    detail: "ISMS, risk treatment, controls, Statement of Applicability și audit readiness.",
    href: "/iso-27001",
  },
  {
    name: "SOC 2",
    detail: "Trust Services Criteria, controls, evidence și pregătire pentru engagement-ul auditorului.",
    href: "/soc2",
  },
  {
    name: "GDPR & Privacy",
    detail: "Data mapping, RoPA, DPIA, third parties, privacy governance și măsuri tehnice.",
    href: "/gdpr",
  },
  {
    name: "NIS2",
    detail: "Cyber risk, resilience, supplier security, incident readiness și evidence continuu.",
    href: "/nis2",
  },
  {
    name: "Accessibility",
    detail: "Assessment, remediation și managementul continuu al accesibilității web.",
    href: "/accessibility",
  },
];

const faqs = [
  {
    question: "Care este diferența dintre platforma self-service și Managed Compliance?",
    answer:
      "Platforma este aceeași. În self-service, echipa sau adviser-ul tău operează programul. În Managed Compliance, ZebraByte preia mai mult din coordonare, evidence, documente, follow-up și audit readiness împreună cu ownerii interni.",
  },
  {
    question: "ZebraByte poate lua toate deciziile de compliance în locul organizației?",
    answer:
      "Nu. Deciziile de business, risk acceptance, responsabilitățile legale și activitățile care aparțin proceselor interne rămân la organizație. Rolul nostru este să reducem munca operațională și să ținem programul coerent și în mișcare.",
  },
  {
    question: "Putem începe cu un singur framework și extinde ulterior?",
    answer:
      "Da. Programul poate porni de la ISO 27001, SOC 2, GDPR sau NIS2 și poate reutiliza controale, riscuri și dovezi atunci când cerințele se suprapun.",
  },
  {
    question: "Managed Compliance include și remediation tehnică?",
    answer:
      "Atunci când un gap cere o măsură tehnică, programul poate fi legat de security assessment, hardening, website security, email security, incident readiness sau infrastructură administrată. Scope-ul se stabilește în funcție de nevoia reală, nu prin adăugarea automată de servicii.",
  },
  {
    question: "ZebraByte emite certificări ISO sau rapoarte SOC 2?",
    answer:
      "Nu. ZebraByte ajută la readiness, implementare, evidence și operarea programului. Certificarea sau raportul de atestare este emis de organismul sau auditorul independent competent pentru framework-ul respectiv.",
  },
];

const serviceSchema = {
  "@context": "https://schema.org",
  "@type": "Service",
  name: "ZebraByte Managed Compliance",
  provider: {
    "@type": "Organization",
    name: "ZebraByte",
    url: "https://www.zebrabyte.ro",
  },
  serviceType: "Managed compliance and continuous GRC operations",
  url: "https://www.zebrabyte.ro/managed-compliance",
};
---

<Layout
  title="Managed Compliance"
  description="Managed Compliance ZebraByte: platformă cloud și expert dedicat pentru controls, evidence, risk, policies, third parties, remediation și audit readiness continuă."
>
  <script type="application/ld+json" set:html={JSON.stringify(serviceSchema)} />

  <main>
    <animated-hero
      class="relative -mt-16 block overflow-hidden px-5 py-10 pt-26 sm:pt-36 sm:pb-12"
    >
      <div
        class="yc-btn text-muted-foreground animate-perspective-in animation-delay-300 mx-auto mb-6 flex w-max items-center gap-2 px-4 py-2 sm:mb-8"
      >
        Managed Compliance
      </div>

      <h1
        class="text-h2 sm:text-h1 mb-6 overflow-hidden text-center font-medium text-balance sm:mb-8"
      >
        <span class="animate-perspective-in block">Compliance,</span>
        <span class="animate-perspective-in block delay-50"> gestionat împreună cu tine. </span>
      </h1>

      <p
        class="text-muted-foreground animate-perspective-in animation-delay-150 mx-auto mb-6 max-w-200 text-center text-lg text-balance sm:mb-8"
      >
        Un specialist ZebraByte coordonează programul de conformitate de la scope și risk
        până la controls, evidence, remediation și audit readiness. Echipa ta păstrează
        ownership-ul real, iar noi reducem munca operațională și ținem programul în mișcare.
      </p>

      <div
        class="mb-11 flex flex-col items-stretch justify-center gap-3 sm:mb-17 sm:flex-row sm:items-center"
      >
        <Button
          class="animate-perspective-in animation-delay-200"
          variant="secondary"
          size="lg"
          href="/compliance-platform"
        >
          Vezi platforma
        </Button>
        <Button
          class="animate-perspective-in animation-delay-300"
          size="lg"
          href="/contact"
        >
          Discută cu un expert
        </Button>
      </div>

      <Badges
        count={10}
        countMobile={6}
        client:load
        border
        class="mx-auto grid max-w-[960px] grid-cols-3 sm:grid-cols-5"
      />
    </animated-hero>

    <ComplianceTrack />

    <section class="container py-10 sm:py-20">
      <h2 class="text-h3 sm:text-h2 mb-3 text-center font-medium">
        Programul rulează continuu, nu doar înainte de audit
      </h2>
      <p
        class="text-muted-foreground mx-auto mb-10 max-w-180 text-center text-lg sm:mb-12"
      >
        Folosim platforma ZebraByte pentru a păstra controls, evidence, risk și documentele
        conectate, iar specialistul dedicat urmărește ce trebuie făcut în continuare.
      </p>

      <div
        class="flex grid-cols-2 flex-col items-start gap-10 sm:grid sm:gap-x-20 sm:gap-y-12"
      >
        <SaleArg
          title="Un expert dedicat programului"
          video="/videos/keyshot1.mp4"
          poster="/videos/keyshot1.jpg"
        >
          <p>
            Ai un owner clar pentru program, care coordonează politicile, controalele,
            evaluările, evidence-ul și pregătirea pentru review-uri sau audit.
          </p>
        </SaleArg>

        <SaleArg
          title="Evidence care se menține în fundal"
          video="/videos/keyshot2.mp4"
          poster="/videos/keyshot2.jpg"
        >
          <p>
            Dovezile, aprobările și review-urile sunt urmărite pe parcurs, astfel încât
            audit readiness să nu înceapă cu reconstruirea ultimelor luni de activitate.
          </p>
        </SaleArg>

        <SaleArg
          title="Trust pentru clienți și parteneri"
          video="/videos/keyshot3.mp4"
          poster="/videos/keyshot3.jpg"
        >
          <p>
            Când trebuie să demonstrezi postura de securitate, documentele aprobate pot fi
            distribuite controlat prin Trust Center fără să expui workspace-ul intern.
          </p>
        </SaleArg>

        <SaleArg
          title="Lucru integrat cu echipa ta"
          video="/videos/keyshot4.mp4"
          poster="/videos/keyshot4.jpg"
        >
          <p>
            Programul este construit în jurul modului în care funcționează organizația,
            cu owners interni și intervenții clare doar atunci când este nevoie de decizie,
            validare sau acțiune tehnică.
          </p>
        </SaleArg>
      </div>
    </section>

    <section class="container py-10 sm:py-20">
      <div class="mx-auto max-w-5xl">
        <div class="mb-10 max-w-180 sm:mb-14">
          <h2 class="text-h3 sm:text-h2 mb-3 font-medium">
            Cine face ce
          </h2>
          <p class="text-muted-foreground text-lg">
            Managed nu înseamnă să inventăm ownership în locul organizației. Separăm clar
            munca pe care o putem coordona de deciziile și activitățile care trebuie să rămână
            la ownerii reali ai proceselor.
          </p>
        </div>

        <div class="border-y">
          <div class="text-muted-foreground hidden grid-cols-[0.7fr_1.15fr_1.15fr] gap-8 border-b py-4 text-sm sm:grid">
            <span>Arie</span>
            <span>ZebraByte</span>
            <span>Echipa ta</span>
          </div>
          {responsibilityRows.map((row) => (
            <div class="grid gap-3 border-b py-6 last:border-b-0 sm:grid-cols-[0.7fr_1.15fr_1.15fr] sm:gap-8">
              <h3 class="font-medium">{row.area}</h3>
              <p class="text-muted-foreground leading-relaxed">{row.zebra}</p>
              <p class="text-muted-foreground leading-relaxed">{row.client}</p>
            </div>
          ))}
        </div>
      </div>
    </section>

    <section class="container py-10 sm:py-20">
      <div class="mx-auto mb-10 max-w-180 text-center sm:mb-14">
        <h2 class="text-h3 sm:text-h2 mb-3 font-medium">
          Un program, mai multe framework-uri
        </h2>
        <p class="text-muted-foreground text-lg">
          Nu reconstruim aceeași muncă de la zero pentru fiecare standard. Acolo unde
          cerințele se suprapun, aceleași controls, risks și evidence pot susține mai multe
          obiective de conformitate.
        </p>
      </div>

      <div class="mx-auto max-w-4xl border-y">
        {frameworks.map((framework) => (
          <a
            href={framework.href}
            class="group grid gap-2 border-b py-6 last:border-b-0 sm:grid-cols-[0.7fr_1.3fr] sm:gap-10"
          >
            <h3 class="font-medium group-hover:underline group-hover:underline-offset-4">
              {framework.name}
            </h3>
            <p class="text-muted-foreground leading-relaxed">{framework.detail}</p>
          </a>
        ))}
      </div>
    </section>

    <Testimonials />
    <Stories />

    <section class="container py-10 sm:py-20">
      <div class="mx-auto max-w-3xl">
        <h2 class="text-h3 sm:text-h2 mb-8 text-center font-medium">
          Întrebări frecvente
        </h2>
        <div class="border-y">
          {faqs.map((faq) => (
            <details class="group border-b py-5 last:border-b-0">
              <summary class="flex cursor-pointer list-none items-center justify-between gap-6 font-medium">
                <span>{faq.question}</span>
                <span class="text-muted-foreground text-xl transition-transform group-open:rotate-45">+</span>
              </summary>
              <p class="text-muted-foreground max-w-2xl pt-4 leading-relaxed">{faq.answer}</p>
            </details>
          ))}
        </div>
      </div>
    </section>

    <section class="container py-12 text-center sm:py-24">
      <h2 class="text-h3 sm:text-h2 mx-auto mb-4 max-w-180 font-medium">
        Construiește un program pe care îl poți menține după primul audit.
      </h2>
      <p class="text-muted-foreground mx-auto mb-8 max-w-160 text-lg">
        Poți folosi platforma direct sau poți lucra cu ZebraByte într-un model Managed
        Compliance, în funcție de cât ownership operațional vrei să păstrezi intern.
      </p>
      <Button href="/contact" size="lg">Discută despre Managed Compliance</Button>
    </section>
  </main>
</Layout>

<script>
  import { AnimatedHero } from "../lib/elements/hero";
  import { customElementDefine } from "../lib/dom";

  customElementDefine("animated-hero", () => AnimatedHero);
</script>
