---
import Layout from "../layouts/Layout.astro";
import Button from "../components/ui/Button.svelte";
import ZebraByteTestimonials from "../components/block/ZebraByteTestimonials.astro";
import Stories from "../components/block/Stories.astro";

const incidentSteps = [
  {
    step: "01",
    title: "Triage",
    text: "Confirmăm ce s-a întâmplat, ce servicii sunt afectate și ce trebuie protejat imediat.",
  },
  {
    step: "02",
    title: "Contain",
    text: "Limităm impactul fără să distrugem informația necesară investigației și recovery-ului.",
  },
  {
    step: "03",
    title: "Recover",
    text: "Restabilim serviciile controlat, verificăm integritatea și închidem căile folosite de atacator.",
  },
  {
    step: "04",
    title: "Improve",
    text: "Findings, root cause și lecțiile incidentului se întorc în controls, monitoring și risk management.",
  },
];

const managedResponsibilities = [
  {
    title: "Hardening",
    text: "Configurare sigură, reducerea suprafeței expuse și control asupra schimbărilor care afectează securitatea.",
  },
  {
    title: "Monitoring",
    text: "Semnale operaționale, vulnerabilități și evenimente relevante urmărite după implementarea inițială.",
  },
  {
    title: "Recovery",
    text: "Backup, restaurare și proceduri de recovery care pot fi folosite când disponibilitatea sau integritatea sunt afectate.",
  },
];

const complianceLinks = [
  {
    label: "ISO/IEC 27001",
    href: "/iso-27001",
    text: "Risk treatment și controale tehnice operate în ISMS.",
    asset: "/frameworks/ISO27001.svg",
  },
  {
    label: "NIS2",
    href: "/nis2",
    text: "Cyber risk, resilience, incidents și supply-chain security.",
    asset: "/frameworks/NIS2.svg",
  },
  {
    label: "GDPR",
    href: "/gdpr",
    text: "Măsuri tehnice și organizaționale pentru datele și procesele relevante.",
    asset: "/frameworks/GDPR.svg",
  },
  {
    label: "SOC 2",
    href: "/soc2",
    text: "Security controls și evidence care reflectă operațiuni reale.",
    asset: "/frameworks/SOC2_TYPE2.svg",
  },
];

const faqs = [
  {
    question: "Trebuie să mut infrastructura la ZebraByte pentru a folosi serviciile de cybersecurity?",
    answer:
      "Nu. Security Assessment, Website Security, Email Security și anumite activități de remediation pot fi realizate în jurul infrastructurii existente. Secure Managed Hosting este o opțiune separată atunci când operarea infrastructurii intră în scope.",
  },
  {
    question: "Security Assessment este același lucru cu un penetration test?",
    answer:
      "Nu automat. Assessment-ul ZebraByte evaluează suprafața expusă, configurațiile și controalele aflate în scope. Un penetration test este un engagement distinct, cu autorizare și reguli de testare specifice.",
  },
  {
    question: "Puteți lucra cu echipa noastră IT sau cu furnizorul existent?",
    answer:
      "Da. Findings și remediation pot fi lucrate împreună cu ownerii și furnizorii existenți. Nu este necesar să înlocuim un furnizor care funcționează bine doar pentru a îmbunătăți postura de securitate.",
  },
  {
    question: "Cybersecurity și compliance sunt același lucru?",
    answer:
      "Nu. Compliance structurează cerințe, governance și evidence. Cybersecurity implementează și operează măsuri tehnice și operaționale care reduc riscul. Le conectăm atunci când aceeași măsură susține și o obligație de compliance.",
  },
  {
    question: "Putem începe doar cu website-ul sau emailul?",
    answer:
      "Da. Putem porni cu un scope foarte clar și îl extindem doar dacă findings, riscul sau schimbările din business justifică un program mai larg.",
  },
];
---

<Layout
  title="Cyber Security"
  description="Cyber Security ZebraByte: security assessment, website security, email security, hardening, monitoring, incident response și secure managed hosting conectate la risk și compliance."
>
  <main>
    <animated-hero
      class="relative -mt-16 block overflow-hidden px-5 py-10 pt-26 sm:pt-36 sm:pb-12"
    >
      <div
        class="text-muted-foreground animate-perspective-in animation-delay-300 mx-auto mb-6 w-max rounded-lg border px-4 py-2 text-sm font-medium sm:mb-8"
      >
        ZebraByte Cyber Security
      </div>

      <h1
        class="text-h2 sm:text-h1 mb-6 overflow-hidden text-center font-medium text-balance sm:mb-8"
      >
        <span class="animate-perspective-in block">Securitate cibernetică,</span>
        <span class="animate-perspective-in block delay-50"> de la finding la control operat. </span>
      </h1>

      <p
        class="text-muted-foreground animate-perspective-in animation-delay-150 mx-auto mb-6 max-w-200 text-center text-lg text-balance sm:mb-8"
      >
        Identificăm riscul, implementăm măsurile tehnice și păstrăm monitoring-ul,
        remediation-ul și incident response-ul conectate după primul proiect.
      </p>

      <div
        class="mb-11 flex flex-col items-stretch justify-center gap-3 sm:mb-17 sm:flex-row sm:items-center"
      >
        <Button
          class="animate-perspective-in animation-delay-200"
          variant="secondary"
          size="lg"
          href="/security-assessment"
        >
          Security Assessment
        </Button>
        <Button
          class="animate-perspective-in animation-delay-300"
          size="lg"
          href="/contact"
        >
          Discută cu un expert
        </Button>
      </div>

      <div class="animate-perspective-in animation-delay-300 mx-auto max-w-5xl">
        <div class="relative min-h-[360px] overflow-hidden rounded-2xl bg-[#eef2e4] sm:min-h-[520px]">
          <div class="absolute inset-x-[7%] top-[9%] sm:inset-x-[11%]">
            <img
              src="/trust-center/security-vulnerability.svg"
              alt="Vizual Probo pentru vulnerability management"
              width="331"
              height="272"
              loading="eager"
              decoding="async"
              class="w-[48%] rounded-xl shadow-[0_18px_44px_rgba(20,30,18,0.12)]"
            />
          </div>
          <div class="absolute top-[22%] right-[6%] flex justify-end sm:right-[10%]">
            <img
              src="/trust-center/security-encryption.svg"
              alt="Vizual Probo pentru encryption controls"
              width="331"
              height="272"
              loading="eager"
              decoding="async"
              class="w-[44%] rounded-xl shadow-[0_18px_44px_rgba(20,30,18,0.12)]"
            />
          </div>
          <div class="absolute right-[16%] bottom-[-6%] sm:right-[24%]">
            <img
              src="/trust-center/security-monitoring.svg"
              alt="Vizual Probo pentru security monitoring"
              width="331"
              height="272"
              loading="eager"
              decoding="async"
              class="w-[46%] rounded-xl shadow-[0_18px_44px_rgba(20,30,18,0.12)]"
            />
          </div>
          <div
            aria-hidden="true"
            class="pointer-events-none absolute -bottom-52 left-1/2 size-[620px] -translate-x-1/2 rounded-full bg-[#e6ff03]/35 blur-3xl"
          ></div>
        </div>
      </div>
    </animated-hero>

    <section class="container py-14 sm:py-24">
      <div class="mx-auto grid max-w-6xl gap-12 lg:grid-cols-[0.72fr_1.28fr] lg:gap-24">
        <div>
          <p class="text-muted-foreground mb-3 text-sm font-medium">SECURITY ASSESSMENT</p>
          <h2 class="text-h3 sm:text-h2 mb-5 font-medium text-balance">
            Începem cu suprafața reală de atac.
          </h2>
          <p class="text-muted-foreground mb-7 text-lg leading-relaxed">
            Domenii, aplicații, servicii expuse, identity, configurații și dependențe sunt
            evaluate înainte să recomandăm produse sau schimbări de infrastructură.
          </p>
          <Button href="/security-assessment" variant="secondary">Vezi Security Assessment</Button>
        </div>

        <div class="relative overflow-hidden rounded-2xl bg-active px-6 pt-8 sm:px-10 sm:pt-12">
          <img
            src="/trust-center/security-vulnerability.svg"
            alt="Vulnerability management și security findings"
            width="331"
            height="272"
            loading="lazy"
            decoding="async"
            class="mx-auto w-full max-w-[620px] translate-y-5 rounded-xl shadow-[0_18px_44px_rgba(20,30,18,0.1)]"
          />
        </div>
      </div>
    </section>

    <section class="border-y bg-level-0 py-14 sm:py-24">
      <div class="container grid items-center gap-12 lg:grid-cols-[1.08fr_0.92fr] lg:gap-24">
        <div class="order-2 lg:order-1">
          <div class="relative min-h-[360px] overflow-hidden rounded-2xl bg-[#f3f4ed] sm:min-h-[470px]">
            <img
              src="/trust-center/security-encryption.svg"
              alt="Encryption și protection controls"
              width="331"
              height="272"
              loading="lazy"
              decoding="async"
              class="absolute top-[9%] left-[8%] w-[67%] rounded-xl shadow-[0_18px_44px_rgba(20,30,18,0.11)]"
            />
            <img
              src="/trust-center/security-vulnerability.svg"
              alt="Security findings și remediation"
              width="331"
              height="272"
              loading="lazy"
              decoding="async"
              class="absolute right-[6%] bottom-[-4%] w-[58%] rounded-xl shadow-[0_18px_44px_rgba(20,30,18,0.11)]"
            />
          </div>
        </div>

        <div class="order-1 lg:order-2">
          <p class="text-muted-foreground mb-3 text-sm font-medium">PROTECT</p>
          <h2 class="text-h3 sm:text-h2 mb-5 font-medium text-balance">
            Protejăm serviciile prin care organizația este expusă.
          </h2>
          <p class="text-muted-foreground mb-8 text-lg leading-relaxed">
            Website-ul, domeniul și emailul sunt adesea primele suprafețe pe care le vede un
            atacator. Hardening-ul este construit în jurul arhitecturii existente și al
            riscului, nu în jurul unui stack obligatoriu.
          </p>
          <div class="space-y-6">
            <a href="/website-security" class="group block border-t pt-5">
              <div class="mb-1 flex items-center justify-between gap-5">
                <h3 class="text-h5 font-medium">Website Security</h3>
                <span class="text-muted-foreground transition-transform group-hover:translate-x-1">→</span>
              </div>
              <p class="text-muted-foreground">
                WAF, DDoS protection, TLS hardening, application protection și recovery.
              </p>
            </a>
            <a href="/email-security" class="group block border-t pt-5">
              <div class="mb-1 flex items-center justify-between gap-5">
                <h3 class="text-h5 font-medium">Email Security</h3>
                <span class="text-muted-foreground transition-transform group-hover:translate-x-1">→</span>
              </div>
              <p class="text-muted-foreground">
                SPF, DKIM, DMARC, anti-spoofing și protecția identity/domain.
              </p>
            </a>
          </div>
        </div>
      </div>
    </section>

    <section class="bg-[#141e12] py-16 text-white sm:py-28">
      <div class="container grid items-center gap-12 lg:grid-cols-[0.88fr_1.12fr] lg:gap-24">
        <div>
          <p class="mb-3 text-sm font-medium text-white/55">OPERATE & MONITOR</p>
          <h2 class="text-h3 sm:text-h2 mb-5 font-medium text-balance">
            O măsură implementată o singură dată nu este un program de securitate.
          </h2>
          <p class="mb-8 max-w-150 text-lg leading-relaxed text-white/70">
            Configurațiile se schimbă, apar vulnerabilități noi, utilizatorii și furnizorii se
            modifică. Monitoring-ul și review-ul continuu păstrează contextul după remedierea
            inițială.
          </p>
          <div class="grid gap-5 sm:grid-cols-2">
            <div class="border-t border-white/20 pt-4">
              <h3 class="mb-2 font-medium">Detectează schimbarea</h3>
              <p class="text-sm leading-relaxed text-white/60">
                Semnale, findings și modificări de posture urmărite în raport cu serviciul real.
              </p>
            </div>
            <div class="border-t border-white/20 pt-4">
              <h3 class="mb-2 font-medium">Închide bucla</h3>
              <p class="text-sm leading-relaxed text-white/60">
                Remediation-ul, ownership-ul și evidence-ul rămân conectate după primul fix.
              </p>
            </div>
          </div>
        </div>

        <div class="relative overflow-hidden rounded-2xl bg-white/95 px-6 pt-8 sm:px-10 sm:pt-12">
          <img
            src="/trust-center/security-monitoring.svg"
            alt="Security monitoring în stilul vizual Probo"
            width="331"
            height="272"
            loading="lazy"
            decoding="async"
            class="mx-auto w-full max-w-[620px] translate-y-5 rounded-xl"
          />
        </div>
      </div>
    </section>

    <section class="container py-16 sm:py-28">
      <div class="mx-auto mb-12 max-w-190 text-center">
        <p class="text-muted-foreground mb-3 text-sm font-medium">INCIDENT RESPONSE</p>
        <h2 class="text-h3 sm:text-h2 mb-4 font-medium text-balance">
          Când apare incidentul, ordinea deciziilor contează.
        </h2>
        <p class="text-muted-foreground text-lg">
          Răspunsul nu începe cu un raport. Începe cu triere, containment și păstrarea
          informației necesare pentru recovery și investigație.
        </p>
      </div>

      <div class="relative mx-auto max-w-6xl">
        <div class="absolute top-[17px] right-0 left-0 hidden h-px bg-border sm:block" aria-hidden="true"></div>
        <div class="grid gap-8 sm:grid-cols-4 sm:gap-6">
          {incidentSteps.map((item) => (
            <article class="relative">
              <div class="mb-5 flex size-9 items-center justify-center rounded-full border bg-background font-mono text-xs">
                {item.step}
              </div>
              <h3 class="text-h5 mb-2 font-medium">{item.title}</h3>
              <p class="text-muted-foreground leading-relaxed">{item.text}</p>
            </article>
          ))}
        </div>
      </div>

      <div class="mt-10 text-center">
        <Button href="/incident-response" variant="secondary">Vezi Incident Response</Button>
      </div>
    </section>

    <section class="overflow-hidden bg-active py-16 sm:py-28">
      <div class="container">
        <div class="mx-auto mb-12 max-w-190 text-center">
          <p class="text-muted-foreground mb-3 text-sm font-medium">SECURE MANAGED HOSTING</p>
          <h2 class="text-h3 sm:text-h2 mb-4 font-medium text-balance">
            Pentru unele sisteme, securitatea include și operarea infrastructurii.
          </h2>
          <p class="text-muted-foreground text-lg">
            Când hosting-ul intră în scope, hardening-ul, monitoring-ul și recovery-ul sunt
            operate ca responsabilități continue, nu ca opțiuni adăugate după incident.
          </p>
        </div>

        <div class="mx-auto grid max-w-6xl gap-8 border-y py-8 sm:grid-cols-3 sm:gap-10 sm:py-10">
          {managedResponsibilities.map((item) => (
            <article>
              <h3 class="text-h5 mb-2 font-medium">{item.title}</h3>
              <p class="text-muted-foreground leading-relaxed">{item.text}</p>
            </article>
          ))}
        </div>

        <div class="mt-9 text-center">
          <Button href="/secure-hosting" variant="secondary">Vezi Secure Managed Hosting</Button>
        </div>
      </div>
    </section>

    <section class="container py-16 sm:py-28">
      <div class="mx-auto mb-12 max-w-190 text-center">
        <p class="text-muted-foreground mb-3 text-sm font-medium">SECURITY × COMPLIANCE</p>
        <h2 class="text-h3 sm:text-h2 mb-4 font-medium text-balance">
          Același control tehnic poate susține mai multe obligații.
        </h2>
        <p class="text-muted-foreground text-lg">
          Nu confundăm cybersecurity cu compliance. Le conectăm doar acolo unde o măsură
          tehnică, un review sau un incident trebuie demonstrat în programul GRC.
        </p>
      </div>

      <div class="mx-auto grid max-w-5xl gap-x-10 gap-y-10 sm:grid-cols-2">
        {complianceLinks.map((item) => (
          <a href={item.href} class="group grid grid-cols-[72px_1fr] items-start gap-5 border-t pt-6">
            <div class="flex size-16 items-center justify-center">
              <img src={item.asset} alt="" class="max-h-14 max-w-14" aria-hidden="true" loading="lazy" />
            </div>
            <div>
              <div class="mb-2 flex items-center justify-between gap-4">
                <h3 class="text-h5 font-medium">{item.label}</h3>
                <span class="text-muted-foreground transition-transform group-hover:translate-x-1">→</span>
              </div>
              <p class="text-muted-foreground leading-relaxed">{item.text}</p>
            </div>
          </a>
        ))}
      </div>
    </section>

    <ZebraByteTestimonials />
    <Stories />

    <section class="container py-14 sm:py-24">
      <div class="mx-auto max-w-3xl">
        <h2 class="text-h3 sm:text-h2 mb-8 text-center font-medium">Întrebări frecvente</h2>
        <div class="border-y">
          {faqs.map((faq) => (
            <details class="group border-b py-5 last:border-b-0">
              <summary class="flex cursor-pointer list-none items-center justify-between gap-6 font-medium">
                <span>{faq.question}</span>
                <span class="text-muted-foreground text-xl transition-transform group-open:rotate-45">+</span>
              </summary>
              <p class="text-muted-foreground max-w-2xl pt-4 leading-relaxed">{faq.answer}</p>
            </details>
          ))}
        </div>
      </div>
    </section>

    <section class="container py-14 text-center sm:py-28">
      <h2 class="text-h3 sm:text-h2 mx-auto mb-4 max-w-190 font-medium text-balance">
        Începe cu riscul pe care îl poți vedea și construiește de acolo.
      </h2>
      <p class="text-muted-foreground mx-auto mb-8 max-w-160 text-lg">
        Putem începe cu o evaluare clară și continua numai cu măsurile care schimbă efectiv
        postura de securitate.
      </p>
      <Button href="/security-assessment" size="lg">Începe cu un Security Assessment</Button>
    </section>
  </main>
</Layout>

<script>
  import { AnimatedHero } from "../lib/elements/hero";
  import { customElementDefine } from "../lib/dom";
  customElementDefine("animated-hero", () => AnimatedHero);
</script>
