---
import Layout from "../layouts/Layout.astro";
import Button from "../components/ui/Button.svelte";
import ZebraByteTestimonials from "../components/block/ZebraByteTestimonials.astro";

const services = [
  {
    title: "Security Assessment",
    text: "Evaluăm suprafața expusă, configurațiile, aplicațiile, domeniile și controalele existente pentru a prioritiza riscurile care merită acțiune.",
    href: "/security-assessment",
  },
  {
    title: "Website Security",
    text: "WAF, DDoS protection, malware monitoring, TLS hardening, application protection și recovery pentru servicii expuse public.",
    href: "/website-security",
  },
  {
    title: "Email Security",
    text: "SPF, DKIM, DMARC, anti-spoofing, identity hardening și protecție împotriva phishing-ului și account compromise.",
    href: "/email-security",
  },
  {
    title: "Incident Response",
    text: "Triage, containment, investigation support, recovery și lessons learned atunci când există un incident sau o suspiciune de compromitere.",
    href: "/incident-response",
  },
  {
    title: "Secure Managed Hosting",
    text: "Infrastructură administrată pentru proiecte unde hardening-ul, monitoring-ul, backup-ul și recovery-ul trebuie operate continuu.",
    href: "/secure-hosting",
  },
];

const lifecycle = [
  {
    step: "01",
    title: "Discover",
    text: "Active, domenii, servicii expuse, identity, furnizori și dependențe care formează suprafața reală de atac.",
  },
  {
    step: "02",
    title: "Prioritize",
    text: "Separăm zgomotul de riscurile care pot schimba efectiv confidențialitatea, integritatea sau disponibilitatea serviciului.",
  },
  {
    step: "03",
    title: "Remediate",
    text: "Hardening, patching, access control, configuration changes și măsuri defensive implementate în ordinea potrivită.",
  },
  {
    step: "04",
    title: "Monitor",
    text: "Urmărim schimbările, vulnerabilitățile și semnalele relevante astfel încât postura să nu revină la starea inițială după primul proiect.",
  },
  {
    step: "05",
    title: "Respond",
    text: "Când apare un incident, procesele de triage, containment și recovery sunt conectate la contextul tehnic deja cunoscut.",
  },
  {
    step: "06",
    title: "Improve",
    text: "Lessons learned, findings și schimbările de risc se întorc în controls și în programul de security/compliance.",
  },
];

const layers = [
  ["Identity", "MFA, SSO, privilege management, account hardening și access reviews."],
  ["Edge & network", "TLS, WAF, rate limiting, DDoS protection și reducerea expunerii inutile."],
  ["Application", "Configuration hardening, vulnerability remediation, secure change și protecția componentelor expuse."],
  ["Infrastructure", "Patching, isolation, backup, recovery, monitoring și controale asupra origin-ului."],
  ["Email & domain", "SPF, DKIM, DMARC, DNS posture și reducerea riscului de impersonation."],
  ["Operations", "Logging, alerting, incident response, supplier risk și procese de review continuu."],
];

const engagementModels = [
  {
    title: "Assessment",
    text: "Ai nevoie de o imagine clară a riscului și de un plan prioritizat înainte să schimbi infrastructura sau să cumperi alte produse.",
  },
  {
    title: "Remediation project",
    text: "Există findings cunoscute și ai nevoie de implementare: hardening, configurare, cleanup, migration sau reducerea suprafeței de atac.",
  },
  {
    title: "Managed security",
    text: "Controalele trebuie operate continuu, cu monitoring, reviews și ownership după finalizarea proiectului inițial.",
  },
  {
    title: "Incident response",
    text: "Există un compromis sau o suspiciune activă și prioritatea este containment-ul, recovery-ul și păstrarea informațiilor necesare investigației.",
  },
];

const complianceConnections = [
  {
    title: "ISO/IEC 27001",
    text: "Măsurile tehnice și evidence-ul pot susține controls și risk treatment din ISMS.",
    href: "/iso-27001",
  },
  {
    title: "NIS2",
    text: "Cyber risk, incident handling, resilience și supply-chain security trebuie să existe în operațiuni.",
    href: "/nis2",
  },
  {
    title: "GDPR",
    text: "Technical and organisational measures trebuie legate de riscul pentru datele și processing activities relevante.",
    href: "/gdpr",
  },
  {
    title: "SOC 2",
    text: "Controls și evidence trebuie să reflecte procese de security operate, nu doar policies.",
    href: "/soc2",
  },
];

const faqs = [
  {
    question: "Trebuie să mut infrastructura la ZebraByte pentru a folosi serviciile de cybersecurity?",
    answer:
      "Nu. Security assessment, website security, email security și anumite activități de remediation pot fi realizate în jurul infrastructurii existente. Managed Hosting este o opțiune separată atunci când ownership-ul infrastructurii face parte din scope.",
  },
  {
    question: "Security Assessment este același lucru cu un penetration test?",
    answer:
      "Nu automat. Assessment-ul ZebraByte evaluează suprafața expusă, configurațiile și controalele în scope. Un penetration test este un engagement distinct, cu reguli de testare și autorizare specifice. Scope-ul trebuie stabilit înainte de orice testare activă.",
  },
  {
    question: "Puteți lucra cu echipa noastră IT sau cu furnizorul existent?",
    answer:
      "Da. Putem livra findings și remediation împreună cu ownerii existenți. Nu este necesar ca ZebraByte să înlocuiască furnizorii care funcționează bine doar pentru a putea îmbunătăți postura de securitate.",
  },
  {
    question: "Cybersecurity și compliance sunt același lucru?",
    answer:
      "Nu. Compliance oferă cerințe, governance și evidence; cybersecurity include măsurile tehnice și operaționale care reduc riscul. Le conectăm acolo unde un control sau o obligație trebuie susținută de o măsură reală.",
  },
  {
    question: "Putem începe doar cu o singură problemă, cum ar fi website-ul sau emailul?",
    answer:
      "Da. Engagement-ul poate fi limitat la un serviciu clar și extins ulterior dacă assessment-ul sau schimbările din business justifică un scope mai larg.",
  },
];
---

<Layout
  title="Cyber Security"
  description="Cyber Security ZebraByte: security assessment, website security, email security, hardening, monitoring, incident response și secure managed hosting conectate la risk și compliance."
>
  <main>
    <animated-hero class="relative -mt-16 block overflow-hidden px-5 py-10 pt-26 sm:pt-36 sm:pb-12">
      <div class="text-muted-foreground animate-perspective-in animation-delay-300 mx-auto mb-6 w-max rounded-lg border px-4 py-2 text-sm font-medium sm:mb-8">
        ZebraByte Cyber Security
      </div>

      <h1 class="text-h2 sm:text-h1 mb-6 overflow-hidden text-center font-medium text-balance sm:mb-8">
        <span class="animate-perspective-in block">Securitate cibernetică,</span>
        <span class="animate-perspective-in block delay-50"> de la finding la control operat. </span>
      </h1>

      <p class="text-muted-foreground animate-perspective-in animation-delay-150 mx-auto mb-6 max-w-200 text-center text-lg text-balance sm:mb-8">
        Identificăm riscurile, implementăm măsurile tehnice și conectăm monitoring-ul,
        remediation-ul și incident response-ul într-un program care poate continua după prima evaluare.
      </p>

      <div class="mb-10 flex flex-col items-stretch justify-center gap-3 sm:flex-row sm:items-center">
        <Button class="animate-perspective-in animation-delay-200" variant="secondary" size="lg" href="/security-assessment">Security Assessment</Button>
        <Button class="animate-perspective-in animation-delay-300" size="lg" href="/contact">Discută cu un expert</Button>
      </div>
    </animated-hero>

    <section class="container pb-12 sm:pb-24">
      <div class="mx-auto max-w-6xl border-y py-10 sm:py-14">
        <div class="mb-12 grid gap-6 lg:grid-cols-[0.7fr_1.3fr] lg:items-end lg:gap-16">
          <div>
            <p class="text-muted-foreground mb-3 text-sm font-medium uppercase tracking-wide">Security control plane</p>
            <h2 class="text-h3 sm:text-h2 font-medium">Un program, nu o colecție de produse.</h2>
          </div>
          <p class="text-muted-foreground text-lg leading-relaxed">
            Alegem punctul de intrare după problemă și risc. Nu forțăm fiecare organizație într-un
            stack identic și nu transformăm fiecare finding într-un produs nou.
          </p>
        </div>

        <div class="grid gap-px border bg-border lg:grid-cols-[1fr_1.25fr_1fr]">
          <a href={services[0].href} class="group bg-level-0 min-h-64 p-6 lg:row-span-2 sm:p-8">
            <span class="text-muted-foreground mb-10 block font-mono text-xs">ENTRY / 01</span>
            <h3 class="text-h4 mb-4 font-medium group-hover:underline group-hover:underline-offset-4">{services[0].title}</h3>
            <p class="text-muted-foreground leading-relaxed">{services[0].text}</p>
          </a>

          <div class="bg-level-3 flex min-h-64 flex-col justify-between p-6 text-invert sm:p-8">
            <div class="font-mono text-xs opacity-45">ZEBRABYTE / SECURITY</div>
            <div>
              <div class="mb-3 text-4xl font-medium tracking-tight">Risk → Control</div>
              <p class="max-w-lg leading-relaxed opacity-65">Assessment, remediation, monitoring și response conectate prin același context tehnic.</p>
            </div>
          </div>

          <a href={services[1].href} class="group bg-level-0 min-h-64 p-6 sm:p-8">
            <span class="text-muted-foreground mb-10 block font-mono text-xs">SERVICE / 02</span>
            <h3 class="text-h4 mb-4 font-medium group-hover:underline group-hover:underline-offset-4">{services[1].title}</h3>
            <p class="text-muted-foreground leading-relaxed">{services[1].text}</p>
          </a>

          <a href={services[2].href} class="group bg-level-0 min-h-64 p-6 sm:p-8">
            <span class="text-muted-foreground mb-10 block font-mono text-xs">SERVICE / 03</span>
            <h3 class="text-h4 mb-4 font-medium group-hover:underline group-hover:underline-offset-4">{services[2].title}</h3>
            <p class="text-muted-foreground leading-relaxed">{services[2].text}</p>
          </a>

          <a href={services[3].href} class="group bg-level-0 min-h-64 p-6 sm:p-8">
            <span class="text-muted-foreground mb-10 block font-mono text-xs">SERVICE / 04</span>
            <h3 class="text-h4 mb-4 font-medium group-hover:underline group-hover:underline-offset-4">{services[3].title}</h3>
            <p class="text-muted-foreground leading-relaxed">{services[3].text}</p>
          </a>

          <a href={services[4].href} class="group bg-level-0 min-h-64 p-6 sm:p-8">
            <span class="text-muted-foreground mb-10 block font-mono text-xs">SERVICE / 05</span>
            <h3 class="text-h4 mb-4 font-medium group-hover:underline group-hover:underline-offset-4">{services[4].title}</h3>
            <p class="text-muted-foreground leading-relaxed">{services[4].text}</p>
          </a>
        </div>
      </div>
    </section>

    <section class="bg-active py-12 sm:py-24">
      <div class="container grid gap-12 lg:grid-cols-[0.58fr_1.42fr] lg:gap-20">
        <div>
          <p class="text-muted-foreground mb-3 text-sm font-medium uppercase tracking-wide">Defense map</p>
          <h2 class="text-h3 sm:text-h2 mb-5 font-medium">Defense in depth, fără o singură „cutie magică”.</h2>
          <p class="text-muted-foreground text-lg leading-relaxed">
            Un atac nu respectă granițele dintre furnizori. Identity, edge, aplicația,
            infrastructura și operațiunile trebuie privite împreună atunci când riscul o cere.
          </p>
        </div>

        <div class="space-y-2">
          {layers.map(([layer, text], index) => (
            <article class:list={["grid gap-3 border px-5 py-5 sm:grid-cols-[54px_0.55fr_1.45fr] sm:gap-7", index === 0 && "sm:mx-0", index === 1 && "sm:mx-3", index === 2 && "sm:mx-6", index === 3 && "sm:mx-9", index === 4 && "sm:mx-12", index === 5 && "sm:mx-15"]}>
              <span class="text-muted-foreground font-mono text-xs">L{index + 1}</span>
              <h3 class="font-medium">{layer}</h3>
              <p class="text-muted-foreground text-sm leading-relaxed">{text}</p>
            </article>
          ))}
        </div>
      </div>
    </section>

    <section class="bg-level-3 py-12 text-invert sm:py-24">
      <div class="container">
        <div class="mb-12 max-w-3xl">
          <p class="mb-3 text-sm font-medium uppercase tracking-wide opacity-55">Security lifecycle</p>
          <h2 class="text-h3 sm:text-h2 mb-4 font-medium">Prima evaluare este doar începutul.</h2>
          <p class="text-lg leading-relaxed opacity-65">Riscul se schimbă odată cu aplicația, utilizatorii, furnizorii și infrastructura.</p>
        </div>

        <div class="grid border border-invert/15 sm:grid-cols-2 lg:grid-cols-3">
          {lifecycle.map((item, index) => (
            <article class="min-h-64 border-b border-invert/15 p-6 sm:border-r [&:nth-child(2n)]:sm:border-r-0 lg:[&:nth-child(2n)]:border-r lg:[&:nth-child(3n)]:border-r-0 lg:[&:nth-last-child(-n+3)]:border-b-0">
              <div class="mb-10 flex items-center justify-between gap-4">
                <span class="font-mono text-xs opacity-40">{item.step}</span>
                <span class="font-mono text-xs opacity-35">{index === lifecycle.length - 1 ? "↻" : "→"}</span>
              </div>
              <h3 class="text-h5 mb-3 font-medium">{item.title}</h3>
              <p class="text-sm leading-relaxed opacity-65">{item.text}</p>
            </article>
          ))}
        </div>
      </div>
    </section>

    <section class="container py-12 sm:py-24">
      <div class="grid gap-12 lg:grid-cols-[0.62fr_1.38fr] lg:gap-20">
        <div>
          <p class="text-muted-foreground mb-3 text-sm font-medium uppercase tracking-wide">Engagement model</p>
          <h2 class="text-h3 sm:text-h2 mb-5 font-medium">Alege modelul după problema reală.</h2>
          <p class="text-muted-foreground text-lg leading-relaxed">
            Uneori ai nevoie doar de o imagine clară. Alteori finding-ul trebuie implementat,
            controlul trebuie operat continuu sau există deja un incident.
          </p>
        </div>

        <div class="grid gap-x-10 sm:grid-cols-2">
          {engagementModels.map((item, index) => (
            <article class="border-t py-7">
              <span class="text-muted-foreground mb-7 block font-mono text-xs">MODE-{String(index + 1).padStart(2, "0")}</span>
              <h3 class="text-h4 mb-3 font-medium">{item.title}</h3>
              <p class="text-muted-foreground leading-relaxed">{item.text}</p>
            </article>
          ))}
        </div>
      </div>
    </section>

    <section class="border-y py-12 sm:py-24">
      <div class="container">
        <div class="mb-10 grid gap-6 lg:grid-cols-[0.7fr_1.3fr] lg:items-end lg:gap-16">
          <div>
            <p class="text-muted-foreground mb-3 text-sm font-medium uppercase tracking-wide">Security → evidence</p>
            <h2 class="text-h3 sm:text-h2 font-medium">Security și compliance se întâlnesc în evidence.</h2>
          </div>
          <p class="text-muted-foreground text-lg leading-relaxed">
            Un framework nu securizează singur infrastructura. Dar măsurile operate și evidence-ul
            tehnic pot susține programul de compliance atunci când cerințele se suprapun.
          </p>
        </div>

        <div class="grid sm:grid-cols-2 lg:grid-cols-4">
          {complianceConnections.map((item, index) => (
            <a href={item.href} class:list={["group min-h-56 border-t py-6 sm:px-6", index > 0 && "lg:border-l"]}>
              <span class="text-muted-foreground mb-8 block font-mono text-xs">MAP-{String(index + 1).padStart(2, "0")}</span>
              <h3 class="mb-3 font-medium group-hover:underline group-hover:underline-offset-4">{item.title}</h3>
              <p class="text-muted-foreground text-sm leading-relaxed">{item.text}</p>
            </a>
          ))}
        </div>
      </div>
    </section>

    <ZebraByteTestimonials />

    <section class="container py-12 sm:py-24">
      <div class="mx-auto max-w-3xl">
        <h2 class="text-h3 sm:text-h2 mb-8 font-medium">Întrebări frecvente</h2>
        <div class="border-y">
          {faqs.map((faq) => (
            <details class="group border-b py-5 last:border-b-0">
              <summary class="flex cursor-pointer list-none items-center justify-between gap-6 font-medium">
                <span>{faq.question}</span>
                <span class="text-muted-foreground text-xl transition-transform group-open:rotate-45">+</span>
              </summary>
              <p class="text-muted-foreground max-w-2xl pt-4 leading-relaxed">{faq.answer}</p>
            </details>
          ))}
        </div>
      </div>
    </section>

    <section class="border-t py-16 text-center sm:py-24">
      <div class="container">
        <h2 class="text-h3 sm:text-h2 mx-auto mb-4 max-w-190 font-medium text-balance">Începe cu riscul pe care îl poți vedea și construiește de acolo.</h2>
        <p class="text-muted-foreground mx-auto mb-8 max-w-160 text-lg">
          Putem începe cu o evaluare a suprafeței expuse și continua doar cu măsurile care
          schimbă efectiv postura de securitate.
        </p>
        <Button href="/security-assessment" size="lg">Începe cu un Security Assessment</Button>
      </div>
    </section>
  </main>
</Layout>

<script>
  import { AnimatedHero } from "../lib/elements/hero";
  import { customElementDefine } from "../lib/dom";
  customElementDefine("animated-hero", () => AnimatedHero);
</script>
