---
import Layout from "../layouts/Layout.astro";
import ZebraByteIndustryServicePage from "../components/ZebraByteIndustryServicePage.astro";
import ZebraByteLegacyPage from "../components/ZebraByteLegacyPage.astro";
import {
  legacyIndustryServiceSlugs,
  findIndustryServiceByLegacySlug,
  type IndustryServiceKey,
  type ZebraByteIndustry,
} from "../content/zebrabyte-industries";
import {
  legacyZebraBytePages,
  type LegacyZebraBytePage,
} from "../content/zebrabyte-legacy-pages";

export function getStaticPaths() {
  const industryPaths = legacyIndustryServiceSlugs.map((legacy) => {
    const match = findIndustryServiceByLegacySlug(legacy)!;
    return {
      params: { legacy },
      props: {
        kind: "industry" as const,
        industry: match.industry,
        service: match.service,
      },
    };
  });

  const legacyPaths = legacyZebraBytePages.map((page) => ({
    params: { legacy: page.slug },
    props: {
      kind: "legacy" as const,
      page,
    },
  }));

  return [...industryPaths, ...legacyPaths];
}

type Props =
  | {
      kind: "industry";
      industry: ZebraByteIndustry;
      service: IndustryServiceKey;
    }
  | {
      kind: "legacy";
      page: LegacyZebraBytePage;
    };

const props = Astro.props as Props;

const labelMap: Record<IndustryServiceKey, string> = {
  cyber: "Securitate cibernetică",
  email: "Securitate email",
  website: "Securitate website",
  hosting: "Hosting securizat",
  maintenance: "Mentenanță WordPress",
};

const title =
  props.kind === "industry"
    ? `${labelMap[props.service]} pentru ${props.industry.shortTitle}`
    : props.page.title;

const description =
  props.kind === "industry"
    ? `${labelMap[props.service]} ZebraByte pentru ${props.industry.shortTitle}: controale tehnice, hardening, monitoring și recovery adaptate riscurilor sectorului.`
    : props.page.description;

const noIndex = props.kind === "legacy" ? props.page.noIndex : false;
---

<Layout title={title} description={description} noIndex={noIndex}>
  <main>
    {
      props.kind === "industry" ? (
        <ZebraByteIndustryServicePage
          industry={props.industry}
          service={props.service}
        />
      ) : (
        <ZebraByteLegacyPage page={props.page} />
      )
    }
  </main>
</Layout>
