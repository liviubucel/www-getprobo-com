---
import Layout from "../layouts/Layout.astro";
import Button from "../components/ui/Button.svelte";

const pillars = [
  {
    label: "Cyber Security",
    title: "Reduce risk in the systems that actually run the business.",
    text: "Assessment, hardening, identity, website/email security și incident response conectate la infrastructura și operațiunile reale.",
    href: "/cyber-security",
  },
  {
    label: "Compliance",
    title: "Turn controls and evidence into an operating program.",
    text: "Framework-uri, risks, controls, evidence, audit readiness și continuous review într-un singur model de lucru.",
    href: "/compliance-platform",
  },
  {
    label: "Privacy",
    title: "Keep governance close to the data and processing it describes.",
    text: "RoPA, DPIA, rights requests, third parties și măsuri tehnice legate de processing-ul real, nu de documente izolate.",
    href: "/gdpr",
  },
  {
    label: "Infrastructure",
    title: "Give critical workloads clear operational ownership.",
    text: "Edge security, managed hosting, monitoring, patching, backup și recovery pentru proiectele unde operarea continuă contează.",
    href: "/secure-hosting",
  },
];

const proofRows = [
  ["Controls", "Ce măsură există, ce risc tratează și cine o operează."],
  ["Evidence", "Configurații, documente, logs, reviews și rezultate care pot susține o afirmație."],
  ["Ownership", "Cine investighează, aprobă, remediază sau validează atunci când ceva se schimbă."],
  ["Recovery", "Ce se întâmplă când prevenția nu este suficientă și serviciul trebuie readus controlat."],
];

const workflow = [
  {
    step: "01",
    title: "Assess",
    text: "Înțelegem activele, datele, furnizorii, controalele și riscurile care contează în mediul real.",
  },
  {
    step: "02",
    title: "Implement",
    text: "Transformăm findings și gap-uri în schimbări tehnice, procese, controls și ownership clar.",
  },
  {
    step: "03",
    title: "Operate",
    text: "Monitoring, reviews, evidence și remediation continuă după primul proiect sau audit.",
  },
];

const boundaries = [
  "Nu vindem migrare dacă infrastructura existentă poate fi securizată corect.",
  "Nu tratăm un framework ca dovadă că toate sistemele sunt securizate.",
  "Nu prezentăm un assessment ca pentest fără scope și autorizare potrivite.",
  "Nu promitem «100% secure» sau conformitate doar pentru că există un tool sau un control.",
];
---

<Layout
  title="De ce ZebraByte"
  description="De ce ZebraByte: cyber security, privacy, compliance și infrastructură administrată conectate într-un singur program operațional."
>
  <main>
    <animated-hero class="relative -mt-16 block overflow-hidden px-5 pb-16 pt-32 sm:pb-24 sm:pt-40">
      <div class="container text-center">
        <p class="text-muted-foreground animate-perspective-in mb-5 text-sm font-medium uppercase tracking-[0.14em]">Why ZebraByte</p>
        <h1 class="text-h2 sm:text-h1 animate-perspective-in animation-delay-100 mx-auto mb-6 max-w-230 font-medium text-balance">
          Securitatea și conformitatea funcționează mai bine când descriu aceeași realitate.
        </h1>
        <p class="text-muted-foreground animate-perspective-in animation-delay-150 mx-auto mb-8 max-w-190 text-lg text-balance">
          ZebraByte conectează cyber security, privacy, compliance și infrastructura administrată astfel încât riscul, controls, evidence și ownership-ul să nu trăiască în proiecte separate.
        </p>
        <div class="flex flex-col justify-center gap-3 sm:flex-row">
          <Button href="/contact" size="lg">Discută cu noi</Button>
          <Button href="/compliance-platform" variant="secondary" size="lg">Vezi platforma</Button>
        </div>
      </div>
    </animated-hero>

    <section class="container pb-12 sm:pb-24">
      <div class="overflow-hidden rounded-2xl border">
        <div class="grid lg:grid-cols-2">
          {pillars.map((pillar, index) => (
            <a
              href={pillar.href}
              class:list={[
                "group min-h-80 p-8 transition-colors hover:bg-active sm:p-12",
                index % 2 === 0 && "lg:border-r",
                index < 2 && "border-b",
              ]}
            >
              <p class="text-muted-foreground mb-12 text-sm font-medium uppercase tracking-wide">{pillar.label}</p>
              <h2 class="text-h3 mb-4 max-w-xl font-medium group-hover:underline group-hover:underline-offset-4">{pillar.title}</h2>
              <p class="text-muted-foreground max-w-xl text-lg leading-relaxed">{pillar.text}</p>
            </a>
          ))}
        </div>
      </div>
    </section>

    <section class="bg-level-3 py-12 text-level-0-foreground sm:py-24">
      <div class="container grid items-start gap-14 lg:grid-cols-[0.8fr_1.2fr] lg:gap-24">
        <div>
          <p class="text-level-0-foreground/55 mb-3 text-sm font-medium uppercase tracking-wide">Evidence, not slogans</p>
          <h2 class="text-h3 sm:text-h2 mb-5 font-medium">Încrederea trebuie să poată fi demonstrată.</h2>
          <p class="text-level-0-foreground/65 text-lg leading-relaxed">
            „Secure” și „compliant” nu sunt rezultate utile dacă nu poți arăta ce control există, cine îl operează, ce evidence îl susține și ce se întâmplă când controlul eșuează.
          </p>
        </div>

        <div class="divide-y divide-level-0-foreground/15 border-y border-level-0-foreground/15">
          {proofRows.map(([title, text]) => (
            <article class="grid gap-3 py-6 sm:grid-cols-[0.55fr_1.45fr] sm:gap-10">
              <h3 class="text-h5 font-medium">{title}</h3>
              <p class="text-level-0-foreground/65 leading-relaxed">{text}</p>
            </article>
          ))}
        </div>
      </div>
    </section>

    <section class="container py-12 sm:py-24">
      <div class="mx-auto mb-12 max-w-190 text-center sm:mb-16">
        <p class="text-muted-foreground mb-3 text-sm font-medium uppercase tracking-wide">One operating model</p>
        <h2 class="text-h3 sm:text-h2 mb-4 font-medium">Poți începe punctual fără să creezi încă un siloz.</h2>
        <p class="text-muted-foreground text-lg leading-relaxed">
          Un assessment poate deveni remediation. Un control tehnic poate genera evidence. Un incident poate schimba risk register-ul. Conectăm etapele doar acolo unde există valoare reală.
        </p>
      </div>

      <div class="mx-auto grid max-w-5xl gap-10 sm:grid-cols-3 sm:gap-14">
        {workflow.map((item) => (
          <article>
            <span class="text-muted-foreground mb-7 block font-mono text-sm">{item.step}</span>
            <h3 class="text-h4 mb-3 font-medium">{item.title}</h3>
            <p class="text-muted-foreground leading-relaxed">{item.text}</p>
          </article>
        ))}
      </div>
    </section>

    <section class="bg-active py-12 sm:py-24">
      <div class="container grid gap-14 lg:grid-cols-2 lg:gap-24">
        <div>
          <p class="text-muted-foreground mb-3 text-sm font-medium uppercase tracking-wide">Clear boundaries</p>
          <h2 class="text-h3 sm:text-h2 mb-5 font-medium">Un partener bun trebuie să știe și ce să nu recomande.</h2>
          <p class="text-muted-foreground text-lg leading-relaxed">
            Scope-ul, autorizarea și limitele tehnice contează la fel de mult ca feature-urile. Preferăm o decizie explicabilă în locul unei promisiuni generale.
          </p>
        </div>
        <div class="space-y-6">
          {boundaries.map((item, index) => (
            <div class="grid grid-cols-[48px_1fr] gap-4 border-t pt-5">
              <span class="text-muted-foreground font-mono text-sm">0{index + 1}</span>
              <p class="text-lg leading-relaxed">{item}</p>
            </div>
          ))}
        </div>
      </div>
    </section>

    <section class="container py-12 sm:py-24">
      <div class="grid overflow-hidden rounded-2xl border lg:grid-cols-2">
        <div class="p-8 sm:p-12">
          <p class="text-muted-foreground mb-3 text-sm font-medium uppercase tracking-wide">Need to see the program?</p>
          <h2 class="text-h3 mb-5 font-medium">Platforma organizează munca internă.</h2>
          <p class="text-muted-foreground mb-7 text-lg leading-relaxed">
            Framework-uri, controls, risks, evidence, tasks și audit readiness rămân într-un workspace intern conectat la operațiunile tehnice.
          </p>
          <Button href="/compliance-platform" variant="secondary">Vezi Platforma de conformitate</Button>
        </div>
        <div class="bg-active p-8 sm:p-12">
          <p class="text-muted-foreground mb-3 text-sm font-medium uppercase tracking-wide">Need to prove it externally?</p>
          <h2 class="text-h3 mb-5 font-medium">Trust Center-ul prezintă doar ce vrei să partajezi.</h2>
          <p class="text-muted-foreground mb-7 text-lg leading-relaxed">
            Documente, NDA, security information și acces controlat pentru clienți și security reviews, separat de workspace-ul intern.
          </p>
          <Button href="/compliance-portal" variant="secondary">Vezi Trust Center</Button>
        </div>
      </div>
    </section>

    <section class="container py-12 text-center sm:py-24">
      <h2 class="text-h3 sm:text-h2 mx-auto mb-4 max-w-190 font-medium text-balance">
        Începe cu problema reală. Extindem programul doar unde aduce valoare.
      </h2>
      <p class="text-muted-foreground mx-auto mb-8 max-w-160 text-lg">
        Putem porni de la security, compliance, privacy sau infrastructură și conecta restul doar când scope-ul o justifică.
      </p>
      <Button href="/contact" size="lg">Discută cu un expert</Button>
    </section>
  </main>
</Layout>

<script>
  import { AnimatedHero } from "../lib/elements/hero";
  import { customElementDefine } from "../lib/dom";
  customElementDefine("animated-hero", () => AnimatedHero);
</script>
