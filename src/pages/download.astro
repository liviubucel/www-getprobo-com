---
import { Image } from "astro:assets";
import Layout from "../layouts/Layout.astro";
import DownloadAgent from "../components/DownloadAgent.svelte";
import ProboLogo from "../assets/probo-logo-only.svg";
---

<Layout
  title="Download Probo Agent"
  description="Descarcă Probo Agent, componenta open-source păstrată în platforma ZebraByte pentru macOS, Linux, Windows și FreeBSD."
  noFrameworks
>
  <main>
    <animated-hero class="relative block overflow-hidden py-16 sm:py-28">
      <section class="container">
        <div class="mx-auto flex max-w-xl flex-col items-center text-center">
          <div class="animate-slide-in mb-8 flex items-center gap-3">
            <img
              src="/favicon.svg"
              alt="ZebraByte"
              width="80"
              height="80"
              class="size-20 rounded-xl"
            />
            <span class="text-muted-foreground text-lg">+</span>
            <Image
              src={ProboLogo}
              alt="Probo Agent"
              width={80}
              height={80}
              class="size-20"
            />
          </div>

          <p
            class="text-muted-foreground animate-slide-in animation-delay-50 mb-4 text-sm font-medium uppercase tracking-[0.12em]"
          >
            Upstream open-source component
          </p>

          <h1
            class="text-h2 animate-slide-in animation-delay-100 mb-4 font-medium"
          >
            Download Probo Agent
          </h1>

          <p
            class="text-muted-foreground animate-slide-in animation-delay-200 mb-5 max-w-xl"
          >
            Păstrăm agentul original Probo și downloader-ul lui complet. Este disponibil
            pentru macOS, Linux, Windows și FreeBSD și poate fi folosit pentru enrollment
            și verificarea continuă a posturei dispozitivelor.
          </p>

          <div
            class="bg-active text-muted-foreground animate-slide-in animation-delay-200 mb-10 rounded-lg border px-4 py-3 text-sm leading-relaxed"
          >
            ZebraByte integrează componenta open-source upstream fără să îi ascundă sau
            să îi schimbe artificial identitatea tehnică. Până la existența unui build
            ZebraByte separat, binarul rămâne Probo Agent.
          </div>

          <p class="text-muted-foreground mb-8 text-sm">
            Vezi
            <a
              href="/docs/product/probo-agent/overview"
              class="underline underline-offset-4">Probo Agent docs</a
            > pentru instalare, comenzi, securitate și enrollment.
          </p>

          <div class="animate-slide-in animation-delay-300 w-full">
            <DownloadAgent client:load />
          </div>
        </div>
      </section>
    </animated-hero>
  </main>
</Layout>

<script>
  import { AnimatedHero } from "../lib/elements/hero";
  import { customElementDefine } from "../lib/dom";

  customElementDefine("animated-hero", () => AnimatedHero);
</script>
