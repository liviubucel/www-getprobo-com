---
import Layout from "../layouts/Layout.astro";
import DownloadAgent from "../components/DownloadAgent.svelte";
---

<Layout
  title="Descarcă ZebraByte Device Agent"
  description="Descarcă ZebraByte Device Agent pentru macOS, Linux, Windows sau FreeBSD și înscrie endpoint-urile în workflow-ul de verificare continuă a posturii."
  noFrameworks
>
  <main>
    <animated-hero class="relative block overflow-hidden py-16 sm:py-28">
      <section class="container">
        <div class="mx-auto flex max-w-xl flex-col items-center text-center">
          <img
            src="/favicon.svg"
            alt="ZebraByte"
            width="80"
            height="80"
            class="animate-slide-in mb-8 size-20"
          />
          <p class="text-muted-foreground animate-slide-in mb-3 font-mono text-xs uppercase tracking-wide">Device posture</p>
          <h1 class="text-h2 animate-slide-in animation-delay-100 mb-4 font-medium">
            Descarcă ZebraByte Device Agent
          </h1>
          <p class="text-muted-foreground animate-slide-in animation-delay-200 mb-5 max-w-xl text-lg leading-relaxed">
            Disponibil pentru macOS, Linux, Windows și FreeBSD. Agentul poate înscrie dispozitive
            și furniza semnale de posture în programul de compliance, acolo unde endpoint-urile fac parte din scope.
          </p>
          <p class="text-muted-foreground animate-slide-in animation-delay-250 mb-10 max-w-lg text-sm leading-relaxed">
            Pentru modelul complet al platformei și modul în care Device Agent se conectează la controls și evidence,
            consultă <a href="/docs/product" class="font-medium underline underline-offset-4">documentația produsului</a>.
          </p>
          <div class="animate-slide-in animation-delay-300 w-full border-y py-6">
            <DownloadAgent client:load />
          </div>
        </div>
      </section>
    </animated-hero>
  </main>
</Layout>

<script>
  import { AnimatedHero } from "../lib/elements/hero";
  import { customElementDefine } from "../lib/dom";

  customElementDefine("animated-hero", () => AnimatedHero);
</script>