---
import Layout from "../layouts/Layout.astro";
import { getCollection } from "astro:content";
import WrittenBy from "../components/block/WrittenBy.astro";
import { pageSize } from "../content.config.ts";
import Pagination from "../components/Pagination.astro";

const allPosts = (await getCollection("blog")).sort(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf(),
);
const lastPage = Math.ceil(allPosts.length / pageSize);
const posts = allPosts.slice(0, pageSize);
const dateFormatter = Intl.DateTimeFormat("ro-RO", {
  year: "numeric",
  month: "long",
  day: "numeric",
});
---

<Layout
  title="Blog: Cyber Security, Compliance & Privacy"
  description="Ghiduri și analize ZebraByte despre securitate și conformitate, împreună cu arhiva editorială upstream Probo păstrată cu atribuirea autorilor originali."
>
  <main class="container my-10 sm:my-20">
    <h1 class="text-h2 animate-slide-in mb-3 font-medium">Blog</h1>
    <p
      class="text-muted-foreground animate-slide-in animation-delay-100 mb-6 text-base"
    >
      Security, privacy, compliance și open source.
    </p>

    <div
      class="bg-active text-muted-foreground animate-slide-in animation-delay-150 mb-10 max-w-3xl rounded-lg border p-4 text-sm leading-relaxed sm:mb-16"
    >
      Arhiva actuală include articole publicate inițial de echipa Probo și păstrate
      pentru continuitatea proiectului open-source. Autorii originali rămân creditați;
      aceste articole nu sunt prezentate ca fiind scrise de echipa ZebraByte.
    </div>

    <div
      class="animate-slide-in animation-delay-300 flex flex-col items-start gap-10 sm:grid sm:grid-cols-[1fr_320px] sm:gap-30"
    >
      <section>
        {
          posts.map((post: any) => (
            <article class="space-y-3 border-b py-10 first:pt-0 last:border-b-0">
              <div class="text-muted-foreground">
                {dateFormatter.format(new Date(post.data.date))}, de{" "}
                {post.data.author.name}
              </div>
              <h2>
                <a
                  href={`/blog/${post.id.split("/").at(-1)}`}
                  class="text-h4 block font-medium hover:opacity-80"
                >
                  {post.data.title}
                </a>
              </h2>
              <p class="text-muted-foreground text-lg whitespace-pre-line">
                {post.data.excerpt}
              </p>
            </article>
          ))
        }
        <Pagination currentPage={1} lastPage={lastPage} url="/blog" />
      </section>
      <aside class="animate-slide-in animation-delay-200 sticky top-20">
        <WrittenBy />
      </aside>
    </div>
  </main>
</Layout>
