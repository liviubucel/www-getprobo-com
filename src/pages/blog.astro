---
import Layout from "../layouts/Layout.astro";

const insights = [
  {
    label: "Compliance",
    title: "Cum construiești un program de compliance care rămâne audit-ready",
    text: "Pornește de la risk, ownership, controls și evidence, nu de la documente create doar înainte de audit.",
    href: "/managed-compliance",
  },
  {
    label: "SOC 2",
    title: "SOC 2 ca program continuu, nu ca proiect punctual",
    text: "Scope, controls, evidence și remediation trebuie să fie conectate la modul real în care operează organizația.",
    href: "/soc2",
  },
  {
    label: "Cyber Security",
    title: "De ce un security assessment trebuie să ducă la remediation",
    text: "Un raport are valoare doar dacă gap-urile sunt prioritizate, au owner și sunt urmărite până la rezultat.",
    href: "/security-assessment",
  },
  {
    label: "Privacy",
    title: "GDPR: documentația trebuie să reflecte infrastructura reală",
    text: "Privacy governance devine mai utilă când este legată de acces, retention, vendors și măsuri tehnice verificabile.",
    href: "/gdpr",
  },
  {
    label: "Accessibility",
    title: "Widgetul nu înlocuiește accessibility compliance",
    text: "Instrumentele gratuite pot ajuta utilizatorii, dar WCAG cere audit, remediation și verificarea experienței reale.",
    href: "/accessibility",
  },
  {
    label: "Infrastructure",
    title: "Secure hosting înseamnă mai mult decât un server rapid",
    text: "Hardening, isolation, backups, monitoring și change control trebuie operate ca parte din postura de securitate.",
    href: "/secure-hosting",
  },
];
---

<Layout
  title="Insights: Cyber Security, Compliance & Privacy"
  description="Resurse ZebraByte despre managed compliance, SOC 2, ISO 27001, GDPR, NIS2, accessibility, cyber security și secure managed hosting."
>
  <main class="container my-10 sm:my-20">
    <h1 class="text-h2 animate-slide-in mb-3 font-medium">Insights</h1>
    <p class="text-muted-foreground animate-slide-in animation-delay-100 mb-12 max-w-2xl text-base sm:mb-16">
      Security, privacy și compliance explicate prin probleme operaționale reale.
    </p>

    <div class="animate-slide-in animation-delay-300 grid gap-5 sm:grid-cols-2 lg:grid-cols-3">
      {insights.map((item) => (
        <article class="group flex min-h-72 flex-col rounded-2xl border bg-level-0 p-6 transition-all hover:-translate-y-1 hover:bg-subtle hover:shadow-lg sm:p-8">
          <p class="text-muted-foreground mb-10 text-sm font-medium">{item.label}</p>
          <h2 class="text-h4 mb-3 font-medium">{item.title}</h2>
          <p class="text-muted-foreground mb-8 leading-relaxed">{item.text}</p>
          <a href={item.href} class="mt-auto font-medium group-hover:underline group-hover:underline-offset-4">Citește ghidul →</a>
        </article>
      ))}
    </div>

    <section class="mt-16 rounded-3xl bg-active p-8 sm:mt-24 sm:p-12">
      <div class="grid gap-6 sm:grid-cols-[1fr_auto] sm:items-center">
        <div>
          <h2 class="text-h3 mb-3 font-medium">Mai multe resurse în Hub</h2>
          <p class="text-muted-foreground max-w-2xl text-lg">Explorează framework-uri, security resources și instrumentele gratuite ZebraByte.</p>
        </div>
        <a href="/hub" class="bg-primary text-primary-foreground inline-flex w-max rounded-full px-6 py-3 font-medium">Deschide Hub</a>
      </div>
    </section>
  </main>
</Layout>
