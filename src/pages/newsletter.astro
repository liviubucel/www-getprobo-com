---
import Layout from "../layouts/Layout.astro";
import Newsletter from "../components/block/Newsletter.astro";
---

<Layout
  title="Newsletter"
  description="Subscribe to ZebraByte insights about compliance, cyber security, privacy and security-first infrastructure."
>
  <main class="container max-w-3xl py-16 sm:py-24">
    <div class="mb-10">
      <p class="text-muted-foreground mb-3 text-sm font-medium uppercase tracking-[0.14em]">Newsletter</p>
      <h1 class="text-h2 mb-4 font-medium">Compliance & security insights, without the noise.</h1>
      <p class="text-muted-foreground max-w-2xl text-lg leading-relaxed">
        Primește ghiduri practice despre compliance, cyber security, privacy, audit readiness și schimbări care contează pentru echipe tehnice și de management.
      </p>
    </div>
    <Newsletter />
  </main>
</Layout>
