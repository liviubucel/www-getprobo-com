---
import Layout from "../layouts/Layout.astro";
---

<Layout
  title="Pagina nu a fost găsită"
  description="Pagina solicitată nu există sau a fost mutată."
  noFrameworks
  noIndex
>
  <animated-hero class="block overflow-hidden px-5 py-28 sm:py-40">
    <h1
      class="text-h2 sm:text-h1 mb-6 overflow-hidden text-center font-medium text-balance sm:mb-8"
    >
      Pagina nu a fost găsită
    </h1>
    <p
      class="text-muted-foreground animate-perspective-in animation-delay-150 mx-auto mb-10 max-w-200 text-center text-lg text-balance"
    >
      Pagina solicitată nu există sau adresa ei s-a schimbat.
    </p>
    <nav class="flex flex-wrap items-center justify-center gap-x-5 gap-y-3" aria-label="Linkuri utile">
      <a href="/" class="text-primary underline underline-offset-4 hover:opacity-80">Acasă</a>
      <a href="/docs" class="text-primary underline underline-offset-4 hover:opacity-80">Documentație</a>
      <a href="/blog" class="text-primary underline underline-offset-4 hover:opacity-80">Blog</a>
      <a href="/hub" class="text-primary underline underline-offset-4 hover:opacity-80">Hub</a>
      <a href="/contact" class="text-primary underline underline-offset-4 hover:opacity-80">Contact</a>
    </nav>
  </animated-hero>
</Layout>

<script>
  import { AnimatedHero } from "../lib/elements/hero";
  import { customElementDefine } from "../lib/dom";

  customElementDefine("animated-hero", () => AnimatedHero);
</script>
