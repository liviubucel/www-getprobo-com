---
import Layout from "../layouts/Layout.astro";
import AboutImg from "../assets/about.png";
import Team from "../components/block/Team.astro";
import Gallery from "../components/block/Gallery.astro";
import Testimonials from "../components/block/Testimonials.astro";
import ResponsiveImage from "../components/ui/ResponsiveImage.astro";
---

<Layout
  title="Platform Archive"
  description="Preserved platform photography, profiles, testimonials and editorial material kept as part of the complete ZebraByte product experience."
  noIndex
>
  <main>
    <section class="container my-10 sm:mt-20 sm:mb-24">
      <p class="text-muted-foreground mb-3 text-sm font-medium uppercase tracking-[0.14em]">Platform archive · noindex</p>
      <h1 class="text-h2 mb-4 font-medium">Platform archive</h1>
      <p class="text-muted-foreground mb-10 max-w-3xl text-lg leading-relaxed">
        Această bibliotecă păstrează fotografia, profilele, testimonialele și materialele editoriale care fac parte din experiența completă a platformei. Conținutul arhivat este prezentat în contextul său și nu transformă automat persoanele sau organizațiile afișate în angajați ori clienți ZebraByte.
      </p>
      <ResponsiveImage
        src={AboutImg}
        class="mb-10 aspect-square rounded-lg object-cover sm:aspect-1080/606"
        mobile={[640, 640]}
        sm={[1080, 607]}
        alt="Platform archive team photography"
      />
      <h2 class="text-muted-foreground mb-1">Mission archive</h2>
      <p class="text-quote">
        We're transforming compliance from a complex burden into an intuitive journey. The platform makes compliance more straightforward and cost-effective, helping businesses organize regulatory requirements with confidence.
      </p>
    </section>
    <Team />
    <Gallery />
    <Testimonials />
  </main>
</Layout>
