---
import Layout from "../layouts/Layout.astro";
import Button from "../components/ui/Button.svelte";

const scope = [
  {
    number: "01",
    title: "External attack surface",
    description: "Domenii, subdomenii, aplicații, servicii publice, DNS și configurații expuse observabile din exterior.",
  },
  {
    number: "02",
    title: "Web & infrastructure posture",
    description: "TLS, security headers, tehnologii expuse, access paths, configurații defensive și vulnerabilități relevante.",
  },
  {
    number: "03",
    title: "Identity & email posture",
    description: "MFA și access controls unde pot fi evaluate, plus SPF, DKIM, DMARC și configurațiile de domeniu relevante.",
  },
  {
    number: "04",
    title: "Risk & remediation",
    description: "Findings explicate prin impact și context, apoi transformate într-un plan de remediere prioritizat și verificabil.",
  },
];

const methodology = [
  ["01", "Scope", "Active, limite de autorizare și medii incluse."],
  ["02", "Discover", "Expunere, tehnologii, servicii și configurații."],
  ["03", "Validate", "Reducem false positives fără testare inutil intruzivă."],
  ["04", "Prioritize", "Severitate, exploatabilitate, expunere și impact."],
  ["05", "Report", "Finding, evidence, risc și recomandare clară."],
  ["06", "Verify", "Confirmăm remedierea și evităm regresiile."],
];

const deliverables = [
  "scope și inventar al suprafeței analizate",
  "findings tehnice prioritizate după risc și context",
  "evidence suficient pentru înțelegere și remediation",
  "recomandări tehnice și pași următori",
  "separarea problemelor urgente de hardening-ul recomandat",
  "mapping către controls sau cerințe de compliance unde este relevant",
  "review al rezultatelor cu ownerii tehnici",
];

const boundaries = [
  {
    title: "Authorization first",
    text: "Nu extindem testarea către alte sisteme, tenants sau furnizori doar pentru că apar ca dependențe. Activele testate trebuie să fie în scope-ul autorizat.",
  },
  {
    title: "Assessment ≠ pentest implicit",
    text: "Un security assessment nu devine automat penetration test. Testarea activă și exploatarea necesită reguli și autorizare potrivite engagement-ului.",
  },
  {
    title: "Minimizăm impactul",
    text: "Validarea trebuie să ofere suficientă încredere fără să provoace indisponibilitate, pierdere de date sau modificări inutile în producție.",
  },
  {
    title: "Secrets stay out of public forms",
    text: "Parole, private keys, recovery codes și token-uri nu trebuie trimise prin formularul public. Accesul se stabilește prin canalul potrivit.",
  },
];

const nextSteps = [
  ["Website Security", "WAF, hardening, monitoring și recovery pentru aplicații expuse public.", "/website-security"],
  ["Email Security", "SPF, DKIM, DMARC și identity hardening pentru domeniu și conturi.", "/email-security"],
  ["Secure Managed Hosting", "Migrare și operare continuă când infrastructura trebuie adusă într-un model managed.", "/secure-hosting"],
  ["Incident Response", "Triage și containment când assessment-ul pornește de la o suspiciune de compromitere.", "/incident-response"],
];

const faqs = [
  {
    question: "Security Assessment este un penetration test?",
    answer:
      "Nu implicit. Assessment-ul analizează suprafața expusă, configurațiile și controalele din scope. Un penetration test are reguli de testare și autorizare distincte și trebuie agreat separat atunci când este necesar.",
  },
  {
    question: "Aveți nevoie de acces administrativ?",
    answer:
      "Nu pentru fiecare assessment. Putem începe din perspectiva externă și putem extinde review-ul către configurații interne doar dacă scope-ul cere asta și accesul este furnizat printr-un canal adecvat.",
  },
  {
    question: "Evaluați și furnizori terți?",
    answer:
      "Putem documenta dependențele și riscul asociat, dar nu testăm infrastructura unui terț fără autorizarea corespunzătoare. Limitele engagement-ului se stabilesc înainte de testare.",
  },
  {
    question: "Ce se întâmplă după raport?",
    answer:
      "Poți remedia cu echipa sau furnizorul existent, ori ZebraByte poate prelua anumite acțiuni de hardening, website/email security, migration sau managed security dacă intră în scope.",
  },
  {
    question: "Assessment-ul poate ajuta și la ISO 27001, NIS2 sau GDPR?",
    answer:
      "Da, findings și evidence tehnic pot susține risk treatment sau controls relevante. Assessment-ul nu certifică însă organizația și nu înlocuiește programul de compliance sau analiza juridică aplicabilă.",
  },
];
---

<Layout
  title="Security Assessment & Cyber Audit"
  description="Security Assessment ZebraByte pentru website, domeniu, email și servicii expuse public, cu findings tehnice, evidence și plan de remediere prioritizat."
>
  <main>
    <animated-hero class="relative -mt-16 block overflow-hidden px-5 py-10 pt-26 sm:pt-36 sm:pb-12">
      <div class="text-muted-foreground animate-perspective-in animation-delay-300 mx-auto mb-6 w-max rounded-lg border px-4 py-2 text-sm font-medium sm:mb-8">
        Security Assessment
      </div>

      <h1 class="text-h2 sm:text-h1 mb-6 overflow-hidden text-center font-medium text-balance sm:mb-8">
        <span class="animate-perspective-in block">Înțelege suprafața de atac</span>
        <span class="animate-perspective-in block delay-50"> înainte să alegi remedierea. </span>
      </h1>

      <p class="text-muted-foreground animate-perspective-in animation-delay-150 mx-auto mb-6 max-w-200 text-center text-lg text-balance sm:mb-8">
        Evaluăm website-ul, domeniul, emailul și serviciile expuse public, validăm constatările și le transformăm într-un plan tehnic prioritizat după risc și impact.
      </p>

      <div class="mb-11 flex flex-col items-stretch justify-center gap-3 sm:mb-17 sm:flex-row sm:items-center">
        <Button class="animate-perspective-in animation-delay-200" variant="secondary" size="lg" href="/cyber-security">Vezi Cyber Security</Button>
        <Button class="animate-perspective-in animation-delay-300" size="lg" href="/contact">Solicită o evaluare</Button>
      </div>
    </animated-hero>

    <section class="container pb-12 sm:pb-24">
      <div class="overflow-hidden rounded-2xl border bg-level-1">
        <div class="grid min-h-[420px] lg:grid-cols-[0.85fr_1.15fr]">
          <div class="border-b p-8 sm:p-12 lg:border-r lg:border-b-0">
            <p class="text-muted-foreground mb-3 text-sm font-medium uppercase tracking-wide">Attack surface</p>
            <h2 class="text-h3 mb-5 font-medium">Ce este expus și cum se leagă.</h2>
            <p class="text-muted-foreground text-lg leading-relaxed">
              Un assessment bun nu tratează website-ul, emailul și DNS-ul ca insule. Inventarul arată relația dintre active și unde un control slab poate schimba riscul altui serviciu.
            </p>
          </div>

          <div class="relative overflow-hidden bg-active p-8 sm:p-12">
            <div class="absolute inset-0 bg-[radial-gradient(circle_at_center,rgba(200,255,45,0.18),transparent_58%)]"></div>
            <div class="relative grid h-full place-items-center">
              <div class="relative w-full max-w-xl">
                <div class="mx-auto mb-10 w-max rounded-full border bg-background px-5 py-3 font-medium">zebrabyte-client.tld</div>
                <div class="grid grid-cols-2 gap-5 sm:grid-cols-4">
                  {scope.map((item) => (
                    <div class="rounded-xl border bg-background p-5 text-center shadow-sm">
                      <span class="text-muted-foreground mb-3 block font-mono text-xs">{item.number}</span>
                      <span class="font-medium">{item.title}</span>
                    </div>
                  ))}
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>
    </section>

    <section class="container py-12 sm:py-24">
      <div class="mx-auto mb-12 max-w-190 text-center sm:mb-16">
        <p class="text-muted-foreground mb-3 text-sm font-medium uppercase tracking-wide">Methodology</p>
        <h2 class="text-h3 sm:text-h2 mb-4 font-medium">Tool-urile descoperă. Procesul produce încredere.</h2>
        <p class="text-muted-foreground text-lg leading-relaxed">
          Valoarea vine din scope, validare și prioritizare. Nu extindem testarea doar pentru a produce un raport mai lung.
        </p>
      </div>

      <div class="relative mx-auto max-w-6xl">
        <div class="absolute top-5 right-[8%] left-[8%] hidden h-px bg-border lg:block"></div>
        <div class="grid gap-10 sm:grid-cols-2 lg:grid-cols-6 lg:gap-6">
          {methodology.map(([step, title, text]) => (
            <article class="relative">
              <div class="mb-5 flex size-10 items-center justify-center rounded-full border bg-background font-mono text-xs">{step}</div>
              <h3 class="text-h5 mb-2 font-medium">{title}</h3>
              <p class="text-muted-foreground leading-relaxed">{text}</p>
            </article>
          ))}
        </div>
      </div>
    </section>

    <section class="bg-level-3 py-12 text-level-0-foreground sm:py-24">
      <div class="container grid items-center gap-14 lg:grid-cols-[0.8fr_1.2fr] lg:gap-24">
        <div>
          <p class="text-level-0-foreground/55 mb-3 text-sm font-medium uppercase tracking-wide">Finding anatomy</p>
          <h2 class="text-h3 sm:text-h2 mb-5 font-medium">Un finding trebuie să poată fi folosit.</h2>
          <p class="text-level-0-foreground/65 text-lg leading-relaxed">
            Nu livrăm doar un nume de vulnerabilitate și un scor. Owner-ul tehnic trebuie să înțeleagă ce am observat, de ce contează, cum se remediază și cum verificăm schimbarea.
          </p>
        </div>

        <div class="overflow-hidden rounded-2xl bg-level-0 text-foreground shadow-xl">
          <div class="flex items-center justify-between border-b px-6 py-5">
            <div>
              <span class="text-muted-foreground text-xs uppercase tracking-wide">Finding ZB-017</span>
              <h3 class="mt-1 font-medium">Administrative interface exposed</h3>
            </div>
            <span class="rounded-full border px-3 py-1 text-sm font-medium">High</span>
          </div>
          <div class="grid sm:grid-cols-2">
            <div class="border-b p-6 sm:border-r sm:border-b-0">
              <p class="text-muted-foreground mb-2 text-xs uppercase tracking-wide">Evidence</p>
              <p class="leading-relaxed">Public route reachable without the expected access boundary.</p>
              <p class="text-muted-foreground mt-6 mb-2 text-xs uppercase tracking-wide">Risk</p>
              <p class="leading-relaxed">Increases credential attack surface and exposure of privileged functionality.</p>
            </div>
            <div class="p-6">
              <p class="text-muted-foreground mb-2 text-xs uppercase tracking-wide">Remediation</p>
              <p class="leading-relaxed">Restrict the administrative path, enforce stronger identity controls and retest legitimate access.</p>
              <p class="text-muted-foreground mt-6 mb-2 text-xs uppercase tracking-wide">Verification</p>
              <p class="leading-relaxed">Confirm unauthorized access is blocked while approved administrative workflows remain functional.</p>
            </div>
          </div>
        </div>
      </div>
    </section>

    <section class="container py-12 sm:py-24">
      <div class="grid gap-14 lg:grid-cols-2 lg:gap-24">
        <div>
          <p class="text-muted-foreground mb-3 text-sm font-medium uppercase tracking-wide">Deliverables</p>
          <h2 class="text-h3 sm:text-h2 mb-5 font-medium">Raportul trebuie să reducă incertitudinea.</h2>
          <p class="text-muted-foreground mb-7 text-lg leading-relaxed">
            Separăm problemele urgente de hardening-ul recomandat și păstrăm suficient context încât rezultatul să poată fi executat de echipa ta, de furnizorul existent sau de ZebraByte.
          </p>
          <div class="space-y-4">
            {deliverables.map((item) => (
              <div class="flex items-start gap-3">
                <span class="mt-2 size-1.5 shrink-0 rounded-full bg-foreground"></span>
                <p class="text-muted-foreground leading-relaxed">{item}</p>
              </div>
            ))}
          </div>
        </div>

        <div class="overflow-hidden rounded-2xl border bg-active p-8 sm:p-12">
          <p class="text-muted-foreground mb-8 text-sm uppercase tracking-wide">Report structure</p>
          <div class="space-y-8">
            <div>
              <span class="text-muted-foreground text-sm">01</span>
              <h3 class="text-h4 mt-2 font-medium">Executive risk view</h3>
            </div>
            <div class="h-px bg-border"></div>
            <div>
              <span class="text-muted-foreground text-sm">02</span>
              <h3 class="text-h4 mt-2 font-medium">Technical findings</h3>
            </div>
            <div class="h-px bg-border"></div>
            <div>
              <span class="text-muted-foreground text-sm">03</span>
              <h3 class="text-h4 mt-2 font-medium">Prioritized remediation</h3>
            </div>
            <div class="h-px bg-border"></div>
            <div>
              <span class="text-muted-foreground text-sm">04</span>
              <h3 class="text-h4 mt-2 font-medium">Verification path</h3>
            </div>
          </div>
        </div>
      </div>
    </section>

    <section class="bg-active py-12 sm:py-24">
      <div class="container">
        <div class="mb-12 max-w-3xl sm:mb-16">
          <p class="text-muted-foreground mb-3 text-sm font-medium uppercase tracking-wide">Rules of engagement</p>
          <h2 class="text-h3 sm:text-h2 mb-4 font-medium">Limitele assessment-ului sunt parte din securitate.</h2>
          <p class="text-muted-foreground text-lg leading-relaxed">
            Autorizarea, impactul acceptabil și modul de gestionare a accesului sunt stabilite înainte de testare, nu improvizate după ce un tool găsește o dependență interesantă.
          </p>
        </div>

        <div class="grid gap-10 sm:grid-cols-2 lg:grid-cols-4 lg:gap-12">
          {boundaries.map((item, index) => (
            <article>
              <span class="text-muted-foreground mb-7 block font-mono text-sm">0{index + 1}</span>
              <h3 class="text-h4 mb-3 font-medium">{item.title}</h3>
              <p class="text-muted-foreground leading-relaxed">{item.text}</p>
            </article>
          ))}
        </div>
      </div>
    </section>

    <section class="container py-12 sm:py-24">
      <div class="mx-auto mb-12 max-w-180 text-center sm:mb-16">
        <p class="text-muted-foreground mb-3 text-sm font-medium uppercase tracking-wide">After assessment</p>
        <h2 class="text-h3 sm:text-h2 mb-4 font-medium">Raportul nu te blochează într-un singur model de execuție.</h2>
        <p class="text-muted-foreground text-lg leading-relaxed">
          Poți remedia intern, împreună cu furnizorii existenți sau cu ZebraByte acolo unde are sens.
        </p>
      </div>

      <div class="mx-auto grid max-w-5xl gap-x-12 sm:grid-cols-2">
        {nextSteps.map(([title, text, href]) => (
          <a href={href} class="group border-t py-7">
            <h3 class="text-h4 font-medium group-hover:underline group-hover:underline-offset-4">{title}</h3>
            <p class="text-muted-foreground mt-3 leading-relaxed">{text}</p>
          </a>
        ))}
      </div>
    </section>

    <section class="container py-10 sm:py-20">
      <div class="mx-auto max-w-3xl">
        <h2 class="text-h3 sm:text-h2 mb-8 text-center font-medium">Întrebări frecvente</h2>
        <div class="border-y">
          {faqs.map((faq) => (
            <details class="group border-b py-5 last:border-b-0">
              <summary class="flex cursor-pointer list-none items-center justify-between gap-6 font-medium">
                <span>{faq.question}</span>
                <span class="text-muted-foreground text-xl transition-transform group-open:rotate-45">+</span>
              </summary>
              <p class="text-muted-foreground max-w-2xl pt-4 leading-relaxed">{faq.answer}</p>
            </details>
          ))}
        </div>
      </div>
    </section>

    <section class="container py-12 text-center sm:py-24">
      <h2 class="text-h3 sm:text-h2 mx-auto mb-4 max-w-190 font-medium text-balance">
        Începe cu riscul pe care îl poți vedea și construiește de acolo.
      </h2>
      <p class="text-muted-foreground mx-auto mb-8 max-w-160 text-lg">
        Putem începe cu suprafața expusă și continua doar cu măsurile care schimbă efectiv postura de securitate.
      </p>
      <Button href="/contact" size="lg">Solicită un Security Assessment</Button>
    </section>
  </main>
</Layout>

<script>
  import { AnimatedHero } from "../lib/elements/hero";
  import { customElementDefine } from "../lib/dom";
  customElementDefine("animated-hero", () => AnimatedHero);
</script>
