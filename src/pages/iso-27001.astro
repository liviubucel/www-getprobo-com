---
import Layout from "../layouts/Layout.astro";
import Button from "../components/ui/Button.svelte";
import FrameworkBadge from "../components/FrameworkBadge.svelte";
import Stories from "../components/block/Stories.astro";

const clauses = [
  ["04", "Context"],
  ["05", "Leadership"],
  ["06", "Planning"],
  ["07", "Support"],
  ["08", "Operation"],
  ["09", "Performance"],
  ["10", "Improvement"],
];

const annexThemes = [
  ["37", "Organizational", "Policies, roles, suppliers, threat intelligence și incident management."],
  ["8", "People", "Screening, awareness, responsibilities și procese care reduc riscul uman."],
  ["14", "Physical", "Zone securizate, echipamente și protecția fizică a informației și infrastructurii."],
  ["34", "Technological", "Identity, logging, vulnerability management, cryptography, networks și secure development."],
];

const certificationJourney = [
  ["01", "Readiness", "Scope, risk assessment, controls, policies, evidence și remediation."],
  ["02", "Internal assurance", "Internal audit, management review, findings și corrective actions."],
  ["03", "Stage 1", "Pregătirea ISMS-ului și documentația necesară pentru evaluarea detaliată."],
  ["04", "Stage 2", "Implementarea și operarea ISMS-ului și a controls din scope."],
  ["05", "Continuous", "Risk reviews, management reviews și continual improvement după certificare."],
];

const securityConnections = [
  "Identity, MFA, SSO și access reviews",
  "Vulnerability management, patching și hardening",
  "Logging, monitoring și incident handling",
  "Backup, recovery și business continuity",
  "Supplier și third-party security",
  "Secure development și change management",
];

const faqs = [
  {
    question: "ZebraByte poate emite certificarea ISO/IEC 27001?",
    answer:
      "Nu. ZebraByte poate ajuta cu readiness, ISMS design, risk management, controls, evidence și remediation. Certificarea este emisă de un organism de certificare independent.",
  },
  {
    question: "Trebuie implementate toate cele 93 de controale din Annex A?",
    answer:
      "Nu automat. Organizația își evaluează riscurile și obligațiile, selectează controls relevante și documentează aplicabilitatea în Statement of Applicability.",
  },
  {
    question: "Ce este Statement of Applicability?",
    answer:
      "Este documentul care leagă tratamentul riscului de controls relevante din Annex A și explică aplicabilitatea lor. Îl tratăm ca parte vie a programului, nu ca un tabel pregătit doar pentru audit.",
  },
  {
    question: "Ce se întâmplă după certificare?",
    answer:
      "ISMS-ul continuă: risk reviews, internal audits, management reviews, corrective actions și actualizarea controls. Certificarea nu transformă programul într-un artefact static.",
  },
];

const serviceSchema = {
  "@context": "https://schema.org",
  "@type": "Service",
  name: "ISO/IEC 27001 Readiness",
  provider: { "@type": "Organization", name: "ZebraByte", url: "https://www.zebrabyte.ro" },
  serviceType: "ISO/IEC 27001 ISMS readiness and continuous compliance support",
  url: "https://www.zebrabyte.ro/iso-27001",
};
---

<Layout
  title="ISO/IEC 27001 Readiness"
  description="ISO/IEC 27001 readiness ZebraByte: ISMS scope, risk management, controls, Statement of Applicability, evidence, internal audit readiness și continual improvement."
>
  <script type="application/ld+json" set:html={JSON.stringify(serviceSchema)} />

  <main class="-mt-16 overflow-hidden pt-16">
    <section class="container py-16 sm:py-24">
      <div class="grid items-center gap-12 lg:grid-cols-[0.9fr_1.1fr] lg:gap-20">
        <div>
          <div class="text-muted-foreground mb-6 w-max rounded-lg border px-3 py-1 text-sm font-medium">ISO/IEC 27001:2022 · ISMS</div>
          <h1 class="text-h2 sm:text-h1 mb-6 max-w-190 font-medium text-balance">Un sistem de management care continuă după certificare.</h1>
          <p class="text-muted-foreground mb-8 max-w-160 text-lg leading-relaxed">
            Scope, risk management, Statement of Applicability, controls, evidence și continual improvement într-un ISMS pe care organizația îl poate opera — nu doar prezenta auditorului.
          </p>
          <div class="flex flex-col gap-3 sm:flex-row">
            <Button href="/contact" size="lg">Discută despre ISO 27001</Button>
            <Button href="/managed-compliance" variant="secondary" size="lg">Managed Compliance</Button>
          </div>
        </div>

        <div class="relative flex min-h-[360px] flex-col items-center justify-center overflow-hidden rounded-[32px] bg-[#001a00] p-6 text-white sm:min-h-[520px] sm:p-10 lg:min-h-[560px]">
          <div aria-hidden="true" class="pointer-events-none absolute -right-28 -bottom-36 size-[520px] rounded-full border-[100px] border-[#e6ff03]/50 blur-[55px]"></div>
          <div class="relative z-10 flex flex-1 items-center justify-center py-5">
            <FrameworkBadge name="ISO27001_dark" class="size-44 sm:size-60 lg:size-64" client:visible />
          </div>
          <div class="relative z-10 flex w-full flex-col items-center justify-between gap-2 text-center text-sm text-white/65 sm:flex-row sm:text-left">
            <span>Information Security Management System</span>
            <span class="text-[#e6ff03]">2022</span>
          </div>
        </div>
      </div>
    </section>

    <section class="bg-[#f8faf4] py-14 sm:py-24">
      <div class="container">
        <div class="grid gap-12 lg:grid-cols-[0.72fr_1.28fr] lg:gap-20">
          <div class="max-w-135">
            <p class="text-muted-foreground mb-3 text-sm font-medium uppercase tracking-[0.12em]">Management system</p>
            <h2 class="text-h3 sm:text-h2 mb-5 font-medium text-balance">Annex A nu este tot standardul.</h2>
            <p class="text-muted-foreground text-lg leading-relaxed">Clauzele 4–10 definesc cum organizația stabilește contextul, conduce programul, tratează riscul, operează controls, verifică performanța și îmbunătățește ISMS-ul.</p>
          </div>

          <div class="grid grid-cols-2 gap-3 sm:grid-cols-4">
            {clauses.map(([number, title], index) => (
              <div class:list={[
                "min-h-36 rounded-[22px] border p-5 sm:min-h-44 sm:p-6",
                index === clauses.length - 1 ? "bg-[#001a00] text-white sm:col-span-2" : "bg-level-0",
              ]}>
                <p class:list={["mb-8 font-mono text-sm", index === clauses.length - 1 ? "text-[#e6ff03]" : "text-muted-foreground"]}>{number}</p>
                <h3 class:list={["text-h5 font-medium", index === clauses.length - 1 && "text-white"]}>{title}</h3>
              </div>
            ))}
          </div>
        </div>
      </div>
    </section>

    <section class="container py-14 sm:py-24">
      <div class="mx-auto mb-12 max-w-180 text-center">
        <p class="text-muted-foreground mb-3 text-sm font-medium uppercase tracking-[0.12em]">Risk → treatment → SoA</p>
        <h2 class="text-h3 sm:text-h2 mb-4 font-medium">Controls trebuie să poată fi urmărite înapoi către risc.</h2>
        <p class="text-muted-foreground text-lg">Statement of Applicability devine legătura dintre decizia de risk treatment și controls pe care organizația a ales să le aplice sau să le excludă justificat.</p>
      </div>

      <div class="mx-auto max-w-6xl overflow-hidden rounded-[28px] border bg-level-0">
        <div class="grid md:grid-cols-4">
          <div class="p-7 sm:p-9">
            <p class="text-muted-foreground mb-8 font-mono text-sm">01</p>
            <h3 class="text-h4 mb-3 font-medium">Context & assets</h3>
            <p class="text-muted-foreground leading-relaxed">Sisteme, informații, procese și dependențe din scope.</p>
          </div>
          <div class="border-t p-7 sm:p-9 md:border-t-0 md:border-l">
            <p class="text-muted-foreground mb-8 font-mono text-sm">02</p>
            <h3 class="text-h4 mb-3 font-medium">Risk assessment</h3>
            <p class="text-muted-foreground leading-relaxed">Threats, vulnerabilities, impact și likelihood.</p>
          </div>
          <div class="border-t bg-[#e6ff03]/15 p-7 sm:p-9 md:border-t-0 md:border-l">
            <p class="text-muted-foreground mb-8 font-mono text-sm">03</p>
            <h3 class="text-h4 mb-3 font-medium">Treatment & SoA</h3>
            <p class="text-muted-foreground leading-relaxed">Decizii, controls selectate și justificarea aplicabilității.</p>
          </div>
          <div class="border-t bg-[#001a00] p-7 text-white sm:p-9 md:border-t-0 md:border-l">
            <p class="mb-8 font-mono text-sm text-[#e6ff03]">04</p>
            <h3 class="text-h4 mb-3 font-medium text-white">Operate & evidence</h3>
            <p class="leading-relaxed text-white/65">Reviews, approvals și rezultate care demonstrează funcționarea controls.</p>
          </div>
        </div>
      </div>
    </section>

    <section class="bg-active py-14 sm:py-24">
      <div class="container">
        <div class="mb-12 max-w-175">
          <p class="text-muted-foreground mb-3 text-sm font-medium uppercase tracking-[0.12em]">Annex A</p>
          <h2 class="text-h3 sm:text-h2 mb-4 font-medium">93 controls, patru teme. Selectarea pornește de la risc.</h2>
          <p class="text-muted-foreground text-lg leading-relaxed">Structura Annex A ajută la organizare, dar nu transformă cele 93 de controls într-o listă universală care trebuie bifată identic de fiecare organizație.</p>
        </div>

        <div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-4">
          {annexThemes.map(([count, title, text], index) => (
            <article class:list={[
              "rounded-[26px] p-7 sm:min-h-[330px] sm:p-8",
              index === 0 ? "bg-[#001a00] text-white" : "border bg-level-0",
            ]}>
              <p class:list={["mb-12 text-5xl font-medium tracking-[-0.05em] sm:mb-16 sm:text-6xl", index === 0 ? "text-[#e6ff03]" : "text-foreground"]}>{count}</p>
              <h3 class:list={["text-h4 mb-4 font-medium", index === 0 && "text-white"]}>{title}</h3>
              <p class:list={["leading-relaxed", index === 0 ? "text-white/65" : "text-muted-foreground"]}>{text}</p>
            </article>
          ))}
        </div>
      </div>
    </section>

    <section class="container py-14 sm:py-24">
      <div class="grid items-center gap-12 lg:grid-cols-[1.1fr_0.9fr] lg:gap-20">
        <div class="grid gap-4 overflow-hidden rounded-[28px] border bg-[#f8faf4] p-4 sm:p-7 lg:relative lg:min-h-[560px] lg:block lg:p-10">
          <div class="overflow-hidden rounded-2xl bg-white p-2 sm:p-3 lg:absolute lg:top-10 lg:right-10 lg:left-10">
            <img src="/trust-center/security-vulnerability.svg" alt="Vulnerability management și security controls" width="760" height="440" loading="lazy" decoding="async" class="mx-auto block aspect-[19/11] h-auto w-full object-contain" />
          </div>
          <div class="grid gap-2 sm:grid-cols-2 lg:absolute lg:right-10 lg:bottom-10 lg:left-10">
            {securityConnections.map((item) => <div class="rounded-xl border bg-level-0 px-4 py-3 text-sm font-medium">{item}</div>)}
          </div>
        </div>
        <div>
          <p class="text-muted-foreground mb-3 text-sm font-medium uppercase tracking-[0.12em]">Controls in operation</p>
          <h2 class="text-h3 sm:text-h2 mb-5 font-medium text-balance">Policies trebuie susținute de realitatea tehnică.</h2>
          <p class="text-muted-foreground mb-7 text-lg leading-relaxed">Identity, vulnerability management, logging, backup, supplier security și secure development trebuie să poată produce evidence din procese reale, nu doar să fie menționate într-un document.</p>
          <Button href="/cyber-security" variant="secondary">Vezi Cyber Security</Button>
        </div>
      </div>
    </section>

    <section class="bg-[#001a00] py-14 text-white sm:py-24">
      <div class="container">
        <div class="mb-12 max-w-170">
          <p class="mb-3 text-sm font-medium uppercase tracking-[0.12em] text-[#e6ff03]">Certification journey</p>
          <h2 class="text-h3 sm:text-h2 mb-4 font-medium text-white">Certificarea este un checkpoint într-un sistem care continuă.</h2>
          <p class="text-lg leading-relaxed text-white/65">ZebraByte pregătește și operează programul. Evaluarea și certificarea rămân independente.</p>
        </div>

        <div class="relative mx-auto max-w-6xl">
          <div aria-hidden="true" class="absolute top-8 bottom-8 left-[23px] w-px bg-white/15 sm:top-[31px] sm:right-8 sm:bottom-auto sm:left-8 sm:h-px sm:w-auto"></div>
          <div class="relative grid gap-7 sm:grid-cols-5 sm:gap-5">
            {certificationJourney.map(([number, title, text]) => (
              <article class="grid grid-cols-[48px_1fr] gap-4 sm:block">
                <div class="grid size-12 place-items-center rounded-full border border-white/20 bg-[#001a00] font-mono text-sm text-[#e6ff03] sm:mb-8">{number}</div>
                <div>
                  <h3 class="text-h5 mb-3 font-medium text-white">{title}</h3>
                  <p class="text-sm leading-relaxed text-white/60">{text}</p>
                </div>
              </article>
            ))}
          </div>
        </div>
      </div>
    </section>

    <section class="container py-14 sm:py-24">
      <div class="grid items-center gap-12 lg:grid-cols-[0.8fr_1.2fr] lg:gap-20">
        <div>
          <p class="text-muted-foreground mb-3 text-sm font-medium uppercase tracking-[0.12em]">After certification</p>
          <h2 class="text-h3 sm:text-h2 mb-5 font-medium text-balance">Publici exact ce poți demonstra în scope-ul certificat.</h2>
          <p class="text-muted-foreground mb-7 text-lg leading-relaxed">Certificatul și materialele aprobate pot fi partajate prin Trust Center, în timp ce risk register-ul, SoA-ul intern și evidence-ul sensibil rămân în workspace.</p>
          <Button href="/compliance-portal">Vezi Trust Center</Button>
        </div>
        <div class="overflow-hidden rounded-[28px] bg-[#E6FF03]/18 p-4 sm:p-7 lg:p-8">
          <img src="/trust-center/browser.svg" alt="Trust Center pentru documentele ISO 27001" width="1146" height="786" loading="lazy" decoding="async" class="mx-auto block aspect-[573/393] h-auto w-full object-contain" />
        </div>
      </div>
    </section>

    <Stories />

    <section class="container py-14 sm:py-24">
      <div class="mx-auto max-w-[768px]">
        <h2 class="text-h3 sm:text-h2 mb-7 text-center font-medium">Întrebări frecvente</h2>
        <div class="divide-y border-y">
          {faqs.map((faq) => (
            <details class="group py-1">
              <summary class="flex cursor-pointer list-none items-center justify-between gap-6 py-4 font-medium"><span>{faq.question}</span><span class="text-muted-foreground text-xl leading-none transition-transform group-open:rotate-45">+</span></summary>
              <p class="text-muted-foreground max-w-2xl pb-5 pr-8 leading-relaxed">{faq.answer}</p>
            </details>
          ))}
        </div>
      </div>
    </section>

    <section class="border-t py-16 text-center sm:py-24">
      <div class="container">
        <h2 class="text-h3 sm:text-h2 mx-auto mb-4 max-w-190 font-medium text-balance">Construiește un ISMS pe care echipa îl poate folosi.</h2>
        <p class="text-muted-foreground mx-auto mb-8 max-w-160 text-lg">Readiness, controls, evidence și continual improvement în același program.</p>
        <Button href="/contact" size="lg">Discută despre ISO 27001</Button>
      </div>
    </section>
  </main>
</Layout>