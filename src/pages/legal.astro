---
import Layout from "../layouts/Layout.astro";
import Button from "../components/ui/Button.svelte";

const documents = [
  {
    title: "Privacy Policy",
    description: "Politica de confidențialitate ZebraByte este menținută prin documentul canonic Iubenda și ruta locală redirecționează către sursa actualizată.",
    href: "/privacy",
    status: "Canonical policy",
  },
  {
    title: "Cookie Policy",
    description: "Informațiile despre cookie-uri și alte tehnologii de tracking sunt menținute în politica canonică ZebraByte.",
    href: "/cookie-policy",
    status: "Canonical policy",
  },
  {
    title: "Terms of Service",
    description: "Termenii contractuali sunt în curs de migrare controlată din setul juridic existent ZebraByte. Nu publicăm termenii Probo și nu rebotezăm documente vechi fără review.",
    href: "/terms",
    status: "Controlled migration",
  },
  {
    title: "Security & Compliance",
    description: "Postura ZebraByte, controalele relevante, documentele disponibile și informațiile de trust sunt centralizate în Trust Center.",
    href: "https://trust.zebrabyte.ro",
    status: "Trust Center",
  },
  {
    title: "Subprocessors",
    description: "Lista de subprocessors este menținută separat pentru a putea fi actualizată fără a rescrie întregul set de politici.",
    href: "https://trust.zebrabyte.ro/subprocessors",
    status: "Trust Center",
  },
  {
    title: "Personal Data Requests",
    description: "Canal separat pentru solicitări privind datele personale și exercitarea drepturilor relevante.",
    href: "https://zebrabyte-limited.privacy.saymine.io/zbt",
    status: "Privacy requests",
  },
];

const operational = [
  {
    title: "DPA",
    text: "Acordul de prelucrare a datelor existent este păstrat în setul juridic ZebraByte și trebuie migrat fără schimbarea sensului juridic înainte de publicarea noii versiuni.",
  },
  {
    title: "Hosting SLA",
    text: "SLA-ul pentru serviciile de hosting trebuie să rămână separat de serviciile Cyber Security și GRC, astfel încât garanțiile operaționale să nu fie confundate cu promisiuni de securitate absolută.",
  },
  {
    title: "Support Terms",
    text: "Termenii de suport și escaladare vor fi păstrați ca document operațional distinct și aliniați cu modelul actual de servicii ZebraByte.",
  },
  {
    title: "Security disclosure",
    text: "Raportarea responsabilă a vulnerabilităților folosește security.txt generat de site și canalul de contact ZebraByte.",
  },
];
---

<Layout
  title="Legal & Trust Center"
  description="Centralizator ZebraByte pentru Privacy Policy, Cookie Policy, Terms, Trust Center, subprocessors, privacy requests și documentele operaționale aflate în migrare controlată."
>
  <main>
    <animated-hero class="relative -mt-16 block overflow-hidden px-5 pb-16 pt-32 sm:pb-24 sm:pt-40">
      <div class="container text-center">
        <div class="border-border-low text-tertiary-foreground animate-perspective-in mx-auto mb-6 w-max rounded-lg border px-2 py-0.5 text-sm font-medium">Legal & Trust</div>
        <h1 class="text-h2 sm:text-h1 mx-auto mb-6 max-w-230 font-medium text-balance">Documentele juridice nu se rebranduiesc prin search & replace.</h1>
        <p class="text-muted-foreground mx-auto mb-8 max-w-190 text-lg text-balance">Păstrăm politicile canonice și migrăm documentele contractuale controlat. Aici găsești sursa potrivită pentru privacy, cookies, terms, trust și solicitări privind datele.</p>
        <div class="flex flex-col justify-center gap-3 sm:flex-row">
          <Button href="https://trust.zebrabyte.ro" size="lg">Deschide Trust Center</Button>
          <Button href="/contact" variant="secondary" size="lg">Întrebare juridică sau contractuală</Button>
        </div>
      </div>
    </animated-hero>

    <section class="container py-16 sm:py-24">
      <div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
        {documents.map((doc) => (
          <a
            href={doc.href}
            target={doc.href.startsWith("http") ? "_blank" : undefined}
            rel={doc.href.startsWith("http") ? "noopener noreferrer" : undefined}
            class="bg-level-0 hover:bg-subtle group rounded-2xl border p-6 transition-colors sm:p-8"
          >
            <span class="bg-active mb-10 inline-flex rounded-full px-3 py-1 text-xs font-medium">{doc.status}</span>
            <h2 class="mb-3 text-xl font-medium group-hover:underline group-hover:underline-offset-4">{doc.title}</h2>
            <p class="text-muted-foreground leading-relaxed">{doc.description}</p>
          </a>
        ))}
      </div>
    </section>

    <section class="bg-active py-16 sm:py-24">
      <div class="container">
        <div class="mb-12 max-w-180">
          <p class="text-muted-foreground mb-3 text-sm font-medium uppercase tracking-[0.12em]">Operational documents</p>
          <h2 class="text-h3 sm:text-h2 mb-4 font-medium">Setul vechi ZebraByte este păstrat ca sursă de migrare, nu înlocuit cu Probo.</h2>
          <p class="text-muted-foreground text-lg">DPA, hosting SLA, support terms și celelalte documente contractuale trebuie mutate cu sensul juridic intact și revizuite pentru noul portofoliu înainte de go-live.</p>
        </div>
        <div class="grid gap-px overflow-hidden rounded-2xl border bg-border sm:grid-cols-2">
          {operational.map((item) => (
            <article class="bg-level-0 p-6 sm:p-8">
              <h3 class="mb-3 text-xl font-medium">{item.title}</h3>
              <p class="text-muted-foreground leading-relaxed">{item.text}</p>
            </article>
          ))}
        </div>
      </div>
    </section>

    <section class="container py-16 sm:py-24">
      <div class="grid gap-4 sm:grid-cols-3">
        <a href="/.well-known/security.txt" class="hover:bg-subtle rounded-xl border p-6 transition-colors">
          <h3 class="mb-2 font-medium">security.txt</h3>
          <p class="text-muted-foreground text-sm">Canalul standardizat pentru security disclosure.</p>
        </a>
        <a href="/gdpr" class="hover:bg-subtle rounded-xl border p-6 transition-colors">
          <h3 class="mb-2 font-medium">GDPR & Privacy Services</h3>
          <p class="text-muted-foreground text-sm">Serviciile ZebraByte sunt separate de politica de confidențialitate a companiei.</p>
        </a>
        <a href="/compliance-portal" class="hover:bg-subtle rounded-xl border p-6 transition-colors">
          <h3 class="mb-2 font-medium">Compliance Portal</h3>
          <p class="text-muted-foreground text-sm">Distribuirea controlată a documentelor și evidence-ului de trust.</p>
        </a>
      </div>
    </section>
  </main>
</Layout>

<script>
  import { AnimatedHero } from "../lib/elements/hero";
  import { customElementDefine } from "../lib/dom";
  customElementDefine("animated-hero", () => AnimatedHero);
</script>
