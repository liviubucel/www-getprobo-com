---
import Layout from "../layouts/Layout.astro";

const turnstileSiteKey = "0x4AAAAAABBpDfopxKwUIKF_";
---

<Layout
  title="Feedback ZebraByte"
  description="Trimite feedback direct echipei ZebraByte prin formularul securizat first-party."
>
  <main class="container my-10 max-w-[760px] sm:my-20">
    <header class="mb-10 max-w-[620px]">
      <h1 class="text-h2 animate-slide-in mb-4 font-medium">Feedback</h1>
      <p class="text-muted-foreground text-lg leading-relaxed">
        Spune-ne ce a mers bine și ce putem îmbunătăți. Mesajul ajunge direct la ZebraByte; nu folosim un formular extern pentru această pagină.
      </p>
    </header>

    <form id="feedback-form" class="space-y-5 border-t pt-8">
      <input type="hidden" name="service" value="Altceva" />
      <input type="hidden" name="phone" value="" />

      <div class="grid gap-5 sm:grid-cols-2">
        <label class="space-y-2 text-sm font-medium">
          <span>Nume *</span>
          <input class="bg-level-0 w-full rounded-lg border px-3 py-2.5 outline-none focus:ring-2 focus:ring-black/10" name="name" required maxlength="100" autocomplete="name" />
        </label>
        <label class="space-y-2 text-sm font-medium">
          <span>Email *</span>
          <input class="bg-level-0 w-full rounded-lg border px-3 py-2.5 outline-none focus:ring-2 focus:ring-black/10" name="email" type="email" required maxlength="254" autocomplete="email" />
        </label>
      </div>

      <label class="block space-y-2 text-sm font-medium">
        <span>Companie</span>
        <input class="bg-level-0 w-full rounded-lg border px-3 py-2.5 outline-none focus:ring-2 focus:ring-black/10" name="company" maxlength="150" autocomplete="organization" />
      </label>

      <fieldset>
        <legend class="mb-2 text-sm font-medium">Cum a fost experiența?</legend>
        <div class="flex flex-wrap gap-2">
          {[1, 2, 3, 4, 5].map((rating) => (
            <label class="cursor-pointer">
              <input class="peer sr-only" type="radio" name="rating" value={rating} required aria-label={`${rating} din 5`} />
              <span class="peer-checked:bg-active peer-focus-visible:ring-primary grid size-10 place-items-center rounded-lg border text-sm peer-focus-visible:ring-2 peer-focus-visible:ring-offset-2">{rating}</span>
            </label>
          ))}
        </div>
      </fieldset>

      <label class="block space-y-2 text-sm font-medium">
        <span>Mesaj *</span>
        <textarea id="feedback-text" class="bg-level-0 min-h-40 w-full resize-y rounded-lg border px-3 py-2.5 outline-none focus:ring-2 focus:ring-black/10" required maxlength="4500"></textarea>
      </label>
      <input id="feedback-message" type="hidden" name="message" />

      <label class="flex items-start gap-3 text-sm">
        <input class="mt-1" type="checkbox" name="consent" value="yes" required />
        <span class="text-muted-foreground">
          Sunt de acord ca datele furnizate să fie procesate pentru gestionarea feedback-ului, conform <a class="underline" href="/privacy">politicii de confidențialitate</a>.
        </span>
      </label>

      <div data-turnstile-container data-sitekey={turnstileSiteKey} aria-label="Verificare de securitate"></div>
      <div id="feedback-status" class="hidden rounded-lg border px-4 py-3 text-sm" role="status" aria-live="polite"></div>
      <button id="feedback-submit" type="submit" class="bg-primary text-primary-foreground h-11 rounded-lg px-5 text-sm font-medium disabled:cursor-not-allowed disabled:opacity-50">
        Trimite feedback
      </button>
    </form>
  </main>
</Layout>

<script>
  import { browserT } from "../lib/browser-i18n";
  import { bindPublicForm } from "../lib/public-form";

  function setupFeedbackForm() {
    const form = document.querySelector<HTMLFormElement>("#feedback-form");
    const status = document.querySelector<HTMLElement>("#feedback-status");
    const submit = document.querySelector<HTMLButtonElement>("#feedback-submit");
    const text = document.querySelector<HTMLTextAreaElement>("#feedback-text");
    const message = document.querySelector<HTMLInputElement>("#feedback-message");
    const turnstile = form?.querySelector<HTMLElement>("[data-turnstile-container]");
    if (!form || !status || !submit || !text || !message || form.dataset.ready === "true") return;
    form.dataset.ready = "true";

    const cleanup = bindPublicForm({
      form,
      status,
      submit,
      turnstile,
      endpoint: "/api/contact",
      prepare: () => {
        const rating = form.querySelector<HTMLInputElement>('input[name="rating"]:checked')?.value;
        if (!rating) return false;
        message.value = `[FEEDBACK ${rating}/5]\n\n${text.value}`;
      },
      copy: {
        verifying: browserT("Se verifică...", "Verifying..."),
        sending: browserT("Se trimite...", "Sending..."),
        success: browserT("Mulțumim pentru feedback.", "Thank you for your feedback."),
        securityError: browserT(
          "Verificarea de securitate nu este încă disponibilă. Încearcă din nou.",
          "Security verification is not ready yet. Please try again.",
        ),
        requestError: browserT(
          "Feedback-ul nu a putut fi trimis.",
          "Your feedback could not be sent.",
        ),
        networkError: browserT(
          "A apărut o eroare de rețea. Încearcă din nou.",
          "A network error occurred. Please try again.",
        ),
      },
    });

    document.addEventListener("astro:before-swap", cleanup, { once: true });
  }

  document.addEventListener("astro:page-load", setupFeedbackForm);
  setupFeedbackForm();
</script>