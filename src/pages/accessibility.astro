<script>
  import { AnimatedHero } from "../lib/elements/hero";
  import { customElementDefine } from "../lib/dom";

  customElementDefine("animated-hero", () => AnimatedHero);

  function initCopySnippet() {
    document
      .querySelectorAll<HTMLButtonElement>("[data-copy-snippet]")
      .forEach((button) => {
        if (button.dataset.copyBound === "true") return;
        button.dataset.copyBound = "true";

        button.addEventListener("click", async () => {
          const code = button.parentElement?.querySelector("code")?.textContent?.trim();
          if (!code) return;

          await navigator.clipboard.writeText(code);
          const icon = button.querySelector<SVGElement>("[data-copy-icon]");
          const success = button.querySelector<SVGElement>("[data-copy-success]");

          icon?.classList.add("hidden");
          success?.classList.remove("hidden");
          window.setTimeout(() => {
            icon?.classList.remove("hidden");
            success?.classList.add("hidden");
          }, 1500);
        });
      });
  }

  function initInteractiveDemo() {
    const trigger = document.getElementById("hero-demo-trigger");
    const demoSection = document.getElementById("demo-section");

    trigger?.addEventListener("click", () => {
      demoSection?.scrollIntoView({ behavior: "smooth" });
    });

    const toggleContrast = document.getElementById("demo-toggle-contrast");
    const toggleText = document.getElementById("demo-toggle-text");
    const toggleDyslexic = document.getElementById("demo-toggle-dyslexic");
    const toggleGuide = document.getElementById("demo-toggle-guide");
    const toggleCursor = document.getElementById("demo-toggle-cursor");
    const toggleAnimations = document.getElementById("demo-toggle-animations");
    const resetBtn = document.getElementById("demo-reset");

    let readingGuideLine: HTMLDivElement | null = null;

    function handleMouseMove(event: MouseEvent) {
      if (readingGuideLine) {
        readingGuideLine.style.top = `${event.clientY - 16}px`;
      }
    }

    function removeReadingGuide() {
      readingGuideLine?.remove();
      readingGuideLine = null;
      document.removeEventListener("mousemove", handleMouseMove);
    }

    function toggleActiveState(button: HTMLElement | null, active: boolean) {
      if (!button) return;
      button.classList.toggle("bg-active", active);
      button.classList.toggle("border-foreground", active);
    }

    toggleContrast?.addEventListener("click", () => {
      const active = document.documentElement.classList.toggle("demo-high-contrast");
      toggleActiveState(toggleContrast, active);
    });

    toggleText?.addEventListener("click", () => {
      const active = document.documentElement.classList.toggle("demo-large-text");
      toggleActiveState(toggleText, active);
    });

    toggleDyslexic?.addEventListener("click", () => {
      const active = document.documentElement.classList.toggle("demo-dyslexic-font");
      toggleActiveState(toggleDyslexic, active);
    });

    toggleGuide?.addEventListener("click", () => {
      if (readingGuideLine) {
        removeReadingGuide();
        toggleActiveState(toggleGuide, false);
        return;
      }

      readingGuideLine = document.createElement("div");
      readingGuideLine.id = "demo-reading-guide";
      readingGuideLine.className =
        "fixed left-0 z-50 h-8 w-full border-y-2 border-yellow-400 bg-yellow-400/25 pointer-events-none";
      document.body.appendChild(readingGuideLine);
      document.addEventListener("mousemove", handleMouseMove);
      toggleActiveState(toggleGuide, true);
    });

    toggleCursor?.addEventListener("click", () => {
      const active = document.documentElement.classList.toggle("demo-large-cursor");
      toggleActiveState(toggleCursor, active);
    });

    toggleAnimations?.addEventListener("click", () => {
      const active = document.documentElement.classList.toggle("demo-no-animations");
      toggleActiveState(toggleAnimations, active);
    });

    resetBtn?.addEventListener("click", () => {
      document.documentElement.classList.remove(
        "demo-high-contrast",
        "demo-large-text",
        "demo-dyslexic-font",
        "demo-large-cursor",
        "demo-no-animations",
      );
      removeReadingGuide();
      [
        toggleContrast,
        toggleText,
        toggleDyslexic,
        toggleGuide,
        toggleCursor,
        toggleAnimations,
      ].forEach((button) => toggleActiveState(button, false));
    });
  }

  function initAll() {
    initCopySnippet();
    initInteractiveDemo();
  }

  initAll();
  document.addEventListener("astro:after-swap", initAll);
</script>

