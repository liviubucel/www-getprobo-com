---
import Layout from "../layouts/Layout.astro";
import Button from "../components/ui/Button.svelte";

const installCode = '<script src="https://accesibilitate.zebrabyte.ro/dist/zbt.js" defer></script>';

const complianceFeatures = [
  [
    "01",
    "Configurare și administrare",
    "Personalizarea, configurarea pe domenii și administrarea widgetului se fac din platforma ZebraByte Compliance.",
  ],
  [
    "02",
    "Audit și remediere",
    "Problemele de accesibilitate pot fi evaluate, prioritizate și urmărite împreună cu celelalte obligații de conformitate.",
  ],
  [
    "03",
    "Dovezi și urmărire",
    "Constatările, responsabilitățile și dovezile de remediere rămân în același program de conformitate al organizației.",
  ],
];
---

<Layout
  title="Accesibilitate în programul de conformitate"
  description="Accesibilitatea este inclusă în programul ZebraByte Compliance. Widgetul standard poate fi instalat gratuit; administrarea, personalizarea, auditul și remedierea sunt disponibile în platforma Compliance."
>
  <main>
    <animated-hero class="relative -mt-16 block overflow-hidden px-5 py-10 pt-26 sm:pt-36 sm:pb-12">
      <div class="text-muted-foreground animate-perspective-in animation-delay-300 mx-auto mb-6 w-max rounded-lg border px-4 py-2 text-sm font-medium sm:mb-8">
        Conformitate · Accesibilitate
      </div>

      <h1 class="text-h2 sm:text-h1 mb-6 overflow-hidden text-center font-medium text-balance sm:mb-8">
        <span class="animate-perspective-in block">Accesibilitatea,</span>
        <span class="animate-perspective-in block delay-50">în programul tău de conformitate.</span>
      </h1>

      <p class="text-muted-foreground animate-perspective-in animation-delay-150 mx-auto mb-6 max-w-200 text-center text-lg text-balance sm:mb-8">
        Widgetul ZebraByte în varianta standard poate fi instalat gratuit pe orice site. Personalizarea,
        administrarea, auditul, remedierea și urmărirea dovezilor sunt funcții ale programului ZebraByte Compliance
        și necesită acces la platformă.
      </p>

      <div class="mb-11 flex flex-col items-stretch justify-center gap-3 sm:mb-17 sm:flex-row sm:items-center">
        <Button class="animate-perspective-in animation-delay-200" variant="secondary" size="lg" href="#widget-gratuit">
          Instalează widgetul standard
        </Button>
        <Button class="animate-perspective-in animation-delay-300" size="lg" href="https://app.zebrabyte.ro">
          Deschide platforma Compliance
        </Button>
      </div>
    </animated-hero>

    <section id="widget-gratuit" class="container py-10 sm:py-20">
      <div class="mx-auto max-w-3xl">
        <div class="mb-10 text-center sm:mb-12">
          <p class="text-muted-foreground mb-3 text-sm font-medium uppercase tracking-[0.12em]">Instalare publică</p>
          <h2 class="text-h3 sm:text-h2 mb-4 font-medium">Widgetul standard este gratuit.</h2>
          <p class="text-muted-foreground mx-auto max-w-2xl text-lg">
            Pentru instalarea de bază nu este necesar un cont ZebraByte. Adaugă codul de mai jos înainte de
            <code>&lt;/body&gt;</code>. Această variantă folosește configurația standard și nu include panoul de administrare.
          </p>
        </div>

        <div class="rounded-2xl border p-5 sm:p-7">
          <pre class="overflow-x-auto rounded-xl bg-[#141e12] p-5 text-sm text-white"><code>{installCode}</code></pre>
          <div class="mt-4 flex flex-wrap items-center gap-3">
            <button
              id="copy-accessibility-code"
              type="button"
              class="bg-primary text-primary-foreground rounded-lg px-4 py-2.5 text-sm font-medium"
            >
              Copiază codul
            </button>
            <span id="copy-accessibility-status" class="text-muted-foreground text-sm" aria-live="polite"></span>
          </div>
        </div>

        <p class="text-muted-foreground mt-5 text-sm leading-relaxed">
          Widgetul este un instrument de suport pentru utilizatori. Instalarea lui, singură, nu demonstrează conformitatea
          unui site cu WCAG și nu înlocuiește remedierea problemelor din cod, conținut, design sau fluxurile aplicației.
        </p>
      </div>
    </section>

    <section class="bg-active py-10 sm:py-20">
      <div class="container">
        <div class="mx-auto mb-10 max-w-3xl text-center sm:mb-12">
          <p class="text-muted-foreground mb-3 text-sm font-medium uppercase tracking-[0.12em]">În ZebraByte Compliance</p>
          <h2 class="text-h3 sm:text-h2 mb-4 font-medium">Restul se administrează din programul de conformitate.</h2>
          <p class="text-muted-foreground text-lg">
            Accesibilitatea nu este un serviciu separat. Pentru organizațiile care folosesc ZebraByte Compliance,
            aceasta este administrată împreună cu controalele, riscurile, responsabilitățile și dovezile aplicabile.
          </p>
        </div>

        <div class="flex flex-col gap-6 sm:flex-row sm:gap-12">
          {complianceFeatures.map(([step, title, text]) => (
            <div class="flex-1">
              <div class="text-muted-foreground mb-5 text-sm font-medium">{step}</div>
              <h3 class="mb-3 text-xl font-medium">{title}</h3>
              <p class="text-muted-foreground leading-relaxed">{text}</p>
            </div>
          ))}
        </div>
      </div>
    </section>

    <section class="container py-10 text-center sm:py-20">
      <h2 class="text-h3 sm:text-h2 mx-auto mb-4 max-w-180 font-medium">
        Ai nevoie de personalizare, audit sau administrare?
      </h2>
      <p class="text-muted-foreground mx-auto mb-8 max-w-170 text-lg">
        Aceste funcții sunt disponibile prin programul ZebraByte Compliance, nu ca instrumente publice separate.
      </p>
      <div class="flex flex-col items-stretch justify-center gap-3 sm:flex-row sm:items-center">
        <Button href="https://app.zebrabyte.ro" size="lg">Deschide platforma Compliance</Button>
        <Button href="/contact" variant="secondary" size="lg">Discută cu un expert</Button>
      </div>
    </section>
  </main>
</Layout>

<script define:vars={{ installCode }}>
  import { AnimatedHero } from "../lib/elements/hero";
  import { customElementDefine } from "../lib/dom";
  customElementDefine("animated-hero", () => AnimatedHero);

  const copyButton = document.querySelector<HTMLButtonElement>("#copy-accessibility-code");
  const copyStatus = document.querySelector<HTMLElement>("#copy-accessibility-status");

  copyButton?.addEventListener("click", async () => {
    try {
      await navigator.clipboard.writeText(installCode);
      if (copyStatus) copyStatus.textContent = "Cod copiat.";
      window.setTimeout(() => {
        if (copyStatus) copyStatus.textContent = "";
      }, 1800);
    } catch {
      if (copyStatus) copyStatus.textContent = "Selectează și copiază codul manual.";
    }
  });
</script>
