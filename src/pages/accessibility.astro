  .demo-dyslexic-font p, .demo-dyslexic-font span, .demo-dyslexic-font li, .demo-dyslexic-font button, .demo-dyslexic-font a { font-family: Arial, sans-serif !important; letter-spacing: .08em !important; word-spacing: .15em !important; }
