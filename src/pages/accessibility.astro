---
import Layout from "../layouts/Layout.astro";
import Button from "../components/ui/Button.svelte";

const installCode =
  '<script src="https://accesibilitate.zebrabyte.ro/dist/zbt.js" defer></script>';

const faqs = [
  {
    question: "Ce este gratuit?",
    answer:
      "Varianta standard a widgetului poate fi instalată gratuit și nu necesită cont ZebraByte. Personalizarea, configurarea pe domenii, auditul, remedierea și administrarea fac parte din ZebraByte Compliance.",
  },
  {
    question: "Cât durează instalarea?",
    answer:
      "Pentru varianta standard adaugi o singură linie de cod înainte de </body>. Scriptul este încărcat cu defer și nu blochează parsarea inițială a paginii.",
  },
  {
    question: "Funcționează pe WordPress și pe site-uri personalizate?",
    answer:
      "Da. Widgetul poate fi folosit pe WordPress, Shopify, Wix, alte CMS-uri și site-uri custom, dacă platforma permite inserarea unui script.",
  },
  {
    question: "Pot personaliza widgetul?",
    answer:
      "Da, dar personalizarea nu este parte din nivelul public gratuit. Configurarea și administrarea se fac din ZebraByte Compliance.",
  },
  {
    question: "Widgetul colectează date despre vizitatori?",
    answer:
      "Varianta standard păstrează preferințele utilizatorului local în browser și nu folosește tracking pentru funcționarea widgetului.",
  },
  {
    question: "Widgetul face singur site-ul conform WCAG?",
    answer:
      "Nu. Widgetul oferă controale de preferință utile utilizatorilor, dar conformitatea reală presupune evaluarea și remedierea codului, conținutului, designului, formularelor și fluxurilor. Aceste activități se gestionează în programul ZebraByte Compliance.",
  },
];

const benefits = [
  {
    title: "Deficiențe de vedere",
    description:
      "Mărirea textului, contrastul ridicat, inversarea culorilor și cursorul mărit pot face navigarea mai confortabilă pentru utilizatorii cu vedere scăzută.",
  },
  {
    title: "Citire asistată",
    description:
      "Text-to-speech și ghidul de citire oferă suport suplimentar utilizatorilor care preferă asistență direct pe pagină.",
  },
  {
    title: "Daltonism",
    description:
      "Controalele de saturație, contrast și afișare monocromă pot face elementele vizuale mai ușor de diferențiat.",
  },
  {
    title: "Cognitiv & ADHD",
    description:
      "Ghidul de citire, oprirea animațiilor și ajustarea spațierii pot reduce distragerile și pot îmbunătăți fluxul de lectură.",
  },
  {
    title: "Epilepsie & fotosensibilitate",
    description:
      "Oprirea animațiilor și reducerea mișcării oferă utilizatorului control asupra efectelor vizuale de pe pagină.",
  },
  {
    title: "Dislexie",
    description:
      "Fontul pentru dislexie și ajustările de spațiere pot îmbunătăți lizibilitatea și separarea caracterelor.",
  },
  {
    title: "Navigare cu tastatura",
    description:
      "Evidențierea linkurilor și a titlurilor sprijină orientarea pe pagină pentru utilizatorii care navighează fără mouse.",
  },
];
---

<Layout
  title="Accesibilitate web · ZebraByte Compliance"
  description="Widgetul standard ZebraByte poate fi instalat gratuit. Personalizarea, auditul, administrarea și remedierea accesibilității sunt gestionate în ZebraByte Compliance."
>
  <animated-hero
    class="relative -mt-16 block overflow-hidden px-5 py-10 pt-26 sm:pt-36 sm:pb-14"
  >
    <div
      class="text-muted-foreground animate-perspective-in animation-delay-300 mx-auto mb-6 w-max rounded-lg border px-4 py-2 text-sm font-medium sm:mb-8"
    >
      Conformitate · Accesibilitate
    </div>

    <h1
      class="text-h2 sm:text-h1 mb-6 overflow-hidden text-center font-medium text-balance sm:mb-8"
    >
      <span class="animate-perspective-in block">Site-ul tău, acum cu un</span>
      <span class="animate-perspective-in block delay-50">
        meniu modern de accesibilitate.
      </span>
    </h1>

    <p
      class="text-muted-foreground animate-perspective-in animation-delay-150 mx-auto mb-6 max-w-200 text-center text-lg text-balance sm:mb-8"
    >
      Widgetul standard se instalează gratuit cu o singură linie de cod.
      Personalizarea, auditul, administrarea și remedierea fac parte din
      ZebraByte Compliance.
    </p>

    <div
      class="mb-8 flex flex-col items-stretch justify-center gap-3 sm:flex-row sm:items-center"
    >
      <Button
        class="animate-perspective-in animation-delay-200"
        variant="secondary"
        size="lg"
        href="#obtine-widget"
      >
        Obține widgetul
      </Button>
      <Button
        class="animate-perspective-in animation-delay-300"
        size="lg"
        href="https://app.zebrabyte.ro"
      >
        Gestionează în Compliance
      </Button>
      <button
        type="button"
        id="hero-demo-trigger"
        class="text-muted-foreground animate-perspective-in animation-delay-300 inline-flex h-11 items-center justify-center px-3 text-sm font-medium transition-colors hover:text-foreground"
      >
        Vezi demo live →
      </button>
    </div>

    <div
      id="obtine-widget"
      class="animate-perspective-in animation-delay-300 mx-auto mb-11 max-w-220 rounded-2xl border bg-background p-3 shadow-sm sm:mb-14 sm:p-4"
    >
      <div
        class="flex items-center gap-3 rounded-xl border bg-active px-4 py-3 text-left"
      >
        <code
          class="min-w-0 flex-1 overflow-x-auto whitespace-nowrap font-mono text-xs text-foreground sm:text-sm"
        >
          &lt;script src="https://accesibilitate.zebrabyte.ro/dist/zbt.js"
          defer&gt;&lt;/script&gt;
        </code>
        <button
          type="button"
          data-copy-snippet
          aria-label="Copiază codul"
          title="Copiază codul"
          class="inline-flex size-9 shrink-0 items-center justify-center rounded-lg border bg-background text-muted-foreground transition-colors hover:text-foreground"
        >
          <svg
            data-copy-icon
            xmlns="http://www.w3.org/2000/svg"
            width="15"
            height="15"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
          >
            <rect width="14" height="14" x="8" y="8" rx="2"></rect>
            <path
              d="M4 16c-1.1 0-2-.9-2-2V4c0-1.1.9-2 2-2h10c1.1 0 2 .9 2 2"
            ></path>
          </svg>
          <svg
            data-copy-success
            xmlns="http://www.w3.org/2000/svg"
            width="15"
            height="15"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            class="hidden"
          >
            <path d="M20 6 9 17l-5-5"></path>
          </svg>
        </button>
      </div>
      <p class="mt-3 text-left text-xs leading-relaxed text-muted-foreground">
        Acesta este nivelul public gratuit: instalarea configurației standard.
        Personalizarea și managementul sunt disponibile în platforma Compliance.
      </p>
    </div>

    <div
      class="animate-perspective-in animation-delay-300 mx-auto max-w-[960px] overflow-hidden rounded-3xl border bg-background p-2 shadow-sm sm:p-3"
    >
      <div class="overflow-hidden rounded-2xl border bg-active">
        <img
          src="https://www.zebrabyte.ro/images/accessibleweb.jpg"
          alt="Previzualizare a meniului ZebraByte de accesibilitate"
          width="1000"
          height="667"
          loading="eager"
          class="block h-auto w-full"
        />
      </div>
    </div>
  </animated-hero>

  <section class="container py-10 sm:py-16">
    <div
      class="mx-auto grid max-w-[960px] overflow-hidden rounded-2xl border bg-background sm:grid-cols-2 lg:grid-cols-4"
    >
      <div class="p-6 text-center lg:border-r">
        <div class="text-3xl font-medium">1 linie</div>
        <div class="mt-1 text-sm text-muted-foreground">de cod pentru instalare</div>
      </div>
      <div
        class="border-t p-6 text-center sm:border-l sm:border-t-0 lg:border-l-0 lg:border-r"
      >
        <div class="text-3xl font-medium">0 tracking</div>
        <div class="mt-1 text-sm text-muted-foreground">pentru widgetul standard</div>
      </div>
      <div class="border-t p-6 text-center lg:border-r lg:border-t-0">
        <div class="text-3xl font-medium">10+</div>
        <div class="mt-1 text-sm text-muted-foreground">controale pentru utilizatori</div>
      </div>
      <div
        class="border-t p-6 text-center sm:border-l lg:border-l-0 lg:border-t-0"
      >
        <div class="text-3xl font-medium">Compliance</div>
        <div class="mt-1 text-sm text-muted-foreground">management și remediere</div>
      </div>
    </div>
  </section>

  <section class="container py-10 sm:py-20">
    <h2 class="text-h3 sm:text-h2 mb-3 text-center font-medium">
      Ce face widgetul de accesibilitate
    </h2>
    <p
      class="text-muted-foreground mx-auto mb-10 max-w-180 text-center text-lg sm:mb-12"
    >
      Controale gata configurate care oferă utilizatorilor mai mult control
      asupra felului în care citesc și navighează pe site.
    </p>

    <div
      class="mx-auto grid max-w-[960px] gap-4 sm:grid-cols-2 lg:grid-cols-3"
    >
      <article class="rounded-2xl border p-6">
        <div class="mb-5 flex size-10 items-center justify-center rounded-xl border">
          <svg xmlns="http://www.w3.org/2000/svg" width="19" height="19" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"></circle><path d="M12 2a10 10 0 0 0 0 20Z"></path></svg>
        </div>
        <h3 class="text-lg font-medium">Deficiențe de vedere</h3>
        <p class="mt-2 text-sm leading-relaxed text-muted-foreground">
          Mărire text, contrast ridicat, inversare culori și controale vizuale
          disponibile direct pe pagină.
        </p>
      </article>

      <article class="rounded-2xl border p-6">
        <div class="mb-5 flex size-10 items-center justify-center rounded-xl border">
          <svg xmlns="http://www.w3.org/2000/svg" width="19" height="19" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M11 5 6 9H2v6h4l5 4z"></path><path d="M15.5 8.5a5 5 0 0 1 0 7"></path></svg>
        </div>
        <h3 class="text-lg font-medium">Text-to-Speech</h3>
        <p class="mt-2 text-sm leading-relaxed text-muted-foreground">
          Utilizatorii pot asculta conținutul paginii direct din widget și își
          pot controla experiența fără instrumente suplimentare.
        </p>
      </article>

      <article class="rounded-2xl border p-6">
        <div class="mb-5 flex size-10 items-center justify-center rounded-xl border">
          <svg xmlns="http://www.w3.org/2000/svg" width="19" height="19" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 22a10 10 0 1 0 0-20v20Z"></path><path d="M12 2a10 10 0 0 1 0 20"></path></svg>
        </div>
        <h3 class="text-lg font-medium">Daltonism</h3>
        <p class="mt-2 text-sm leading-relaxed text-muted-foreground">
          Controale de saturație, contrast și afișare monocromă pentru o
          diferențiere mai ușoară a conținutului.
        </p>
      </article>

      <article class="rounded-2xl border p-6">
        <div class="mb-5 flex size-10 items-center justify-center rounded-xl border">
          <svg xmlns="http://www.w3.org/2000/svg" width="19" height="19" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="5" width="18" height="14" rx="2"></rect><path d="M7 9h.01M11 9h.01M15 9h.01M7 13h10"></path></svg>
        </div>
        <h3 class="text-lg font-medium">Navigare din tastatură</h3>
        <p class="mt-2 text-sm leading-relaxed text-muted-foreground">
          Evidențierea linkurilor și titlurilor sprijină orientarea pe pagină
          pentru utilizatorii care navighează fără mouse.
        </p>
      </article>

      <article class="rounded-2xl border p-6">
        <div class="mb-5 flex size-10 items-center justify-center rounded-xl border">
          <svg xmlns="http://www.w3.org/2000/svg" width="19" height="19" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M22 12h-4l-3 9L9 3l-3 9H2"></path></svg>
        </div>
        <h3 class="text-lg font-medium">Cognitiv & ADHD</h3>
        <p class="mt-2 text-sm leading-relaxed text-muted-foreground">
          Ghid de citire, oprirea animațiilor și ajustarea spațierii pentru
          reducerea distragerilor.
        </p>
      </article>

      <article class="rounded-2xl border p-6">
        <div class="mb-5 flex size-10 items-center justify-center rounded-xl border">
          <svg xmlns="http://www.w3.org/2000/svg" width="19" height="19" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"></path></svg>
        </div>
        <h3 class="text-lg font-medium">În programul Compliance</h3>
        <p class="mt-2 text-sm leading-relaxed text-muted-foreground">
          Widgetul este partea vizibilă. Evaluarea, remedierea, responsabilitățile
          și dovezile se gestionează în programul de conformitate.
        </p>
      </article>
    </div>
  </section>

  <section id="demo-section" class="container py-10 sm:py-20">
    <div
      class="mx-auto grid max-w-[960px] gap-10 rounded-3xl border bg-background p-6 sm:p-8 lg:grid-cols-2 lg:p-10"
    >
      <div>
        <h2 class="text-h3 sm:text-h2 font-medium">
          Cine beneficiază de acest widget?
        </h2>
        <p class="mb-8 mt-4 text-lg leading-relaxed text-muted-foreground">
          Vizitatorii au nevoi diferite. Widgetul pune la dispoziție controale
          care fac navigarea mai confortabilă fără să schimbe designul site-ului.
        </p>

        <div class="space-y-3">
          {
            benefits.map((benefit) => (
              <details class="group overflow-hidden rounded-xl border bg-background">
                <summary class="flex cursor-pointer list-none items-center justify-between p-4 font-medium transition-colors hover:bg-active">
                  <span>{benefit.title}</span>
                  <span class="text-xl text-muted-foreground transition-transform group-open:rotate-45">
                    +
                  </span>
                </summary>
                <div class="border-t p-4 text-sm leading-relaxed text-muted-foreground">
                  {benefit.description}
                </div>
              </details>
            ))
          }
        </div>
      </div>

      <div>
        <h2 class="text-h3 sm:text-h2 font-medium">Testează widgetul live</h2>
        <p class="mb-8 mt-4 text-lg leading-relaxed text-muted-foreground">
          Apasă pe butoane pentru a vedea cum se schimbă experiența paginii.
        </p>

        <div class="rounded-2xl border bg-active p-3 sm:p-4">
          <div class="overflow-hidden rounded-xl border bg-background">
            <div
              class="flex items-center justify-between border-b px-5 py-4"
            >
              <span class="text-sm font-medium">Preferințe Accesibilitate</span>
              <button
                type="button"
                id="demo-reset"
                class="rounded-lg border px-3 py-1.5 text-xs text-muted-foreground transition-colors hover:text-foreground"
              >
                Resetează
              </button>
            </div>

            <div class="grid grid-cols-2 gap-3 p-4 sm:p-5">
              <button type="button" id="demo-toggle-contrast" class="demo-btn rounded-xl border p-4 text-sm font-medium transition-colors hover:bg-active">Contrast ridicat</button>
              <button type="button" id="demo-toggle-text" class="demo-btn rounded-xl border p-4 text-sm font-medium transition-colors hover:bg-active">Mărire text</button>
              <button type="button" id="demo-toggle-dyslexic" class="demo-btn rounded-xl border p-4 text-sm font-medium transition-colors hover:bg-active">Font dislexie</button>
              <button type="button" id="demo-toggle-guide" class="demo-btn rounded-xl border p-4 text-sm font-medium transition-colors hover:bg-active">Ghid citire</button>
              <button type="button" id="demo-toggle-cursor" class="demo-btn rounded-xl border p-4 text-sm font-medium transition-colors hover:bg-active">Cursor mărit</button>
              <button type="button" id="demo-toggle-animations" class="demo-btn rounded-xl border p-4 text-sm font-medium transition-colors hover:bg-active">Fără animații</button>
            </div>
          </div>
        </div>

        <div class="mt-5 grid gap-3 sm:grid-cols-2">
          <a
            href="https://app.zebrabyte.ro"
            class="rounded-xl border p-4 text-sm transition-colors hover:bg-active"
          >
            <span class="font-medium">Personalizare și administrare</span>
            <span class="mt-1 block text-xs text-muted-foreground">
              Deschide ZebraByte Compliance →
            </span>
          </a>
          <a
            href="https://app.zebrabyte.ro"
            class="rounded-xl border p-4 text-sm transition-colors hover:bg-active"
          >
            <span class="font-medium">Audit și remediere</span>
            <span class="mt-1 block text-xs text-muted-foreground">
              Disponibile în programul Compliance →
            </span>
          </a>
        </div>
      </div>
    </div>
  </section>

  <section class="container py-10 sm:py-20">
    <div
      class="mx-auto grid max-w-[960px] overflow-hidden rounded-3xl border bg-background md:grid-cols-[1.05fr_0.95fr]"
    >
      <div class="border-b p-6 sm:p-8 md:border-b-0 md:border-r">
        <div class="rounded-2xl border bg-active p-4">
          <div class="mb-4 flex items-center justify-between border-b pb-3">
            <span class="font-mono text-xs text-muted-foreground">index.html</span>
            <span class="text-xs text-muted-foreground">instalare standard</span>
          </div>
          <div class="space-y-2 font-mono text-[11px] leading-5 text-muted-foreground sm:text-xs">
            <div>&lt;!DOCTYPE html&gt;</div>
            <div>&lt;html lang="ro"&gt;</div>
            <div>&nbsp;&nbsp;&lt;head&gt;...&lt;/head&gt;</div>
            <div>&nbsp;&nbsp;&lt;body&gt;</div>
            <div>&nbsp;&nbsp;&nbsp;&nbsp;&lt;!-- conținutul site-ului --&gt;</div>
            <div class="overflow-x-auto rounded-lg border bg-background px-3 py-2 text-foreground">
              &nbsp;&nbsp;&nbsp;&nbsp;&lt;script src="https://accesibilitate.zebrabyte.ro/dist/zbt.js" defer&gt;&lt;/script&gt;
            </div>
            <div>&nbsp;&nbsp;&lt;/body&gt;</div>
            <div>&lt;/html&gt;</div>
          </div>
        </div>
      </div>

      <div class="flex flex-col justify-center p-6 sm:p-8">
        <p class="mb-3 text-sm font-medium text-muted-foreground">
          Instalare standard
        </p>
        <h2 class="text-h3 font-medium">
          Instalare rapidă. Funcționează pe orice site.
        </h2>
        <p class="mt-4 leading-relaxed text-muted-foreground">
          Fără cont pentru varianta standard. Lipești scriptul înainte de
          <code class="rounded border px-1.5 py-0.5 font-mono text-xs text-foreground">
            &lt;/body&gt;
          </code>
          și widgetul devine disponibil.
        </p>
        <p class="mt-4 leading-relaxed text-muted-foreground">
          Funcționează pe WordPress, Shopify, Wix, site-uri custom și pe alte
          platforme care permit inserarea unui script.
        </p>
        <div class="mt-7 flex flex-col gap-3 sm:flex-row">
          <Button size="lg" href="#obtine-widget">Obține widgetul</Button>
          <Button size="lg" variant="secondary" href="https://app.zebrabyte.ro">
            Administrează în Compliance
          </Button>
        </div>
      </div>
    </div>
  </section>

  <section class="container py-10 sm:py-20">
    <h2 class="text-h3 sm:text-h2 mb-3 text-center font-medium">
      Patru pași pentru varianta standard
    </h2>
    <p
      class="text-muted-foreground mx-auto mb-10 max-w-180 text-center text-lg sm:mb-12"
    >
      Instalarea publică rămâne simplă; managementul începe în ZebraByte Compliance.
    </p>

    <div class="mx-auto grid max-w-[960px] gap-4 sm:grid-cols-2 lg:grid-cols-4">
      <article class="rounded-2xl border p-6">
        <div class="mb-5 flex size-8 items-center justify-center rounded-full bg-primary text-xs font-medium text-primary-foreground">1</div>
        <h3 class="font-medium">Lipești scriptul</h3>
        <p class="mt-2 text-sm leading-relaxed text-muted-foreground">
          Copiezi o linie de HTML și o adaugi înainte de &lt;/body&gt;.
        </p>
      </article>
      <article class="rounded-2xl border p-6">
        <div class="mb-5 flex size-8 items-center justify-center rounded-full bg-primary text-xs font-medium text-primary-foreground">2</div>
        <h3 class="font-medium">Widgetul apare</h3>
        <p class="mt-2 text-sm leading-relaxed text-muted-foreground">
          Butonul flotant este disponibil pe pagină cu setările standard.
        </p>
      </article>
      <article class="rounded-2xl border p-6">
        <div class="mb-5 flex size-8 items-center justify-center rounded-full bg-primary text-xs font-medium text-primary-foreground">3</div>
        <h3 class="font-medium">Vizitatorii ajustează</h3>
        <p class="mt-2 text-sm leading-relaxed text-muted-foreground">
          Fiecare utilizator selectează preferințele potrivite pentru el.
        </p>
      </article>
      <article class="rounded-2xl border p-6">
        <div class="mb-5 flex size-8 items-center justify-center rounded-full bg-primary text-xs font-medium text-primary-foreground">4</div>
        <h3 class="font-medium">Preferințele se păstrează</h3>
        <p class="mt-2 text-sm leading-relaxed text-muted-foreground">
          Setările rămân local în browser între vizite.
        </p>
      </article>
    </div>
  </section>

  <section class="container py-10 sm:py-20">
    <div class="mx-auto grid max-w-[960px] gap-4 md:grid-cols-2">
      <article class="rounded-3xl border p-7 sm:p-8">
        <p class="mb-3 text-sm font-medium text-muted-foreground">
          Confidențialitate
        </p>
        <h2 class="text-h3 font-medium">
          Zero tracking. Preferințele rămân în browser.
        </h2>
        <p class="mt-4 leading-relaxed text-muted-foreground">
          Varianta standard păstrează preferințele utilizatorului local în
          browser și nu folosește tracking pentru funcționarea widgetului.
        </p>
      </article>

      <article class="rounded-3xl border bg-active p-7 sm:p-8">
        <p class="mb-3 text-sm font-medium text-muted-foreground">
          ZebraByte Compliance
        </p>
        <h2 class="text-h3 font-medium">
          Widgetul este doar partea vizibilă.
        </h2>
        <p class="mt-4 leading-relaxed text-muted-foreground">
          Personalizarea, configurarea, evaluarea problemelor, remedierea și
          dovezile sunt gestionate în programul de conformitate.
        </p>
        <a
