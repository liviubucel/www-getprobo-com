---
import Layout from "../layouts/Layout.astro";
import Button from "../components/ui/Button.svelte";

const tools = [
  { title: "Instalare widget", href: "/accesibilitate/obtine-widget", text: "Snippet public, self-host și pași de verificare." },
  { title: "Personalizează", href: "/accesibilitate/personalizeaza", text: "Poziție, offset, dimensiune, culoare, icon și TTS." },
  { title: "Audit / dev mode", href: "/accesibilitate/audit", text: "Activează ?acc-dev=true și investighează problemele." },
  { title: "FAQ", href: "/accesibilitate/faq", text: "WCAG, overlay, privacy, instalare și limitări." },
  { title: "Disclaimer", href: "/accesibilitate/disclaimer", text: "Rolul și limitele tehnice ale widgetului." },
];

const process = [
  ["01", "Audit", "Identifică barierele reale din pagini și fluxuri, nu doar un scor automat."],
  ["02", "Remediation", "Transformă constatările în acțiuni clare pentru design, development și content."],
  ["03", "Evidence", "Păstrează constatările, responsabilitățile și remedierea în programul de compliance."],
];
---

<Layout
  title="Accessibility Compliance"
  description="Instrumente gratuite ZebraByte pentru accessibility și WCAG, integrate în zona de managed compliance."
>
  <main>
    <animated-hero class="relative -mt-16 block overflow-hidden px-5 py-10 pt-26 sm:pt-36 sm:pb-12">
      <div class="text-muted-foreground animate-perspective-in animation-delay-300 mx-auto mb-6 w-max rounded-lg border px-4 py-2 text-sm font-medium sm:mb-8">
        Compliance · Free tools
      </div>
      <h1 class="text-h2 sm:text-h1 mb-6 overflow-hidden text-center font-medium text-balance sm:mb-8">
        <span class="animate-perspective-in block">Accessibility,</span>
        <span class="animate-perspective-in block delay-50"> în același program de compliance.</span>
      </h1>
      <p class="text-muted-foreground animate-perspective-in animation-delay-150 mx-auto mb-6 max-w-200 text-center text-lg text-balance sm:mb-8">
        Instrumentele ZebraByte pentru accessibility sunt gratuite. Ele ajută la audit, configurare și preferințe de accesibilitate,
        iar constatările WCAG pot fi urmărite împreună cu celelalte controale și remediation din Managed Compliance.
      </p>
      <div class="mb-11 flex flex-col items-stretch justify-center gap-3 sm:mb-17 sm:flex-row sm:items-center">
        <Button class="animate-perspective-in animation-delay-200" variant="secondary" size="lg" href="/accesibilitate/obtine-widget">Instalează gratuit</Button>
        <Button class="animate-perspective-in animation-delay-300" size="lg" href="/managed-compliance">Managed Compliance</Button>
      </div>
    </animated-hero>

    <section class="container py-10 sm:py-20">
      <h2 class="text-h3 sm:text-h2 mb-3 text-center font-medium">Instrumente gratuite pentru accessibility</h2>
      <p class="text-muted-foreground mx-auto mb-10 max-w-180 text-center text-lg sm:mb-12">
        Widgetul este un ajutor pentru utilizator, nu o promisiune că simpla instalare face un website compliant. Accessibility reală rămâne o combinație de cod, design, content, testare și remediation.
      </p>
      <div class="grid gap-3 sm:grid-cols-2 lg:grid-cols-3">
        {tools.map((tool) => (
          <a href={tool.href} class="group rounded-xl border p-6 transition-colors hover:bg-subtle">
            <h3 class="mb-2 font-medium group-hover:underline group-hover:underline-offset-4">{tool.title}</h3>
            <p class="text-muted-foreground text-sm leading-relaxed">{tool.text}</p>
          </a>
        ))}
      </div>
    </section>

    <section class="bg-active py-10 sm:py-20">
      <div class="container">
        <h2 class="text-h3 sm:text-h2 mb-3 text-center font-medium">Din audit în evidence și remediation</h2>
        <p class="text-muted-foreground mx-auto mb-10 max-w-180 text-center text-lg sm:mb-12">
          Când accessibility face parte din programul de compliance, problemele nu rămân într-un raport separat: au owner, prioritate, acțiune și dovadă de remediere.
        </p>
        <div class="flex flex-col gap-6 sm:flex-row sm:gap-16">
          {process.map(([step, title, text]) => (
            <div class="flex-1">
              <div class="text-muted-foreground mb-5 text-sm font-medium">{step}</div>
              <h3 class="mb-3 text-xl font-medium">{title}</h3>
              <p class="text-muted-foreground leading-relaxed">{text}</p>
            </div>
          ))}
        </div>
      </div>
    </section>

    <section class="container py-10 text-center sm:py-20">
      <h2 class="text-h3 sm:text-h2 mx-auto mb-4 max-w-180 font-medium">Accessibility nu este un produs separat ZebraByte.</h2>
      <p class="text-muted-foreground mx-auto mb-8 max-w-170 text-lg">
        Instrumentele rămân gratuite, iar pentru organizațiile care folosesc Managed Compliance, accessibility poate fi urmărită în aceeași guvernanță cu privacy, security și celelalte obligații aplicabile.
      </p>
      <Button href="/managed-compliance" size="lg">Vezi Managed Compliance</Button>
    </section>
  </main>
</Layout>

<script>
  import { AnimatedHero } from "../lib/elements/hero";
  import { customElementDefine } from "../lib/dom";
  customElementDefine("animated-hero", () => AnimatedHero);
</script>
