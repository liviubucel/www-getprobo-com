---
import Layout from "../layouts/Layout.astro";
import Button from "../components/ui/Button.svelte";
import { zebraByteIndustries } from "../content/zebrabyte-industries";

const capabilities = [
  { title: "Assess", text: "Înțelegem suprafața expusă, activele critice, furnizorii și obligațiile aplicabile." },
  { title: "Protect", text: "Implementăm hardening, WAF, email authentication, access controls și măsuri tehnice potrivite contextului." },
  { title: "Govern", text: "Legăm riscurile și măsurile tehnice de GDPR, NIS2, ISO 27001 readiness și procesele interne." },
  { title: "Evidence", text: "Urmărim controalele, schimbările și dovezile în programul continuu ZebraByte." },
  { title: "Respond", text: "Pregătim incident response și recovery înainte să fie nevoie de ele și intervenim când apare un incident real." },
  { title: "Improve", text: "Revizuim periodic postura și ajustăm programul când se schimbă infrastructura, riscul sau cerințele." },
];
---

<Layout
  title="Industrii"
  description="Cyber security, managed compliance, privacy, NIS2, ISO 27001 readiness și secure infrastructure adaptate pentru legal, medical, sector public, e-commerce, logistică, educație și alte industrii."
>
  <main>
    <animated-hero class="relative -mt-16 block overflow-hidden px-5 pt-32 pb-16 sm:pt-40 sm:pb-24">
      <div class="container text-center">
        <div class="border-border-low text-tertiary-foreground animate-perspective-in mx-auto mb-6 w-max rounded-lg border px-2 py-0.5 text-sm font-medium">Industrii</div>
        <h1 class="text-h2 sm:text-h1 mx-auto mb-6 max-w-230 font-medium text-balance">Aceleași controale. Riscuri diferite în fiecare industrie.</h1>
        <p class="text-muted-foreground mx-auto mb-8 max-w-190 text-lg text-balance">
          Nu vindem un pachet identic tuturor și nici servicii IT generice. Adaptăm managed compliance, cybersecurity și infrastructura security-first la datele, serviciile și obligațiile sectorului tău.
        </p>
        <div class="flex flex-col justify-center gap-3 sm:flex-row">
          <Button href="/contact" size="lg">Discută despre industria ta</Button>
          <Button href="/security-assessment" variant="secondary" size="lg">Începe cu un assessment</Button>
        </div>
      </div>
    </animated-hero>

    <section class="container py-16 sm:py-24">
      <div class="mx-auto mb-12 max-w-180 text-center">
        <p class="text-muted-foreground mb-3 text-sm font-medium uppercase tracking-[0.12em]">Sectoare</p>
        <h2 class="text-h3 sm:text-h2 mb-4 font-medium">Domenii pentru care programul trebuie adaptat.</h2>
        <p class="text-muted-foreground text-lg">Fiecare card deschide pagina dedicată, construită pe riscurile și scenariile reale ale sectorului.</p>
      </div>

      <div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
        {zebraByteIndustries.map((industry) => (
          <a
            href={`/industrii/${industry.slug}`}
            class="bg-level-0 group rounded-2xl border p-6 transition-colors hover:bg-subtle sm:p-8"
          >
            <div class="mb-7 flex items-start justify-between gap-4">
              <h3 class="text-xl font-medium group-hover:underline group-hover:underline-offset-4">{industry.shortTitle}</h3>
              <span class="text-muted-foreground" aria-hidden="true">↗</span>
            </div>
            <p class="text-muted-foreground mb-7 leading-relaxed">{industry.description}</p>
            <div class="flex flex-wrap gap-2">
              {industry.priorities.slice(0, 4).map((priority) => (
                <span class="bg-active rounded-full px-3 py-1 text-xs">{priority}</span>
              ))}
            </div>
          </a>
        ))}
      </div>
    </section>

    <section class="bg-active py-16 sm:py-24">
      <div class="container">
        <div class="mb-12 max-w-180">
          <p class="text-muted-foreground mb-3 text-sm font-medium uppercase tracking-[0.12em]">Model operațional</p>
          <h2 class="text-h3 sm:text-h2 mb-4 font-medium">Procesul rămâne coerent chiar dacă industria se schimbă.</h2>
          <p class="text-muted-foreground text-lg">Același model leagă compliance-ul continuu de controale tehnice și security operations.</p>
        </div>
        <div class="grid gap-px overflow-hidden rounded-2xl border bg-border sm:grid-cols-2 lg:grid-cols-3">
          {capabilities.map((capability, index) => (
            <article class="bg-level-0 p-6 sm:p-8">
              <div class="text-muted-foreground mb-8 text-sm">0{index + 1}</div>
              <h3 class="mb-3 text-xl font-medium">{capability.title}</h3>
              <p class="text-muted-foreground leading-relaxed">{capability.text}</p>
            </article>
          ))}
        </div>
      </div>
    </section>

    <section class="container py-16 sm:py-24">
      <div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-4">
        <a href="/managed-compliance" class="hover:bg-subtle rounded-xl border p-6 transition-colors"><h3 class="mb-2 font-medium">Managed Compliance</h3><p class="text-muted-foreground text-sm">Program gestionat și audit readiness continuă.</p></a>
        <a href="/cyber-security" class="hover:bg-subtle rounded-xl border p-6 transition-colors"><h3 class="mb-2 font-medium">Cyber Security</h3><p class="text-muted-foreground text-sm">Programul tehnic de protecție și resilience.</p></a>
        <a href="/gdpr" class="hover:bg-subtle rounded-xl border p-6 transition-colors"><h3 class="mb-2 font-medium">GDPR & Privacy</h3><p class="text-muted-foreground text-sm">Privacy governance și măsuri tehnice.</p></a>
        <a href="/secure-hosting" class="hover:bg-subtle rounded-xl border p-6 transition-colors"><h3 class="mb-2 font-medium">Secure Managed Hosting</h3><p class="text-muted-foreground text-sm">Infrastructură administrată security-first.</p></a>
      </div>
    </section>

    <section class="border-t py-16 text-center sm:py-24">
      <div class="container">
        <h2 class="text-h3 sm:text-h2 mx-auto mb-4 max-w-180 font-medium">Nu vezi industria ta în listă?</h2>
        <p class="text-muted-foreground mx-auto mb-8 max-w-160 text-lg">Pornim de la date, aplicații și risc, nu de la eticheta sectorului.</p>
        <Button href="/contact" size="lg">Descrie-ne contextul</Button>
      </div>
    </section>
  </main>
</Layout>

<script>
  import { AnimatedHero } from "../lib/elements/hero";
  import { customElementDefine } from "../lib/dom";
  customElementDefine("animated-hero", () => AnimatedHero);
</script>
