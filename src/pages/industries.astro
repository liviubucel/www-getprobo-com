---
import Layout from "../layouts/Layout.astro";
import Button from "../components/ui/Button.svelte";
import { zebraByteIndustries } from "../content/zebrabyte-industries";

const operatingModel = [
  {
    step: "01",
    title: "Assess",
    text: "Înțelegem activele, datele, serviciile expuse, furnizorii și obligațiile care schimbă riscul sectorului respectiv.",
  },
  {
    step: "02",
    title: "Protect",
    text: "Implementăm hardening, identity controls, website/email security și alte măsuri tehnice potrivite mediului real.",
  },
  {
    step: "03",
    title: "Govern",
    text: "Legăm riscurile și măsurile de GDPR, NIS2, ISO 27001, SOC 2 sau alte cerințe relevante fără să le tratăm ca framework-uri identice.",
  },
  {
    step: "04",
    title: "Evidence",
    text: "Controls, reviews, approvals și rezultate tehnice rămân conectate la programul de compliance și risk management.",
  },
  {
    step: "05",
    title: "Respond",
    text: "Pregătim incident response și recovery înainte de incident și transformăm findings în remediation după un eveniment real.",
  },
  {
    step: "06",
    title: "Improve",
    text: "Revizuim programul pe măsură ce aplicațiile, furnizorii, obligațiile și amenințările se schimbă.",
  },
];

const capabilities = [
  {
    title: "Managed Compliance",
    text: "Controls, risk, evidence, privacy și audit readiness într-un program operat continuu.",
    href: "/managed-compliance",
  },
  {
    title: "Cyber Security",
    text: "Assessment, identity, website/email security, hardening și incident response pentru riscul tehnic real.",
    href: "/cyber-security",
  },
  {
    title: "Privacy & regulatory readiness",
    text: "GDPR, NIS2, ISO 27001 și alte obligații conectate la procese și măsuri demonstrabile.",
    href: "/gdpr",
  },
  {
    title: "Secure Managed Hosting",
    text: "Infrastructură, migration, monitoring și recovery pentru workload-uri care au nevoie de ownership după deploy.",
    href: "/secure-hosting",
  },
];
---

<Layout
  title="Industrii"
  description="Cyber security, managed compliance, privacy, NIS2, ISO 27001 readiness și secure infrastructure adaptate pentru legal, medical, sector public, e-commerce, logistică, educație și alte industrii."
>
  <main>
    <animated-hero
      class="relative -mt-16 block overflow-hidden px-5 py-10 pt-26 sm:pt-36 sm:pb-12"
    >
      <div
        class="text-muted-foreground animate-perspective-in animation-delay-300 mx-auto mb-6 w-max rounded-lg border px-4 py-2 text-sm font-medium sm:mb-8"
      >
        Industrii
      </div>

      <h1
        class="text-h2 sm:text-h1 mb-6 overflow-hidden text-center font-medium text-balance sm:mb-8"
      >
        <span class="animate-perspective-in block">Aceleași discipline.</span>
        <span class="animate-perspective-in block delay-50"> Riscuri diferite în fiecare industrie. </span>
      </h1>

      <p
        class="text-muted-foreground animate-perspective-in animation-delay-150 mx-auto mb-6 max-w-200 text-center text-lg text-balance sm:mb-8"
      >
        Adaptăm cybersecurity, compliance și infrastructura la datele, serviciile,
        dependențele și obligațiile sectorului — fără să transformăm fiecare industrie într-un
        pachet IT generic cu alt nume.
      </p>

      <div
        class="mb-10 flex flex-col items-stretch justify-center gap-3 sm:flex-row sm:items-center"
      >
        <Button
          class="animate-perspective-in animation-delay-200"
          variant="secondary"
          size="lg"
          href="/security-assessment"
        >
          Începe cu un assessment
        </Button>
        <Button
          class="animate-perspective-in animation-delay-300"
          size="lg"
          href="/contact"
        >
          Discută despre industria ta
        </Button>
      </div>
    </animated-hero>

    <section class="container py-10 sm:py-20">
      <div class="mx-auto mb-10 max-w-180 text-center sm:mb-14">
        <h2 class="text-h3 sm:text-h2 mb-3 font-medium">Sectoare pentru care contextul schimbă programul</h2>
        <p class="text-muted-foreground text-lg">
          Fiecare pagină pornește de la riscurile și operațiunile sectorului, apoi le leagă de
          serviciile ZebraByte care pot trata problema respectivă.
        </p>
      </div>

      <div class="mx-auto max-w-5xl border-y">
        {zebraByteIndustries.map((industry, index) => (
          <a
            href={`/industrii/${industry.slug}`}
            class="group grid gap-3 border-b py-7 last:border-b-0 sm:grid-cols-[64px_0.7fr_1.3fr] sm:gap-8"
          >
            <span class="text-muted-foreground font-mono text-sm">{String(index + 1).padStart(2, "0")}</span>
            <div>
              <h3 class="text-h5 font-medium group-hover:underline group-hover:underline-offset-4">
                {industry.shortTitle}
              </h3>
              <p class="text-muted-foreground mt-2 text-sm">
                {industry.priorities.slice(0, 4).join(" · ")}
              </p>
            </div>
            <p class="text-muted-foreground leading-relaxed">{industry.description}</p>
          </a>
        ))}
      </div>
    </section>

    <section class="bg-active py-10 sm:py-20">
      <div class="container">
        <div class="mx-auto mb-10 max-w-180 text-center sm:mb-14">
          <h2 class="text-h3 sm:text-h2 mb-3 font-medium">Modelul rămâne coerent chiar dacă sectorul se schimbă</h2>
          <p class="text-muted-foreground text-lg">
            Nu schimbăm disciplina de lucru pentru fiecare industrie. Schimbăm contextul,
            prioritățile și controls care merită atenție.
          </p>
        </div>

        <div class="mx-auto max-w-5xl border-y">
          {operatingModel.map((item) => (
            <article class="grid gap-3 border-b py-7 last:border-b-0 sm:grid-cols-[64px_0.75fr_1.25fr] sm:gap-8">
              <span class="text-muted-foreground font-mono text-sm">{item.step}</span>
              <h3 class="text-h5 font-medium">{item.title}</h3>
              <p class="text-muted-foreground leading-relaxed">{item.text}</p>
            </article>
          ))}
        </div>
      </div>
    </section>

    <section class="container py-10 sm:py-20">
      <div class="grid gap-12 lg:grid-cols-2 lg:gap-20">
        <div>
          <h2 class="text-h3 sm:text-h2 mb-5 font-medium">Un singur program poate combina mai multe capabilități</h2>
          <p class="text-muted-foreground text-lg leading-relaxed">
            Unele organizații au nevoie doar de un assessment. Altele au nevoie de controls
            tehnice, compliance și ownership operațional în același scope. Alegem combinația
            după risc, nu după eticheta industriei.
          </p>
        </div>
        <div class="border-y">
          {capabilities.map((item) => (
            <a href={item.href} class="group block border-b py-5 last:border-b-0">
              <h3 class="font-medium group-hover:underline group-hover:underline-offset-4">{item.title}</h3>
              <p class="text-muted-foreground mt-2 leading-relaxed">{item.text}</p>
            </a>
          ))}
        </div>
      </div>
    </section>

    <section class="container py-12 text-center sm:py-24">
      <h2 class="text-h3 sm:text-h2 mx-auto mb-4 max-w-190 font-medium text-balance">
        Nu vezi industria ta în listă?
      </h2>
      <p class="text-muted-foreground mx-auto mb-8 max-w-160 text-lg">
        Pornim de la date, aplicații, furnizori și risc. Nu este nevoie să forțăm organizația
        într-o categorie doar ca să putem începe.
      </p>
      <Button href="/contact" size="lg">Descrie-ne contextul</Button>
    </section>
  </main>
</Layout>

<script>
  import { AnimatedHero } from "../lib/elements/hero";
  import { customElementDefine } from "../lib/dom";
  customElementDefine("animated-hero", () => AnimatedHero);
</script>
