---
import Layout from "../layouts/Layout.astro";
import Button from "../components/ui/Button.svelte";
import { zebraByteIndustries } from "../content/zebrabyte-industries";

const riskLenses = [
  {
    number: "01",
    title: "Data sensitivity",
    text: "Date medicale, secret profesional, informații despre clienți sau donatori schimbă impactul unei expuneri și controalele care merită prioritate.",
  },
  {
    number: "02",
    title: "Public exposure",
    text: "Website-uri, API-uri, formulare și servicii publice măresc suprafața de atac și cer protecție diferită față de sisteme exclusiv interne.",
  },
  {
    number: "03",
    title: "Operational dependency",
    text: "Pentru e-commerce, logistică sau servicii publice, indisponibilitatea poate deveni imediat o problemă de venit, producție sau continuitate.",
  },
  {
    number: "04",
    title: "Third-party reliance",
    text: "SaaS, furnizori, integrări și acces extern pot muta o parte importantă din risc în afara infrastructurii administrate direct de organizație.",
  },
];

const operatingModel = [
  ["01", "Assess", "Active, date, expunere și dependențe."],
  ["02", "Protect", "Identity, website, email și infrastructură."],
  ["03", "Govern", "Risk, privacy și cerințe aplicabile."],
  ["04", "Evidence", "Controls, reviews și rezultate verificabile."],
  ["05", "Respond", "Incident readiness și recovery."],
  ["06", "Improve", "Schimbări, findings și priorități noi."],
];

const capabilities = [
  {
    title: "Managed Compliance",
    text: "Controls, risk, evidence, privacy și audit readiness într-un program operat continuu.",
    href: "/managed-compliance",
  },
  {
    title: "Cyber Security",
    text: "Assessment, identity, website/email security, hardening și incident response pentru riscul tehnic real.",
    href: "/cyber-security",
  },
  {
    title: "Privacy & regulatory readiness",
    text: "GDPR, NIS2, ISO 27001 și alte obligații conectate la procese și măsuri demonstrabile.",
    href: "/compliance",
  },
  {
    title: "Secure Managed Hosting",
    text: "Infrastructură, migration, monitoring și recovery pentru workload-uri care au nevoie de ownership după deploy.",
    href: "/secure-hosting",
  },
];
---

<Layout
  title="Industrii"
  description="Cyber security, managed compliance, privacy, NIS2, ISO 27001 readiness și secure infrastructure adaptate pentru legal, medical, sector public, e-commerce, logistică, educație și alte industrii."
>
  <main>
    <animated-hero class="relative -mt-16 block overflow-hidden px-5 py-10 pt-26 sm:pt-36 sm:pb-12">
      <div class="text-muted-foreground animate-perspective-in animation-delay-300 mx-auto mb-6 w-max rounded-lg border px-4 py-2 text-sm font-medium sm:mb-8">
        Industrii
      </div>

      <h1 class="text-h2 sm:text-h1 mb-6 overflow-hidden text-center font-medium text-balance sm:mb-8">
        <span class="animate-perspective-in block">Aceleași discipline.</span>
        <span class="animate-perspective-in block delay-50"> Alt risc în fiecare industrie. </span>
      </h1>

      <p class="text-muted-foreground animate-perspective-in animation-delay-150 mx-auto mb-6 max-w-200 text-center text-lg text-balance sm:mb-8">
        Cybersecurity, compliance și infrastructura se schimbă în funcție de date, expunere, continuitate și furnizori. Programul trebuie să reflecte sectorul, nu doar să-i poarte numele.
      </p>

      <div class="mb-11 flex flex-col items-stretch justify-center gap-3 sm:mb-17 sm:flex-row sm:items-center">
        <Button class="animate-perspective-in animation-delay-200" variant="secondary" size="lg" href="/security-assessment">
          Începe cu un assessment
        </Button>
        <Button class="animate-perspective-in animation-delay-300" size="lg" href="/contact">
          Discută despre industria ta
        </Button>
      </div>
    </animated-hero>

    <section class="container pb-12 sm:pb-24">
      <div class="mb-10 max-w-3xl sm:mb-14">
        <p class="text-muted-foreground mb-3 text-sm font-medium uppercase tracking-wide">Sector navigator</p>
        <h2 class="text-h3 sm:text-h2 mb-4 font-medium">Contextul schimbă ordinea priorităților.</h2>
        <p class="text-muted-foreground text-lg leading-relaxed">
          Fiecare sector pornește de la propriile date, operațiuni și dependențe. Alege contextul cel mai apropiat de organizația ta și vezi cum se schimbă programul.
        </p>
      </div>

      <div class="grid gap-x-14 lg:grid-cols-2 lg:gap-x-20">
        {zebraByteIndustries.map((industry, index) => (
          <a href={`/industrii/${industry.slug}`} class="group border-t py-8 sm:py-10">
            <div class="mb-8 flex items-start justify-between gap-6">
              <span class="text-muted-foreground font-mono text-sm">{String(index + 1).padStart(2, "0")}</span>
              <span class="text-muted-foreground text-right text-xs uppercase tracking-wide">
                {industry.priorities.slice(0, 3).join(" · ")}
              </span>
            </div>
            <h3 class="text-h3 mb-3 font-medium group-hover:underline group-hover:underline-offset-4">
              {industry.shortTitle}
            </h3>
            <p class="text-muted-foreground max-w-2xl text-lg leading-relaxed">{industry.description}</p>
          </a>
        ))}
      </div>
    </section>

    <section class="bg-level-3 py-12 text-level-0-foreground sm:py-24">
      <div class="container">
        <div class="mb-12 max-w-3xl sm:mb-16">
          <p class="text-level-0-foreground/55 mb-3 text-sm font-medium uppercase tracking-wide">Risk lens</p>
          <h2 class="text-h3 sm:text-h2 mb-4 font-medium">Industria nu schimbă principiile. Schimbă riscul.</h2>
          <p class="text-level-0-foreground/65 text-lg leading-relaxed">
            Aceeași măsură poate avea altă prioritate într-o clinică, o firmă de avocatură sau un magazin online. Folosim contextul pentru a decide ce trebuie tratat primul.
          </p>
        </div>

        <div class="grid gap-x-14 sm:grid-cols-2 lg:gap-x-24">
          {riskLenses.map((item) => (
            <article class="border-t border-level-0-foreground/15 py-8">
              <span class="text-level-0-foreground/40 mb-8 block font-mono text-sm">{item.number}</span>
              <h3 class="text-h3 mb-3 font-medium">{item.title}</h3>
              <p class="text-level-0-foreground/65 text-lg leading-relaxed">{item.text}</p>
            </article>
          ))}
        </div>
      </div>
    </section>

    <section class="bg-active py-12 sm:py-24">
      <div class="container">
        <div class="mx-auto mb-12 max-w-190 text-center sm:mb-16">
          <p class="text-muted-foreground mb-3 text-sm font-medium uppercase tracking-wide">Operating model</p>
          <h2 class="text-h3 sm:text-h2 mb-4 font-medium">Un singur mod de lucru. Priorități diferite.</h2>
          <p class="text-muted-foreground text-lg leading-relaxed">
            Nu reinventăm procesul pentru fiecare sector. Schimbăm scope-ul, ordinea controls și nivelul de ownership în funcție de risc.
          </p>
        </div>

        <div class="relative mx-auto max-w-6xl">
          <div class="absolute top-5 right-[8%] left-[8%] hidden h-px bg-border lg:block"></div>
          <div class="grid gap-10 sm:grid-cols-2 lg:grid-cols-6 lg:gap-6">
            {operatingModel.map(([step, title, text]) => (
              <article class="relative">
                <div class="mb-5 flex size-10 items-center justify-center rounded-full border bg-background font-mono text-xs">{step}</div>
                <h3 class="text-h5 mb-2 font-medium">{title}</h3>
                <p class="text-muted-foreground leading-relaxed">{text}</p>
              </article>
            ))}
          </div>
        </div>
      </div>
    </section>

    <section class="container py-12 sm:py-24">
      <div class="grid gap-14 lg:grid-cols-[0.75fr_1.25fr] lg:gap-24">
        <div>
          <p class="text-muted-foreground mb-3 text-sm font-medium uppercase tracking-wide">Capabilities</p>
          <h2 class="text-h3 sm:text-h2 mb-5 font-medium">Combinăm doar capabilitățile care schimbă riscul.</h2>
          <p class="text-muted-foreground text-lg leading-relaxed">
            Unele organizații au nevoie de un assessment punctual. Altele au nevoie de security engineering, compliance și ownership operațional în același program. Sectorul nu obligă automat un anumit pachet.
          </p>
        </div>

        <div class="grid gap-x-10 sm:grid-cols-2">
          {capabilities.map((item) => (
            <a href={item.href} class="group border-t py-7">
              <h3 class="text-h4 font-medium group-hover:underline group-hover:underline-offset-4">{item.title}</h3>
              <p class="text-muted-foreground mt-3 leading-relaxed">{item.text}</p>
            </a>
          ))}
        </div>
      </div>
    </section>

    <section class="container py-12 text-center sm:py-24">
      <h2 class="text-h3 sm:text-h2 mx-auto mb-4 max-w-190 font-medium text-balance">Nu vezi industria ta?</h2>
      <p class="text-muted-foreground mx-auto mb-8 max-w-160 text-lg">
        Pornim de la date, aplicații, furnizori și risc. Nu este nevoie să forțăm organizația într-o categorie doar ca să putem începe.
      </p>
      <Button href="/contact" size="lg">Descrie-ne contextul</Button>
    </section>
  </main>
</Layout>

<script>
  import { AnimatedHero } from "../lib/elements/hero";
  import { customElementDefine } from "../lib/dom";
  customElementDefine("animated-hero", () => AnimatedHero);
</script>
