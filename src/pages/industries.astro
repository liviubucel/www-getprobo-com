---
import Layout from "../layouts/Layout.astro";
import Button from "../components/ui/Button.svelte";
import { zebraByteIndustries } from "../content/zebrabyte-industries";

const operatingModel = [
  {
    step: "01",
    title: "Assess",
    text: "Înțelegem activele, datele, serviciile expuse, furnizorii și obligațiile care schimbă riscul sectorului respectiv.",
  },
  {
    step: "02",
    title: "Protect",
    text: "Implementăm hardening, identity controls, website/email security și alte măsuri tehnice potrivite mediului real.",
  },
  {
    step: "03",
    title: "Govern",
    text: "Legăm riscurile și măsurile de GDPR, NIS2, ISO 27001, SOC 2 sau alte cerințe relevante fără să le tratăm ca framework-uri identice.",
  },
  {
    step: "04",
    title: "Evidence",
    text: "Controls, reviews, approvals și rezultate tehnice rămân conectate la programul de compliance și risk management.",
  },
  {
    step: "05",
    title: "Respond",
    text: "Pregătim incident response și recovery înainte de incident și transformăm findings în remediation după un eveniment real.",
  },
  {
    step: "06",
    title: "Improve",
    text: "Revizuim programul pe măsură ce aplicațiile, furnizorii, obligațiile și amenințările se schimbă.",
  },
];

const capabilities = [
  {
    title: "Managed Compliance",
    text: "Controls, risk, evidence, privacy și audit readiness într-un program operat continuu.",
    href: "/managed-compliance",
  },
  {
    title: "Cyber Security",
    text: "Assessment, identity, website/email security, hardening și incident response pentru riscul tehnic real.",
    href: "/cyber-security",
  },
  {
    title: "Privacy & regulatory readiness",
    text: "GDPR, NIS2, ISO 27001 și alte obligații conectate la procese și măsuri demonstrabile.",
    href: "/gdpr",
  },
  {
    title: "Secure Managed Hosting",
    text: "Infrastructură, migration, monitoring și recovery pentru workload-uri care au nevoie de ownership după deploy.",
    href: "/secure-hosting",
  },
];
---

<Layout
  title="Industrii"
  description="Cyber security, managed compliance, privacy, NIS2, ISO 27001 readiness și secure infrastructure adaptate pentru legal, medical, sector public, e-commerce, logistică, educație și alte industrii."
>
  <main>
    <animated-hero class="relative -mt-16 block overflow-hidden px-5 py-10 pt-26 sm:pt-36 sm:pb-12">
      <div class="text-muted-foreground animate-perspective-in animation-delay-300 mx-auto mb-6 w-max rounded-lg border px-4 py-2 text-sm font-medium sm:mb-8">
        Industrii
      </div>

      <h1 class="text-h2 sm:text-h1 mb-6 overflow-hidden text-center font-medium text-balance sm:mb-8">
        <span class="animate-perspective-in block">Aceleași discipline.</span>
        <span class="animate-perspective-in block delay-50"> Riscuri diferite în fiecare industrie. </span>
      </h1>

      <p class="text-muted-foreground animate-perspective-in animation-delay-150 mx-auto mb-6 max-w-200 text-center text-lg text-balance sm:mb-8">
        Adaptăm cybersecurity, compliance și infrastructura la datele, serviciile,
        dependențele și obligațiile sectorului — fără să transformăm fiecare industrie într-un
        pachet IT generic cu alt nume.
      </p>

      <div class="mb-10 flex flex-col items-stretch justify-center gap-3 sm:flex-row sm:items-center">
        <Button class="animate-perspective-in animation-delay-200" variant="secondary" size="lg" href="/security-assessment">Începe cu un assessment</Button>
        <Button class="animate-perspective-in animation-delay-300" size="lg" href="/contact">Discută despre industria ta</Button>
      </div>
    </animated-hero>

    <section class="container pb-12 sm:pb-24">
      <div class="grid gap-12 lg:grid-cols-[0.48fr_1.52fr] lg:gap-20">
        <div class="lg:sticky lg:top-28 lg:self-start">
          <p class="text-muted-foreground mb-3 text-sm font-medium uppercase tracking-wide">Sector atlas</p>
          <h2 class="text-h3 sm:text-h2 mb-5 font-medium">Contextul schimbă ordinea priorităților.</h2>
          <p class="text-muted-foreground text-lg leading-relaxed">
            Un cabinet de avocatură, o clinică și o companie de logistică pot folosi aceleași
            discipline de security și compliance, dar activele critice, impactul și dependențele
            nu sunt aceleași.
          </p>
        </div>

        <div class="border-y">
          {zebraByteIndustries.map((industry, index) => (
            <a
              href={`/industrii/${industry.slug}`}
              class="group block border-b py-7 last:border-b-0 sm:py-9"
            >
              <div class="grid gap-5 sm:grid-cols-[72px_0.72fr_1.28fr] sm:gap-8">
                <span class="text-muted-foreground font-mono text-sm">{String(index + 1).padStart(2, "0")}</span>
                <div>
                  <h3 class="text-h4 font-medium group-hover:underline group-hover:underline-offset-4">{industry.shortTitle}</h3>
                  <div class="mt-4 flex flex-wrap gap-x-4 gap-y-2">
                    {industry.priorities.slice(0, 3).map((priority) => (
                      <span class="text-muted-foreground text-xs">{priority}</span>
                    ))}
                  </div>
                </div>
                <div class="flex items-start justify-between gap-6">
                  <p class="text-muted-foreground max-w-2xl leading-relaxed">{industry.description}</p>
                  <span class="text-muted-foreground mt-1 hidden text-xl transition-transform group-hover:translate-x-1 sm:block">→</span>
                </div>
              </div>
            </a>
          ))}
        </div>
      </div>
    </section>

    <section class="bg-level-3 py-12 text-level-0-foreground sm:py-24">
      <div class="container">
        <div class="mb-12 max-w-3xl">
          <p class="mb-3 text-sm font-medium uppercase tracking-wide opacity-55">Cross-sector operating model</p>
          <h2 class="text-h3 sm:text-h2 mb-4 font-medium">Disciplina rămâne coerentă chiar dacă sectorul se schimbă.</h2>
          <p class="text-lg leading-relaxed opacity-65">
            Schimbăm contextul și prioritățile, nu inventăm un proces complet diferit pentru fiecare verticală.
          </p>
        </div>

        <div class="overflow-x-auto pb-3">
          <div class="grid min-w-[980px] grid-cols-6 border-y border-level-0-foreground/15">
            {operatingModel.map((item, index) => (
              <article class:list={["relative min-h-72 px-5 py-6", index < operatingModel.length - 1 && "border-r border-level-0-foreground/15"]}>
                <div class="mb-10 flex items-center justify-between gap-4">
                  <span class="font-mono text-xs opacity-40">{item.step}</span>
                  <span class="font-mono text-xs opacity-35">{index < operatingModel.length - 1 ? "→" : "↻"}</span>
                </div>
                <h3 class="mb-4 font-medium">{item.title}</h3>
                <p class="text-sm leading-relaxed opacity-65">{item.text}</p>
              </article>
            ))}
          </div>
        </div>
      </div>
    </section>

    <section class="container py-12 sm:py-24">
      <div class="grid gap-12 lg:grid-cols-[0.58fr_1.42fr] lg:gap-20">
        <div>
          <p class="text-muted-foreground mb-3 text-sm font-medium uppercase tracking-wide">Capability mix</p>
          <h2 class="text-h3 sm:text-h2 mb-5 font-medium">Un singur program poate combina mai multe capabilități.</h2>
          <p class="text-muted-foreground text-lg leading-relaxed">
            Unele organizații au nevoie doar de un assessment. Altele au nevoie de controls
            tehnice, compliance și ownership operațional în același scope. Alegem combinația
            după risc, nu după eticheta industriei.
          </p>
        </div>

        <div class="grid gap-x-10 sm:grid-cols-2">
          {capabilities.map((item, index) => (
            <a href={item.href} class="group border-t py-7">
              <div class="text-muted-foreground mb-8 font-mono text-xs">CAP-{String(index + 1).padStart(2, "0")}</div>
              <h3 class="text-h4 mb-3 font-medium group-hover:underline group-hover:underline-offset-4">{item.title}</h3>
              <p class="text-muted-foreground max-w-xl leading-relaxed">{item.text}</p>
            </a>
          ))}
        </div>
      </div>
    </section>

    <section class="border-t py-16 text-center sm:py-24">
      <div class="container">
        <h2 class="text-h3 sm:text-h2 mx-auto mb-4 max-w-190 font-medium text-balance">Nu vezi industria ta în listă?</h2>
        <p class="text-muted-foreground mx-auto mb-8 max-w-160 text-lg">
          Pornim de la date, aplicații, furnizori și risc. Nu este nevoie să forțăm organizația
          într-o categorie doar ca să putem începe.
        </p>
        <Button href="/contact" size="lg">Descrie-ne contextul</Button>
      </div>
    </section>
  </main>
</Layout>

<script>
  import { AnimatedHero } from "../lib/elements/hero";
  import { customElementDefine } from "../lib/dom";
  customElementDefine("animated-hero", () => AnimatedHero);
</script>
