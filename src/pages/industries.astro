---
import Layout from "../layouts/Layout.astro";
import Button from "../components/ui/Button.svelte";

const industries = [
  {
    title: "Avocatură & Notariat",
    description: "Confidențialitatea documentelor, identitatea de email și accesul la sisteme sunt centrale. Combinăm security assessment, email security, website protection, privacy și audit readiness.",
    controls: ["Email authentication", "Website security", "GDPR & privacy", "Secure hosting"],
  },
  {
    title: "Medical & Clinici",
    description: "Date sensibile, disponibilitate și acces controlat. Punem accent pe protecția aplicațiilor, identitate, backup/recovery și procese de privacy care reflectă realitatea tehnică.",
    controls: ["Access control", "Backup & recovery", "Privacy", "Monitoring"],
  },
  {
    title: "Instituții Publice",
    description: "Servicii publice expuse, obligații de securitate și accesibilitate, plus cerințe de guvernanță. Legăm cybersecurity, NIS2 readiness, GDPR și WCAG într-un program coerent.",
    controls: ["NIS2 readiness", "Accessibility", "Incident readiness", "Website security"],
  },
  {
    title: "E-commerce",
    description: "Disponibilitatea magazinului, securitatea conturilor și protecția checkout-ului influențează direct veniturile. Reducem riscul fără să sacrificăm performanța.",
    controls: ["WAF & DDoS", "Email security", "Recovery", "Continuous monitoring"],
  },
  {
    title: "Imobiliare",
    description: "Site-uri cu multe formulare, date despre clienți și integrări externe. Protejăm aplicația, identitatea de email și datele colectate prin fluxurile comerciale.",
    controls: ["Form protection", "Privacy", "Email security", "Secure hosting"],
  },
  {
    title: "HoReCa",
    description: "Rezervări, plăți, site-uri cu trafic variabil și furnizori multipli. Punem accent pe disponibilitate, hardening și capacitatea de recuperare rapidă.",
    controls: ["Availability", "WAF", "Backup", "Incident response"],
  },
  {
    title: "Producție & Logistică",
    description: "Aplicații operaționale, tracking, conturi privilegiate și dependențe de terți. Prioritizăm accesul, riscul furnizorilor, reziliența și răspunsul la incidente.",
    controls: ["Identity", "Third-party risk", "NIS2 readiness", "Recovery"],
  },
  {
    title: "Educație",
    description: "Platforme publice și interne care procesează date despre elevi, studenți și personal. Combinăm privacy, accesibilitate și protecția infrastructurii.",
    controls: ["GDPR", "Accessibility", "Identity", "Website security"],
  },
  {
    title: "ONG-uri",
    description: "Echipe mici, multe servicii SaaS și resurse limitate. Construim un baseline pragmatic de securitate și continuitate fără complexitate inutilă.",
    controls: ["Security baseline", "Email security", "Backups", "Awareness"],
  },
];

const capabilities = [
  { title: "Assess", text: "Înțelegem suprafața expusă, activele critice, furnizorii și obligațiile aplicabile." },
  { title: "Protect", text: "Implementăm hardening, WAF, email authentication, access controls și măsuri tehnice potrivite contextului." },
  { title: "Govern", text: "Legăm riscurile și măsurile tehnice de GDPR, NIS2, ISO 27001 readiness și procesele interne." },
  { title: "Evidence", text: "Urmărim controalele, schimbările și dovezile în modelul continuu al platformei Probo/ZebraByte." },
  { title: "Respond", text: "Pregătim incident response și recovery înainte să fie nevoie de ele și intervenim când apare un incident real." },
  { title: "Improve", text: "Revizuim periodic postura și ajustăm programul când se schimbă infrastructura, riscul sau cerințele." },
];
---

<Layout
  title="Industries"
  description="Cyber security, privacy, NIS2, ISO 27001 readiness și secure infrastructure adaptate pentru legal, medical, sector public, e-commerce, logistică, educație și alte industrii."
>
  <main>
    <animated-hero class="relative -mt-16 block overflow-hidden px-5 pb-16 pt-32 sm:pb-24 sm:pt-40">
      <div class="container text-center">
        <div class="border-border-low text-tertiary-foreground animate-perspective-in mx-auto mb-6 w-max rounded-lg border px-2 py-0.5 text-sm font-medium">Industries</div>
        <h1 class="text-h2 sm:text-h1 mx-auto mb-6 max-w-230 font-medium text-balance">Aceleași controale. Riscuri diferite în fiecare industrie.</h1>
        <p class="text-muted-foreground mx-auto mb-8 max-w-190 text-lg text-balance">
          Nu vindem un pachet identic tuturor. Adaptăm cybersecurity, privacy, compliance și infrastructura la datele, serviciile și obligațiile care contează în sectorul tău.
        </p>
        <div class="flex flex-col justify-center gap-3 sm:flex-row">
          <Button href="/contact" size="lg">Discută despre industria ta</Button>
          <Button href="/security-assessment" variant="secondary" size="lg">Începe cu un assessment</Button>
        </div>
      </div>
    </animated-hero>

    <section class="container py-16 sm:py-24">
      <div class="mx-auto mb-12 max-w-180 text-center">
        <p class="text-muted-foreground mb-3 text-sm font-medium uppercase tracking-[0.12em]">Sectors</p>
        <h2 class="text-h3 sm:text-h2 mb-4 font-medium">Domenii pentru care programul trebuie adaptat.</h2>
        <p class="text-muted-foreground text-lg">Am consolidat verticalele din site-ul ZebraByte anterior într-o singură experiență mai clară, păstrând contextul real al fiecărui sector.</p>
      </div>

      <div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
        {industries.map((industry) => (
          <article class="bg-level-0 rounded-2xl border p-6 sm:p-8">
            <h3 class="mb-3 text-xl font-medium">{industry.title}</h3>
            <p class="text-muted-foreground mb-7 leading-relaxed">{industry.description}</p>
            <div class="flex flex-wrap gap-2">
              {industry.controls.map((control) => (
                <span class="bg-active rounded-full px-3 py-1 text-xs">{control}</span>
              ))}
            </div>
          </article>
        ))}
      </div>
    </section>

    <section class="bg-active py-16 sm:py-24">
      <div class="container">
        <div class="mb-12 max-w-180">
          <p class="text-muted-foreground mb-3 text-sm font-medium uppercase tracking-[0.12em]">Operating model</p>
          <h2 class="text-h3 sm:text-h2 mb-4 font-medium">Procesul rămâne coerent chiar dacă industria se schimbă.</h2>
          <p class="text-muted-foreground text-lg">Păstrăm modelul Probo de lucru continuu și îl extindem de la compliance către controls tehnice și operational security.</p>
        </div>
        <div class="grid gap-px overflow-hidden rounded-2xl border bg-border sm:grid-cols-2 lg:grid-cols-3">
          {capabilities.map((capability, index) => (
            <article class="bg-level-0 p-6 sm:p-8">
              <div class="text-muted-foreground mb-8 text-sm">0{index + 1}</div>
              <h3 class="mb-3 text-xl font-medium">{capability.title}</h3>
              <p class="text-muted-foreground leading-relaxed">{capability.text}</p>
            </article>
          ))}
        </div>
      </div>
    </section>

    <section class="container py-16 sm:py-24">
      <div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-4">
        <a href="/cyber-security" class="hover:bg-subtle rounded-xl border p-6 transition-colors">
          <h3 class="mb-2 font-medium">Cyber Security</h3>
          <p class="text-muted-foreground text-sm">Programul tehnic de bază.</p>
        </a>
        <a href="/gdpr" class="hover:bg-subtle rounded-xl border p-6 transition-colors">
          <h3 class="mb-2 font-medium">GDPR & Privacy</h3>
          <p class="text-muted-foreground text-sm">Privacy governance și măsuri tehnice.</p>
        </a>
        <a href="/nis2" class="hover:bg-subtle rounded-xl border p-6 transition-colors">
          <h3 class="mb-2 font-medium">NIS2 Readiness</h3>
          <p class="text-muted-foreground text-sm">Governance, risk și resilience.</p>
        </a>
        <a href="/accessibility" class="hover:bg-subtle rounded-xl border p-6 transition-colors">
          <h3 class="mb-2 font-medium">Accessibility</h3>
          <p class="text-muted-foreground text-sm">WCAG assessment și remediation.</p>
        </a>
      </div>
    </section>

    <section class="border-t py-16 text-center sm:py-24">
      <div class="container">
        <h2 class="text-h3 sm:text-h2 mx-auto mb-4 max-w-180 font-medium">Nu vezi industria ta în listă?</h2>
        <p class="text-muted-foreground mx-auto mb-8 max-w-160 text-lg">Pornim de la date, aplicații și risc, nu de la eticheta sectorului. Putem construi programul și pentru alte domenii.</p>
        <Button href="/contact" size="lg">Descrie-ne contextul</Button>
      </div>
    </section>
  </main>
</Layout>

<script>
  import { AnimatedHero } from "../lib/elements/hero";
  import { customElementDefine } from "../lib/dom";
  customElementDefine("animated-hero", () => AnimatedHero);
</script>
