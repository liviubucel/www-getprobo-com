---
import Layout from "../layouts/Layout.astro";
import { getCollection } from "astro:content";
import Logos from "../components/block/Logos.astro";
import StoryCard from "../components/StoryCard.astro";
import { sortStoriesForListing } from "../lib/stories.ts";

const stories = sortStoriesForListing(await getCollection("stories"));
---

<Layout
  title="Studii de caz și exemple de conformitate"
  description="Studii de caz și exemple reale despre cum echipe de tehnologie au abordat SOC 2, ISO 27001 și programe moderne de conformitate, alături de proiecte ZebraByte."
>
  <main class="my-10 sm:my-20">
    <div class="container">
      <h1
        class="text-h2 sm:text-h1 mb-3 overflow-hidden text-center font-medium"
      >
        <span class="animate-perspective-in inline-block">Compliance</span>
        <span class="animate-perspective-in animation-delay-100 inline-block"
          >Stories</span
        >
      </h1>
      <p
        class="text-muted-foreground animate-perspective-in animation-delay-200 mx-auto max-w-2xl text-center text-base"
      >
        Proiecte ZebraByte și studii de referință despre modul în care companiile
        moderne își structurează securitatea și conformitatea. Exemplele de
        referință ilustrează rezultate și metode aplicabile unei platforme de
        compliance precum ZebraByte și nu reprezintă automat relații comerciale
        ZebraByte.
      </p>
    </div>
    <Logos class="animate-slide-in animation-delay-300 my-6" constrained />
    <div
      class="animate-slide-in animation-delay-250 container grid grid-cols-1 gap-5 sm:grid-cols-2 sm:gap-6"
    >
      {stories.map((item) => <StoryCard story={item} />)}
    </div>
  </main>
</Layout>
