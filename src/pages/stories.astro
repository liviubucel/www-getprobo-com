---
import Layout from "../layouts/Layout.astro";
import { getCollection } from "astro:content";
import StoryCard from "../components/StoryCard.astro";
import { sortStoriesForListing } from "../lib/stories.ts";

const stories = sortStoriesForListing(
  (await getCollection("stories")).filter((story) =>
    story.id.startsWith("zebrabyte-"),
  ),
);
---

<Layout
  title="Studii de caz"
  description="Studii de caz ZebraByte despre securitate, compliance și infrastructură security-first."
>
  <main class="my-10 sm:my-20">
    <div class="container">
      <h1 class="text-h2 sm:text-h1 mb-3 overflow-hidden text-center font-medium">
        <span class="animate-perspective-in inline-block">Studii de</span>{" "}
        <span class="animate-perspective-in animation-delay-100 inline-block">caz</span>
      </h1>
      <p class="text-muted-foreground animate-perspective-in animation-delay-200 mx-auto mb-10 max-w-180 text-center text-base sm:mb-14">
        Situații documentate din activitatea ZebraByte, cu accent pe probleme, intervenții și rezultate verificabile.
      </p>
    </div>

    <section class="container">
      {
        stories.length > 0 ? (
          <div class="animate-slide-in animation-delay-250 grid grid-cols-1 gap-5 sm:grid-cols-2 sm:gap-6">
            {stories.map((item) => <StoryCard story={item} />)}
          </div>
        ) : (
          <div class="mx-auto max-w-2xl rounded-2xl border bg-active p-8 text-center sm:p-12">
            <h2 class="text-h4 mb-3 font-medium">Mai multe studii de caz sunt în pregătire.</h2>
            <p class="text-muted-foreground">Publicăm doar proiecte pe care le putem documenta corect și fără a expune informații confidențiale.</p>
          </div>
        )
      }
    </section>
  </main>
</Layout>
