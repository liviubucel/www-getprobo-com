---
import clsx from "clsx";
import { frameworks } from "../content/frameworks.ts";
import FrameworkBadge from "./FrameworkBadgeStatic.astro";

interface Props {
  count: number;
  countMobile?: number;
  class?: string;
  border?: boolean;
}

const {
  count,
  countMobile = count,
  class: className,
  border = false,
} = Astro.props;

const preferredOrder = [
  "SOC2_TYPE1",
  "ISO27001",
  "ISO42001",
  "CCPA",
  "JetDePierre",
  "ISO27701",
  "HIPAA",
  "FERPA",
  "CASA",
  "SOC2_TYPE2",
  "SOC3",
];

const orderedFrameworks = [
  ...preferredOrder
    .map((badge) => frameworks.find((framework) => framework.badge === badge))
    .filter((framework): framework is (typeof frameworks)[number] => Boolean(framework)),
  ...frameworks.filter((framework) => !preferredOrder.includes(framework.badge)),
].slice(0, count);
---

<div class={clsx(className, "relative")}>
  {
    orderedFrameworks.map((framework, index) => (
      <div
        class:list={[
          "place-items-center overflow-hidden text-center",
          border && "aspect-square transition-colors hover:bg-[#F4FCE6] md:aspect-192/180",
          index >= countMobile ? "hidden sm:grid" : "grid",
        ]}
      >
        <div class="col-1 row-1 size-25 space-y-3 aspect-square mix-blend-multiply">
          <FrameworkBadge
            name={framework.badge}
            class="mx-auto block size-16"
            priority={index < Math.min(countMobile, 6)}
          />
          <div class="text-xxs whitespace-nowrap">{framework.label}</div>
        </div>
      </div>
    ))
  }

  {
    border && (
      <>
        <div class="pointer-events-none absolute inset-0 sm:hidden" aria-hidden="true">
          {[0, 33.333, 66.667, 100].map((left) => (
            <span class="badge-v-rule absolute top-[-20px] bottom-[-20px] w-px" style={`left:${left}%`} />
          ))}
          {[0, 50, 100].map((top) => (
            <span class="badge-h-rule absolute right-[-20px] left-[-20px] h-px" style={`top:${top}%`} />
          ))}
        </div>
        <div class="pointer-events-none absolute inset-0 hidden sm:block" aria-hidden="true">
          {[0, 20, 40, 60, 80, 100].map((left) => (
            <span class="badge-v-rule absolute top-[-20px] bottom-[-20px] w-px" style={`left:${left}%`} />
          ))}
          {[0, 50, 100].map((top) => (
            <span class="badge-h-rule absolute right-[-20px] left-[-20px] h-px" style={`top:${top}%`} />
          ))}
        </div>
      </>
    )
  }
</div>

<style>
  .badge-v-rule {
    background: linear-gradient(
      to bottom,
      transparent,
      var(--color-border-low) 20px,
      var(--color-border-low) calc(100% - 20px),
      transparent
    );
  }

  .badge-h-rule {
    background: linear-gradient(
      to right,
      transparent,
      var(--color-border-low) 40px,
      var(--color-border-low) calc(100% - 40px),
      transparent
    );
  }
</style>
