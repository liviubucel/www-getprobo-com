---
interface Props {
  name: string;
  class?: string;
  priority?: boolean;
}

const { name, class: className, priority = false } = Astro.props;
const assetName = name.replaceAll(" ", "");
---

<img
  src={`/frameworks/${assetName}.svg?v=3`}
  class={className}
  alt={`${name} badge de conformitate`}
  width="64"
  height="64"
  loading={priority ? "eager" : "lazy"}
  fetchpriority={priority ? "high" : "auto"}
  decoding="async"
  draggable="false"
/>
