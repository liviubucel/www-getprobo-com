---
import Button from "../ui/Button.svelte";
import Badges from "../Badges.svelte";
import ComplianceTrack from "../block/ComplianceTrack.astro";
import Frameworks from "../block/Frameworks.astro";
import Logos from "../block/Logos.astro";
import Newsletter from "../block/Newsletter.astro";
import Stories from "../block/Stories.astro";
import Testimonials from "../block/Testimonials.astro";
import ZebraByteTestimonials from "../block/ZebraByteTestimonials.astro";
import {
  cmsImageUrl,
  localize,
  portableTextToHtml,
  toPublicHref,
  type CmsLocale,
} from "../../lib/cms/content";

interface Props {
  document: Record<string, any>;
  locale: CmsLocale;
}

const { document, locale } = Astro.props;
const sections = (document.sections ?? []).filter((section: any) => section?.enabled !== false);

const themeClass: Record<string, string> = {
  default: "bg-level-0",
  muted: "bg-subtle",
  dark: "bg-level-1",
  brand: "bg-secondary",
};
const densityClass: Record<string, string> = {
  compact: "py-8 sm:py-12",
  normal: "py-10 sm:py-20",
  roomy: "py-14 sm:py-28",
};
const widthClass: Record<string, string> = {
  narrow: "max-w-3xl",
  normal: "max-w-5xl",
  wide: "max-w-7xl",
};
const columnClass: Record<number, string> = {
  2: "sm:grid-cols-2",
  3: "sm:grid-cols-2 lg:grid-cols-3",
  4: "sm:grid-cols-2 lg:grid-cols-4",
};

const sectionClasses = (section: any) => [
  themeClass[section.theme] ?? themeClass.default,
  densityClass[section.density] ?? densityClass.normal,
];
const text = (value: any) => localize(value, locale) as string;
const href = (value: string | undefined) => toPublicHref(value, locale);
const image = (value: any) => cmsImageUrl(value);
---

<main data-cms-managed-page data-cms-document-id={document._id}>
  {
    sections.map((section: any) => {
      if (section._type === "heroSection") {
        const animated = section.variant === "animated";
        const Wrapper = animated ? "animated-hero" : "section";
        const mediaUrl = image(section.media?.image);
        return (
          <Wrapper
            id={section.anchorId || undefined}
            class:list={[
              "relative block overflow-hidden px-5 pt-26 pb-12 sm:pt-36 sm:pb-16",
              themeClass[section.theme] ?? themeClass.default,
            ]}
          >
            <div class="container text-center">
              {section.eyebrow && (
                <div class="yc-btn text-muted-foreground mx-auto mb-6 flex w-fit max-w-full items-center justify-center px-4 py-2 text-sm sm:mb-8 sm:text-base">
                  {text(section.eyebrow)}
                </div>
              )}
              <h1 class="text-h2 sm:text-h1 mx-auto mb-6 max-w-5xl overflow-hidden text-center font-medium text-balance sm:mb-8">
                <span class={animated ? "animate-perspective-in block" : "block"}>{text(section.title)}</span>
                {section.highlight && (
                  <span class={animated ? "animate-perspective-in block delay-50" : "block"}> {text(section.highlight)} </span>
                )}
              </h1>
              {section.description && (
                <p class="text-muted-foreground mx-auto mb-8 max-w-3xl text-center text-lg text-balance">
                  {text(section.description)}
                </p>
              )}
              {(section.primaryCta || section.secondaryCta) && (
                <div class="mb-10 flex flex-col items-stretch justify-center gap-3 sm:flex-row sm:items-center">
                  {section.primaryCta && (
                    <Button size="lg" href={href(section.primaryCta.href)} variant={section.primaryCta.style === "secondary" ? "secondary" : undefined}>
                      {text(section.primaryCta.label)}
                    </Button>
                  )}
                  {section.secondaryCta && (
                    <Button size="lg" href={href(section.secondaryCta.href)} variant="secondary">
                      {text(section.secondaryCta.label)}
                    </Button>
                  )}
                </div>
              )}
              {section.badges?.length > 0 && (
                <div class="mb-8 flex flex-wrap justify-center gap-2">
                  {section.badges.map((badge: any) => (
                    <span class="rounded-full border px-3 py-1.5 text-sm">{text(badge)}</span>
                  ))}
                </div>
              )}
              {section.media?.videoUrl && (
                <video class="mx-auto mt-8 w-full max-w-5xl rounded-2xl border" controls playsinline preload="metadata">
                  <source src={section.media.videoUrl} />
                </video>
              )}
              {!section.media?.videoUrl && mediaUrl && (
                <img class="mx-auto mt-8 max-h-[680px] w-full max-w-5xl rounded-2xl border object-cover" src={mediaUrl} alt={text(section.media.alt)} loading="eager" decoding="async" />
              )}
              {section.showFrameworkBadges && (
                <Badges count={10} countMobile={6} client:load border class="mx-auto mt-10 grid max-w-[960px] grid-cols-3 sm:grid-cols-5" />
              )}
              {section.showReferenceLogos && (
                <div class="mt-10 mix-blend-multiply"><Logos constrained /></div>
              )}
            </div>
          </Wrapper>
        );
      }

      if (section._type === "richTextSection") {
        return (
          <section id={section.anchorId || undefined} class:list={sectionClasses(section)}>
            <div class:list={["container", widthClass[section.width] ?? widthClass.normal]}>
              {section.eyebrow && <p class="text-muted-foreground mb-3 text-sm font-medium">{text(section.eyebrow)}</p>}
              {section.title && <h2 class="text-h3 sm:text-h2 mb-7 font-medium">{text(section.title)}</h2>}
              <div class="cms-rich-text" set:html={portableTextToHtml(text(section.body), locale)} />
            </div>
          </section>
        );
      }

      if (section._type === "featureGridSection") {
        return (
          <section id={section.anchorId || undefined} class:list={sectionClasses(section)}>
            <div class="container">
              {section.eyebrow && <p class="text-muted-foreground mb-3 text-center text-sm font-medium">{text(section.eyebrow)}</p>}
              {section.title && <h2 class="text-h3 sm:text-h2 mb-3 text-center font-medium">{text(section.title)}</h2>}
              {section.description && <p class="text-muted-foreground mx-auto mb-10 max-w-3xl text-center text-lg">{text(section.description)}</p>}
              <div class:list={["grid gap-4 sm:gap-6", columnClass[section.columns] ?? columnClass[3]]}>
                {(section.items ?? []).map((item: any) => (
                  <article class:list={["rounded-2xl p-6", section.variant === "plain" ? "" : "border", section.variant === "panel" && "bg-subtle"]}>
                    {item.icon && <div class="text-muted-foreground mb-4 text-xs font-semibold uppercase tracking-wide">{item.icon}</div>}
                    <h3 class="mb-2 text-lg font-semibold">{text(item.title)}</h3>
                    <p class="text-muted-foreground leading-relaxed">{text(item.description)}</p>
                    {item.link && <a class="mt-4 inline-flex font-medium underline-offset-4 hover:underline" href={href(item.link.href)}>{text(item.link.label)}</a>}
                  </article>
                ))}
              </div>
            </div>
          </section>
        );
      }

      if (section._type === "mediaSection") {
        const mediaUrl = image(section.media?.image);
        const posterUrl = image(section.poster);
        const mediaFirst = section.variant === "media-left";
        return (
          <section id={section.anchorId || undefined} class:list={sectionClasses(section)}>
            <div class:list={["container grid items-center gap-8 sm:gap-14", section.variant === "full-width" ? "" : "lg:grid-cols-2"]}>
              <div class:list={[mediaFirst ? "lg:order-2" : ""]}>
                {section.eyebrow && <p class="text-muted-foreground mb-3 text-sm font-medium">{text(section.eyebrow)}</p>}
                {section.title && <h2 class="text-h3 sm:text-h2 mb-5 font-medium">{text(section.title)}</h2>}
                {section.body && <div class="cms-rich-text" set:html={portableTextToHtml(text(section.body), locale)} />}
                {section.cta && <a class="mt-6 inline-flex font-medium underline-offset-4 hover:underline" href={href(section.cta.href)}>{text(section.cta.label)}</a>}
              </div>
              <div class:list={["overflow-hidden rounded-2xl", mediaFirst ? "lg:order-1" : ""]}>
                {section.media?.videoUrl ? (
                  <video class="w-full" controls playsinline preload="metadata" poster={posterUrl}><source src={section.media.videoUrl} /></video>
                ) : mediaUrl ? (
                  <img class="w-full object-cover" src={mediaUrl} alt={text(section.media.alt)} loading="lazy" decoding="async" />
                ) : null}
              </div>
            </div>
          </section>
        );
      }

      if (section._type === "mediaGridSection") {
        return (
          <section id={section.anchorId || undefined} class:list={sectionClasses(section)}>
            <div class="container">
              {section.title && <h2 class="text-h3 sm:text-h2 mb-3 text-center font-medium">{text(section.title)}</h2>}
              {section.description && <p class="text-muted-foreground mx-auto mb-10 max-w-3xl text-center text-lg">{text(section.description)}</p>}
              <div class:list={["grid gap-10", section.columns === 3 ? "lg:grid-cols-3" : "sm:grid-cols-2"]}>
                {(section.items ?? []).map((item: any) => {
                  const mediaUrl = image(item.media?.image);
                  const posterUrl = image(item.poster);
                  return (
                    <article>
                      {(item.media?.videoUrl || mediaUrl) && (
                        <div class="mb-5 overflow-hidden rounded-2xl border">
                          {item.media?.videoUrl ? <video class="w-full" muted loop playsinline controls preload="metadata" poster={posterUrl}><source src={item.media.videoUrl} /></video> : <img class="w-full" src={mediaUrl} alt={text(item.media?.alt)} loading="lazy" decoding="async" />}
                        </div>
                      )}
                      <h3 class="mb-2 text-xl font-semibold">{text(item.title)}</h3>
                      <div class="cms-rich-text text-muted-foreground" set:html={portableTextToHtml(text(item.body), locale)} />
                      {item.link && <a class="mt-4 inline-flex font-medium underline-offset-4 hover:underline" href={href(item.link.href)}>{text(item.link.label)}</a>}
                    </article>
                  );
                })}
              </div>
            </div>
          </section>
        );
      }

      if (section._type === "statsSection") {
        return (
          <section id={section.anchorId || undefined} class:list={sectionClasses(section)}>
            <div class="container">
              {section.title && <h2 class="text-h3 sm:text-h2 mb-10 text-center font-medium">{text(section.title)}</h2>}
              <div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-4">
                {(section.items ?? []).map((item: any) => (
                  <div class="rounded-2xl border p-6 text-center">
                    <div class="text-h3 mb-2 font-semibold">{item.value}</div>
                    <div class="font-medium">{text(item.label)}</div>
                    {item.detail && <div class="text-muted-foreground mt-1 text-sm">{text(item.detail)}</div>}
                  </div>
                ))}
              </div>
            </div>
          </section>
        );
      }

      if (section._type === "logoCloudSection") {
        return (
          <section id={section.anchorId || undefined} class:list={sectionClasses(section)}>
            <div class="container">
              {section.title && <h2 class="text-muted-foreground mb-8 text-center font-medium">{text(section.title)}</h2>}
              <div class="flex flex-wrap items-center justify-center gap-8 sm:gap-12">
                {(section.logos ?? []).map((logo: any) => {
                  const src = image(logo.logo);
                  const body = src ? <img class="max-h-10 max-w-36 object-contain" src={src} alt={logo.name} loading="lazy" decoding="async" /> : null;
                  return logo.url ? <a href={logo.url} target="_blank" rel="noopener noreferrer">{body}</a> : body;
                })}
              </div>
            </div>
          </section>
        );
      }

      if (section._type === "testimonialsSection") {
        return (
          <section id={section.anchorId || undefined} class:list={sectionClasses(section)}>
            <div class="container">
              {section.title && <h2 class="text-h3 sm:text-h2 mb-10 text-center font-medium">{text(section.title)}</h2>}
              <div class="grid gap-5 lg:grid-cols-3">
                {(section.items ?? []).map((item: any) => (
                  <figure class="rounded-2xl border p-6">
                    <blockquote class="text-lg leading-relaxed">“{text(item.quote)}”</blockquote>
                    <figcaption class="text-muted-foreground mt-5 text-sm">{[item.name, text(item.role), item.company].filter(Boolean).join(" · ")}</figcaption>
                  </figure>
                ))}
              </div>
            </div>
          </section>
        );
      }

      if (section._type === "comparisonTableSection") {
        return (
          <section id={section.anchorId || undefined} class:list={sectionClasses(section)}>
            <div class="container overflow-x-auto">
              {section.title && <h2 class="text-h3 sm:text-h2 mb-3 font-medium">{text(section.title)}</h2>}
              {section.description && <p class="text-muted-foreground mb-8 max-w-3xl text-lg">{text(section.description)}</p>}
              <table class="w-full min-w-[720px] border-collapse text-left">
                <thead><tr class="border-b">{(section.columns ?? []).map((column: any) => <th class="p-4 font-medium">{text(column)}</th>)}</tr></thead>
                <tbody>{(section.rows ?? []).map((row: any) => <tr class="border-b"><th class="p-4 font-medium">{text(row.label)}</th>{(row.values ?? []).map((value: any) => <td class="text-muted-foreground p-4">{text(value)}</td>)}</tr>)}</tbody>
              </table>
            </div>
          </section>
        );
      }

      if (section._type === "cardGridSection") {
        return (
          <section id={section.anchorId || undefined} class:list={sectionClasses(section)}>
            <div class="container">
              {section.title && <h2 class="text-h3 sm:text-h2 mb-3 text-center font-medium">{text(section.title)}</h2>}
              {section.description && <p class="text-muted-foreground mx-auto mb-10 max-w-3xl text-center text-lg">{text(section.description)}</p>}
              <div class:list={["grid gap-4 sm:gap-6", columnClass[section.columns] ?? columnClass[3]]}>
                {(section.cards ?? []).map((card: any) => {
                  const cardImage = image(card.media?.image);
                  return (
                    <article class:list={["overflow-hidden rounded-2xl p-6", section.variant === "plain" ? "" : "border", section.variant === "subtle" && "bg-subtle"]}>
                      {cardImage && <img class="mb-5 aspect-[16/9] w-full rounded-xl object-cover" src={cardImage} alt={text(card.media?.alt)} loading="lazy" decoding="async" />}
                      {card.eyebrow && <div class="text-muted-foreground mb-2 text-sm font-medium">{text(card.eyebrow)}</div>}
                      <h3 class="mb-2 text-xl font-semibold">{text(card.title)}</h3>
                      {card.description && <p class="text-muted-foreground leading-relaxed">{text(card.description)}</p>}
                      {card.tags?.length > 0 && <div class="mt-4 flex flex-wrap gap-2">{card.tags.map((tag: string) => <span class="rounded-full border px-2.5 py-1 text-xs">{tag}</span>)}</div>}
                      {card.link && <a class="mt-5 inline-flex font-medium underline-offset-4 hover:underline" href={href(card.link.href)}>{text(card.link.label)}</a>}
                    </article>
                  );
                })}
              </div>
            </div>
          </section>
        );
      }

      if (section._type === "stepsSection") {
        return (
          <section id={section.anchorId || undefined} class:list={sectionClasses(section)}>
            <div class="container">
              {section.title && <h2 class="text-h3 sm:text-h2 mb-3 font-medium">{text(section.title)}</h2>}
              {section.description && <p class="text-muted-foreground mb-10 max-w-3xl text-lg">{text(section.description)}</p>}
              <ol class="grid gap-4 lg:grid-cols-3">
                {(section.steps ?? []).map((step: any, index: number) => (
                  <li class="rounded-2xl border p-6">
                    <div class="text-muted-foreground mb-4 text-sm font-semibold">{String(index + 1).padStart(2, "0")}</div>
                    <h3 class="mb-2 text-xl font-semibold">{text(step.title)}</h3>
                    <p class="text-muted-foreground leading-relaxed">{text(step.description)}</p>
                    {step.link && <a class="mt-4 inline-flex font-medium underline-offset-4 hover:underline" href={href(step.link.href)}>{text(step.link.label)}</a>}
                  </li>
                ))}
              </ol>
            </div>
          </section>
        );
      }

      if (section._type === "pricingSection") {
        return (
          <section id={section.anchorId || undefined} class:list={sectionClasses(section)}>
            <div class="container">
              {section.title && <h2 class="text-h3 sm:text-h2 mb-3 text-center font-medium">{text(section.title)}</h2>}
              {section.description && <p class="text-muted-foreground mx-auto mb-10 max-w-3xl text-center text-lg">{text(section.description)}</p>}
              <div class="grid gap-5 lg:grid-cols-3">
                {(section.plans ?? []).map((plan: any) => (
                  <article class:list={["rounded-2xl border p-6", plan.highlighted && "bg-secondary ring-1 ring-current"]}>
                    <h3 class="text-xl font-semibold">{text(plan.name)}</h3>
                    <div class="mt-3 text-3xl font-semibold">{text(plan.price)}</div>
                    {plan.description && <p class="text-muted-foreground mt-3">{text(plan.description)}</p>}
                    {plan.features?.length > 0 && <ul class="mt-6 space-y-2">{plan.features.map((feature: any) => <li>✓ {text(feature)}</li>)}</ul>}
                    {plan.cta && <div class="mt-7"><Button href={href(plan.cta.href)} variant={plan.highlighted ? undefined : "secondary"}>{text(plan.cta.label)}</Button></div>}
                  </article>
                ))}
              </div>
            </div>
          </section>
        );
      }

      if (section._type === "faqSection") {
        return (
          <section id={section.anchorId || undefined} class:list={sectionClasses(section)}>
            <div class="container max-w-5xl">
              {section.title && <h2 class="text-h3 sm:text-h2 mb-3 text-center font-medium">{text(section.title)}</h2>}
              {section.description && <p class="text-muted-foreground mx-auto mb-8 max-w-3xl text-center text-lg">{text(section.description)}</p>}
              <div class="divide-y border-y">
                {(section.items ?? []).map((item: any) => (
                  <details class="group py-5">
                    <summary class="cursor-pointer list-none pr-8 text-lg font-medium">{text(item.question)}</summary>
                    <div class="cms-rich-text text-muted-foreground mt-4" set:html={portableTextToHtml(text(item.answer), locale)} />
                  </details>
                ))}
              </div>
            </div>
          </section>
        );
      }

      if (section._type === "ctaSection") {
        return (
          <section id={section.anchorId || undefined} class:list={sectionClasses(section)}>
            <div class="container">
              <div class:list={["mx-auto max-w-5xl rounded-3xl border p-7 text-center sm:p-12", section.variant === "banner" && "max-w-none"]}>
                <h2 class="text-h3 sm:text-h2 font-medium">{text(section.title)}</h2>
                {section.description && <p class="text-muted-foreground mx-auto mt-3 max-w-3xl text-lg">{text(section.description)}</p>}
                <div class="mt-7 flex flex-col justify-center gap-3 sm:flex-row">
                  <Button href={href(section.primaryCta.href)}>{text(section.primaryCta.label)}</Button>
                  {section.secondaryCta && <Button href={href(section.secondaryCta.href)} variant="secondary">{text(section.secondaryCta.label)}</Button>}
                </div>
              </div>
            </div>
          </section>
        );
      }

      if (section._type === "siteBlockSection") {
        return (
          <section id={section.anchorId || undefined} class:list={sectionClasses(section)}>
            {section.title && <div class="container mb-8 text-center"><h2 class="text-h3 sm:text-h2 font-medium">{text(section.title)}</h2>{section.description && <p class="text-muted-foreground mx-auto mt-3 max-w-3xl text-lg">{text(section.description)}</p>}</div>}
            {section.component === "complianceTrack" && <ComplianceTrack />}
            {section.component === "badges" && <div class="container"><Badges count={section.count ?? 10} countMobile={section.countMobile ?? 6} client:load border={section.border} class="mx-auto grid max-w-[960px] grid-cols-3 sm:grid-cols-5" /></div>}
            {section.component === "frameworks" && <Frameworks />}
            {section.component === "logos" && <div class="container"><Logos constrained={section.constrained} /></div>}
            {section.component === "stories" && <Stories />}
            {section.component === "zebrabyteTestimonials" && <ZebraByteTestimonials />}
            {section.component === "testimonials" && <Testimonials />}
            {section.component === "newsletter" && <div class="container max-w-3xl"><Newsletter /></div>}
          </section>
        );
      }

      return null;
    })
  }
</main>

<script>
  import { customElementDefine } from "../../lib/dom";
  import { AnimatedHero } from "../../lib/elements/hero";
  customElementDefine("animated-hero", () => AnimatedHero);
</script>

<style>
  .cms-rich-text :global(p) { margin-top: 1rem; line-height: 1.75; }
  .cms-rich-text :global(p:first-child) { margin-top: 0; }
  .cms-rich-text :global(h2) { margin-top: 2.5rem; margin-bottom: .75rem; font-size: clamp(1.75rem, 3vw, 2.5rem); font-weight: 600; line-height: 1.15; }
  .cms-rich-text :global(h3) { margin-top: 2rem; margin-bottom: .75rem; font-size: 1.5rem; font-weight: 600; }
  .cms-rich-text :global(h4) { margin-top: 1.5rem; margin-bottom: .5rem; font-size: 1.2rem; font-weight: 600; }
  .cms-rich-text :global(ul), .cms-rich-text :global(ol) { margin-top: 1rem; padding-left: 1.5rem; }
  .cms-rich-text :global(ul) { list-style: disc; }
  .cms-rich-text :global(ol) { list-style: decimal; }
  .cms-rich-text :global(li) { margin-top: .45rem; }
  .cms-rich-text :global(blockquote) { margin: 1.5rem 0; border-left: 2px solid currentColor; padding-left: 1rem; font-style: italic; }
  .cms-rich-text :global(a) { text-decoration: underline; text-underline-offset: 3px; }
  .cms-rich-text :global(code) { border-radius: .35rem; background: var(--color-subtle); padding: .1rem .3rem; font-size: .9em; }
  .cms-rich-text :global(figure) { margin: 2rem 0; }
  .cms-rich-text :global(img) { width: 100%; border-radius: 1rem; }
  .cms-rich-text :global(figcaption) { margin-top: .5rem; color: var(--color-muted-foreground); font-size: .875rem; }
</style>
