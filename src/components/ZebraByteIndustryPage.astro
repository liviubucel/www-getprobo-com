---
import Button from "./ui/Button.svelte";
import type { ZebraByteIndustry } from "../content/zebrabyte-industries";
import { industryServiceMeta } from "../content/zebrabyte-industries";
import { getIndustryEditorial } from "../content/zebrabyte-industry-editorial";

interface Props {
  industry: ZebraByteIndustry;
}

const { industry } = Astro.props;
const editorial = getIndustryEditorial(industry.slug);
if (!editorial) throw new Error(`Missing adapted industry editorial content for ${industry.slug}`);

const services = Object.entries(industry.serviceSlugs)
  .filter(([key]) => key !== "maintenance")
  .map(([key, slug]) => ({
    key,
    slug,
    meta: industryServiceMeta[key as keyof typeof industryServiceMeta],
    href: key === "hosting" ? "/secure-hosting" : `/${slug}`,
  }));
---

<animated-hero class="relative -mt-16 block overflow-hidden px-5 py-10 pt-26 sm:pt-36 sm:pb-12">
  <a
    href="/industries"
    class="text-muted-foreground animate-perspective-in animation-delay-300 mx-auto mb-6 block w-max rounded-lg border px-4 py-2 text-sm font-medium hover:underline sm:mb-8"
  >
    Industrii · {industry.shortTitle}
  </a>

  <h1 class="text-h2 sm:text-h1 mb-6 overflow-hidden text-center font-medium text-balance sm:mb-8">
    <span class="animate-perspective-in block">{industry.title}</span>
  </h1>

  <p class="text-muted-foreground animate-perspective-in animation-delay-150 mx-auto mb-6 max-w-200 text-center text-lg text-balance sm:mb-8">
    {industry.description}
  </p>

  <div class="mb-11 flex flex-col items-stretch justify-center gap-3 sm:mb-17 sm:flex-row sm:items-center">
    <Button class="animate-perspective-in animation-delay-200" variant="secondary" size="lg" href="/security-assessment">
      Începe cu un assessment
    </Button>
    <Button class="animate-perspective-in animation-delay-300" size="lg" href="/contact">
      Discută cu un expert
    </Button>
  </div>
</animated-hero>

<section class="container pb-12 sm:pb-24">
  <div class="grid gap-12 lg:grid-cols-[1.15fr_0.85fr] lg:gap-24">
    <div>
      <p class="text-muted-foreground mb-3 text-sm font-medium uppercase tracking-wide">Context</p>
      <h2 class="text-h3 sm:text-h2 mb-5 font-medium">Security trebuie să reflecte modul în care funcționează organizația.</h2>
      <div class="text-muted-foreground space-y-5 text-lg leading-relaxed">
        <p>{industry.context}</p>
        <p>{editorial.intro}</p>
      </div>
    </div>

    <aside class="border-t pt-6 lg:mt-2">
      <p class="text-muted-foreground mb-6 text-sm font-medium uppercase tracking-wide">Priorități în acest sector</p>
      <div class="divide-y border-y">
        {industry.priorities.map((priority, index) => (
          <div class="grid grid-cols-[42px_1fr] gap-4 py-4">
            <span class="text-muted-foreground font-mono text-xs">{String(index + 1).padStart(2, "0")}</span>
            <span class="font-medium">{priority}</span>
          </div>
        ))}
      </div>
    </aside>
  </div>
</section>

<section class="bg-level-3 py-12 text-level-0-foreground sm:py-24">
  <div class="container">
    <div class="mb-12 max-w-3xl sm:mb-16">
      <p class="text-level-0-foreground/55 mb-3 text-sm font-medium uppercase tracking-wide">Risk surface</p>
      <h2 class="text-h3 sm:text-h2 mb-4 font-medium">Riscul sectorului se vede în operațiuni, nu într-un checklist generic.</h2>
      <p class="text-level-0-foreground/65 text-lg leading-relaxed">
        Prioritizăm expunerea după impactul asupra datelor, identității, disponibilității și relațiilor cu furnizorii din {industry.shortTitle}.
      </p>
    </div>

    <div class="grid gap-x-14 sm:grid-cols-2 lg:gap-x-24">
      {industry.risks.map((risk, index) => (
        <article class="border-t border-level-0-foreground/15 py-8">
          <span class="text-level-0-foreground/40 mb-7 block font-mono text-sm">{String(index + 1).padStart(2, "0")}</span>
          <p class="text-h4 max-w-xl font-medium leading-snug">{risk}</p>
        </article>
      ))}
    </div>
  </div>
</section>

<section class="container py-12 sm:py-24">
  <div class="grid gap-14 lg:grid-cols-[0.7fr_1.3fr] lg:gap-24">
    <div class="lg:sticky lg:top-28 lg:self-start">
      <p class="text-muted-foreground mb-3 text-sm font-medium uppercase tracking-wide">Focus areas</p>
      <h2 class="text-h3 sm:text-h2 mb-5 font-medium">Ce merită protejat cu prioritate.</h2>
      <p class="text-muted-foreground text-lg leading-relaxed">
        Nu redenumim același pachet pentru fiecare industrie. Focus-ul pornește din operațiunile și datele care fac riscul diferit aici.
      </p>
    </div>

    <div class="grid gap-x-10 sm:grid-cols-2">
      {editorial.focusAreas.map((area, index) => (
        <article class="border-t py-7 sm:py-8">
          <span class="text-muted-foreground mb-7 block font-mono text-sm">{String(index + 1).padStart(2, "0")}</span>
          <h3 class="text-h4 mb-3 font-medium">{area.title}</h3>
          <p class="text-muted-foreground leading-relaxed">{area.description}</p>
        </article>
      ))}
    </div>
  </div>
</section>

<section class="bg-active py-12 sm:py-24">
  <div class="container">
    <div class="mx-auto mb-12 max-w-190 text-center sm:mb-16">
      <p class="text-muted-foreground mb-3 text-sm font-medium uppercase tracking-wide">Capability handoff</p>
      <h2 class="text-h3 sm:text-h2 mb-4 font-medium">Security și compliance conectate la același risc.</h2>
      <p class="text-muted-foreground text-lg leading-relaxed">
        Folosim doar capabilitățile care reduc riscul sau susțin cerințe reale. Nu este necesar să schimbi furnizori sau să cumperi întregul program pentru a începe.
      </p>
    </div>

    <div class="mx-auto max-w-5xl border-y">
      <a href="/managed-compliance" class="group grid gap-4 border-b py-7 sm:grid-cols-[0.7fr_1.3fr] sm:gap-12">
        <div>
          <p class="text-muted-foreground mb-2 text-sm">Compliance</p>
          <h3 class="text-h4 font-medium group-hover:underline group-hover:underline-offset-4">Managed Compliance</h3>
        </div>
        <p class="text-muted-foreground text-lg leading-relaxed">Risk, controls, evidence și audit readiness gestionate într-un program continuu.</p>
      </a>

      {services.map(({ href, meta }) => (
        <a href={href} class="group grid gap-4 border-b py-7 last:border-b-0 sm:grid-cols-[0.7fr_1.3fr] sm:gap-12">
          <div>
            <p class="text-muted-foreground mb-2 text-sm">{meta.eyebrow}</p>
            <h3 class="text-h4 font-medium group-hover:underline group-hover:underline-offset-4">{meta.label}</h3>
          </div>
          <p class="text-muted-foreground text-lg leading-relaxed">{meta.description}</p>
        </a>
      ))}
    </div>
  </div>
</section>

<section class="container py-12 sm:py-24">
  <div class="grid gap-14 lg:grid-cols-[0.9fr_1.1fr] lg:items-start lg:gap-24">
    <div>
      <p class="text-muted-foreground mb-3 text-sm font-medium uppercase tracking-wide">Integrated program</p>
      <h2 class="text-h3 sm:text-h2 mb-5 font-medium">{editorial.partner.title}</h2>
      <p class="text-muted-foreground text-lg leading-relaxed">{editorial.partner.description}</p>
    </div>

    <div class="space-y-0">
      {editorial.partner.points.map((point, index) => (
        <div class="grid grid-cols-[52px_1fr] gap-5 border-t py-6">
          <span class="text-muted-foreground font-mono text-sm">{String(index + 1).padStart(2, "0")}</span>
          <p class="text-lg font-medium leading-relaxed">{point}</p>
        </div>
      ))}
    </div>
  </div>
</section>

<section class="bg-level-3 py-12 text-level-0-foreground sm:py-24">
  <div class="container">
    <div class="mb-12 max-w-3xl sm:mb-16">
      <p class="text-level-0-foreground/55 mb-3 text-sm font-medium uppercase tracking-wide">Outcomes</p>
      <h2 class="text-h3 sm:text-h2 mb-4 font-medium">Ce trebuie să rămână după proiect.</h2>
      <p class="text-level-0-foreground/65 text-lg leading-relaxed">
        Nu urmărim doar livrarea unor documente. Scopul este o postură tehnică și operațională care poate fi menținută, verificată și demonstrată.
      </p>
    </div>

    <div class="grid gap-x-14 sm:grid-cols-2 lg:gap-x-24">
      {industry.outcomes.map((outcome, index) => (
        <article class="border-t border-level-0-foreground/15 py-8">
          <span class="text-level-0-foreground/40 mb-7 block font-mono text-sm">{String(index + 1).padStart(2, "0")}</span>
          <p class="text-h4 max-w-xl font-medium leading-snug">{outcome}</p>
        </article>
      ))}
    </div>
  </div>
</section>

<section class="container py-12 sm:py-24">
  <div class="grid gap-12 lg:grid-cols-[0.7fr_1.3fr] lg:gap-24">
    <div>
      <p class="text-muted-foreground mb-3 text-sm font-medium uppercase tracking-wide">FAQ</p>
      <h2 class="text-h3 sm:text-h2 font-medium">Întrebări frecvente pentru {industry.shortTitle}</h2>
    </div>

    <div class="border-y">
      {editorial.faqs.map((faq) => (
        <details class="group border-b py-5 last:border-b-0 sm:py-6">
          <summary class="flex cursor-pointer list-none items-start justify-between gap-6 font-medium">
            <span>{faq.question}</span>
            <span class="text-muted-foreground text-xl transition-transform group-open:rotate-45" aria-hidden="true">+</span>
          </summary>
          <p class="text-muted-foreground max-w-190 pt-4 leading-relaxed">{faq.answer}</p>
        </details>
      ))}
    </div>
  </div>
</section>

<section class="container py-12 text-center sm:py-24">
  <h2 class="text-h3 sm:text-h2 mx-auto mb-4 max-w-190 font-medium text-balance">Security, compliance și infrastructură într-un singur program.</h2>
  <p class="text-muted-foreground mx-auto mb-8 max-w-170 text-lg">
    Putem începe cu un assessment punctual, fără obligația de a schimba furnizorii existenți, sau putem prelua implementarea și operarea măsurilor rezultate.
  </p>
  <Button href="/contact" size="lg">Discută despre {industry.shortTitle}</Button>
</section>

<script>
  import { AnimatedHero } from "../lib/elements/hero";
  import { customElementDefine } from "../lib/dom";
  customElementDefine("animated-hero", () => AnimatedHero);
</script>
