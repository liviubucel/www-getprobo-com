---
import Button from "./ui/Button.svelte";
import type { ZebraByteIndustry } from "../content/zebrabyte-industries";
import { industryServiceMeta } from "../content/zebrabyte-industries";
import { getIndustryEditorial } from "../content/zebrabyte-industry-editorial";

interface Props {
  industry: ZebraByteIndustry;
}

const { industry } = Astro.props;
const editorial = getIndustryEditorial(industry.slug);
if (!editorial) throw new Error(`Missing adapted industry editorial content for ${industry.slug}`);

const services = Object.entries(industry.serviceSlugs)
  .filter(([key]) => key !== "maintenance")
  .map(([key, slug]) => ({
    key,
    slug,
    meta: industryServiceMeta[key as keyof typeof industryServiceMeta],
    href: key === "hosting" ? "/secure-hosting" : `/${slug}`,
  }));
---

<animated-hero
  class="relative -mt-16 block overflow-hidden px-5 py-10 pt-26 sm:pt-36 sm:pb-12"
>
  <a
    href="/industries"
    class="text-muted-foreground animate-perspective-in animation-delay-300 mx-auto mb-6 block w-max rounded-lg border px-4 py-2 text-sm font-medium hover:underline sm:mb-8"
  >
    Industrii · {industry.shortTitle}
  </a>

  <h1
    class="text-h2 sm:text-h1 mb-6 overflow-hidden text-center font-medium text-balance sm:mb-8"
  >
    <span class="animate-perspective-in block">{industry.title}</span>
  </h1>

  <p
    class="text-muted-foreground animate-perspective-in animation-delay-150 mx-auto mb-6 max-w-200 text-center text-lg text-balance sm:mb-8"
  >
    {industry.description}
  </p>

  <div
    class="mb-10 flex flex-col items-stretch justify-center gap-3 sm:flex-row sm:items-center"
  >
    <Button
      class="animate-perspective-in animation-delay-200"
      variant="secondary"
      size="lg"
      href="/security-assessment"
    >
      Începe cu un assessment
    </Button>
    <Button
      class="animate-perspective-in animation-delay-300"
      size="lg"
      href="/contact"
    >
      Discută cu un expert
    </Button>
  </div>
</animated-hero>

<section class="container py-10 sm:py-20">
  <div class="mx-auto max-w-4xl">
    <p class="text-muted-foreground mb-3 text-sm font-medium uppercase tracking-[0.12em]">
      Context
    </p>
    <h2 class="text-h3 sm:text-h2 mb-5 font-medium">
      Security trebuie să reflecte modul în care funcționează organizația.
    </h2>
    <div class="text-muted-foreground space-y-5 text-lg leading-relaxed">
      <p>{industry.context}</p>
      <p>{editorial.intro}</p>
    </div>
    <p class="text-muted-foreground mt-8 text-sm leading-relaxed">
      <span class="font-medium text-foreground">Priorități:</span>
      {" "}{industry.priorities.join(" · ")}
    </p>
  </div>
</section>

<section class="bg-active py-10 sm:py-20">
  <div class="container">
    <div class="mx-auto mb-10 max-w-180 text-center sm:mb-14">
      <h2 class="text-h3 sm:text-h2 mb-3 font-medium">
        Suprafața de risc în {industry.shortTitle}
      </h2>
      <p class="text-muted-foreground text-lg">
        Nu toate riscurile au aceeași prioritate. Contextul sectorului ne ajută să separăm
        expunerea relevantă de controalele care doar arată bine într-un checklist.
      </p>
    </div>

    <div class="mx-auto max-w-5xl border-y">
      {industry.risks.map((risk, index) => (
        <div class="grid gap-3 border-b py-6 last:border-b-0 sm:grid-cols-[64px_1fr] sm:gap-8">
          <span class="text-muted-foreground font-mono text-sm">0{index + 1}</span>
          <p class="text-lg leading-relaxed">{risk}</p>
        </div>
      ))}
    </div>
  </div>
</section>

<section class="container py-10 sm:py-20">
  <div class="mx-auto mb-10 max-w-180 text-center sm:mb-14">
    <h2 class="text-h3 sm:text-h2 mb-3 font-medium">
      Ce merită protejat cu prioritate
    </h2>
    <p class="text-muted-foreground text-lg">
      Focus-ul se construiește în jurul operațiunilor, datelor și dependențelor specifice
      sectorului, nu prin redenumirea unui pachet generic.
    </p>
  </div>

  <div class="mx-auto max-w-5xl border-y">
    {editorial.focusAreas.map((area, index) => (
      <article class="grid gap-3 border-b py-7 last:border-b-0 sm:grid-cols-[64px_0.75fr_1.25fr] sm:gap-8">
        <span class="text-muted-foreground font-mono text-sm">0{index + 1}</span>
        <h3 class="text-h5 font-medium">{area.title}</h3>
        <p class="text-muted-foreground leading-relaxed">{area.description}</p>
      </article>
    ))}
  </div>
</section>

<section class="bg-active py-10 sm:py-20">
  <div class="container">
    <div class="mx-auto mb-10 max-w-180 text-center sm:mb-14">
      <h2 class="text-h3 sm:text-h2 mb-3 font-medium">
        Security și compliance conectate la același risc
      </h2>
      <p class="text-muted-foreground text-lg">
        Putem combina assessment, controls, evidence, application security, email identity
        și managed infrastructure doar acolo unde reduc riscul sau susțin cerințele reale ale
        organizației.
      </p>
    </div>

    <div class="mx-auto max-w-5xl border-y">
      <a
        href="/managed-compliance"
        class="group grid gap-3 border-b py-6 sm:grid-cols-[0.65fr_1.35fr] sm:gap-10"
      >
        <div>
          <p class="text-muted-foreground mb-2 text-sm">Compliance</p>
          <h3 class="text-h5 font-medium group-hover:underline group-hover:underline-offset-4">
            Managed Compliance
          </h3>
        </div>
        <p class="text-muted-foreground leading-relaxed">
          Risk, controls, evidence și audit readiness gestionate într-un program continuu.
        </p>
      </a>
      {services.map(({ href, meta }) => (
        <a
          href={href}
          class="group grid gap-3 border-b py-6 last:border-b-0 sm:grid-cols-[0.65fr_1.35fr] sm:gap-10"
        >
          <div>
            <p class="text-muted-foreground mb-2 text-sm">{meta.eyebrow}</p>
            <h3 class="text-h5 font-medium group-hover:underline group-hover:underline-offset-4">
              {meta.label}
            </h3>
          </div>
          <p class="text-muted-foreground leading-relaxed">{meta.description}</p>
        </a>
      ))}
    </div>
  </div>
</section>

<section class="container py-10 sm:py-20">
  <div class="grid gap-12 lg:grid-cols-[0.85fr_1.15fr] lg:gap-20">
    <div>
      <p class="text-muted-foreground mb-3 text-sm font-medium uppercase tracking-[0.12em]">
        Program integrat
      </p>
      <h2 class="text-h3 sm:text-h2 mb-5 font-medium">{editorial.partner.title}</h2>
      <p class="text-muted-foreground text-lg leading-relaxed">{editorial.partner.description}</p>
    </div>
    <div class="border-y">
      {editorial.partner.points.map((point, index) => (
        <div class="grid grid-cols-[48px_1fr] gap-4 border-b py-5 last:border-b-0 sm:py-6">
          <span class="text-muted-foreground font-mono text-sm">0{index + 1}</span>
          <p class="font-medium leading-relaxed">{point}</p>
        </div>
      ))}
    </div>
  </div>
</section>

<section class="bg-active py-10 sm:py-20">
  <div class="container grid gap-12 lg:grid-cols-2 lg:gap-20">
    <div>
      <p class="text-muted-foreground mb-3 text-sm font-medium uppercase tracking-[0.12em]">
        Rezultate
      </p>
      <h2 class="text-h3 sm:text-h2 mb-5 font-medium">
        Ce trebuie să rămână după proiect
      </h2>
      <p class="text-muted-foreground text-lg leading-relaxed">
        Nu urmărim doar livrarea unor documente. Scopul este o postură tehnică și
        operațională mai clară, care poate fi menținută, verificată și demonstrată.
      </p>
    </div>
    <div class="border-y">
      {industry.outcomes.map((outcome, index) => (
        <div class="grid grid-cols-[48px_1fr] gap-4 border-b py-5 last:border-b-0 sm:py-6">
          <span class="text-muted-foreground font-mono text-sm">0{index + 1}</span>
          <p class="font-medium leading-relaxed">{outcome}</p>
        </div>
      ))}
    </div>
  </div>
</section>

<section class="container py-10 sm:py-20">
  <div class="grid gap-10 lg:grid-cols-[0.75fr_1.25fr] lg:gap-20">
    <div>
      <p class="text-muted-foreground mb-3 text-sm font-medium uppercase tracking-[0.12em]">
        FAQ
      </p>
      <h2 class="text-h3 sm:text-h2 font-medium">
        Întrebări frecvente pentru {industry.shortTitle}
      </h2>
    </div>
    <div class="border-y">
      {editorial.faqs.map((faq) => (
        <details class="group border-b py-5 last:border-b-0 sm:py-6">
          <summary class="flex cursor-pointer list-none items-start justify-between gap-6 font-medium">
            <span>{faq.question}</span>
            <span
              class="text-muted-foreground text-xl transition-transform group-open:rotate-45"
              aria-hidden="true"
            >+</span>
          </summary>
          <p class="text-muted-foreground max-w-190 pt-4 leading-relaxed">{faq.answer}</p>
        </details>
      ))}
    </div>
  </div>
</section>

<section class="container py-12 text-center sm:py-24">
  <h2 class="text-h3 sm:text-h2 mx-auto mb-4 max-w-190 font-medium text-balance">
    Security, compliance și infrastructură într-un singur program.
  </h2>
  <p class="text-muted-foreground mx-auto mb-8 max-w-170 text-lg">
    Putem începe cu un assessment punctual, fără obligația de a schimba furnizorii existenți,
    sau putem prelua implementarea și operarea măsurilor rezultate.
  </p>
  <Button href="/contact" size="lg">Discută despre {industry.shortTitle}</Button>
</section>

<script>
  import { AnimatedHero } from "../lib/elements/hero";
  import { customElementDefine } from "../lib/dom";
  customElementDefine("animated-hero", () => AnimatedHero);
</script>
