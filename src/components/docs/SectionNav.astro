---
const sections = [
  { label: "Docs", href: "/docs" },
  { label: "Compliance", href: "/managed-compliance" },
  { label: "Compliance Portal", href: "/compliance-portal" },
  { label: "Cyber Security", href: "/cyber-security" },
  { label: "Free Tools", href: "/tools" },
];

const currentPath = Astro.url.pathname.replace(/\/+$/, "") || "/";
---

<nav
  class="docs-section-nav flex min-w-0 gap-7 overflow-x-auto [scrollbar-width:none] [-ms-overflow-style:none] [&::-webkit-scrollbar]:hidden"
  aria-label="Documentation sections"
>
  {sections.map((section) => {
    const isActive = currentPath === section.href;
    return (
      <a
        href={section.href}
        class:list={[
          "docs-section-nav__link shrink-0 text-sm transition-colors",
          isActive ? "docs-section-nav__link--active" : "",
        ]}
        aria-current={isActive ? "page" : undefined}
      >
        {section.label}
      </a>
    );
  })}
</nav>

<style>
  .docs-section-nav__link {
    position: relative;
    margin-bottom: -1px;
    padding-block: 0.875rem;
    white-space: nowrap;
    color: var(--color-muted-foreground);
    font-weight: 600;
    text-decoration: none;
  }

  .docs-section-nav__link:hover {
    color: var(--color-primary);
    text-decoration: none;
  }

  .docs-section-nav__link::after {
    position: absolute;
    inset-inline: 0;
    inset-block-end: 0;
    height: 3px;
    background: var(--docs-accent);
    content: "";
    opacity: 0;
    transform: scaleX(0.45);
    transition: opacity 160ms ease, transform 160ms ease;
  }

  .docs-section-nav__link--active,
  .docs-section-nav__link[aria-current="page"] {
    color: var(--color-success);
  }

  .docs-section-nav__link--active::after,
  .docs-section-nav__link[aria-current="page"]::after {
    opacity: 1;
    transform: scaleX(1);
  }

  @media (prefers-reduced-motion: reduce) {
    .docs-section-nav__link::after { transition: none; }
  }
</style>
