---
import MobileMenuFooter from "virtual:starlight/components/MobileMenuFooter";

const groups = [
  {
    label: "Documentation",
    items: [
      { label: "Overview", href: "/docs" },
      { label: "Managed Compliance", href: "/managed-compliance" },
      { label: "Compliance Portal", href: "/compliance-portal" },
    ],
  },
  {
    label: "Frameworks",
    items: [
      { label: "SOC 2", href: "/soc2" },
      { label: "ISO/IEC 27001", href: "/iso-27001" },
      { label: "GDPR & Privacy", href: "/gdpr" },
      { label: "NIS2", href: "/nis2" },
      { label: "Accessibility", href: "/accessibility" },
    ],
  },
  {
    label: "Security",
    items: [
      { label: "Cyber Security", href: "/cyber-security" },
      { label: "Security Assessment", href: "/security-assessment" },
      { label: "Website Security", href: "/website-security" },
      { label: "Email Security", href: "/email-security" },
      { label: "Incident Response", href: "/incident-response" },
      { label: "Secure Managed Hosting", href: "/secure-hosting" },
    ],
  },
];

const currentPath = Astro.url.pathname.replace(/\/+$/, "") || "/";
---

{groups.map((group) => (
  <section class="sidebar-section" aria-label={group.label}>
    <h2>{group.label}</h2>
    <ul class="sidebar-section-links">
      {group.items.map((item) => {
        const isActive = currentPath === item.href;
        return (
          <li>
            <a href={item.href} aria-current={isActive ? "page" : undefined}>
              {item.label}
            </a>
          </li>
        );
      })}
    </ul>
  </section>
))}

<div class="md:sl-hidden">
  <MobileMenuFooter />
</div>

<style>
  .sidebar-section + .sidebar-section {
    margin-top: 1rem;
    border-top: 1px solid var(--sl-color-hairline-light);
    padding-top: 1rem;
  }

  h2 {
    margin: 0 0 0.45rem;
    color: var(--color-primary);
    font-size: 0.875rem;
    font-weight: 600;
    letter-spacing: 0.04em;
    text-transform: uppercase;
  }

  ul {
    display: grid;
    gap: 0.15rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  a {
    display: block;
    border-radius: 0.5rem;
    padding: 0.48rem 0.65rem;
    color: var(--color-muted-foreground);
    font-size: 0.92rem;
    text-decoration: none;
    transition: background-color 140ms ease, color 140ms ease;
  }

  a:hover {
    background: var(--color-subtle);
    color: var(--color-primary);
  }

  a[aria-current="page"] {
    background: var(--color-highlight);
    color: var(--color-primary);
    font-weight: 600;
  }
</style>
