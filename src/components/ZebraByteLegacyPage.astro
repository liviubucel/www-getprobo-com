---
import Button from "./ui/Button.svelte";
import type { LegacyZebraBytePage } from "../content/zebrabyte-legacy-pages";

interface Props {
  page: LegacyZebraBytePage;
}

const { page } = Astro.props;
---

<animated-hero class="relative -mt-16 block overflow-hidden px-5 pb-16 pt-32 sm:pb-24 sm:pt-40">
  <div class="container text-center">
    <div class="border-border-low text-tertiary-foreground animate-perspective-in mx-auto mb-6 w-max rounded-lg border px-3 py-1.5 text-sm font-medium">
      {page.eyebrow}
    </div>
    <h1 class="text-h2 sm:text-h1 mx-auto mb-6 max-w-230 font-medium text-balance">{page.title}</h1>
    <p class="text-muted-foreground mx-auto mb-8 max-w-190 text-lg text-balance">{page.description}</p>
    <div class="flex flex-col justify-center gap-3 sm:flex-row">
      <Button href="/contact" size="lg">Discută cu ZebraByte</Button>
      <Button href="/cyber-security" variant="secondary" size="lg">Vezi programul complet</Button>
    </div>
  </div>
</animated-hero>

<section class="container pb-12 sm:pb-24">
  <div class="grid gap-14 lg:grid-cols-[0.8fr_1.2fr] lg:items-start lg:gap-24">
    <div>
      <p class="text-muted-foreground mb-3 text-sm font-medium uppercase tracking-wide">Context</p>
      <h2 class="text-h3 sm:text-h2 mb-5 font-medium">De ce contează în operațiunile reale.</h2>
    </div>
    <div>
      <p class="text-muted-foreground text-lg leading-relaxed">{page.intro}</p>
      {page.note && <p class="mt-6 border-y py-4 text-sm leading-relaxed sm:py-5">{page.note}</p>}
    </div>
  </div>
</section>

<section class="bg-level-3 py-12 text-level-0-foreground sm:py-24">
  <div class="container">
    <div class="mb-12 max-w-3xl sm:mb-16">
      <p class="text-level-0-foreground/55 mb-3 text-sm font-medium uppercase tracking-wide">What it covers</p>
      <h2 class="text-h3 sm:text-h2 mb-4 font-medium">Capabilitățile care definesc serviciul.</h2>
      <p class="text-level-0-foreground/65 text-lg leading-relaxed">
        Scope-ul concret depinde de proiect, dar aceste elemente descriu ce trebuie să poată face serviciul și ce rezultat urmărește.
      </p>
    </div>

    <div class="grid gap-x-14 sm:grid-cols-2 lg:gap-x-24">
      {page.features.map((feature, index) => (
        <article class="border-t border-level-0-foreground/15 py-8">
          <span class="text-level-0-foreground/40 mb-7 block font-mono text-sm">{String(index + 1).padStart(2, "0")}</span>
          <h3 class="text-h3 mb-3 font-medium">{feature.title}</h3>
          <p class="text-level-0-foreground/65 text-lg leading-relaxed">{feature.description}</p>
        </article>
      ))}
    </div>
  </div>
</section>

<section class="bg-active py-12 sm:py-24">
  <div class="container">
    <div class="mx-auto mb-12 max-w-190 text-center sm:mb-16">
      <p class="text-muted-foreground mb-3 text-sm font-medium uppercase tracking-wide">Proces</p>
      <h2 class="text-h3 sm:text-h2 mb-4 font-medium">{page.processTitle}</h2>
      <p class="text-muted-foreground text-lg leading-relaxed">
        Procesul păstrează ownership-ul și ordinea schimbărilor clare, astfel încât implementarea să nu devină o colecție de intervenții fără context.
      </p>
    </div>

    <div class="relative mx-auto max-w-6xl">
      <div class="absolute top-5 right-[8%] left-[8%] hidden h-px bg-border lg:block"></div>
      <div class="grid gap-10 sm:grid-cols-2 lg:grid-cols-4 lg:gap-8">
        {page.process.map((step, index) => (
          <article class="relative">
            <div class="mb-5 flex size-10 items-center justify-center rounded-full border bg-background font-mono text-xs">
              {String(index + 1).padStart(2, "0")}
            </div>
            <p class="text-h5 font-medium leading-relaxed">{step}</p>
          </article>
        ))}
      </div>
    </div>
  </div>
</section>

<section class="container py-12 sm:py-24">
  <div class="grid gap-14 lg:grid-cols-[0.7fr_1.3fr] lg:gap-24">
    <div>
      <p class="text-muted-foreground mb-3 text-sm font-medium uppercase tracking-wide">Continuă</p>
      <h2 class="text-h3 sm:text-h2 mb-5 font-medium">Servicii conectate.</h2>
      <p class="text-muted-foreground text-lg leading-relaxed">
        Poți păstra proiectul punctual sau îl poți conecta la alte capabilități atunci când riscul și ownership-ul o justifică.
      </p>
    </div>

    <div class="grid gap-x-10 sm:grid-cols-2">
      {page.related.map((item) => (
        <a href={item.href} class="group border-t py-7">
          <h3 class="text-h4 font-medium group-hover:underline group-hover:underline-offset-4">{item.label}</h3>
          <p class="text-muted-foreground mt-3 leading-relaxed">Vezi cum se leagă de programul ZebraByte și ce scope poate rămâne separat.</p>
        </a>
      ))}
    </div>
  </div>
</section>

<section class="container py-12 text-center sm:py-24">
  <h2 class="text-h3 sm:text-h2 mx-auto mb-4 max-w-190 font-medium text-balance">Începe cu problema reală, nu cu un pachet generic.</h2>
  <p class="text-muted-foreground mx-auto mb-8 max-w-160 text-lg">Stabilim scope-ul, ce merită păstrat și ce trebuie schimbat înainte să recomandăm o implementare mai mare.</p>
  <Button href="/contact" size="lg">Discută cu ZebraByte</Button>
</section>

<script>
  import { AnimatedHero } from "../lib/elements/hero";
  import { customElementDefine } from "../lib/dom";
  customElementDefine("animated-hero", () => AnimatedHero);
</script>
