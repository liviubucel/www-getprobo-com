---
import Button from "./ui/Button.svelte";
import type { LegacyZebraBytePage } from "../content/zebrabyte-legacy-pages";

interface Props {
  page: LegacyZebraBytePage;
}

const { page } = Astro.props;
---

<animated-hero class="relative -mt-16 block overflow-hidden px-5 pb-16 pt-32 sm:pb-24 sm:pt-40">
  <div class="container text-center">
    <div class="border-border-low text-tertiary-foreground animate-perspective-in mx-auto mb-6 w-max rounded-lg border px-2 py-0.5 text-sm font-medium">
      {page.eyebrow}
    </div>
    <h1 class="text-h2 sm:text-h1 mx-auto mb-6 max-w-230 font-medium text-balance">{page.title}</h1>
    <p class="text-muted-foreground mx-auto mb-8 max-w-190 text-lg text-balance">{page.description}</p>
    <div class="flex flex-col justify-center gap-3 sm:flex-row">
      <Button href="/contact" size="lg">Discută cu ZebraByte</Button>
      <Button href="/cyber-security" variant="secondary" size="lg">Vezi programul complet</Button>
    </div>
  </div>
</animated-hero>

<section class="container py-14 sm:py-20">
  <div class="mx-auto max-w-190">
    <p class="text-muted-foreground mb-3 text-sm font-medium uppercase tracking-[0.12em]">Din ZebraByte</p>
    <h2 class="text-h3 sm:text-h2 mb-5 font-medium">Conținut păstrat și integrat în experiența Probo.</h2>
    <p class="text-muted-foreground text-lg leading-relaxed">{page.intro}</p>
    {page.note && <p class="mt-6 border-y py-4 text-sm leading-relaxed sm:py-5">{page.note}</p>}
  </div>
</section>

<section class="container pb-16 sm:pb-24">
  <div class="grid gap-px overflow-hidden rounded-2xl border bg-border sm:grid-cols-2 lg:grid-cols-3">
    {page.features.map((feature) => (
      <article class="bg-level-0 min-h-60 p-6 sm:p-8">
        <h3 class="mb-3 text-xl font-medium">{feature.title}</h3>
        <p class="text-muted-foreground leading-relaxed">{feature.description}</p>
      </article>
    ))}
  </div>
</section>

<section class="bg-active py-16 sm:py-24">
  <div class="container grid gap-10 lg:grid-cols-[0.8fr_1.2fr] lg:items-start">
    <div>
      <p class="text-muted-foreground mb-3 text-sm font-medium uppercase tracking-[0.12em]">Proces</p>
      <h2 class="text-h3 sm:text-h2 font-medium">{page.processTitle}</h2>
    </div>
    <div class="overflow-hidden rounded-2xl border bg-level-0">
      {page.process.map((step, index) => (
        <div class="grid grid-cols-[52px_1fr] gap-3 border-b p-5 last:border-b-0 sm:p-6">
          <span class="text-muted-foreground text-sm">0{index + 1}</span>
          <p class="font-medium leading-relaxed">{step}</p>
        </div>
      ))}
    </div>
  </div>
</section>

<section class="container py-16 sm:py-24">
  <div class="mb-8 max-w-170">
    <p class="text-muted-foreground mb-3 text-sm font-medium uppercase tracking-[0.12em]">Continuă</p>
    <h2 class="text-h3 font-medium">Servicii conectate</h2>
  </div>
  <div class="grid gap-px overflow-hidden rounded-2xl border bg-border sm:grid-cols-2 lg:grid-cols-3">
    {page.related.map((item) => (
      <a href={item.href} class="bg-level-0 group min-h-44 p-6 transition-colors hover:bg-subtle sm:p-8">
        <h3 class="font-medium group-hover:underline group-hover:underline-offset-4">{item.label}</h3>
        <p class="text-muted-foreground mt-2 text-sm">Deschide serviciul și vezi cum se leagă de programul ZebraByte.</p>
      </a>
    ))}
  </div>
</section>

<script>
  import { AnimatedHero } from "../lib/elements/hero";
  import { customElementDefine } from "../lib/dom";
  customElementDefine("animated-hero", () => AnimatedHero);
</script>
