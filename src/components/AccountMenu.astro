---
import Icon from "./Icon.astro";
import MenuIcon from "./MenuIcon.astro";
import { directMenuItems } from "../content/menu";

type Props = {
  id?: string;
  mobile?: boolean;
};

const {
  id: panelId = "client-access-panel",
  mobile = false,
} = Astro.props;
---

<client-access-menu
  class:list={[
    "relative",
    mobile ? "block" : "ml-2 hidden xl:block",
  ]}
  data-mobile-account-menu={mobile ? "true" : undefined}
>
  <button
    type="button"
    data-account-trigger
    class:list={[
      "text-primary grid size-10 place-items-center transition-all duration-150 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-current/15",
      mobile
        ? "text-muted-foreground hover:text-primary rounded-lg hover:bg-subtle aria-expanded:bg-subtle aria-expanded:text-primary aria-expanded:ring-1 aria-expanded:ring-current/10"
        : "bg-secondary hover:bg-active rounded-full border shadow-[0_1px_2px_rgba(20,30,18,0.04)] transition-[background-color,border-color,box-shadow] hover:shadow-[0_3px_10px_rgba(20,30,18,0.09)] aria-expanded:bg-subtle aria-expanded:shadow-[0_3px_10px_rgba(20,30,18,0.10)]",
    ]}
    aria-label="Autentificare și acces clienți"
    title="Acces clienți"
    aria-haspopup="true"
    aria-expanded="false"
    aria-controls={panelId}
  >
    <span class="grid size-5 -translate-y-px place-items-center" aria-hidden="true">
      <svg
        viewBox="0 0 24 24"
        width={mobile ? 20 : 18}
        height={mobile ? 20 : 18}
        fill="none"
        stroke="currentColor"
        stroke-width="1.9"
        stroke-linecap="round"
        stroke-linejoin="round"
      >
        <path d="M20 21a8 8 0 0 0-16 0" />
        <circle cx="12" cy="7" r="4" />
      </svg>
    </span>
  </button>

  <div
    id={panelId}
    data-account-panel
    class:list={[
      "pointer-events-none z-[80] origin-top-right translate-y-[-6px] scale-[0.985] opacity-0 transition duration-200",
      mobile
        ? "absolute top-full right-[-3rem] mt-3 w-[min(360px,calc(100vw-2rem))]"
        : "absolute top-full right-0 mt-3 w-[340px]",
    ]}
    hidden
  >
    {
      mobile && (
        <span
          class="bg-secondary absolute -top-[7px] right-[62px] z-10 size-3.5 rotate-45 border-t border-l"
          aria-hidden="true"
        />
      )
    }

    <div
      class:list={[
        "bg-secondary overflow-hidden border shadow-[0_16px_32px_rgba(20,30,18,0.16)]",
        mobile ? "rounded-xl" : "rounded-2xl",
      ]}
    >
      <div class="border-b px-4 py-3.5">
        <p class="font-semibold">Acces clienți</p>
        <p class="text-muted-foreground mt-0.5 text-[13px] leading-5">
          Alege platforma în care vrei să intri.
        </p>
      </div>

      <div class="p-2">
        {
          directMenuItems.map((item) => (
            <a
              href={item.href}
              target="_blank"
              rel="noopener noreferrer"
              class="group flex items-center gap-3 rounded-xl p-3 outline-none transition-colors hover:bg-subtle focus-visible:bg-subtle"
            >
              <span class="grid size-10 shrink-0 place-items-center rounded-[10px] border bg-secondary">
                <MenuIcon name={item.icon} />
              </span>
              <span class="min-w-0 flex-1">
                <span class="block font-semibold">{item.label}</span>
                <span class="text-muted-foreground block text-sm leading-5">
                  {item.description}
                </span>
              </span>
              <Icon
                name="caret-right"
                size={16}
                class="text-muted-foreground transition-transform group-hover:translate-x-0.5"
              />
            </a>
          ))
        }
      </div>
    </div>
  </div>
</client-access-menu>

<script>
  import { customElementDefine } from "../lib/dom";

  class ClientAccessMenu extends HTMLElement {
    trigger: HTMLButtonElement | null = null;
    panel: HTMLElement | null = null;
    open = false;
    hideTimer: number | null = null;

    connectedCallback() {
      this.trigger = this.querySelector("[data-account-trigger]");
      this.panel = this.querySelector("[data-account-panel]");
      this.trigger?.addEventListener("click", this.toggle);
      document.addEventListener("pointerdown", this.onDocumentPointerDown);
      document.addEventListener("keydown", this.onKeyDown);
      document.addEventListener("zbt:main-menu-open", this.closeFromMainMenu);
    }

    disconnectedCallback() {
      this.trigger?.removeEventListener("click", this.toggle);
      document.removeEventListener("pointerdown", this.onDocumentPointerDown);
      document.removeEventListener("keydown", this.onKeyDown);
      document.removeEventListener("zbt:main-menu-open", this.closeFromMainMenu);
      if (this.hideTimer) window.clearTimeout(this.hideTimer);
    }

    closeDesktopNavigation() {
      const desktopMenu = document.querySelector<HTMLElement>(
        'header-menu[data-open="true"]',
      );
      if (!desktopMenu) return;

      // Reuse HeaderMenu's existing Escape path so its animation/focus state
      // remains owned by HeaderMenu instead of being duplicated here.
      document.dispatchEvent(
        new KeyboardEvent("keydown", { key: "Escape", bubbles: true }),
      );
    }

    closeMainNavigation() {
      this.closeDesktopNavigation();

      const burger = document.querySelector<HTMLElement>(
        'burger-menu[aria-expanded="true"]',
      );
      burger?.click();
    }

    setOpen(next: boolean) {
      if (!this.trigger || !this.panel || this.open === next) return;

      if (next) this.closeMainNavigation();

      this.open = next;
      this.trigger.setAttribute("aria-expanded", String(next));

      if (this.hideTimer) {
        window.clearTimeout(this.hideTimer);
        this.hideTimer = null;
      }

      if (next) {
        document.dispatchEvent(new CustomEvent("zbt:account-menu-open"));
        this.panel.hidden = false;
        requestAnimationFrame(() => {
          if (!this.panel) return;
          this.panel.classList.remove(
            "pointer-events-none",
            "translate-y-[-6px]",
            "scale-[0.985]",
            "opacity-0",
          );
          this.panel.classList.add(
            "pointer-events-auto",
            "translate-y-0",
            "scale-100",
            "opacity-100",
          );
        });
        return;
      }

      this.panel.classList.add(
        "pointer-events-none",
        "translate-y-[-6px]",
        "scale-[0.985]",
        "opacity-0",
      );
      this.panel.classList.remove(
        "pointer-events-auto",
        "translate-y-0",
        "scale-100",
        "opacity-100",
      );
      this.hideTimer = window.setTimeout(() => {
        if (this.panel && !this.open) this.panel.hidden = true;
      }, 200);
    }

    toggle = (event: Event) => {
      event.stopPropagation();
      this.setOpen(!this.open);
    };

    closeFromMainMenu = () => this.setOpen(false);

    onDocumentPointerDown = (event: PointerEvent) => {
      if (this.open && !this.contains(event.target as Node)) this.setOpen(false);
    };

    onKeyDown = (event: KeyboardEvent) => {
      if (event.key !== "Escape" || !this.open) return;
      event.preventDefault();
      this.setOpen(false);
      this.trigger?.focus();
    };
  }

  customElementDefine("client-access-menu", () => ClientAccessMenu);
</script>
