---
interface Props {
  class?: string;
  compact?: boolean;
  locale?: "ro" | "en";
  canonicalPath?: string;
}

const { class: className, compact = false, locale, canonicalPath } = Astro.props;
const currentPath = canonicalPath || Astro.url.pathname || "/";
const normalizedPath = currentPath === "/" ? "/" : `/${currentPath.replace(/^\/+|\/+$/g, "")}`;
const isEnglish = locale ? locale === "en" : normalizedPath === "/en" || normalizedPath.startsWith("/en/");
const romanianPath = isEnglish
  ? normalizedPath === "/en"
    ? "/"
    : normalizedPath.replace(/^\/en(?=\/|$)/, "") || "/"
  : normalizedPath;
const englishPath = romanianPath === "/" ? "/en" : `/en${romanianPath}`;
const switchPath = isEnglish ? romanianPath : englishPath;
---

<a
  href={switchPath}
  data-locale-switch
  data-language-switch
  class:list={[
    "text-muted-foreground hover:text-primary hover:bg-highlight inline-flex items-center justify-center gap-1.5 transition-colors focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-current focus-visible:ring-offset-2",
    compact ? "h-10 min-w-[3.75rem] rounded-lg px-2" : "h-8 rounded-md px-[9px]",
    className,
  ]}
  aria-label={isEnglish ? "Schimbă limba în română" : "Switch language to English"}
  title={isEnglish ? "Română" : "English"}
>
  <svg
    viewBox="0 0 24 24"
    width="20"
    height="20"
    class="shrink-0"
    fill="none"
    stroke="currentColor"
    stroke-width="2"
    stroke-linecap="round"
    stroke-linejoin="round"
    aria-hidden="true"
  >
    <circle cx="12" cy="12" r="10" />
    <path d="M2 12h20" />
    <path d="M12 2a15.3 15.3 0 0 1 0 20" />
    <path d="M12 2a15.3 15.3 0 0 0 0 20" />
  </svg>
  <span data-language-code class="shrink-0 text-xs font-semibold tracking-wide">{isEnglish ? "RO" : "EN"}</span>
</a>

<script>
  import { installBrowserI18nObserver } from "../lib/browser-i18n";

  const bindLanguageSwitchers = () => {
    const pathname = window.location.pathname || "/";
    const english = pathname === "/en" || pathname.startsWith("/en/");
    const target = english
      ? pathname === "/en"
        ? "/"
        : pathname.slice(3) || "/"
      : pathname === "/"
        ? "/en"
        : `/en${pathname}`;

    document.querySelectorAll<HTMLAnchorElement>("[data-language-switch]").forEach((link) => {
      link.href = `${target}${window.location.search}${window.location.hash}`;
      const code = link.querySelector<HTMLElement>("[data-language-code]");
      if (code) code.textContent = english ? "RO" : "EN";
      link.setAttribute(
        "aria-label",
        english ? "Schimbă limba în română" : "Switch language to English",
      );
      link.title = english ? "Română" : "English";
    });

    installBrowserI18nObserver();
  };

  document.addEventListener("astro:page-load", bindLanguageSwitchers);
  bindLanguageSwitchers();
</script>
