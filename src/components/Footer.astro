---
import ZebraByteLogo from "./ZebraByteLogo.astro";
import Frameworks from "./block/Frameworks.astro";
import ZebraByteStatus from "../components/ZebraByteStatus.svelte";
import Newsletter from "./block/Newsletter.astro";
import AskAi from "./AskAi.astro";

const menus = [
  {
    label: "Resurse",
    items: [
      { label: "Acasă", href: "/" },
      { label: "Blog", href: "/blog" },
      { label: "Hub", href: "/hub" },
      { label: "Studii de caz", href: "/stories" },
      { label: "Păreri de la clienți ⭐", href: "/love-from-customer" },
      { label: "Jurnal de modificări", href: "/changelog" },
      { label: "Descărcări", href: "/download" },
      { label: "Documentație", href: "/docs" },
      { label: "Instrumente gratuite", href: "/tools" },
    ],
  },
  {
    label: "Companie",
    items: [
      { label: "Despre", href: "/about" },
      { label: "Cariere", href: "/careers" },
      { label: "Brand", href: "/brand" },
      { label: "Industrii", href: "/industries" },
      { label: "Parteneriate", href: "/partnerships" },
      { label: "Contact", href: "/contact" },
      { label: "Portal clienți", href: "https://portal.zebrabyte.ro" },
    ],
  },
  {
    label: "Conformitate și juridic",
    items: [
      { label: "Centru juridic", href: "/legal" },
      { label: "Securitate ZebraByte", href: "/security" },
      { label: "Conformitate gestionată", href: "/managed-compliance" },
      { label: "Platforma GRC", href: "/compliance-platform" },
      { label: "Trust Center", href: "/compliance-portal" },
      { label: "SOC 2", href: "/soc2" },
      { label: "ISO/IEC 27001", href: "/iso-27001" },
      { label: "GDPR și confidențialitate", href: "/gdpr" },
      { label: "NIS2", href: "/nis2" },
      { label: "Accesibilitate", href: "/accessibility" },
      { label: "Politica privind cookie-urile", href: "/cookie-policy" },
      { label: "Politica de confidențialitate", href: "/privacy" },
      { label: "Termeni și condiții", href: "/terms" },
      { label: "Acord de prelucrare a datelor (DPA)", href: "/dpa" },
      { label: "SLA găzduire", href: "/legal/hosting-sla" },
    ],
  },
];

type Props = {
  noFrameworks?: boolean;
};
---

{!Astro.props.noFrameworks && <Frameworks />}

<footer class="site-footer bg-level-0 space-y-10 py-10 sm:py-20">
  <div class="container flex grid-cols-[520fr_560fr] flex-col-reverse gap-8 sm:grid">
    <div class="text-tertiary-foreground space-y-4 sm:max-w-[320px]">
      <a href="/" class="block w-max">
        <ZebraByteLogo />
      </a>
      <Newsletter variant="footer" />
    </div>

    <div class="grid grid-cols-2 gap-x-6 gap-y-10 text-xs sm:grid-cols-3 sm:gap-y-6">
      {menus.map((menu, index) => (
        <div class:list={["space-y-3", index === 2 && "col-span-2 sm:col-span-1"]}>
          <div class="mb-3 font-medium">{menu.label}</div>
          <ul class:list={["space-y-3", index === 2 && "columns-2 gap-x-8 sm:columns-1"]}>
            {menu.items.map((item) => (
              <li class="break-inside-avoid">
                <a href={item.href} class="text-tertiary-foreground text-sm hover:text-white hover:underline">
                  {item.label}
                </a>
              </li>
            ))}
          </ul>
        </div>
      ))}
    </div>
  </div>

  <div class="container flex flex-col items-start justify-between gap-4 sm:flex-row sm:items-center">
    <p class="text-tertiary-foreground text-xxs flex flex-wrap items-center gap-3">
      Copyright © 2023-2026 ZEBRABYTE LIMITED. Toate drepturile rezervate.
      <span>Nr. companie 15194067 · ICO ZB748706</span>
      <ZebraByteStatus client:load />
    </p>
    <AskAi />
  </div>
</footer>

<style>
  .site-footer {
    content-visibility: auto;
    contain-intrinsic-size: 760px;
  }
</style>