---
import { Image } from "astro:assets";
import ZebraByteLogo from "./ZebraByteLogo.astro";
import ProboLogo from "../assets/probo-logo.svg";
import Frameworks from "./block/Frameworks.astro";
import OpenStatus from "../components/OpenStatus.svelte";
import Newsletter from "./block/Newsletter.astro";
import AskAi from "./AskAi.astro";
import { Toaster } from "svelte-sonner";

const upstreamCookieBannerEnabled =
  import.meta.env.PUBLIC_ENABLE_UPSTREAM_COOKIE_BANNER === "true" &&
  Boolean(import.meta.env.PUBLIC_COOKIE_BANNER_ID) &&
  Boolean(import.meta.env.PUBLIC_COOKIE_BANNER_API_BASE_URL);

const menus = [
  {
    label: "Security",
    items: [
      { label: "Cyber Security", href: "/cyber-security" },
      { label: "Security Assessment", href: "/security-assessment" },
      { label: "Website Security", href: "/website-security" },
      { label: "Email Security", href: "/email-security" },
      { label: "Incident Response", href: "/incident-response" },
      { label: "Secure Managed Hosting", href: "/secure-hosting" },
    ],
  },
  {
    label: "Conformitate",
    items: [
      { label: "GDPR & Privacy", href: "/gdpr" },
      { label: "NIS2 Readiness", href: "/nis2" },
      { label: "ISO/IEC 27001", href: "/iso-27001" },
      { label: "Compliance Portal", href: "/compliance-portal" },
      { label: "SOC 2 Hub", href: "/hub/soc2" },
      { label: "Compliance Recommender", href: "/hub/compliance-recommender" },
    ],
  },
  {
    label: "Platformă & Resurse",
    items: [
      { label: "Platformă open-source", href: "/docs/deployment/self-hosting/docker-compose" },
      { label: "Download Probo Agent", href: "/download" },
      { label: "Docs", href: "/docs" },
      { label: "Hub", href: "/hub" },
      { label: "Blog", href: "/blog" },
      { label: "Stories", href: "/stories" },
      { label: "Changelog", href: "/changelog" },
      { label: "Love from Customers ⭐", href: "/love-from-customer" },
    ],
  },
  {
    label: "Companie",
    items: [
      { label: "About", href: "/about" },
      { label: "Industries", href: "/industries" },
      { label: "Partnerships", href: "/partnerships" },
      { label: "Careers", href: "/careers" },
      { label: "Brand", href: "/brand" },
      { label: "Contact", href: "/contact" },
      { label: "Portal clienți", href: "https://portal.zebrabyte.ro" },
      { label: "LinkedIn", href: "https://www.linkedin.com/company/zebrabyteuk" },
    ],
  },
  {
    label: "Probo upstream",
    items: [
      { label: "Original Compliance Portal", href: "/products/compliance-portal" },
      { label: "Probo Agent Docs", href: "/docs/product/probo-agent/overview" },
      { label: "Probo vs Vanta", href: "/hub/probo-vs-vanta" },
      { label: "Original Stories", href: "/stories" },
      { label: "Original Changelog", href: "/changelog" },
      { label: "Probo GitHub", href: "https://github.com/getprobo/probo" },
      { label: "Probo website", href: "https://www.probo.com" },
    ],
  },
  {
    label: "Legal",
    items: [
      { label: "Cookie Policy", href: "/cookie-policy" },
      { label: "Privacy Policy", href: "/privacy" },
      { label: "Terms of service", href: "/terms" },
      { label: "Security", href: "https://trust.zebrabyte.ro" },
      { label: "Subprocessors", href: "https://trust.zebrabyte.ro/subprocessors" },
    ],
  },
];

type Props = {
  noFrameworks?: boolean;
};
---

{!Astro.props.noFrameworks && <Frameworks />}

<footer class="bg-level-0 space-y-10 py-10 sm:py-20">
  <div class="container space-y-10">
    <div class="grid gap-10 lg:grid-cols-[300px_1fr]">
      <div class="text-tertiary-foreground space-y-5">
        <ZebraByteLogo />
        <p class="max-w-[280px] text-sm leading-relaxed">
          Cyber security, privacy, compliance și infrastructură securizată construite
          peste experiența open-source Probo pe care o păstrăm complet.
        </p>
        <Newsletter variant="footer" />
      </div>

      <div class="grid grid-cols-2 gap-x-6 gap-y-10 text-xs sm:grid-cols-3 xl:grid-cols-6">
        {
          menus.map((menu) => (
            <div class="space-y-3">
              <div class="mb-3 font-medium">{menu.label}</div>
              <ul class="space-y-3">
                {menu.items.map((item) => (
                  <li>
                    <a
                      href={item.href}
                      class="text-tertiary-foreground text-sm hover:text-white hover:underline"
                    >
                      {item.label}
                    </a>
                  </li>
                ))}
                {menu.label === "Legal" && upstreamCookieBannerEnabled && (
                  <li>
                    <probo-settings-link class="text-tertiary-foreground flex-nowrap text-sm whitespace-nowrap hover:text-white hover:underline">
                      <a href="#">Setări cookie</a>
                    </probo-settings-link>
                  </li>
                )}
              </ul>
            </div>
          ))
        }
      </div>
    </div>

    <div class="border-border-low flex flex-col gap-5 border-t pt-6 sm:flex-row sm:items-center sm:justify-between">
      <div class="flex flex-wrap items-center gap-4">
        <span class="text-tertiary-foreground text-xs">Platform core derived from</span>
        <a
          href="https://github.com/getprobo/probo"
          target="_blank"
          rel="noopener noreferrer"
          aria-label="Probo upstream project"
          class="opacity-80 transition-opacity hover:opacity-100"
        >
          <Image src={ProboLogo} alt="Probo" width={73} height={20} />
        </a>
      </div>

      <div class="flex flex-col items-start gap-4 sm:items-end">
        <p class="text-tertiary-foreground text-xxs flex items-center gap-3">
          Copyright © 2023-2026 ZebraByte. All rights reserved.
          <OpenStatus client:visible />
        </p>
        <AskAi />
      </div>
    </div>
  </div>
</footer>

<Toaster richColors position="top-center" client:only="svelte" />
