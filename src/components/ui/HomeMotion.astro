---
type Scene = "expert" | "automation" | "security" | "workspace";

interface Props {
  scene: Scene;
}

const { scene } = Astro.props;
---

<div class="zbt-motion" data-scene={scene} aria-hidden="true">
  <div class="zbt-app">
    <div class="zbt-topbar">
      <div class="zbt-brand">
        <img src="/images/zbt-negru.svg" alt="" width="3242" height="1166" />
      </div>
      <div class="zbt-topbar-actions">
        <span></span><span></span><span></span>
      </div>
    </div>

    {
      scene === "expert" && (
        <div class="zbt-layout">
          <aside class="zbt-sidebar">
            <div class="zbt-nav-item is-active"><i />Overview</div>
            <div class="zbt-nav-item"><i />Controls</div>
            <div class="zbt-nav-item"><i />Risks</div>
            <div class="zbt-nav-item"><i />Evidence</div>
          </aside>
          <div class="zbt-content expert-scene">
            <div class="zbt-page-head">
              <div>
                <span class="zbt-kicker">Program overview</span>
                <strong>ISO 27001 readiness</strong>
              </div>
              <span class="zbt-chip">On track</span>
            </div>

            <div class="zbt-progress-card">
              <div class="zbt-progress-copy"><b>82%</b><span>program complete</span></div>
              <div class="zbt-progress"><span /></div>
            </div>

            <div class="zbt-section-label">Today</div>
            <div class="zbt-task-list">
              <div class="zbt-task task-a">
                <span class="zbt-check">✓</span>
                <div><b>Access review</b><small>Reviewed by ZebraByte</small></div>
                <span class="zbt-status">Done</span>
              </div>
              <div class="zbt-task task-b">
                <span class="zbt-check">02</span>
                <div><b>Vendor risk review</b><small>Assigned to your compliance expert</small></div>
                <span class="zbt-avatar">Z</span>
              </div>
              <div class="zbt-task task-c">
                <span class="zbt-check">03</span>
                <div><b>Audit evidence pack</b><small>Preparing 14 evidence items</small></div>
                <span class="zbt-live-dot" />
              </div>
            </div>

            <div class="zbt-float-note expert-note">
              <span class="zbt-avatar is-large">Z</span>
              <div><b>Expert update</b><small>3 actions handled for you</small></div>
              <span class="zbt-mini-check">✓</span>
            </div>
          </div>
        </div>
      )
    }

    {
      scene === "automation" && (
        <div class="zbt-layout">
          <aside class="zbt-sidebar">
            <div class="zbt-nav-item"><i />Overview</div>
            <div class="zbt-nav-item is-active"><i />Evidence</div>
            <div class="zbt-nav-item"><i />Integrations</div>
            <div class="zbt-nav-item"><i />Tasks</div>
          </aside>
          <div class="zbt-content automation-scene">
            <div class="zbt-page-head">
              <div>
                <span class="zbt-kicker">Evidence automation</span>
                <strong>Continuous collection</strong>
              </div>
              <span class="zbt-chip">Live</span>
            </div>

            <div class="zbt-flow">
              <div class="zbt-source source-one"><span>CF</span><small>Cloudflare</small></div>
              <div class="zbt-source source-two"><span>MS</span><small>Microsoft</small></div>
              <div class="zbt-source source-three"><span>GH</span><small>GitHub</small></div>
              <div class="zbt-flow-lines"><i class="line-one"/><i class="line-two"/><i class="line-three"/><em /></div>
              <div class="zbt-vault">
                <div class="zbt-vault-icon">✓</div>
                <b>Evidence vault</b>
                <small>Synced automatically</small>
              </div>
            </div>

            <div class="zbt-sync-grid">
              <div class="zbt-sync-row row-one"><span class="zbt-doc"/><div><b>MFA configuration</b><small>Microsoft Entra ID</small></div><span>Synced</span></div>
              <div class="zbt-sync-row row-two"><span class="zbt-doc"/><div><b>WAF configuration</b><small>Cloudflare</small></div><span>Synced</span></div>
              <div class="zbt-sync-row row-three"><span class="zbt-doc"/><div><b>Repository protection</b><small>GitHub</small></div><span>Synced</span></div>
            </div>
          </div>
        </div>
      )
    }

    {
      scene === "security" && (
        <div class="zbt-layout">
          <aside class="zbt-sidebar">
            <div class="zbt-nav-item"><i />Overview</div>
            <div class="zbt-nav-item is-active"><i />Security</div>
            <div class="zbt-nav-item"><i />Findings</div>
            <div class="zbt-nav-item"><i />Incidents</div>
          </aside>
          <div class="zbt-content security-scene">
            <div class="zbt-page-head">
              <div>
                <span class="zbt-kicker">Security posture</span>
                <strong>Controls connected to reality</strong>
              </div>
              <span class="zbt-score"><b>92</b>/100</span>
            </div>

            <div class="zbt-security-cards">
              <div class="zbt-security-card card-web">
                <div class="zbt-security-icon">W</div><div><b>Website</b><small>WAF · DDoS · TLS</small></div><span>Protected</span>
              </div>
              <div class="zbt-security-card card-mail">
                <div class="zbt-security-icon">@</div><div><b>Email</b><small>DMARC · MFA · filtering</small></div><span>Protected</span>
              </div>
              <div class="zbt-security-card card-access">
                <div class="zbt-security-icon">A</div><div><b>Access</b><small>SSO · least privilege</small></div><span>Healthy</span>
              </div>
            </div>

            <div class="zbt-threat-card">
              <div class="zbt-threat-head"><div><span class="zbt-kicker">Edge protection</span><b>Threat activity</b></div><span class="zbt-chip">Last 24h</span></div>
              <div class="zbt-chart"><i/><i/><i/><i/><i/><i/><i/><i/><i/><i/><i/><i/></div>
              <div class="zbt-threat-foot"><span><b class="threat-counter">248</b><small>blocked requests</small></span><span><b>0</b><small>critical findings</small></span></div>
            </div>
          </div>
        </div>
      )
    }

    {
      scene === "workspace" && (
        <div class="zbt-layout">
          <aside class="zbt-sidebar">
            <div class="zbt-nav-item is-active"><i />Workspace</div>
            <div class="zbt-nav-item"><i />Documents</div>
            <div class="zbt-nav-item"><i />Actions</div>
            <div class="zbt-nav-item"><i />Activity</div>
          </aside>
          <div class="zbt-content workspace-scene">
            <div class="zbt-page-head">
              <div>
                <span class="zbt-kicker">Unified workspace</span>
                <strong>Everything in one program</strong>
              </div>
              <span class="zbt-chip">Live</span>
            </div>

            <div class="zbt-work-columns">
              <div class="zbt-work-main">
                <div class="zbt-tabs"><span class="is-active">Actions</span><span>Evidence</span><span>Risks</span></div>
                <div class="zbt-action-row action-one"><span class="zbt-check">✓</span><div><b>Security policy approved</b><small>Control A.5.1 · 2 min ago</small></div><span class="zbt-status">Done</span></div>
                <div class="zbt-action-row action-two"><span class="zbt-check">02</span><div><b>Review privileged access</b><small>Owner · ZebraByte</small></div><span class="zbt-avatar">Z</span></div>
                <div class="zbt-action-row action-three"><span class="zbt-check">03</span><div><b>Attach audit evidence</b><small>4 files collected automatically</small></div><span class="zbt-live-dot" /></div>
              </div>
              <div class="zbt-activity-panel">
                <span class="zbt-kicker">Activity</span>
                <div class="zbt-activity activity-one"><i/><p><b>Evidence synced</b><small>Cloudflare WAF</small></p></div>
                <div class="zbt-activity activity-two"><i/><p><b>Risk updated</b><small>Residual risk: Low</small></p></div>
                <div class="zbt-activity activity-three"><i/><p><b>Message received</b><small>ZebraByte expert</small></p></div>
              </div>
            </div>

            <div class="zbt-float-note workspace-note">
              <span class="zbt-avatar is-large">Z</span>
              <div><b>ZebraByte</b><small>I reviewed the evidence. You're all set.</small></div>
              <span class="zbt-mini-check">✓</span>
            </div>
          </div>
        </div>
      )
    }
  </div>
</div>

<style>
  .zbt-motion {
    --ink: #141e12;
    --muted: #6b716a;
    --line: rgba(2, 42, 2, 0.08);
    --line-strong: rgba(0, 26, 0, 0.15);
    --paper: #fffffb;
    --panel: #fff;
    --soft: #f4f5f1;
    --accent: #93c926;
    --active: #e4f7c7;
    position: relative;
    width: 100%;
    aspect-ratio: 560 / 360;
    overflow: hidden;
    border-radius: 1rem;
    background:
      radial-gradient(circle at 78% 15%, rgba(147, 201, 38, 0.16), transparent 34%),
      #eeede8;
    color: var(--ink);
    font-family: "Geist", ui-sans-serif, system-ui, sans-serif;
    box-shadow: inset 0 0 0 1px rgba(20, 30, 18, 0.04);
  }

  .zbt-app {
    position: absolute;
    inset: 7.5% 6.2% -4.5%;
    overflow: hidden;
    border: 1px solid var(--line-strong);
    border-radius: 11px 11px 0 0;
    background: var(--panel);
    box-shadow: 0 18px 45px rgba(20, 30, 18, 0.12);
    transform: perspective(1000px) rotateX(0.8deg);
  }

  .zbt-topbar {
    height: 12.5%;
    min-height: 32px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 0 4.2%;
    border-bottom: 1px solid var(--line);
    background: rgba(255, 255, 255, 0.94);
  }

  .zbt-brand { width: 19%; display: flex; align-items: center; }
  .zbt-brand img { width: 100%; max-width: 88px; height: auto; display: block; }
  .zbt-topbar-actions { display: flex; gap: 5px; align-items: center; }
  .zbt-topbar-actions span { display: block; width: 5px; height: 5px; border-radius: 50%; background: #d4d8d2; }
  .zbt-topbar-actions span:last-child { background: var(--accent); }

  .zbt-layout { display: grid; grid-template-columns: 24% 1fr; height: 87.5%; }
  .zbt-sidebar { padding: 7% 7%; border-right: 1px solid var(--line); background: #fbfcf9; }
  .zbt-nav-item { display: flex; align-items: center; gap: 7px; padding: 7px 8px; margin-bottom: 4px; border-radius: 6px; color: #7d837c; font-size: clamp(6px, 1.22vw, 10px); white-space: nowrap; }
  .zbt-nav-item i { width: 7px; height: 7px; border: 1px solid #aeb4ad; border-radius: 2px; }
  .zbt-nav-item.is-active { color: var(--ink); background: #eef1eb; font-weight: 650; }
  .zbt-nav-item.is-active i { background: var(--ink); border-color: var(--ink); }

  .zbt-content { position: relative; padding: 5.6% 5.5%; overflow: hidden; }
  .zbt-page-head { display: flex; justify-content: space-between; align-items: flex-start; gap: 10px; }
  .zbt-page-head > div { display: grid; gap: 3px; }
  .zbt-page-head strong { font-size: clamp(9px, 1.9vw, 15px); letter-spacing: -0.03em; line-height: 1.1; }
  .zbt-kicker { color: #899088; font-size: clamp(5px, 0.92vw, 7px); text-transform: uppercase; letter-spacing: 0.13em; font-weight: 700; }
  .zbt-chip { padding: 3px 6px; border-radius: 999px; background: var(--active); color: #506c0c; font-size: clamp(5px, 0.9vw, 7px); font-weight: 700; }

  .zbt-progress-card { display: grid; grid-template-columns: auto 1fr; align-items: end; gap: 11px; margin-top: 5.5%; padding: 4.4%; border: 1px solid var(--line); border-radius: 8px; background: #fcfdfa; }
  .zbt-progress-copy { display: grid; gap: 1px; min-width: 45px; }
  .zbt-progress-copy b { font-size: clamp(12px, 2.6vw, 21px); line-height: 1; }
  .zbt-progress-copy span { color: var(--muted); font-size: clamp(5px, 0.9vw, 7px); white-space: nowrap; }
  .zbt-progress { height: 5px; margin-bottom: 4px; overflow: hidden; border-radius: 99px; background: #e8ebe5; }
  .zbt-progress span { display: block; width: 82%; height: 100%; transform-origin: left; border-radius: inherit; background: var(--accent); animation: zbt-progress 5.2s ease-in-out infinite; }
  .zbt-section-label { margin: 5.5% 0 2.5%; color: #8b918a; font-size: clamp(5px, 0.9vw, 7px); font-weight: 700; text-transform: uppercase; letter-spacing: .1em; }

  .zbt-task-list, .zbt-sync-grid { display: grid; gap: 4px; }
  .zbt-task, .zbt-sync-row, .zbt-action-row { display: grid; grid-template-columns: auto minmax(0, 1fr) auto; align-items: center; gap: 7px; min-height: 34px; padding: 6px 8px; border: 1px solid var(--line); border-radius: 6px; background: #fff; }
  .zbt-task b, .zbt-sync-row b, .zbt-action-row b { display: block; font-size: clamp(6px, 1.08vw, 8px); font-weight: 650; line-height: 1.15; }
  .zbt-task small, .zbt-sync-row small, .zbt-action-row small { display: block; margin-top: 2px; color: #8c928b; font-size: clamp(5px, 0.84vw, 6.5px); line-height: 1.15; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
  .zbt-check { display: grid; width: 18px; height: 18px; place-items: center; border-radius: 5px; background: #f0f2ee; color: #677066; font-size: 6px; font-weight: 800; }
  .zbt-task:first-child .zbt-check, .zbt-action-row:first-child .zbt-check { background: var(--active); color: #536d13; }
  .zbt-status { padding: 3px 5px; border-radius: 999px; background: #f0f4eb; color: #65715d; font-size: 5.5px; font-weight: 700; }
  .zbt-avatar { display: grid; width: 17px; height: 17px; place-items: center; border-radius: 50%; background: var(--ink); color: white; font-size: 6px; font-weight: 800; }
  .zbt-avatar.is-large { width: 24px; height: 24px; font-size: 8px; }
  .zbt-live-dot { width: 7px; height: 7px; border-radius: 50%; background: var(--accent); box-shadow: 0 0 0 0 rgba(147, 201, 38, .35); animation: zbt-pulse 2s infinite; }

  .zbt-float-note { position: absolute; display: grid; grid-template-columns: auto 1fr auto; align-items: center; gap: 7px; min-width: 51%; padding: 7px 9px; border: 1px solid var(--line-strong); border-radius: 8px; background: rgba(255,255,255,.96); box-shadow: 0 11px 28px rgba(20,30,18,.13); }
  .zbt-float-note b { display: block; font-size: clamp(6px, 1.05vw, 8px); }
  .zbt-float-note small { display: block; margin-top: 1px; color: var(--muted); font-size: clamp(5px, .82vw, 6.5px); }
  .expert-note { right: 3.2%; bottom: 4%; animation: zbt-float 5.4s ease-in-out infinite; }
  .zbt-mini-check { display: grid; width: 15px; height: 15px; place-items: center; border-radius: 50%; background: var(--active); color: #55720e; font-size: 7px; font-weight: 800; }

  .zbt-flow { position: relative; height: 42%; min-height: 100px; margin-top: 4.5%; border: 1px solid var(--line); border-radius: 8px; background: linear-gradient(180deg, #fbfcf9, #fff); }
  .zbt-source { position: absolute; left: 6%; display: grid; grid-template-columns: 19px auto; grid-template-rows: auto auto; column-gap: 6px; align-items: center; width: 31%; }
  .zbt-source > span { grid-row: 1 / span 2; display: grid; width: 19px; height: 19px; place-items: center; border: 1px solid var(--line-strong); border-radius: 5px; background: white; font-size: 5.5px; font-weight: 800; }
  .zbt-source small { font-size: clamp(5px, .86vw, 6.5px); color: #70776f; }
  .source-one { top: 16%; } .source-two { top: 42%; } .source-three { top: 68%; }
  .zbt-flow-lines i { position: absolute; left: 37%; width: 23%; height: 1px; background: #d8ddd5; transform-origin: left; }
  .zbt-flow-lines i::after { content: ""; position: absolute; top: -2px; left: 0; width: 5px; height: 5px; border-radius: 50%; background: var(--accent); animation: zbt-travel 3.1s linear infinite; }
  .zbt-flow-lines .line-one { top: 25%; transform: rotate(8deg); }
  .zbt-flow-lines .line-two { top: 50%; }
  .zbt-flow-lines .line-three { top: 75%; transform: rotate(-8deg); }
  .zbt-flow-lines .line-two::after { animation-delay: -1s; } .zbt-flow-lines .line-three::after { animation-delay: -2s; }
  .zbt-vault { position: absolute; right: 6%; top: 24%; width: 31%; height: 52%; display: grid; place-content: center; justify-items: center; gap: 3px; border: 1px solid var(--line-strong); border-radius: 8px; background: white; box-shadow: 0 7px 20px rgba(20,30,18,.06); text-align: center; }
  .zbt-vault-icon { display: grid; width: 24px; height: 24px; place-items: center; margin-bottom: 2px; border-radius: 7px; background: var(--active); color: #56740d; font-size: 10px; font-weight: 800; }
  .zbt-vault b { font-size: clamp(6px, 1.05vw, 8px); } .zbt-vault small { color: var(--muted); font-size: clamp(5px, .82vw, 6px); }
  .zbt-sync-grid { margin-top: 4%; }
  .zbt-sync-row { min-height: 28px; padding: 4px 7px; }
  .zbt-sync-row > span:last-child { color: #5d770d; font-size: 5.5px; font-weight: 700; opacity: .45; animation: zbt-sync 3s ease-in-out infinite; }
  .zbt-sync-row.row-two > span:last-child { animation-delay: -1s; } .zbt-sync-row.row-three > span:last-child { animation-delay: -2s; }
  .zbt-doc { width: 14px; height: 16px; border: 1px solid #bdc3bb; border-radius: 3px; background: linear-gradient(135deg, #fff 72%, #e7ebe4 72%); }

  .zbt-score { color: var(--muted); font-size: clamp(6px, 1vw, 8px); } .zbt-score b { color: var(--ink); font-size: clamp(12px, 2.2vw, 18px); }
  .zbt-security-cards { display: grid; grid-template-columns: repeat(3,1fr); gap: 5px; margin-top: 5%; }
  .zbt-security-card { min-width: 0; padding: 7px; border: 1px solid var(--line); border-radius: 7px; background: #fcfdfa; animation: zbt-card-glow 6s ease-in-out infinite; }
  .zbt-security-card:nth-child(2) { animation-delay: -2s; } .zbt-security-card:nth-child(3) { animation-delay: -4s; }
  .zbt-security-icon { display: grid; width: 20px; height: 20px; place-items: center; margin-bottom: 8px; border-radius: 6px; background: #edf1e9; font-size: 6px; font-weight: 800; }
  .zbt-security-card b { display: block; font-size: clamp(6px, 1vw, 8px); }
  .zbt-security-card small { display: block; min-height: 13px; margin-top: 2px; color: var(--muted); font-size: clamp(4.5px, .75vw, 5.5px); }
  .zbt-security-card > span { display: inline-block; margin-top: 6px; color: #5c740f; font-size: 5px; font-weight: 700; }
  .zbt-threat-card { margin-top: 5%; padding: 7px 9px; border: 1px solid var(--line); border-radius: 8px; background: #fff; }
  .zbt-threat-head { display: flex; justify-content: space-between; align-items: center; }
  .zbt-threat-head > div { display: grid; gap: 1px; } .zbt-threat-head b { font-size: clamp(6px, 1.05vw, 8px); }
  .zbt-chart { height: 48px; display: flex; align-items: end; gap: 3px; margin-top: 5px; padding-top: 5px; border-bottom: 1px solid var(--line); }
  .zbt-chart i { flex: 1; min-width: 2px; height: 20%; border-radius: 2px 2px 0 0; background: #d9e2ce; transform-origin: bottom; animation: zbt-bars 3.6s ease-in-out infinite; }
  .zbt-chart i:nth-child(2n) { height: 42%; animation-delay: -.4s; } .zbt-chart i:nth-child(3n) { height: 68%; animation-delay: -.8s; } .zbt-chart i:nth-child(5n) { height: 88%; animation-delay: -1.2s; }
  .zbt-threat-foot { display: flex; gap: 18%; padding-top: 6px; }
  .zbt-threat-foot span { display: grid; } .zbt-threat-foot b { font-size: clamp(7px, 1.2vw, 10px); } .zbt-threat-foot small { color: var(--muted); font-size: 5px; }

  .zbt-work-columns { display: grid; grid-template-columns: 63% 1fr; gap: 6px; margin-top: 5%; }
  .zbt-work-main, .zbt-activity-panel { border: 1px solid var(--line); border-radius: 8px; background: #fff; overflow: hidden; }
  .zbt-tabs { display: flex; gap: 10px; padding: 7px 8px 0; border-bottom: 1px solid var(--line); }
  .zbt-tabs span { padding-bottom: 6px; color: #8a9089; font-size: 5.5px; }
  .zbt-tabs span.is-active { color: var(--ink); border-bottom: 1.5px solid var(--ink); font-weight: 700; }
  .zbt-action-row { min-height: 35px; margin: 5px 6px; padding: 5px 6px; }
  .zbt-activity-panel { padding: 8px; }
  .zbt-activity { display: grid; grid-template-columns: auto 1fr; gap: 6px; align-items: flex-start; margin-top: 9px; opacity: .55; animation: zbt-activity 5s ease-in-out infinite; }
  .zbt-activity:nth-of-type(3) { animation-delay: -1.6s; } .zbt-activity:nth-of-type(4) { animation-delay: -3.2s; }
  .zbt-activity i { width: 6px; height: 6px; margin-top: 2px; border-radius: 50%; background: var(--accent); }
  .zbt-activity p { margin: 0; } .zbt-activity b { display: block; font-size: clamp(5px, .88vw, 6.5px); } .zbt-activity small { display: block; margin-top: 2px; color: var(--muted); font-size: 4.8px; }
  .workspace-note { right: 2.5%; bottom: 3%; width: 63%; animation: zbt-float 5.8s ease-in-out infinite; }

  @keyframes zbt-progress { 0%,15% { transform: scaleX(.18); } 58%,85% { transform: scaleX(1); } 100% { transform: scaleX(.18); } }
  @keyframes zbt-pulse { 0% { box-shadow: 0 0 0 0 rgba(147,201,38,.45); } 70% { box-shadow: 0 0 0 7px rgba(147,201,38,0); } 100% { box-shadow: 0 0 0 0 rgba(147,201,38,0); } }
  @keyframes zbt-float { 0%,100% { transform: translateY(7px); opacity: .78; } 30%,72% { transform: translateY(0); opacity: 1; } }
  @keyframes zbt-travel { 0% { left: 0; opacity: 0; } 12% { opacity: 1; } 86% { opacity: 1; } 100% { left: calc(100% - 5px); opacity: 0; } }
  @keyframes zbt-sync { 0%,18% { opacity: .25; } 45%,78% { opacity: 1; } 100% { opacity: .25; } }
  @keyframes zbt-card-glow { 0%,100% { box-shadow: 0 0 0 rgba(147,201,38,0); } 45% { box-shadow: inset 0 0 0 1px rgba(147,201,38,.28); } }
  @keyframes zbt-bars { 0%,100% { transform: scaleY(.42); opacity: .48; } 50% { transform: scaleY(1); opacity: 1; } }
