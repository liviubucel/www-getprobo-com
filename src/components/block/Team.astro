---
import MenuIcon from "../MenuIcon.astro";
import type { MenuIconName } from "../../content/menu";

type Discipline = {
  name: string;
  role: string;
  bio: string;
  icon: MenuIconName;
};

const leadDisciplines: Discipline[] = [
  {
    name: "Managed Compliance",
    role: "Controale, dovezi și audit readiness",
    bio: "Coordonăm programul de conformitate de la analiză și risk reviews până la politici, evidence, remediation și pregătirea continuă pentru audit.",
    icon: "shield-check",
  },
  {
    name: "Cyber Security",
    role: "Evaluare, hardening și remediere",
    bio: "Legăm cerințele de conformitate de măsuri tehnice reale: evaluare de securitate, protecția aplicațiilor și emailului, vulnerability management și răspuns la incidente.",
    icon: "magnifying-glass",
  },
];

const disciplines: Discipline[] = [
  ...leadDisciplines,
  {
    name: "Secure Infrastructure",
    role: "Hosting administrat și platform security",
    bio: "Infrastructură administrată cu hardening, izolare, backup, monitorizare și change management orientat spre securitate.",
    icon: "terminal-window",
  },
  {
    name: "Incident Response",
    role: "Evaluare, izolare și recuperare",
    bio: "Sprijin pentru evaluarea incidentului, izolarea cauzei, remediere și pașii de recuperare necesari după un eveniment de securitate.",
    icon: "clock-counter-clockwise",
  },
  {
    name: "Privacy & GRC",
    role: "Risc, guvernanță și privacy",
    bio: "Conectăm obligațiile de privacy, evaluările de risc, furnizorii și controalele într-un program care poate fi urmărit și demonstrat.",
    icon: "users-three",
  },
  {
    name: "Automation",
    role: "Integrări, evidence și workflows",
    bio: "Automatizăm colectarea dovezilor, integrările și operațiunile repetitive fără să înlocuim ownership-ul uman asupra deciziilor de securitate și conformitate.",
    icon: "code",
  },
];
---

<section class="container py-10 sm:py-20">
  <h2 class="text-h3 mb-10 font-medium sm:mb-20">Cum lucrăm</h2>

  <div class="flex flex-col gap-10 sm:flex-row sm:gap-20">
    {leadDisciplines.map((item) => (
      <article class="flex-1 space-y-2">
        <div class="bg-level-1 mb-4 grid size-[102px] place-items-center rounded-lg border sm:mb-8" aria-hidden="true">
          <MenuIcon name={item.icon} class="size-8" />
        </div>
        <h3 class="font-medium">{item.name}</h3>
        <div>{item.role}</div>
        <p class="text-lg">{item.bio}</p>
      </article>
    ))}
  </div>

  <hr class="my-10 sm:my-30" />

  <h2 class="text-h3 mb-10 font-medium sm:mb-20">Capabilități</h2>
  <div class="grid grid-cols-2 gap-4 sm:grid-cols-4">
    {disciplines.map((item) => (
      <article class="space-y-2">
        <div class="bg-level-1 mb-4 grid size-[102px] place-items-center rounded-lg border sm:mb-8" aria-hidden="true">
          <MenuIcon name={item.icon} class="size-7" />
        </div>
        <h3 class="font-medium">{item.name}</h3>
        <div>{item.role}</div>
      </article>
    ))}
  </div>
</section>
