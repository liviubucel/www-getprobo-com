---
const leads = [
  {
    name: "Cyber Security",
    role: "Security engineering & incident response",
    bio: "Evaluare tehnică, hardening, vulnerability management, protecția aplicațiilor și suport pentru incidente, conectate direct la riscul de business.",
  },
  {
    name: "Privacy & Compliance",
    role: "GDPR, NIS2 & audit readiness",
    bio: "Politici, controale, risk management și dovezi menținute într-un program continuu, nu într-un set static de documente.",
  },
];

const disciplines = [
  ...leads,
  {
    name: "Secure Infrastructure",
    role: "Managed hosting & platform security",
  },
  {
    name: "Digital Accessibility",
    role: "WCAG assessment & remediation",
  },
  {
    name: "Automation",
    role: "Integrations, evidence & workflows",
  },
  {
    name: "Security Governance",
    role: "Controls, vendors & continuous improvement",
  },
];
---

<section class="container py-10 sm:py-20">
  <h2 class="text-h3 mb-10 font-medium sm:mb-20">Cum lucrăm</h2>
  <div class="flex flex-col gap-10 sm:flex-row sm:gap-20">
    {
      leads.map((item) => (
        <article class="space-y-2 sm:flex-1">
          <div class="bg-active mb-4 grid size-20 place-items-center rounded-lg border text-lg font-medium sm:mb-8">
            {item.name
              .split(" ")
              .map((part) => part[0])
              .join("")
              .slice(0, 2)}
          </div>
          <h3 class="font-medium">{item.name}</h3>
          <div>{item.role}</div>
          <p class="text-lg">{item.bio}</p>
        </article>
      ))
    }
  </div>

  <hr class="my-10 sm:my-30" />

  <h2 class="text-h3 mb-10 font-medium sm:mb-20">Discipline conectate într-un singur program</h2>
  <div class="grid grid-cols-2 gap-4 sm:grid-cols-3">
    {
      disciplines.map((item) => (
        <article class="space-y-2">
          <div class="bg-level-1 mb-4 grid size-18 place-items-center rounded-lg border text-sm font-medium sm:mb-8">
            {item.name
              .split(" ")
              .map((part) => part[0])
              .join("")
              .slice(0, 2)}
          </div>
          <h3 class="font-medium">{item.name}</h3>
          <div class="text-muted-foreground">{item.role}</div>
        </article>
      ))
    }
  </div>
</section>
