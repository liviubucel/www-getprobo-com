---
import { Image } from "astro:assets";
import BryanPortrait from "../../assets/about/bryan-frimin.png";
import AntoinePortrait from "../../assets/about/antoine-bourchardy.png";
import LudovicPortrait from "../../assets/about/ludovic-vielle.jpeg";
import SachaPortrait from "../../assets/about/sacha-al-himdani.png";
import ArthurPortrait from "../../assets/about/arthur-mayoux.jpeg";
import EmilePortrait from "../../assets/about/emile-re.jpeg";

const disciplines = [
  {
    name: "Cyber Security",
    role: "Security engineering & incident response",
    bio: "Evaluare tehnică, hardening, vulnerability management, protecția aplicațiilor și suport pentru incidente, conectate direct la riscul de business.",
  },
  {
    name: "Privacy & Compliance",
    role: "GDPR, NIS2 & audit readiness",
    bio: "Politici, controale, risk management și dovezi menținute într-un program continuu, nu într-un set static de documente.",
  },
  {
    name: "Secure Infrastructure",
    role: "Managed hosting & platform security",
    bio: "Infrastructură administrată cu hardening, izolare, monitorizare și procese operaționale orientate spre securitate.",
  },
  {
    name: "Automation",
    role: "Integrations, evidence & workflows",
    bio: "Automatizare pentru evidence collection, workflow-uri, integrări și operațiuni repetitive de compliance.",
  },
];

const upstreamFounders = [
  {
    img: AntoinePortrait,
    alt: "Antoine Bourchardy",
    name: "Antoine Bourchardy",
    role: "Probo co-founder & CEO",
    bio: "ISO 27001 auditor with experience in compliance assessment and implementation.",
  },
  {
    img: BryanPortrait,
    alt: "Bryan Frimin",
    name: "Bryan Frimin",
    role: "Probo co-founder & CTO",
    bio: "YC alumnus and engineer with prior SOC 2 and ISO 27001 compliance experience.",
  },
];

const upstreamTeam = [
  { img: SachaPortrait, alt: "Sacha Al Himdani", name: "Sacha Al Himdani", role: "Probo Founding Engineer" },
  { img: ArthurPortrait, alt: "Arthur Mayoux", name: "Arthur Mayoux", role: "Probo Biz Ops" },
  { img: EmilePortrait, alt: "Émile Ré", name: "Émile Ré", role: "Probo Founding Engineer" },
  { img: LudovicPortrait, alt: "Ludovic Vielle", name: "Ludovic Vielle", role: "Probo Founding Engineer" },
];
---

<section class="container py-10 sm:py-20">
  <h2 class="text-h3 mb-10 font-medium sm:mb-16">Disciplinele ZebraByte</h2>
  <div class="grid gap-8 sm:grid-cols-2">
    {
      disciplines.map((item) => (
        <article class="space-y-2 rounded-xl border p-6 sm:p-8">
          <h3 class="text-xl font-medium">{item.name}</h3>
          <div class="text-muted-foreground">{item.role}</div>
          <p class="text-lg">{item.bio}</p>
        </article>
      ))
    }
  </div>

  <hr class="my-12 sm:my-24" />

  <div class="mb-10 max-w-3xl sm:mb-16">
    <p class="text-muted-foreground mb-3 text-sm font-medium uppercase tracking-[0.14em]">Upstream Probo</p>
    <h2 class="text-h3 mb-4 font-medium">Echipa originală din spatele proiectului pe care îl păstrăm</h2>
    <p class="text-muted-foreground text-lg">
      Păstrăm și istoria vizuală a proiectului Probo. Persoanele de mai jos apar ca echipa upstream Probo și nu sunt prezentate ca angajați ZebraByte.
    </p>
  </div>

  <div class="flex flex-col gap-10 sm:flex-row sm:gap-20">
    {
      upstreamFounders.map((f) => (
        <article class="space-y-2 sm:flex-1">
          <Image
            densities={[1, 2]}
            src={f.img}
            alt={f.alt}
            width={102}
            height={102}
            class="mb-4 rounded-lg sm:mb-8"
          />
          <h3 class="font-medium">{f.name}</h3>
          <div>{f.role}</div>
          <p class="text-lg">{f.bio}</p>
        </article>
      ))
    }
  </div>

  <div class="mt-12 grid grid-cols-2 gap-6 sm:mt-20 sm:grid-cols-4">
    {
      upstreamTeam.map((item) => (
        <article class="space-y-2">
          <Image
            densities={[1, 2]}
            src={item.img}
            alt={item.alt}
            width={102}
            height={102}
            class="mb-4 rounded-lg sm:mb-8"
          />
          <h3 class="font-medium">{item.name}</h3>
          <div class="text-muted-foreground">{item.role}</div>
        </article>
      ))
    }
  </div>
</section>
