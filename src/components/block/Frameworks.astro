---
import { Image } from "astro:assets";
import ZebraByteMark from "../../assets/zebrabyte-mark.svg";
import ProboMark from "../../assets/probo-logo-only.svg";
import Badges from "../Badges.svelte";
import Button from "../../components/ui/Button.svelte";
---

<div class="bg-linear-to-b from-[#F8FAF4] to-[#FFFFFB] py-10 sm:py-20">
  <div class="container">
    <div class="mx-auto mb-6 flex w-max items-center gap-3">
      <Image
        src={ZebraByteMark}
        alt="ZebraByte"
        width={48}
        height={48}
        class="size-12"
      />
      <span class="text-muted-foreground text-sm">+</span>
      <Image
        src={ProboMark}
        alt="Probo upstream"
        width={48}
        height={48}
        class="size-12"
      />
    </div>
    <h2 class="text-h3 sm:text-h2 mb-3 text-center font-medium">
      Framework-uri gestionate în aceeași experiență
    </h2>
    <p class="text-muted-foreground mx-auto mb-12 max-w-180 text-center text-lg">
      ZebraByte extinde experiența originală Probo cu servicii de cybersecurity,
      privacy și infrastructură securizată, păstrând biblioteca de framework-uri,
      controale și dovezi. Badge-urile indică framework-uri suportate în platformă,
      nu certificări deținute automat de ZebraByte.
    </p>

    <Badges
      count={10}
      countMobile={9}
      client:visible
      class="mx-auto mb-13 grid max-w-[660px] grid-cols-3 justify-center justify-items-center gap-2 gap-y-10 sm:grid-cols-5 sm:gap-x-10"
    />

    <Button
      rel="nofollow noreferrer"
      href="/contact"
      size="lg"
      class="mx-auto flex w-max"
    >
      Discută despre conformitate
    </Button>
  </div>
</div>
