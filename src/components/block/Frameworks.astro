---
import Badges from "../Badges.svelte";
import Button from "../../components/ui/Button.svelte";
---

<div class="bg-linear-to-b from-[#F8FAF4] to-[#FFFFFB] py-10 sm:py-20">
  <div class="container">
    <img
      src="/images/zbt-negru.svg"
      alt="ZebraByte"
      width="122"
      height="44"
      class="mx-auto mb-6 h-11 w-auto object-contain"
    />
    <h2 class="text-h3 sm:text-h2 mb-3 text-center font-medium">
      Managed frameworks
    </h2>
    <p class="text-muted-foreground mx-auto mb-12 max-w-2xl text-center text-lg">
      Managed compliance pentru framework-uri de securitate, privacy și governance,
      conectat direct la controalele tehnice și evidence-ul organizației.
    </p>

    <Badges
      count={10}
      countMobile={9}
      client:visible
      class="mx-auto mb-13 grid max-w-[660px] grid-cols-3 justify-center justify-items-center gap-2 gap-y-10 sm:grid-cols-5 sm:gap-x-10"
    />

    <Button
      rel="nofollow noreferrer"
      href="/managed-compliance"
      size="lg"
      class="mx-auto flex w-max"
    >
      Explorează Managed Compliance
    </Button>
  </div>
</div>
