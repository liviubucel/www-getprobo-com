---
import { Image } from "astro:assets";
import Logo from "../../assets/zebrabyte-mark.svg";
import Badges from "../Badges.svelte";
import Button from "../../components/ui/Button.svelte";
---

<div class="bg-linear-to-b from-[#F8FAF4] to-[#FFFFFB] py-10 sm:py-20">
  <div class="container">
    <Image
      src={Logo}
      alt="ZebraByte"
      width={48}
      height={48}
      class="mx-auto mb-6"
    />
    <h2 class="text-h3 sm:text-h2 mb-3 text-center font-medium">
      Framework-uri și standarde gestionate în platformă
    </h2>
    <p class="text-muted-foreground mx-auto mb-12 max-w-180 text-center text-lg">
      Platforma poate organiza controale, dovezi și activități pentru mai multe
      framework-uri de securitate și conformitate. Afișarea unui badge indică
      suportul în platformă, nu o certificare deținută automat de ZebraByte.
    </p>

    <Badges
      count={10}
      countMobile={9}
      client:visible
      class="mx-auto mb-13 grid max-w-[660px] grid-cols-3 justify-center justify-items-center gap-2 gap-y-10 sm:grid-cols-5 sm:gap-x-10"
    />

    <Button
      rel="nofollow noreferrer"
      href="/contact"
      size="lg"
      class="mx-auto flex w-max"
    >
      Discută despre conformitate
    </Button>
  </div>
</div>
