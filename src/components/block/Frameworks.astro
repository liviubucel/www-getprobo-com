---
import { Image } from "astro:assets";
import Mark from "../../assets/zebrabyte-mark.svg";
import Badges from "../Badges.svelte";
import Button from "../../components/ui/Button.svelte";
---

<div class="frameworks-section bg-linear-to-b from-[#F8FAF4] to-[#FFFFFB] py-10 sm:py-20">
  <div class="container">
    <Image
      src={Mark}
      alt="ZebraByte"
      width={48}
      height={48}
      class="mx-auto mb-6"
    />
    <h2 class="text-h3 sm:text-h2 mb-3 text-center font-medium">
      <span class="frameworks-ro" lang="ro">Framework-uri gestionate</span>
      <span class="frameworks-en" lang="en">Managed frameworks</span>
    </h2>
    <p class="text-muted-foreground mb-12 text-center text-lg">
      <span class="frameworks-ro" lang="ro">
        Nu găsești framework-ul pe care îl cauți?<br />
        Discută cu noi — este posibil să îl putem include în program.
      </span>
      <span class="frameworks-en" lang="en">
        Not seeing the framework you are looking for?<br />
        Reach out — we may already support it in the programme.
      </span>
    </p>

    <Badges
      count={10}
      countMobile={9}
      client:visible
      class="mx-auto mb-13 grid max-w-[660px] grid-cols-3 justify-center justify-items-center gap-2 gap-y-10 sm:grid-cols-5 sm:gap-x-10"
    />

    <Button
      rel="nofollow noreferrer"
      href="/contact"
      size="lg"
      class="mx-auto flex w-fit max-w-full"
    >
      <span class="frameworks-ro" lang="ro">Discută cu un expert</span>
      <span class="frameworks-en" lang="en">Talk to an expert</span>
    </Button>
  </div>
</div>

<style>
  .frameworks-section {
    content-visibility: auto;
    contain-intrinsic-size: 680px;
  }

  .frameworks-en {
    display: none;
  }

  :global(html[lang="en"]) .frameworks-ro {
    display: none;
  }

  :global(html[lang="en"]) .frameworks-en {
    display: inline;
  }
</style>
