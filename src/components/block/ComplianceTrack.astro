---
import ComplianceTrackItem from "../ui/ComplianceTrackItem.astro";
---

<section class="animate-fade-in animation-delay-500 container py-10 sm:py-20">
  <h2
    class="text-h3 sm:text-h2 intersect-once intersect:animate-slide-in mb-3 text-center font-medium"
  >
    De la haos la control
  </h2>
  <p
    class="text-muted-foreground intersect-once intersect:animate-slide-in motion-delay-100 mx-auto mb-10 max-w-180 text-center text-lg sm:mb-16"
  >
    Specialiștii noștri coordonează întregul parcurs — de la configurare și evaluarea
    riscurilor până la audit și monitorizare continuă — astfel încât echipa ta să rămână
    concentrată pe activitatea principală.
  </p>
  <compliance-track class="flex flex-col gap-6 sm:flex-row sm:gap-16">
    <ComplianceTrackItem position="01" title="Analiză și plan">
      Începem cu evaluarea mediului, a riscurilor și a furnizorilor, identificăm lacunele și
      stabilim pașii prioritari. Apoi construim un program de conformitate adaptat modului în
      care lucrează echipa ta.
    </ComplianceTrackItem>
    <ComplianceTrackItem position="02" title="Implementare și audit">
      Colectarea dovezilor este automatizată prin platformă, iar echipa noastră pregătește
      documentele și coordonează comunicarea necesară pentru audit. Participi doar acolo unde
      este nevoie, cu pregătire și context clar.
    </ComplianceTrackItem>
    <ComplianceTrackItem position="03" title="Conformitate continuă">
      După finalizarea auditului, programul continuă în fundal: monitorizăm schimbările,
      actualizăm controalele, reînnoim dovezile și menținem evaluările la zi pentru o pregătire
      continuă.
    </ComplianceTrackItem>
  </compliance-track>
</section>

<script>
  import { customElementDefine } from "../../lib/dom";

  class ComplianceTrack extends HTMLElement {
    private observer: IntersectionObserver | null = null;
    private timers: number[] = [];
    private started = false;

    connectedCallback() {
      const activateAll = () => {
        Array.from(this.children).forEach((child) => child.setAttribute("data-active", "true"));
      };

      if (window.matchMedia("(prefers-reduced-motion: reduce)").matches) {
        activateAll();
        return;
      }

      this.observer = new IntersectionObserver(
        (entries) => {
          if (this.started || !entries.some((entry) => entry.isIntersecting)) return;
          this.started = true;

          Array.from(this.children).forEach((child, index) => {
            const timer = window.setTimeout(() => {
              child.setAttribute("data-active", "true");
            }, 1000 + index * 2000);
            this.timers.push(timer);
          });

          this.observer?.disconnect();
          this.observer = null;
        },
        { threshold: 0.2 },
      );
      this.observer.observe(this);
    }

    disconnectedCallback() {
      this.timers.forEach((timer) => window.clearTimeout(timer));
      this.timers = [];
      this.observer?.disconnect();
      this.observer = null;
    }
  }

  customElementDefine("compliance-track", () => ComplianceTrack);
</script>

<style>
  .compliance-item[data-active] .square {
    animation: squareIn 0.5s ease-in-out;
  }

  @keyframes squareIn {
    0% {
      transform: scale(1);
    }
    50% {
      transform: scale(0.5);
    }
    100% {
      transform: scale(1);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .compliance-item[data-active] .square {
      animation: none;
    }
  }
</style>
