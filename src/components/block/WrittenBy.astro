---
import clsx from "clsx";
import { Image } from "astro:assets";
import AntoinePortrait from "../../assets/antoine-bourchardy.png";
import ArthurPortrait from "../../assets/arthur-mayoux-blog.svg";
import BryanPortrait from "../../assets/bryan_firmin.svg";
import EmilePortrait from "../../assets/emile_blog.svg";

interface Props {
  class?: string;
  author?: string;
}

const { class: className, author } = Astro.props;

const authors = [
  {
    name: "Antoine Bouchardy",
    portrait: AntoinePortrait,
    linkedin: "https://www.linkedin.com/in/antoinebouchardy/",
    bio: "CEO și co-fondator Probo; autor original al articolelor upstream despre compliance, startup-uri și reglementare.",
  },
  {
    name: "Bryan Frimin",
    portrait: BryanPortrait,
    linkedin: "https://www.linkedin.com/in/gearnode/",
    bio: "CTO și co-fondator Probo; autor original pe teme de cybersecurity și platforme open-source de compliance.",
  },
  {
    name: "Arthur Mayoux",
    portrait: ArthurPortrait,
    linkedin: "https://www.linkedin.com/in/arthurmayoux/",
    bio: "Chief of Staff la Probo; autor original al unor materiale din arhiva upstream.",
  },
  {
    name: "Émile Ré",
    portrait: EmilePortrait,
    bio: "Founding engineer la Probo; autor original pe partea tehnică a platformei open-source de compliance.",
  },
];

const selectedAuthors = author
  ? authors.filter((item) => item.name === author)
  : authors;
---

<div class={clsx("flex flex-col gap-6", className)}>
  <div class="bg-active rounded-lg border p-4 text-xs leading-relaxed text-muted-foreground">
    <strong class="text-foreground">Atribuire upstream:</strong> articolele din
    această arhivă au fost publicate inițial în proiectul Probo. ZebraByte le
    păstrează pentru continuitatea resursei open-source, fără a modifica identitatea
    autorilor originali.
  </div>

  <div class="flex flex-col gap-8 sm:gap-10">
    {
      selectedAuthors.map((item) => (
        <div class="flex flex-col gap-6 sm:flex-row sm:items-center sm:gap-8">
          <div class="flex flex-1 flex-col gap-2">
            <div class="text-xs font-medium">Autor original: {item.name}</div>
            <div class="text-muted-foreground text-xs leading-relaxed">
              {item.linkedin ? (
                <a href={item.linkedin} class="text-success" target="_blank" rel="noopener noreferrer">
                  {item.name}
                </a>
              ) : (
                item.name
              )}{" "}
              — {item.bio}
            </div>
          </div>
          <Image
            src={item.portrait}
            alt={`Portret ${item.name}`}
            class="mx-auto block size-20 shrink-0 sm:mx-0 sm:size-24"
            width={164}
            height={164}
          />
        </div>
      ))
    }
  </div>
</div>
