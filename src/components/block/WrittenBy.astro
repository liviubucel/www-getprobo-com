---
import clsx from "clsx";
import { Image } from "astro:assets";
import AntoinePortrait from "../../assets/antoine-bourchardy.png";
import ArthurPortrait from "../../assets/arthur-mayoux-blog.svg";
import BryanPortrait from "../../assets/bryan_firmin.svg";
import EmilePortrait from "../../assets/emile_blog.svg";

interface Props {
  class?: string;
  author?: string;
}

const { class: className, author } = Astro.props;

const showBoth = !author;
const isAntoine = author === "Antoine Bouchardy";
const isArthur = author === "Arthur Mayoux";
const isBryan = author === "Bryan Frimin";
const isEmile = author === "Émile Ré";
---

{
  showBoth && (
    <div class={clsx("flex flex-col gap-8 sm:gap-10", className)}>
      <div class="text-xs font-medium">
        Written by Antoine Bouchardy, Bryan Frimin, Arthur Mayoux and Émile Ré
      </div>

      <div class="flex flex-col gap-6 sm:flex-row sm:items-center sm:gap-10">
        <div class="flex flex-col gap-2">
          <div class="text-muted-foreground text-xs">
            <a href="https://www.linkedin.com/in/antoinebouchardy/" class="text-success">Antoine Bouchardy</a>
            {" "}writes about the challenges founders and security teams face when balancing growth, compliance and regulation.
          </div>
        </div>
        <Image densities={[1, 2]} src={AntoinePortrait} alt="Portrait Antoine Bouchardy" class="mx-auto block shrink-0 sm:mx-0 sm:size-25" width={164} height={164} />
      </div>

      <div class="flex flex-col gap-6 sm:flex-row sm:items-center sm:gap-10">
        <div class="flex flex-col gap-2">
          <div class="text-muted-foreground text-xs">
            <a href="https://www.linkedin.com/in/gearnode/" class="text-success">Bryan Frimin</a>
            {" "}writes about cyber security, engineering and practical compliance automation.
          </div>
        </div>
        <Image src={BryanPortrait} alt="Portrait Bryan Frimin" class="mx-auto block shrink-0 sm:mx-0 sm:size-25" width={164} height={164} />
      </div>

      <div class="flex flex-col gap-6 sm:flex-row sm:items-center sm:gap-10">
        <div class="flex flex-col gap-2">
          <div class="text-muted-foreground text-xs">
            <a href="https://www.linkedin.com/in/arthurmayoux/" class="text-success">Arthur Mayoux</a>
            {" "}writes about operations, compliance programs and the work required to scale security processes.
          </div>
        </div>
        <Image src={ArthurPortrait} alt="Portrait Arthur Mayoux" class="mx-auto block shrink-0 sm:mx-0 sm:size-25" width={164} height={164} />
      </div>

      <div class="flex flex-col gap-6 sm:flex-row sm:items-center sm:gap-10">
        <div class="flex flex-col gap-2">
          <div class="text-muted-foreground text-xs">
            Émile Ré writes about the technical side of compliance platforms, integrations and engineering workflows.
          </div>
        </div>
        <Image src={EmilePortrait} alt="Portrait Émile Ré" class="mx-auto block shrink-0 sm:mx-0 sm:size-25" width={164} height={164} />
      </div>
    </div>
  )
}

{
  (isAntoine || isArthur || isBryan || isEmile) && (
    <div class={clsx("flex flex-col gap-6 sm:flex-row sm:items-center sm:gap-10", className)}>
      <div class="flex flex-col gap-2">
        {isAntoine && (
          <>
            <div class="text-xs font-medium">Written by Antoine Bouchardy</div>
            <div class="text-muted-foreground text-xs">
              <a href="https://www.linkedin.com/in/antoinebouchardy/" class="text-success">Antoine Bouchardy</a>
              {" "}writes about the challenges founders and security teams face when balancing growth, compliance and regulation.
            </div>
          </>
        )}
        {isArthur && (
          <>
            <div class="text-xs font-medium">Written by Arthur Mayoux</div>
            <div class="text-muted-foreground text-xs">
              <a href="https://www.linkedin.com/in/arthurmayoux/" class="text-success">Arthur Mayoux</a>
              {" "}writes about operations, compliance programs and scaling security processes.
            </div>
          </>
        )}
        {isBryan && (
          <>
            <div class="text-xs font-medium">Written by Bryan Frimin</div>
            <div class="text-muted-foreground text-xs">
              <a href="https://www.linkedin.com/in/gearnode/" class="text-success">Bryan Frimin</a>
              {" "}writes about cyber security, engineering and practical compliance automation.
            </div>
          </>
        )}
        {isEmile && (
          <>
            <div class="text-xs font-medium">Written by Émile Ré</div>
            <div class="text-muted-foreground text-xs">Émile Ré writes about integrations, engineering workflows and the technical side of compliance platforms.</div>
          </>
        )}
      </div>

      {isAntoine && <Image densities={[1, 2]} src={AntoinePortrait} alt="Portrait Antoine Bouchardy" class="mx-auto block shrink-0 sm:mx-0 sm:size-25" width={164} height={164} />}
      {isArthur && <Image src={ArthurPortrait} alt="Portrait Arthur Mayoux" class="mx-auto block shrink-0 sm:mx-0 sm:size-25" width={164} height={164} />}
      {isBryan && <Image src={BryanPortrait} alt="Portrait Bryan Frimin" class="mx-auto block shrink-0 sm:mx-0 sm:size-25" width={164} height={164} />}
      {isEmile && <Image src={EmilePortrait} alt="Portrait Émile Ré" class="mx-auto block shrink-0 sm:mx-0 sm:size-25" width={164} height={164} />}
    </div>
  )
}
