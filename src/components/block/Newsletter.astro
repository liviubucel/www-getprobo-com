---
import clsx from "clsx";
import Button from "../ui/Button.svelte";
import { tv } from "tailwind-variants";

const newsletter = tv({
  base: "",
  variants: {
    variant: {
      default: "bg-subtle rounded-3xl p-6 sm:p-8",
      footer: "sm:max-w-[320px]",
    },
  },
  defaultVariants: {
    variant: "default",
  },
});

const props = Astro.props;
const turnstileSiteKey = "0x4AAAAAABBpDfopxKwUIKF_";
---

<newsletter-form>
  <div class={newsletter(Astro.props)}>
    <form class={clsx(props.variant !== "footer" && "@sm:flex @sm:items-start gap-10")}>
      <div
        class={clsx(
          "mb-5 @sm:max-w-72 @sm:mb-0",
          props.variant === "footer" ? "text-sm" : "text-lg font-medium",
        )}
      >
        Primește analize și ghiduri ZebraByte despre cyber security, privacy și compliance.
      </div>

      <div class="min-w-0 flex-1 space-y-3">
        <input
          class={clsx(
            "border-border-mid placeholder:text-quaternary bg-secondary w-full rounded-lg border px-3",
            props.variant === "footer" ? "h-9" : "h-11 sm:h-10",
          )}
          name="email"
          type="email"
          maxlength="254"
          required
          autocomplete="email"
          placeholder="Email"
          aria-label="Adresa de email"
        />

        <label class="text-muted-foreground flex items-start gap-2 text-xs leading-relaxed">
          <input class="mt-0.5" type="checkbox" name="consent" value="yes" required />
          <span>
            Sunt de acord cu prelucrarea adresei pentru newsletter. Abonarea se confirmă prin email și poate fi retrasă oricând.
          </span>
        </label>

        <div
          class="max-w-full overflow-hidden"
          data-turnstile-container
          data-sitekey={turnstileSiteKey}
          data-size="flexible"
          role="group"
                aria-label="Verificare de securitate"
        ></div>

        <div class="flex flex-wrap items-center gap-3">
          <Button
            type="submit"
            class={clsx(
              "text-base",
              props.variant === "footer" ? "h-9 w-max" : "h-11 sm:h-10",
            )}
          >
            Abonează-mă
          </Button>
          <span class="text-muted-foreground hidden text-xs" data-status aria-live="polite"></span>
        </div>
      </div>
    </form>

    <div
      class={clsx(
        "hidden",
        props.variant === "footer" ? "text-sm" : "text-lg font-medium",
      )}
      data-success
    >
      Verifică inbox-ul pentru linkul de confirmare. Abonarea devine activă numai după confirmare.
    </div>
  </div>
</newsletter-form>

<script>
  import { customElementDefine } from "../../lib/dom";
  import { browserT, getBrowserLocale } from "../../lib/browser-i18n";
  import {
    ensureTurnstileToken,
    lazyRenderTurnstile,
    resetTurnstile,
  } from "../../lib/turnstile";

  class NewsletterForm extends HTMLElement {
    private turnstileCleanup?: () => void;

    connectedCallback() {
      const form = this.querySelector("form") as HTMLFormElement | null;
      const success = this.querySelector<HTMLElement>("[data-success]");
      const status = this.querySelector<HTMLElement>("[data-status]");
      const button = form?.querySelector("button") as HTMLButtonElement | null;
      const turnstile = this.querySelector<HTMLElement>("[data-turnstile-container]");
      if (!form || !success || !status || !button) return;

      this.turnstileCleanup?.();
      this.turnstileCleanup = lazyRenderTurnstile(turnstile);

      form.addEventListener("submit", async (event) => {
        event.preventDefault();
        button.disabled = true;
        button.textContent = browserT("Se verifică...", "Verifying...");
        status.classList.add("hidden");
        status.textContent = "";

        try {
          const verified = await ensureTurnstileToken(turnstile);
          if (!verified) {
            status.textContent = browserT(
              "Verificarea de securitate nu este încă disponibilă. Încearcă din nou.",
              "Security verification is not ready yet. Please try again.",
            );
            status.classList.remove("hidden");
            return;
          }

          button.textContent = browserT("Se trimite...", "Sending...");
          const response = await fetch("/api/newsletter/subscribe", {
            method: "POST",
            headers: { "Accept-Language": getBrowserLocale() },
            body: new FormData(form),
          });
          const payload = (await response.json()) as {
            success?: boolean;
            error?: string;
            alreadySubscribed?: boolean;
          };

          if (!response.ok || !payload.success) {
            status.textContent = browserT(
              "Abonarea nu a putut fi procesată.",
              "Your subscription could not be processed.",
            );
            status.classList.remove("hidden");
            return;
          }

          form.hidden = true;
          success.classList.remove("hidden");
          if (payload.alreadySubscribed) {
            success.textContent = browserT(
              "Adresa este deja abonată la newsletter-ul ZebraByte.",
              "This email address is already subscribed to the ZebraByte newsletter.",
            );
          } else {
            success.textContent = browserT(
              "Verifică inbox-ul pentru linkul de confirmare. Abonarea devine activă numai după confirmare.",
              "Check your inbox for the confirmation link. Your subscription becomes active only after confirmation.",
            );
          }
        } catch {
          status.textContent = browserT(
            "A apărut o eroare de rețea. Încearcă din nou.",
            "A network error occurred. Please try again.",
          );
          status.classList.remove("hidden");
        } finally {
          resetTurnstile(turnstile);
          button.disabled = false;
          button.textContent = browserT("Abonează-mă", "Subscribe");
        }
      });
    }

    disconnectedCallback() {
      this.turnstileCleanup?.();
      this.turnstileCleanup = undefined;
    }
  }

  customElementDefine("newsletter-form", () => NewsletterForm);
</script>
