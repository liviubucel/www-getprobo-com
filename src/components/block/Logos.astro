---
import { clsx } from "clsx";
import LogosScroll from "../LogosScroll.svelte";

type Props = {
  constrained?: boolean;
  class?: string;
};

const technologies = [
  { name: "Cloudflare", href: "https://www.cloudflare.com" },
  { name: "Microsoft", href: "https://www.microsoft.com" },
  { name: "GitHub", href: "https://github.com" },
  { name: "Stripe", href: "https://stripe.com" },
  { name: "Sanity", href: "https://www.sanity.io" },
  { name: "Sentry", href: "https://sentry.io" },
  { name: "Zoho", href: "https://www.zoho.com" },
  { name: "iubenda", href: "https://www.iubenda.com" },
  { name: "20i", href: "https://www.20i.com" },
  { name: "Astro", href: "https://astro.build" },
];
---

<section
  class={clsx(
    "relative overflow-hidden p-0",
    Astro.props.class,
    Astro.props.constrained && "mx-auto sm:max-w-270",
  )}
>
  <LogosScroll class="flex h-16 w-max items-center sm:h-30" client:load>
    {
      technologies.map((technology) => (
        <a
          href={technology.href}
          target="_blank"
          rel="noopener noreferrer"
          class="mx-4 flex w-30 flex-none items-center justify-center sm:mx-12 sm:w-44"
          aria-label={technology.name}
        >
          <span class="text-primary/75 text-lg font-semibold tracking-[-0.03em] sm:text-xl">
            {technology.name}
          </span>
        </a>
      ))
    }
  </LogosScroll>

  {
    Astro.props.constrained && (
      <>
        <div class="absolute top-0 right-0 h-full w-5 bg-linear-to-l from-[#FFFFFB] to-[#FFFFFB]/0 sm:w-10" />
        <div class="absolute top-0 left-0 h-full w-5 bg-linear-to-r from-[#FFFFFB] to-[#FFFFFB]/0 sm:w-10" />
      </>
    )
  }
</section>
