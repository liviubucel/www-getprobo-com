---
import { clsx } from "clsx";
import LogosScroll from "../LogosScroll.svelte";
import MenuIcon from "../MenuIcon.astro";
import type { MenuIconName } from "../../content/menu";

type Props = {
  constrained?: boolean;
  class?: string;
};

type Capability = {
  label: string;
  href: string;
  icon: MenuIconName;
};

const capabilities: Capability[] = [
  { label: "Managed Compliance", href: "/managed-compliance", icon: "shield-check" },
  { label: "Cyber Security", href: "/cyber-security", icon: "magnifying-glass" },
  { label: "Secure Hosting", href: "/secure-hosting", icon: "terminal-window" },
  { label: "Incident Response", href: "/incident-response", icon: "clock-counter-clockwise" },
  { label: "Website Security", href: "/website-security", icon: "monitor" },
  { label: "Email Security", href: "/email-security", icon: "shield-check" },
  { label: "ISO/IEC 27001", href: "/iso-27001", icon: "book-open-text" },
  { label: "SOC 2", href: "/soc2", icon: "article" },
  { label: "GDPR", href: "/gdpr", icon: "users-three" },
  { label: "NIS2", href: "/nis2", icon: "compass" },
  { label: "Accesibilitate", href: "/accessibility", icon: "sparkle" },
];
---

<section
  class={clsx(
    "relative overflow-hidden p-0",
    Astro.props.class,
    Astro.props.constrained && "mx-auto sm:max-w-270",
  )}
  aria-label="Capabilități ZebraByte"
>
  <LogosScroll class="flex h-16 w-max items-center sm:h-30" client:load>
    {capabilities.map((capability) => (
      <a
        href={capability.href}
        class="mx-4 flex w-44 flex-none items-center justify-center gap-3 sm:mx-12 sm:w-56"
      >
        <span class="bg-level-1 grid size-9 shrink-0 place-items-center rounded-lg border" aria-hidden="true">
          <MenuIcon name={capability.icon} class="size-5" />
        </span>
        <span class="text-primary whitespace-nowrap text-sm font-medium sm:text-base">
          {capability.label}
        </span>
      </a>
    ))}
  </LogosScroll>

  {Astro.props.constrained && (
    <>
      <div class="absolute top-0 right-0 h-full w-5 bg-linear-to-l from-[#FFFFFB] to-[#FFFFFB]/0 sm:w-10" aria-hidden="true" />
      <div class="absolute top-0 left-0 h-full w-5 bg-linear-to-r from-[#FFFFFB] to-[#FFFFFB]/0 sm:w-10" aria-hidden="true" />
    </>
  )}
</section>
