---
import ZebraByteLogo from "./ZebraByteLogo.astro";
import HeaderMenu from "./HeaderMenu.astro";
import AccountMenu from "./AccountMenu.astro";
import Button from "./ui/Button.svelte";
import MobileMenu from "./MobileMenu.astro";
import Icon from "./Icon.astro";
import { menuGroups } from "../content/menu";

type Props = {
  hideBurger?: boolean;
  docsChrome?: boolean;
};

const { hideBurger = false, docsChrome = false } = Astro.props;
---

<header
  data-site-header
  class:list={[
    "page-header text-primary transition-all",
    docsChrome
      ? "bg-transparent"
      : "bg-secondary/90 sticky top-0 z-50 border-b backdrop-blur-md",
  ]}
>
  <div
    class:list={[
      "mx-auto flex min-h-16 items-center py-2.5 sm:py-3",
      docsChrome
        ? "docs-header-inner w-full max-w-none px-[var(--docs-page-padding-x)]"
        : "container",
    ]}
  >
    <ZebraByteLogo class="mr-auto" />

    <nav
      class="hidden items-center gap-2.25 xl:flex"
      transition:name="header-nav"
      aria-label="Navigație principală"
    >
      <HeaderMenu groups={menuGroups} />
    </nav>

    <div class="ml-auto hidden items-center gap-2 xl:ml-3 xl:flex" transition:name="header-actions">
      <Button href="/contact" class="h-8 px-3 whitespace-nowrap">
        Discută cu un expert
      </Button>
      <AccountMenu />
    </div>

    <slot />

    {
      !hideBurger && (
        <div class="ml-auto flex items-center gap-1 xl:hidden">
          <a
            href="https://portal.zebrabyte.ro"
            target="_blank"
            rel="noopener noreferrer"
            class="text-muted-foreground hover:text-primary grid size-10 place-items-center rounded-lg transition-colors"
            aria-label="Portal clienți ZebraByte"
            title="Portal clienți"
          >
            <svg
              viewBox="0 0 24 24"
              width="20"
              height="20"
              fill="none"
              stroke="currentColor"
              stroke-width="1.8"
              stroke-linecap="round"
              stroke-linejoin="round"
              aria-hidden="true"
            >
              <circle cx="12" cy="7" r="4" />
              <path d="M4 21a8 8 0 0 1 16 0" />
            </svg>
          </a>

          <burger-menu
            class="group grid size-10 cursor-pointer place-items-center rounded-lg transition-colors hover:bg-subtle"
            aria-label="Deschide meniul"
            aria-expanded="false"
            aria-controls="mobile-menu"
            role="button"
            tabindex="0"
          >
            <span class="relative grid size-6 place-items-center" aria-hidden="true">
              <Icon name="list" size={22} class="group-aria-expanded:hidden" />
              <Icon name="x" size={22} class="hidden group-aria-expanded:block" />
            </span>
          </burger-menu>
        </div>
      )
    }
  </div>
</header>

<MobileMenu id="mobile-menu" />

<script>
  import { customElementDefine } from "../lib/dom";

  class BurgerMenu extends HTMLElement {
    menu = document.querySelector("#mobile-menu") as HTMLElement | null;
    hideTimer: number | null = null;

    connectedCallback() {
      this.addEventListener("click", this.toggleExpanded);
      this.addEventListener("keydown", this.onButtonKeyDown);
      document.addEventListener("keydown", this.closeOnEscape);
      this.menu?.addEventListener("click", this.closeAfterNavigation);
      window.addEventListener("resize", this.closeOnDesktop);
      this.setExpanded(false, false);
    }

    disconnectedCallback() {
      this.removeEventListener("click", this.toggleExpanded);
      this.removeEventListener("keydown", this.onButtonKeyDown);
      document.removeEventListener("keydown", this.closeOnEscape);
      this.menu?.removeEventListener("click", this.closeAfterNavigation);
      window.removeEventListener("resize", this.closeOnDesktop);
      if (this.hideTimer) window.clearTimeout(this.hideTimer);
      this.unlockPage();
    }

    lockPage() {
      document.body.style.setProperty("overflow", "hidden");
      document.documentElement.style.setProperty("overflow", "hidden");
      this.closest("header")?.classList.add("mobile-menu-open");
    }

    unlockPage() {
      document.body.style.removeProperty("overflow");
      document.documentElement.style.removeProperty("overflow");
      this.closest("header")?.classList.remove("mobile-menu-open");
    }

    setExpanded(expanded: boolean, animate = true) {
      if (!this.menu) return;
      if (this.hideTimer) {
        window.clearTimeout(this.hideTimer);
        this.hideTimer = null;
      }

      this.setAttribute("aria-expanded", String(expanded));
      this.setAttribute(
        "aria-label",
        expanded ? "Închide meniul" : "Deschide meniul",
      );

      if (expanded) {
        this.menu.hidden = false;
        this.menu.setAttribute("aria-hidden", "false");
        this.lockPage();

        requestAnimationFrame(() => {
          this.menu?.classList.remove(
            "pointer-events-none",
            "-translate-y-2",
            "opacity-0",
          );
          this.menu?.classList.add(
            "pointer-events-auto",
            "translate-y-0",
            "opacity-100",
          );
        });
        return;
      }

      this.unlockPage();
      this.menu.setAttribute("aria-hidden", "true");
      this.menu.classList.add(
        "pointer-events-none",
        "-translate-y-2",
        "opacity-0",
      );
      this.menu.classList.remove(
        "pointer-events-auto",
        "translate-y-0",
        "opacity-100",
      );

      if (!animate) {
        this.menu.hidden = true;
        return;
      }

      this.hideTimer = window.setTimeout(() => {
        if (this.menu && this.getAttribute("aria-expanded") !== "true") {
          this.menu.hidden = true;
        }
      }, 180);
    }

    toggleExpanded = () =>
      this.setExpanded(this.getAttribute("aria-expanded") !== "true");

    onButtonKeyDown = (event: KeyboardEvent) => {
      if (event.key !== "Enter" && event.key !== " ") return;
      event.preventDefault();
      this.toggleExpanded();
    };

    closeOnEscape = (event: KeyboardEvent) => {
      if (
        event.key === "Escape" &&
        this.getAttribute("aria-expanded") === "true"
      ) {
        event.preventDefault();
        this.setExpanded(false);
        this.focus();
      }
    };

    closeAfterNavigation = (event: Event) => {
      if (event.target instanceof Element && event.target.closest("a")) {
        this.setExpanded(false);
      }
    };

    closeOnDesktop = () => {
      if (
        window.matchMedia("(min-width: 1280px)").matches &&
        this.getAttribute("aria-expanded") === "true"
      ) {
        this.setExpanded(false, false);
      }
    };
  }

  customElementDefine("burger-menu", () => BurgerMenu);
</script>

<style>
  @media (max-width: 1279px) {
    .page-header.mobile-menu-open {
      position: fixed;
      inset: 0 0 auto 0;
      width: 100%;
      z-index: 50;
    }
  }
</style>
