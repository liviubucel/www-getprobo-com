---
import ZebraByteLogo from "./ZebraByteLogo.astro";
import HeaderMenu from "./HeaderMenu.astro";
import AccountMenu from "./AccountMenu.astro";
import LanguageSwitcher from "./LanguageSwitcher.astro";
import Button from "./ui/Button.svelte";
import MobileMenu from "./MobileMenu.astro";
import Icon from "./Icon.astro";
import { menuGroups } from "../content/menu";

type Props = {
  hideBurger?: boolean;
  docsChrome?: boolean;
};

const { hideBurger = false, docsChrome = false } = Astro.props;
---

<header
  data-site-header
  class:list={[
    "page-header text-primary transition-all",
    docsChrome
      ? "bg-transparent"
      : "bg-secondary/90 sticky top-0 z-50 border-b backdrop-blur-md",
  ]}
>
  <div
    class:list={[
      "mx-auto flex min-h-16 items-center py-2.5 sm:py-3",
      docsChrome
        ? "docs-header-inner w-full max-w-none px-[var(--docs-page-padding-x)]"
        : "container",
    ]}
  >
    <ZebraByteLogo class="mr-auto" />

    <nav
      class="hidden items-center gap-2.25 xl:flex"
      transition:name="header-nav"
      aria-label="Navigație principală"
    >
      <HeaderMenu groups={menuGroups} />
    </nav>

    <div class="ml-auto hidden items-center gap-2 xl:ml-3 xl:flex" transition:name="header-actions">
      <LanguageSwitcher />
      <Button href="/contact" class="h-8 px-3 whitespace-nowrap">
        Discută cu un expert
      </Button>
      <AccountMenu id="client-access-panel-desktop" />
    </div>

    <slot />

    {
      !hideBurger && (
        <div class="ml-auto flex items-center gap-1 xl:hidden">
          <LanguageSwitcher compact />
          <AccountMenu id="client-access-panel-mobile" mobile />

          <burger-menu
            class="group grid size-10 cursor-pointer place-items-center rounded-lg transition-colors hover:bg-subtle"
            aria-label="Deschide meniul"
            aria-expanded="false"
            aria-controls="mobile-menu"
            role="button"
            tabindex="0"
          >
            <span class="relative grid size-6 place-items-center" aria-hidden="true">
              <Icon name="list" size={22} class="group-aria-expanded:hidden" />
              <Icon name="x" size={22} class="hidden group-aria-expanded:block" />
            </span>
          </burger-menu>
        </div>
      )
    }
  </div>
</header>
