---
import type { MenuGroup } from "../content/menu";
import Icon from "./Icon.astro";
import MenuIcon from "./MenuIcon.astro";
import Button from "./ui/Button.svelte";

interface Props {
  groups: MenuGroup[];
}

const { groups } = Astro.props;
const menuId = "desktop-navigation-menu";
---

<header-menu class="relative flex h-8 items-center gap-2.25">
  {
    groups.map((group, index) => {
      const triggerId = `${menuId}-trigger-${index}`;
      return (
        <Button
          variant="navigation"
          size="navigation"
          type={group.href ? undefined : "button"}
          href={group.href}
          id={triggerId}
          data-menu-trigger
          data-menu-index={index}
          aria-expanded="false"
          aria-controls={menuId}
        >
          {group.label}
          <Icon name="caret-down" size={14} />
        </Button>
      );
    })
  }

  <div
    data-hover-corridor
    class="fixed top-12 left-1/2 z-10 h-7 w-[min(1120px,calc(100vw-40px))] -translate-x-1/2"
    hidden
  ></div>

  <div
    id={menuId}
    data-menu-viewport
    class="fixed top-16 left-1/2 z-10 w-[min(1120px,calc(100vw-40px))] pt-3"
    hidden
  >
    <div
      data-menu-shell
      class="bg-secondary relative h-[min(29.5rem,calc(100vh-5.75rem))] overflow-hidden rounded-2xl shadow-[inset_0_0_0_1px_var(--color-border-low),0_16px_32px_rgba(186,193,122,0.2)]"
    >
      {
        groups.map((group, index) => (
          <div
            data-menu-panel
            data-menu-index={index}
            role="group"
            aria-labelledby={`${menuId}-trigger-${index}`}
            class="absolute inset-0 grid grid-cols-[minmax(0,1.45fr)_minmax(360px,0.95fr)] items-start gap-5 p-3"
            hidden
          >
            <div class="flex min-w-0 flex-col items-start gap-6 self-start overflow-hidden px-2 py-5">
              {group.showLabel !== false && (
                <p class="text-muted-foreground px-3 text-sm font-medium">
                  {group.label}
                </p>
              )}
              <div class="grid w-full grid-cols-2 gap-x-2.5 gap-y-1.5">
                {group.items.map((item) => (
                  <a
                    href={item.href}
                    class="navigation-menu-link relative isolate flex min-h-19 min-w-0 items-start gap-3 rounded-2xl p-3 outline-none"
                  >
                    <span class="grid size-11 shrink-0 place-items-center rounded-[10px] border">
                      <MenuIcon name={item.icon} />
                    </span>
                    <span class="min-w-0 pt-0.5 text-[14.8px] leading-5">
                      <span class="block font-semibold">{item.label}</span>
                      <span class="text-muted-foreground mt-0.5 block text-[12.8px] leading-[17px]">
                        {item.description}
                      </span>
                    </span>
                  </a>
                ))}
              </div>
            </div>

            <a
              href={group.feature.href}
              class="bg-subtle group/feature relative block aspect-square min-w-0 overflow-hidden rounded-lg outline-none focus-visible:ring-2 focus-visible:ring-current"
              aria-label={`${group.feature.eyebrow}: ${group.feature.title}`}
            >
              <img
                data-menu-feature-image
                data-src={group.feature.asset}
                alt={group.feature.alt}
                width="640"
                height="640"
                decoding="async"
                fetchpriority="low"
                class:list={[
                  "navigation-feature-media absolute max-w-none",
                  group.feature.variant === "story" &&
                    "navigation-feature-media--story inset-0 size-full object-cover",
                  group.feature.variant === "product" &&
                    "navigation-feature-media--product top-25 left-6 h-180 w-270 rounded-[15px] object-cover object-top-left shadow-[0_16px_32px_rgba(186,193,122,0.2)]",
                  group.feature.variant === "guide" &&
                    "navigation-feature-media--guide top-25 -left-43.5 h-55 w-193.5",
                ]}
              />

              {group.feature.variant === "story" && (
                <span class="absolute inset-0 bg-linear-to-b from-[rgba(0,0,0,0.72)] via-[rgba(0,0,0,0.05)] to-[rgba(0,0,0,0.35)]" />
              )}
              {group.feature.variant !== "story" && (
                <span class="navigation-feature-halo" aria-hidden="true" />
              )}

              <span
                class:list={[
                  "absolute top-5 right-5 left-5 z-10 flex flex-col items-start gap-1 [word-break:break-word]",
                  group.feature.variant === "story" && "text-white",
                ]}
              >
                <span
                  class:list={[
                    "text-sm leading-5 font-medium",
                    group.feature.variant === "story"
                      ? "text-[#e6ff03]"
                      : "text-muted-foreground",
                  ]}
                >
                  {group.feature.eyebrow}
                </span>
                <span class="text-[20px] leading-7 font-semibold tracking-[-0.4px]">
                  {group.feature.title}
                </span>
              </span>
            </a>
          </div>
        ))
      }
    </div>
  </div>
</header-menu>

<script>
  import { customElementDefine } from "../lib/dom";

  class HeaderMenu extends HTMLElement {
    private triggers: HTMLElement[] = [];
    private panels: HTMLElement[] = [];
    private viewport: HTMLElement | null = null;
    private corridor: HTMLElement | null = null;
    private activeIndex = -1;
    private closeTimer: number | null = null;

    connectedCallback() {
      this.triggers = Array.from(this.querySelectorAll<HTMLElement>("[data-menu-trigger]"));
      this.panels = Array.from(this.querySelectorAll<HTMLElement>("[data-menu-panel]"));
      this.viewport = this.querySelector<HTMLElement>("[data-menu-viewport]");
      this.corridor = this.querySelector<HTMLElement>("[data-hover-corridor]");

      this.triggers.forEach((trigger) => {
        trigger.addEventListener("pointerenter", this.onTriggerPointerEnter);
        trigger.addEventListener("focus", this.onTriggerFocus);
      });
      this.addEventListener("pointerenter", this.cancelClose);
      this.addEventListener("pointerleave", this.scheduleClose);
      this.addEventListener("focusout", this.onFocusOut);
      document.addEventListener("keydown", this.onKeyDown);
    }

    disconnectedCallback() {
      this.triggers.forEach((trigger) => {
        trigger.removeEventListener("pointerenter", this.onTriggerPointerEnter);
        trigger.removeEventListener("focus", this.onTriggerFocus);
      });
      this.removeEventListener("pointerenter", this.cancelClose);
      this.removeEventListener("pointerleave", this.scheduleClose);
      this.removeEventListener("focusout", this.onFocusOut);
      document.removeEventListener("keydown", this.onKeyDown);
      this.cancelClose();
    }

    private indexFromTrigger(trigger: HTMLElement) {
      return Number(trigger.dataset.menuIndex);
    }

    private loadPanelMedia(index: number) {
      const image = this.panels[index]?.querySelector<HTMLImageElement>("[data-menu-feature-image]");
      if (!image || image.getAttribute("src")) return;
      const src = image.dataset.src;
      if (src) image.src = src;
    }

    private open(index: number) {
      if (!this.viewport || !this.panels[index]) return;
      this.cancelClose();
      this.loadPanelMedia(index);
      this.activeIndex = index;
      this.viewport.hidden = false;
      if (this.corridor) this.corridor.hidden = false;

      this.panels.forEach((panel, panelIndex) => {
        panel.hidden = panelIndex !== index;
        panel.inert = panelIndex !== index;
        panel.setAttribute("aria-hidden", String(panelIndex !== index));
      });
      this.triggers.forEach((trigger, triggerIndex) => {
        trigger.setAttribute("aria-expanded", String(triggerIndex === index));
      });

      requestAnimationFrame(() => {
        this.dataset.open = "true";
      });
    }

    private close = () => {
      if (!this.viewport) return;
      this.activeIndex = -1;
      this.dataset.open = "false";
      this.triggers.forEach((trigger) => trigger.setAttribute("aria-expanded", "false"));
      window.setTimeout(() => {
        if (this.dataset.open === "true") return;
        if (this.viewport) this.viewport.hidden = true;
        if (this.corridor) this.corridor.hidden = true;
        this.panels.forEach((panel) => {
          panel.hidden = true;
          panel.inert = true;
          panel.setAttribute("aria-hidden", "true");
        });
      }, 180);
    };

    private onTriggerPointerEnter = (event: PointerEvent) => {
      if (event.pointerType === "touch") return;
      this.open(this.indexFromTrigger(event.currentTarget as HTMLElement));
    };

    private onTriggerFocus = (event: FocusEvent) => {
      this.open(this.indexFromTrigger(event.currentTarget as HTMLElement));
    };

    private cancelClose = () => {
      if (this.closeTimer === null) return;
      window.clearTimeout(this.closeTimer);
      this.closeTimer = null;
    };

    private scheduleClose = () => {
      this.cancelClose();
      this.closeTimer = window.setTimeout(() => {
        this.closeTimer = null;
        if (!this.matches(":hover") && !this.contains(document.activeElement)) this.close();
      }, 160);
    };

    private onFocusOut = (event: FocusEvent) => {
      if (!this.contains(event.relatedTarget as Node | null)) this.scheduleClose();
    };

    private onKeyDown = (event: KeyboardEvent) => {
      if (event.key !== "Escape" || this.activeIndex < 0) return;
      const trigger = this.triggers[this.activeIndex];
      this.close();
      trigger?.focus();
    };
  }

  customElementDefine("header-menu", () => HeaderMenu);
</script>

<style>
  .navigation-menu-link::before {
    position: absolute;
    inset: 0;
    z-index: -1;
    border-radius: inherit;
    pointer-events: none;
    content: "";
    background: var(--color-subtle);
    opacity: 0;
    transform: scale(0.96);
    transition: opacity 180ms ease, transform 180ms ease;
  }

  .navigation-menu-link:focus-visible::before {
    opacity: 1;
    transform: scale(1);
  }

  @media (hover: hover) and (pointer: fine) {
    .navigation-menu-link:hover::before {
      opacity: 1;
      transform: scale(1);
    }
  }

  [data-menu-viewport] {
    opacity: 0;
    pointer-events: none;
    transform: translateX(-50%) translateY(-6px) scale(0.99);
    transform-origin: top center;
    transition: opacity 150ms ease, transform 180ms ease;
  }

  header-menu[data-open="true"] [data-menu-viewport] {
    opacity: 1;
    pointer-events: auto;
    transform: translateX(-50%) translateY(0) scale(1);
  }

  .navigation-feature-halo {
    position: absolute;
    inset: 18% -20% -38%;
    display: block;
    border-radius: 50%;
    background: radial-gradient(circle at 50% 45%, rgba(147, 201, 38, 0.2), transparent 62%);
    pointer-events: none;
  }

  @media (prefers-reduced-motion: reduce) {
    .navigation-menu-link::before,
    [data-menu-viewport] {
      transition: none;
    }
  }

  @media (prefers-reduced-motion: no-preference) and (hover: hover) and (pointer: fine) {
    .navigation-feature-media {
      transition: transform 220ms ease;
    }
    a:hover .navigation-feature-media--product {
      transform: translate3d(0, -4px, 0);
    }
    a:hover .navigation-feature-media--guide {
      transform: translate3d(-8px, 0, 0);
    }
    a:hover .navigation-feature-media--story {
      transform: scale(1.02);
    }
  }
</style>
