---
import { menuGroups as fallbackMenuGroups, type MenuGroup } from "../content/menu.ts";
import Icon from "./Icon.astro";
import MenuIcon from "./MenuIcon.astro";

interface MenuCta {
  label: string;
  href: string;
}

interface Props {
  id?: string;
  groups?: MenuGroup[];
  primaryCta?: MenuCta;
  secondaryCta?: MenuCta;
}

const {
  id,
  groups = fallbackMenuGroups,
  primaryCta = { label: "Discută cu un expert", href: "/contact" },
  secondaryCta = { label: "Vezi Platforma GRC", href: "/compliance-platform" },
} = Astro.props;
const currentPath = Astro.url.pathname;

const isGroupActive = (group: MenuGroup) =>
  group.items.some(
    (item) => item.href.startsWith("/") && currentPath.startsWith(item.href),
  ) ||
  (group.feature.href.startsWith("/") &&
    currentPath.startsWith(group.feature.href));
---

<div
  {id}
  data-mobile-navigation
  hidden
  aria-hidden="true"
  class="bg-secondary pointer-events-none fixed inset-x-0 top-16 bottom-0 z-40 -translate-y-2 overflow-y-auto border-t opacity-0 transition-[opacity,transform] duration-200 xl:hidden"
>
  <div class="mx-auto w-full max-w-2xl px-4 pt-4 pb-28 sm:px-5">
    <div class="overflow-hidden rounded-2xl border bg-secondary">
      {
        groups.map((group) => (
          <details
            data-mobile-section
            class="group/mobile border-b last:border-b-0"
            open={isGroupActive(group)}
          >
            <summary class="flex min-h-14 cursor-pointer list-none items-center justify-between gap-4 px-4 py-3.5 text-[16px] font-semibold outline-none transition-colors hover:bg-subtle/60 focus-visible:ring-2 focus-visible:ring-current focus-visible:ring-inset group-open/mobile:bg-subtle/70 [&::-webkit-details-marker]:hidden">
              <span>{group.label}</span>
              <span class="text-muted-foreground grid size-7 shrink-0 place-items-center transition-transform duration-200 group-open/mobile:rotate-180">
                <Icon name="caret-down" size={17} />
              </span>
            </summary>

            <div class="bg-subtle/45 border-t px-2 pt-1 pb-3">
              <div class="flex w-full flex-col">
                {group.items.map((item) => {
                  const external = item.href.startsWith("http");
                  return (
                    <a
                      href={item.href}
                      target={external ? "_blank" : undefined}
                      rel={external ? "noopener noreferrer" : undefined}
                      class="group/item flex items-start gap-3 rounded-xl px-2 py-3 outline-none transition-colors hover:bg-secondary focus-visible:bg-secondary"
                    >
                      <span class="bg-secondary grid size-9 shrink-0 place-items-center rounded-lg border">
                        <MenuIcon name={item.icon} />
                      </span>
                      <span class="min-w-0 flex-1 pt-0.5">
                        <span class="block text-[14px] leading-5 font-semibold">
                          {item.label}
                        </span>
                        <span class="text-muted-foreground mt-0.5 block text-[12.5px] leading-[18px]">
                          {item.description}
                        </span>
                      </span>
                      <Icon
                        name="caret-right"
                        size={16}
                        class="text-muted-foreground mt-2 shrink-0 transition-transform group-hover/item:translate-x-0.5"
                      />
                    </a>
                  );
                })}
              </div>

              <a
                href={group.feature.href}
                target={group.feature.href.startsWith("http") ? "_blank" : undefined}
                rel={group.feature.href.startsWith("http") ? "noopener noreferrer" : undefined}
                class="bg-secondary group/feature mx-1 mt-2 block overflow-hidden rounded-xl border outline-none transition-shadow hover:shadow-mid focus-visible:ring-2 focus-visible:ring-current focus-visible:ring-offset-2"
                aria-label={`${group.feature.eyebrow}: ${group.feature.title}`}
              >
                <div class="relative aspect-[16/9] overflow-hidden">
                  <img
                    src={group.feature.asset}
                    alt={group.feature.alt}
                    width="640"
                    height="360"
                    loading={group.label === "Companie" ? "eager" : "lazy"}
                    decoding="async"
                    fetchpriority={group.label === "Companie" ? "auto" : "low"}
                    data-mobile-feature-image
                    class:list={[
                      "absolute inset-0 size-full",
                      group.feature.variant === "story" && "object-cover",
                      group.feature.variant === "product" &&
                        "object-cover object-top",
                      group.feature.variant === "guide" &&
                        "object-contain object-bottom px-4 pt-14 pb-3",
                    ]}
                  />

                  {group.feature.variant === "story" && (
                    <span class="absolute inset-0 bg-linear-to-b from-[rgba(0,0,0,0.72)] via-[rgba(0,0,0,0.05)] to-[rgba(0,0,0,0.35)]" />
                  )}

                  {group.feature.variant !== "story" && (
                    <span class="mobile-navigation-feature-halo" aria-hidden="true" />
                  )}

                  <span
                    class:list={[
                      "absolute top-3.5 right-4 left-4 z-10 flex flex-col gap-1",
                      group.feature.variant === "story" && "text-white",
                    ]}
                  >
                    <span
                      class:list={[
                        "text-[11px] leading-4 font-semibold",
                        group.feature.variant === "story"
                          ? "text-[#e6ff03]"
                          : "text-muted-foreground",
                      ]}
                    >
                      {group.feature.eyebrow}
                    </span>
                    <span class="max-w-[28rem] text-[16px] leading-5 font-semibold tracking-[-0.15px]">
                      {group.feature.title}
                    </span>
                  </span>
                </div>
              </a>
            </div>
          </details>
        ))
      }
    </div>

    <div class="mt-4 grid gap-2.5">
      <a
        href={primaryCta.href}
        class="bg-primary text-primary-foreground flex min-h-12 items-center justify-center rounded-full px-4 text-center text-[15px] font-semibold transition-opacity hover:opacity-90"
      >
        {primaryCta.label}
      </a>
      <a
        href={secondaryCta.href}
        class="flex min-h-11 items-center justify-center rounded-full border bg-secondary px-4 text-center text-[14px] font-semibold transition-colors hover:bg-subtle"
      >
        {secondaryCta.label}
      </a>
    </div>
  </div>
</div>

<style>
.mobile-navigation-feature-halo{position:absolute;bottom:-52px;left:50%;z-index:2;display:block;width:min(783px,180vw);aspect-ratio:1;transform:translateX(-50%);pointer-events:none}.mobile-navigation-feature-halo::before{position:absolute;inset:-21.93%;content:"";background:url("/navigation/ellipse.svg") center/100% 100% no-repeat;transform:rotate(180deg) scaleY(-1)}
</style>

<script>
  const warmedFeatureUrls = new Set<string>();

  const warmImage = (image: HTMLImageElement | null) => {
    if (!image) return;
    const src = image.currentSrc || image.src;
    if (!src || warmedFeatureUrls.has(src)) return;

    warmedFeatureUrls.add(src);
    const preload = new Image();
    preload.decoding = "async";
    preload.src = src;
  };

  const bindMobileNavigation = () => {
    document
      .querySelectorAll<HTMLElement>("[data-mobile-navigation]")
      .forEach((menu) => {
        if (menu.dataset.navigationBound === "true") return;
        menu.dataset.navigationBound = "true";

        const sections = Array.from(
          menu.querySelectorAll<HTMLDetailsElement>(
            "details[data-mobile-section]",
          ),
        );

        sections.forEach((section) => {
          section.addEventListener("toggle", () => {
            if (!section.open) return;

            warmImage(
              section.querySelector<HTMLImageElement>(
                "[data-mobile-feature-image]",
              ),
            );

            sections.forEach((other) => {
              if (other !== section) other.open = false;
            });
          });
        });
      });
  };

  document.addEventListener("astro:page-load", bindMobileNavigation);
  bindMobileNavigation();
</script>
