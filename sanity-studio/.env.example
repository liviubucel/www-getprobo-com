# These values are public Studio configuration, not secrets.
SANITY_STUDIO_PROJECT_ID=yj548pxh
SANITY_STUDIO_DATASET=production

# Presentation Tool frontend. Use staging for editor preview; production can be
# selected later after the dedicated draft-preview path is enabled.
SANITY_STUDIO_PREVIEW_URL=https://stag.zebrabyte.ro

# Never put read/write/deploy tokens in SANITY_STUDIO_* variables.
# Sanity Studio authenticates editors with their Sanity account session.
